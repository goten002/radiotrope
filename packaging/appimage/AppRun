#!/bin/sh
# AppRun: the AppImage starts the desktop app. The two terminal tools are
# inside it too, reached either way:
#
#   ./Radiotrope.AppImage radiotrope-cli --help      by name as the first argument
#   ln -s Radiotrope.AppImage radiotrope-cli         or through a link with its name
#
# The libraries the AppImage carries are found through the programs' rpath
# (set by linuxdeploy), so nothing is exported here: the programs
# Radiotrope starts (xdg-open, a file manager) see the system's own
# libraries.
HERE=$(dirname "$(readlink -f "$0")")

case "$1" in
radiotrope-cli | radiotrope-probe)
    program=$1
    shift
    exec "$HERE/usr/bin/$program" "$@"
    ;;
esac

# ARGV0 is the name the AppImage was started by (set by its runtime)
case "$(basename "${ARGV0:-$0}")" in
radiotrope-cli*) exec "$HERE/usr/bin/radiotrope-cli" "$@" ;;
radiotrope-probe*) exec "$HERE/usr/bin/radiotrope-probe" "$@" ;;
*) exec "$HERE/usr/bin/radiotrope" "$@" ;;
esac
