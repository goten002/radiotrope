import { Theme } from "defaults.slint";

// Live audio levels, written from Rust about 30 times a second
export global VizData {
    in property <float> vu-left;
    in property <float> vu-right;
    // Bar heights per band (0-1), noise-gated
    in property <[float]> spectrum;
    // Dot Matrix: band pairs averaged into 8 columns, and their peak dots
    in property <[float]> columns;
    in property <[float]> peaks;
    // Something is playing; off, the modes show nothing
    in property <bool> active;
    // Some band has a level (not silence)
    in property <bool> has-signal;
}

// Visualizer colours
export global VizStyle {
    // "logo" (colours sampled from the station logo) or "accent"
    in-out property <string> palette: "logo";
    // Up to three main colours of the current station logo, from Rust
    in property <[color]> logo-colors;

    // Colour at position t (0-1) across the bars: the logo colours spread
    // from left to right, or the accent when there are none
    public pure function bar-color(t: float) -> color {
        if palette != "logo" || logo-colors.length == 0 {
            return Theme.accent;
        }
        if logo-colors.length == 1 {
            return logo-colors[0];
        }
        if logo-colors.length == 2 {
            return logo-colors[1].mix(logo-colors[0], t);
        }
        if t < 0.5 {
            return logo-colors[1].mix(logo-colors[0], t * 2);
        }
        return logo-colors[2].mix(logo-colors[1], (t - 0.5) * 2);
    }

    // Mode after `mode` in the click cycle: Wave (the default), Spectrum,
    // Mirror, Dot Matrix, VU, horizontal VU
    public pure function next-mode(mode: string) -> string {
        if mode == "wave" { return "spectrum"; }
        if mode == "spectrum" { return "mirror"; }
        if mode == "mirror" { return "dots"; }
        if mode == "dots" { return "vu"; }
        if mode == "vu" { return "hbars"; }
        return "wave";
    }
}

// One bar used by every mode: a flat fill with no track behind it. `anchor`
// is where the fill grows from: "bottom", "center" or "left".
component Bar inherits Rectangle {
    in property <float> level;
    in property <color> tint: Theme.accent;
    in property <string> anchor: "bottom";

    property <bool> horizontal: anchor == "left";
    property <float> amount: clamp(root.level, 0, 1);

    if root.amount > 0.01: Rectangle {
        width: root.horizontal ? max(2px, root.amount * parent.width) : parent.width;
        height: root.horizontal ? parent.height : max(2px, root.amount * parent.height);
        x: 0;
        y: root.anchor == "bottom" ? parent.height - self.height
            : root.anchor == "center" ? (parent.height - self.height) / 2
            : 0;
        border-radius: 1.5px;
        background: root.tint;
    }
}

// The visualizer drawing for a mode, filling its area (no background)
export component VizContent inherits Rectangle {
    in property <string> mode: "wave";
    in property <bool> is-loading;
    // Gap between spectrum bars
    in property <length> gap: 1px;

    // Loading animation (tuning): a needle sweeps back and forth across a
    // row of faint dial ticks, which light up and rise as it passes, like a
    // radio searching for the station
    property <int> tune-ticks: 16;
    // Needle position across the dial (0-1), easing at both ends
    property <float> tune-pos: 0.5 - 0.5 * cos(mod(animation-tick() / 1600ms * 180deg, 360deg));
    property <length> tune-gap: 2px;
    property <length> tune-tick: (root.width - (root.tune-ticks - 1) * root.tune-gap) / root.tune-ticks;

    if root.is-loading: Rectangle {
        for i in root.tune-ticks: Bar {
            // How close the needle is (1 at the tick, fading within a few ticks)
            property <float> near: pow(2.718, -pow((i + 0.5) / root.tune-ticks - root.tune-pos, 2) / 0.006);

            x: i * (root.tune-tick + root.tune-gap);
            width: root.tune-tick;
            height: parent.height;
            level: 0.14 + 0.5 * self.near;
            opacity: 0.25 + 0.75 * self.near;
            tint: VizStyle.bar-color(i / (root.tune-ticks - 1));
        }

        Rectangle {
            x: root.tune-pos * parent.width - 1px;
            y: 4px;
            width: 2px;
            height: parent.height - 4px;
            border-radius: 1px;
            background: VizStyle.bar-color(root.tune-pos);
        }
    }

    // Spectrum: bars rising from the bottom
    if !root.is-loading && root.mode == "spectrum": HorizontalLayout {
        spacing: root.gap;

        for val[i] in VizData.spectrum: Bar {
            horizontal-stretch: 1;
            level: val;
            tint: VizStyle.bar-color(i / max(1, VizData.spectrum.length - 1));
        }
    }

    // Mirror: bars grow out from the middle, the same up and down
    if !root.is-loading && root.mode == "mirror": HorizontalLayout {
        spacing: root.gap;

        for val[i] in VizData.spectrum: Bar {
            horizontal-stretch: 1;
            level: val;
            anchor: "center";
            tint: VizStyle.bar-color(i / max(1, VizData.spectrum.length - 1));
        }
    }

    // Wave: the bands as one smooth curve with a soft fill below. Drawn as
    // one piece per pair of bands so each piece has a single colour: the
    // software renderer (Pi build) fills a path with one colour only.
    property <float> vw: root.width / 1px;
    property <float> vh: root.height / 1px;
    property <int> last-band: VizData.spectrum.length - 1;

    pure function wave-x(i: int) -> float {
        return clamp(i, 0, root.last-band) * root.vw / max(1, root.last-band);
    }

    pure function wave-y(i: int) -> float {
        return root.vh - 1 - clamp(VizData.spectrum[clamp(i, 0, root.last-band)], 0, 1) * (root.vh - 3);
    }


    // Colour of the piece from band i to i + 1
    pure function wave-color(i: int) -> color {
        return VizStyle.bar-color((i + 0.5) / max(1, root.last-band));
    }

    // The whole curve shows while any band has a level, running along the
    // bottom where bands are quiet; silence leaves the tile empty like the
    // bars instead of a flat line
    if !root.is-loading && root.mode == "wave" && VizData.has-signal: Rectangle {
        // Fill: opaque (mixed with the tile colour) so the pieces can
        // overlap slightly and leave no seams
        for i in root.last-band: Path {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            viewbox-width: root.vw;
            viewbox-height: root.vh;
            fill: root.wave-color(i).mix(Theme.viz-bg, 0.28);

            MoveTo { x: root.wave-x(i); y: root.vh; }
            LineTo { x: root.wave-x(i); y: root.wave-y(i); }
            CubicTo {
                control-1-x: root.wave-x(i) + (root.wave-x(i + 1) - root.wave-x(i - 1)) / 6;
                control-1-y: root.wave-y(i) + (root.wave-y(i + 1) - root.wave-y(i - 1)) / 6;
                control-2-x: root.wave-x(i + 1) - (root.wave-x(i + 2) - root.wave-x(i)) / 6;
                control-2-y: root.wave-y(i + 1) - (root.wave-y(i + 2) - root.wave-y(i)) / 6;
                x: root.wave-x(i + 1);
                y: root.wave-y(i + 1);
            }
            LineTo { x: root.wave-x(i + 1) + 0.6; y: root.wave-y(i + 1); }
            LineTo { x: root.wave-x(i + 1) + 0.6; y: root.vh; }
            Close { }
        }

        // Line on top
        for i in root.last-band: Path {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            viewbox-width: root.vw;
            viewbox-height: root.vh;
            stroke: root.wave-color(i);
            stroke-width: 2px;
            stroke-line-cap: round;

            MoveTo { x: root.wave-x(i); y: root.wave-y(i); }
            CubicTo {
                control-1-x: root.wave-x(i) + (root.wave-x(i + 1) - root.wave-x(i - 1)) / 6;
                control-1-y: root.wave-y(i) + (root.wave-y(i + 1) - root.wave-y(i - 1)) / 6;
                control-2-x: root.wave-x(i + 1) - (root.wave-x(i + 2) - root.wave-x(i)) / 6;
                control-2-y: root.wave-y(i + 1) - (root.wave-y(i + 2) - root.wave-y(i)) / 6;
                x: root.wave-x(i + 1);
                y: root.wave-y(i + 1);
            }
        }
    }

    // Dot Matrix: 8 columns of LED dots, unlit ones faint, with a peak dot
    // on each column that hangs, then falls
    property <int> dot-count: 8;
    property <length> dot-gap: 2px;
    property <length> dot: (min(root.width, root.height) - (root.dot-count - 1) * root.dot-gap) / root.dot-count;
    property <length> dots-size: root.dot-count * root.dot + (root.dot-count - 1) * root.dot-gap;

    if !root.is-loading && root.mode == "dots": Rectangle {
        for level[c] in VizData.columns: Rectangle {
            // Level in dots: whole dots are lit, the one above lights by the
            // fraction, so the column fades between dots instead of jumping
            property <float> fill: clamp(level, 0, 1) * root.dot-count;
            // Dot holding the peak, shown only above the lit ones
            property <int> peak-row: ceil(clamp(VizData.peaks[c], 0, 1) * root.dot-count) - 1;
            property <color> tint: VizStyle.bar-color(c / max(1, VizData.columns.length - 1));

            x: (parent.width - root.dots-size) / 2 + c * (root.dot + root.dot-gap);
            y: (parent.height - root.dots-size) / 2;
            width: root.dot;
            height: root.dots-size;

            for r in root.dot-count: Rectangle {
                y: parent.height - (r + 1) * root.dot - r * root.dot-gap;
                width: root.dot;
                height: root.dot;
                border-radius: root.dot / 2;
                property <bool> peak: r == parent.peak-row && r >= ceil(parent.fill);
                // Unlit dots are faint while something plays, gone when stopped
                background: parent.tint.with-alpha(self.peak ? 1 : (VizData.active ? 0.12 : 0) + 0.88 * clamp(parent.fill - r, 0, 1));
            }
        }
    }

    // VU: two vertical meters, left and right
    if !root.is-loading && root.mode == "vu": HorizontalLayout {
        spacing: 6px;
        alignment: center;

        Bar {
            width: 20px;
            level: VizData.vu-left;
            tint: VizStyle.bar-color(0);
        }

        Bar {
            width: 20px;
            level: VizData.vu-right;
            tint: VizStyle.bar-color(1);
        }
    }

    // Horizontal VU: the same two meters lying down, same thickness
    if !root.is-loading && root.mode == "hbars": VerticalLayout {
        spacing: 6px;
        alignment: center;

        Bar {
            height: 20px;
            level: VizData.vu-left;
            anchor: "left";
            tint: VizStyle.bar-color(0);
        }

        Bar {
            height: 20px;
            level: VizData.vu-right;
            anchor: "left";
            tint: VizStyle.bar-color(1);
        }
    }
}

// 70px tile in the header; click cycles the mode
export component Visualization inherits Rectangle {
    in property <bool> is-loading;
    in-out property <string> viz-mode: "wave";

    width: 70px;
    height: 70px;
    background: Theme.viz-bg;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.hairline;
    clip: true;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.viz-mode = VizStyle.next-mode(root.viz-mode); }
    }

    VizContent {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        mode: root.viz-mode;
        is-loading: root.is-loading;
    }
}
