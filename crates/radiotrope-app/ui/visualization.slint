import { Theme } from "theme.slint";

// Live audio levels, written from Rust about 30 times a second
export global VizData {
    in property <float> vu-left;
    in property <float> vu-right;
    // Bar heights per band (0-1), noise-gated
    in property <[float]> spectrum;
}

// Visualizer colours
export global VizStyle {
    // "logo" (colours sampled from the station logo) or "accent"
    in-out property <string> palette: "logo";
    // Up to three main colours of the current station logo, from Rust
    in property <[color]> logo-colors;

    // Colour at position t (0-1) across the bars: the logo colours spread
    // from left to right, or the accent when there are none
    public pure function bar-color(t: float) -> color {
        if palette != "logo" || logo-colors.length == 0 {
            return Theme.accent;
        }
        if logo-colors.length == 1 {
            return logo-colors[0];
        }
        if logo-colors.length == 2 {
            return logo-colors[1].mix(logo-colors[0], t);
        }
        if t < 0.5 {
            return logo-colors[1].mix(logo-colors[0], t * 2);
        }
        return logo-colors[2].mix(logo-colors[1], (t - 0.5) * 2);
    }

    // Mode after `mode` in the click cycle
    public pure function next-mode(mode: string) -> string {
        if mode == "mirror" { return "spectrum"; }
        if mode == "spectrum" { return "vu"; }
        if mode == "vu" { return "hbars"; }
        return "mirror";
    }
}

// One bar used by every mode: a recessed track with a shaded, rounded-looking
// fill. `anchor` is where the fill grows from: "bottom", "center" or "left".
component Bar inherits Rectangle {
    in property <float> level;
    in property <color> tint: Theme.accent;
    in property <string> anchor: "bottom";

    property <bool> horizontal: anchor == "left";
    property <float> amount: clamp(root.level, 0, 1);

    // Track, slightly sunk into the tile
    Rectangle {
        border-radius: 2px;
        background: Theme.viz-track;
        border-width: 1px;
        border-color: Theme.dark-mode ? #00000059 : #0000000f;
    }

    if root.amount > 0.01: Rectangle {
        width: root.horizontal ? max(2px, root.amount * parent.width) : parent.width;
        height: root.horizontal ? parent.height : max(2px, root.amount * parent.height);
        x: 0;
        y: root.anchor == "bottom" ? parent.height - self.height
            : root.anchor == "center" ? (parent.height - self.height) / 2
            : 0;
        border-radius: 2px;
        // Lit from the upper left: bright edge, full colour, darker far side
        background: root.horizontal
            ? @linear-gradient(180deg, root.tint.brighter(0.35) 0%, root.tint 40%, root.tint.darker(0.45) 100%)
            : @linear-gradient(90deg, root.tint.brighter(0.35) 0%, root.tint 45%, root.tint.darker(0.45) 100%);
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000059;

        // Highlight on the leading edge
        Rectangle {
            x: root.horizontal ? parent.width - self.width : 0;
            y: 0;
            width: root.horizontal ? 1px : parent.width;
            height: root.horizontal ? parent.height : 1px;
            border-radius: 1px;
            background: root.tint.brighter(0.7).with-alpha(0.8);
        }
    }
}

// The visualizer drawing for a mode, filling its area (no background)
export component VizContent inherits Rectangle {
    in property <string> mode: "mirror";
    in property <bool> is-loading;
    // Gap between spectrum bars
    in property <length> gap: 1px;

    // Loading animation (bouncing bars)
    if root.is-loading: HorizontalLayout {
        spacing: 3px;

        for i in [0, 1, 2, 3, 4]: Bar {
            horizontal-stretch: 1;
            level: 0.3 + 0.7 * abs(sin(mod(animation-tick() / 800ms * 360deg - i * 36deg, 360deg)));
            tint: VizStyle.bar-color(i / 4);
        }
    }

    // Spectrum: bars rising from the bottom
    if !root.is-loading && root.mode == "spectrum": HorizontalLayout {
        spacing: root.gap;

        for val[i] in VizData.spectrum: Bar {
            horizontal-stretch: 1;
            level: val;
            tint: VizStyle.bar-color(i / max(1, VizData.spectrum.length - 1));
        }
    }

    // Mirror: bars grow out from the middle, the same up and down
    if !root.is-loading && root.mode == "mirror": HorizontalLayout {
        spacing: root.gap;

        for val[i] in VizData.spectrum: Bar {
            horizontal-stretch: 1;
            level: val;
            anchor: "center";
            tint: VizStyle.bar-color(i / max(1, VizData.spectrum.length - 1));
        }
    }

    // VU: two vertical meters, left and right
    if !root.is-loading && root.mode == "vu": HorizontalLayout {
        spacing: 6px;
        alignment: center;

        Bar {
            width: 20px;
            level: VizData.vu-left;
            tint: VizStyle.bar-color(0);
        }

        Bar {
            width: 20px;
            level: VizData.vu-right;
            tint: VizStyle.bar-color(1);
        }
    }

    // Horizontal VU: the same two meters lying down, same thickness
    if !root.is-loading && root.mode == "hbars": VerticalLayout {
        spacing: 6px;
        alignment: center;

        Bar {
            height: 20px;
            level: VizData.vu-left;
            anchor: "left";
            tint: VizStyle.bar-color(0);
        }

        Bar {
            height: 20px;
            level: VizData.vu-right;
            anchor: "left";
            tint: VizStyle.bar-color(1);
        }
    }
}

// 70px tile in the header; click cycles the mode
export component Visualization inherits Rectangle {
    in property <bool> is-loading;
    in-out property <string> viz-mode: "mirror";

    width: 70px;
    height: 70px;
    background: Theme.viz-bg;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.hairline;
    clip: true;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.viz-mode = VizStyle.next-mode(root.viz-mode); }
    }

    VizContent {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        mode: root.viz-mode;
        is-loading: root.is-loading;
    }
}
