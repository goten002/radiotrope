import { Theme } from "theme.slint";

// Live audio levels, written from Rust about 30 times a second
export global VizData {
    in property <float> vu-left;
    in property <float> vu-right;
    in property <float> vu-peak-left;
    in property <float> vu-peak-right;
    // Bar heights per band (0-1), already smoothed
    in property <[float]> spectrum;
    // Peak-hold dot per band (0-1)
    in property <[float]> peaks;
    // SVG path of the spectrum as a filled curve, 100 x 100 viewbox
    in property <string> curve-path;
}

// Visualizer look: palette and whether it also runs wide behind the header
export global VizStyle {
    // "logo" (the icon's yellow-orange-magenta) or "accent"
    in-out property <string> palette: "logo";
    in-out property <bool> wide: false;

    out property <color> low: palette == "logo" ? #ffc23a : Theme.accent.brighter(0.3);
    out property <color> mid: palette == "logo" ? #ff6b2c : Theme.accent;
    out property <color> high: palette == "logo" ? #e0245e : Theme.accent.darker(0.35);
    // Bottom-to-top and left-to-right gradients
    out property <brush> vertical: @linear-gradient(0deg, low 0%, mid 55%, high 100%);
    out property <brush> downward: @linear-gradient(180deg, low 0%, mid 55%, high 100%);
    out property <brush> horizontal: @linear-gradient(90deg, low 0%, mid 60%, high 100%);
    // Mode after `mode` in the click cycle
    public pure function next-mode(mode: string) -> string {
        if mode == "mirror" { return "spectrum"; }
        if mode == "spectrum" { return "curve"; }
        if mode == "curve" { return "vu"; }
        if mode == "vu" { return "hbars"; }
        return "mirror";
    }

    out property <brush> curve-fill: @linear-gradient(0deg, low.with-alpha(0.25) 0%, mid.with-alpha(0.55) 50%, high.with-alpha(0.85) 100%);
}

// Vertical bar filled with the full-height gradient, so short bars stay
// warm and only tall ones reach the top color; optional peak-hold dot
component GradientBar inherits Rectangle {
    in property <float> level;
    in property <float> peak;
    in property <bool> show-peak: true;
    in property <bool> show-track: true;
    // Grow downward from the top edge (mirror reflection)
    in property <bool> downward: false;

    if root.show-track: Rectangle {
        border-radius: min(self.width / 2, 2px);
        background: Theme.viz-track;
    }

    Rectangle {
        x: 0;
        width: parent.width;
        height: clamp(root.level, 0, 1) * parent.height;
        y: root.downward ? 0 : parent.height - self.height;
        border-radius: min(self.width / 2, 2px);
        clip: true;

        Rectangle {
            x: 0;
            y: root.downward ? 0 : parent.height - root.height;
            width: parent.width;
            height: root.height;
            background: root.downward ? VizStyle.downward : VizStyle.vertical;
        }
    }

    if root.show-peak && root.peak > 0.03: Rectangle {
        x: 0;
        width: parent.width;
        height: 2px;
        y: (1 - clamp(root.peak, 0, 1)) * (parent.height - self.height);
        border-radius: 1px;
        background: Theme.text-primary.with-alpha(0.75);
    }
}

// Horizontal meter bar with a peak tick
component HorizontalMeter inherits Rectangle {
    in property <float> level;
    in property <float> peak;

    border-radius: min(self.height / 2, 3px);
    background: Theme.viz-track;
    clip: true;

    Rectangle {
        x: 0;
        width: clamp(root.level, 0, 1) * parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        clip: true;

        Rectangle {
            x: 0;
            width: root.width;
            height: parent.height;
            background: VizStyle.horizontal;
        }
    }

    if root.peak > 0.03: Rectangle {
        x: clamp(root.peak, 0, 1) * (parent.width - self.width);
        width: 2px;
        height: parent.height;
        background: Theme.text-primary.with-alpha(0.75);
    }
}

// The visualizer drawing for a mode, filling its area (no background)
export component VizContent inherits Rectangle {
    in property <string> mode: "mirror";
    in property <bool> is-loading;
    // Gap between spectrum bars
    in property <length> gap: 1px;
    in property <bool> peaks: true;
    // Faint full-height track behind each spectrum bar
    in property <bool> tracks: true;

    // Loading animation (bouncing gradient bars)
    if root.is-loading: HorizontalLayout {
        spacing: 3px;

        for i in [0, 1, 2, 3, 4]: Rectangle {
            horizontal-stretch: 1;

            GradientBar {
                property <float> anim: abs(sin(mod(animation-tick() / 800ms * 360deg - i * 36deg, 360deg)));
                level: 0.3 + 0.7 * self.anim;
                show-peak: false;
                show-track: false;
            }
        }
    }

    // Spectrum: gradient bars with peak dots
    if !root.is-loading && root.mode == "spectrum": HorizontalLayout {
        spacing: root.gap;

        for val[i] in VizData.spectrum: GradientBar {
            horizontal-stretch: 1;
            level: val;
            peak: i < VizData.peaks.length ? VizData.peaks[i] : 0;
            show-peak: root.peaks;
            show-track: root.tracks;
        }
    }

    // Mirror: bars grow up from the middle over a faded reflection
    if !root.is-loading && root.mode == "mirror": HorizontalLayout {
        spacing: root.gap;

        for val[i] in VizData.spectrum: VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;

            GradientBar {
                vertical-stretch: 1;
                level: val;
                peak: i < VizData.peaks.length ? VizData.peaks[i] : 0;
                show-peak: root.peaks;
                show-track: false;
            }

            GradientBar {
                vertical-stretch: 1;
                level: val;
                downward: true;
                show-peak: false;
                show-track: false;
                opacity: 0.3;
            }
        }
    }

    // Curve: the spectrum as a smooth filled shape
    if !root.is-loading && root.mode == "curve": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: VizData.curve-path;
        fill: VizStyle.curve-fill;
        stroke: VizStyle.mid;
        stroke-width: 1.5px;
    }

    // VU: two vertical meters, left and right
    if !root.is-loading && root.mode == "vu": HorizontalLayout {
        spacing: 4px;
        alignment: center;

        GradientBar {
            width: min(root.width / 2 - 4px, 22px);
            level: VizData.vu-left;
            peak: VizData.vu-peak-left;
            show-peak: root.peaks;
        }

        GradientBar {
            width: min(root.width / 2 - 4px, 22px);
            level: VizData.vu-right;
            peak: VizData.vu-peak-right;
            show-peak: root.peaks;
        }
    }

    // Horizontal VU bars
    if !root.is-loading && root.mode == "hbars": VerticalLayout {
        spacing: 6px;
        alignment: center;

        HorizontalMeter {
            height: min(root.height / 2 - 6px, 14px);
            level: VizData.vu-left;
            peak: VizData.vu-peak-left;
        }

        HorizontalMeter {
            height: min(root.height / 2 - 6px, 14px);
            level: VizData.vu-right;
            peak: VizData.vu-peak-right;
        }
    }
}

// 70px tile in the header; click cycles the mode
export component Visualization inherits Rectangle {
    in property <bool> is-loading;
    in-out property <string> viz-mode: "mirror";

    width: 70px;
    height: 70px;
    background: Theme.viz-bg;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.hairline;
    clip: true;

    // Soft glow at the bottom, in the palette's warm color
    Rectangle {
        background: @linear-gradient(0deg, VizStyle.mid.with-alpha(0.14) 0%, VizStyle.mid.with-alpha(0) 70%);
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.viz-mode = VizStyle.next-mode(root.viz-mode); }
    }

    VizContent {
        x: 7px;
        y: 7px;
        width: parent.width - 14px;
        height: parent.height - 14px;
        mode: root.viz-mode;
        is-loading: root.is-loading;
    }
}
