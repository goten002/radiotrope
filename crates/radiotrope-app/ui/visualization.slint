import { Theme } from "theme.slint";

// Live audio levels, written from Rust about 30 times a second
export global VizData {
    in property <float> vu-left;
    in property <float> vu-right;
    in property <float> vu-peak-left;
    in property <float> vu-peak-right;
    // Bar heights per band (0-1), already smoothed and noise-gated
    in property <[float]> spectrum;
    // Peak-hold dot per band (0-1)
    in property <[float]> peaks;
}

// Visualizer colours
export global VizStyle {
    // "logo" (the app icon's yellow, orange, red and magenta) or "accent"
    in-out property <string> palette: "logo";

    // Colour of a bar at position t (0 = bass on the left, 1 = treble)
    public pure function bar-color(t: float) -> color {
        if palette != "logo" {
            return Theme.accent;
        }
        if t < 0.33 {
            return #ff7a1f.mix(#ffc23a, t / 0.33);
        }
        if t < 0.66 {
            return #f0284a.mix(#ff7a1f, (t - 0.33) / 0.33);
        }
        return #b01c78.mix(#f0284a, (t - 0.66) / 0.34);
    }

    // Level-meter gradient, bottom to top (quiet to loud)
    out property <brush> meter: palette == "logo"
        ? @linear-gradient(0deg, #ffc23a 0%, #ff7a1f 45%, #f0284a 80%, #b01c78 100%)
        : @linear-gradient(0deg, Theme.accent.brighter(0.3) 0%, Theme.accent 55%, Theme.accent.darker(0.35) 100%);
    out property <brush> meter-horizontal: palette == "logo"
        ? @linear-gradient(90deg, #ffc23a 0%, #ff7a1f 45%, #f0284a 80%, #b01c78 100%)
        : @linear-gradient(90deg, Theme.accent.brighter(0.3) 0%, Theme.accent 60%, Theme.accent.darker(0.35) 100%);

    // Mode after `mode` in the click cycle
    public pure function next-mode(mode: string) -> string {
        if mode == "mirror" { return "spectrum"; }
        if mode == "spectrum" { return "vu"; }
        if mode == "vu" { return "hbars"; }
        return "mirror";
    }
}

// Spectrum bar growing up from the bottom, with a peak-hold dot
component SpectrumBar inherits Rectangle {
    in property <float> level;
    in property <float> peak;
    in property <color> tint;

    if root.level > 0.01: Rectangle {
        x: 0;
        width: parent.width;
        height: clamp(root.level, 0, 1) * parent.height;
        y: parent.height - self.height;
        border-radius: min(self.width / 2, 1.5px);
        background: @linear-gradient(0deg, root.tint.darker(0.3) 0%, root.tint 100%);
    }

    if root.peak > 0.03: Rectangle {
        x: 0;
        width: parent.width;
        height: 2px;
        y: (1 - clamp(root.peak, 0, 1)) * (parent.height - self.height);
        background: Theme.text-primary.with-alpha(0.75);
    }
}

// Mirror bar: grows out from the middle, the same up and down
component MirrorBar inherits Rectangle {
    in property <float> level;
    in property <float> peak;
    in property <color> tint;

    if root.level > 0.01: Rectangle {
        x: 0;
        width: parent.width;
        height: clamp(root.level, 0, 1) * parent.height;
        y: (parent.height - self.height) / 2;
        border-radius: min(self.width / 2, 1.5px);
        background: @linear-gradient(0deg, root.tint 0%, root.tint.darker(0.3) 50%, root.tint 100%);
    }

    if root.peak > 0.03: Rectangle {
        x: 0;
        width: parent.width;
        height: 1.5px;
        y: (1 - clamp(root.peak, 0, 1)) * (parent.height - self.height) / 2;
        background: Theme.text-primary.with-alpha(0.7);
    }

    if root.peak > 0.03: Rectangle {
        x: 0;
        width: parent.width;
        height: 1.5px;
        y: parent.height - self.height - (1 - clamp(root.peak, 0, 1)) * (parent.height - self.height) / 2;
        background: Theme.text-primary.with-alpha(0.7);
    }
}

// Vertical level meter filled with the full-height meter gradient, so quiet
// levels stay warm and only loud ones reach the top colour
component MeterBar inherits Rectangle {
    in property <float> level;
    in property <float> peak;

    Rectangle {
        border-radius: 2px;
        background: Theme.viz-track;
    }

    Rectangle {
        x: 0;
        width: parent.width;
        height: clamp(root.level, 0, 1) * parent.height;
        y: parent.height - self.height;
        border-radius: 2px;
        clip: true;

        Rectangle {
            x: 0;
            y: parent.height - root.height;
            width: parent.width;
            height: root.height;
            background: VizStyle.meter;
        }
    }

    if root.peak > 0.03: Rectangle {
        x: 0;
        width: parent.width;
        height: 2px;
        y: (1 - clamp(root.peak, 0, 1)) * (parent.height - self.height);
        background: Theme.text-primary.with-alpha(0.75);
    }
}

// Horizontal meter bar with a peak tick
component HorizontalMeter inherits Rectangle {
    in property <float> level;
    in property <float> peak;

    border-radius: 2px;
    background: Theme.viz-track;
    clip: true;

    Rectangle {
        x: 0;
        width: clamp(root.level, 0, 1) * parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        clip: true;

        Rectangle {
            x: 0;
            width: root.width;
            height: parent.height;
            background: VizStyle.meter-horizontal;
        }
    }

    if root.peak > 0.03: Rectangle {
        x: clamp(root.peak, 0, 1) * (parent.width - self.width);
        width: 2px;
        height: parent.height;
        background: Theme.text-primary.with-alpha(0.75);
    }
}

// The visualizer drawing for a mode, filling its area (no background)
export component VizContent inherits Rectangle {
    in property <string> mode: "mirror";
    in property <bool> is-loading;
    // Gap between spectrum bars
    in property <length> gap: 1px;

    // Loading animation (bouncing bars)
    if root.is-loading: HorizontalLayout {
        spacing: 3px;

        for i in [0, 1, 2, 3, 4]: SpectrumBar {
            horizontal-stretch: 1;
            level: 0.3 + 0.7 * abs(sin(mod(animation-tick() / 800ms * 360deg - i * 36deg, 360deg)));
            tint: VizStyle.bar-color(i / 4);
        }
    }

    // Spectrum: bars rising from the bottom with peak dots
    if !root.is-loading && root.mode == "spectrum": HorizontalLayout {
        spacing: root.gap;

        for val[i] in VizData.spectrum: SpectrumBar {
            horizontal-stretch: 1;
            level: val;
            peak: i < VizData.peaks.length ? VizData.peaks[i] : 0;
            tint: VizStyle.bar-color(i / max(1, VizData.spectrum.length - 1));
        }
    }

    // Mirror: bars grow out from the middle, symmetric top and bottom
    if !root.is-loading && root.mode == "mirror": HorizontalLayout {
        spacing: root.gap;

        for val[i] in VizData.spectrum: MirrorBar {
            horizontal-stretch: 1;
            level: val;
            peak: i < VizData.peaks.length ? VizData.peaks[i] : 0;
            tint: VizStyle.bar-color(i / max(1, VizData.spectrum.length - 1));
        }
    }

    // VU: two vertical meters, left and right
    if !root.is-loading && root.mode == "vu": HorizontalLayout {
        spacing: 4px;
        alignment: center;

        MeterBar {
            width: min(root.width / 2 - 4px, 22px);
            level: VizData.vu-left;
            peak: VizData.vu-peak-left;
        }

        MeterBar {
            width: min(root.width / 2 - 4px, 22px);
            level: VizData.vu-right;
            peak: VizData.vu-peak-right;
        }
    }

    // Horizontal VU bars
    if !root.is-loading && root.mode == "hbars": VerticalLayout {
        spacing: 6px;
        alignment: center;

        HorizontalMeter {
            height: min(root.height / 2 - 6px, 14px);
            level: VizData.vu-left;
            peak: VizData.vu-peak-left;
        }

        HorizontalMeter {
            height: min(root.height / 2 - 6px, 14px);
            level: VizData.vu-right;
            peak: VizData.vu-peak-right;
        }
    }
}

// 70px tile in the header; click cycles the mode
export component Visualization inherits Rectangle {
    in property <bool> is-loading;
    in-out property <string> viz-mode: "mirror";

    width: 70px;
    height: 70px;
    background: Theme.viz-bg;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.hairline;
    clip: true;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.viz-mode = VizStyle.next-mode(root.viz-mode); }
    }

    VizContent {
        x: 7px;
        y: 7px;
        width: parent.width - 14px;
        height: parent.height - 14px;
        mode: root.viz-mode;
        is-loading: root.is-loading;
    }
}
