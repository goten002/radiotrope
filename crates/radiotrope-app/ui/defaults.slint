// UI defaults in one place: colours, text sizes, shapes and animation
// speeds (Theme), and window and dialog sizes and delays (Defaults).
// Change a value here and rebuild; nothing else needs to change.
//
// Components use these instead of literal values, so both themes (and the
// accent color) apply everywhere.

export global Theme {
    in-out property <bool> dark-mode: true;
    // Soft accent glow on the header, the controls and dialogs
    in-out property <bool> panel-gradient: true;

    // ── Layers, back to front ──
    // Main list area
    out property <color> surface: dark-mode ? #18191b : #f3f3f6;
    // Header and bottom bar
    out property <color> panel: dark-mode ? #222427 : #ffffff;
    // Dialogs and popups
    out property <color> card: dark-mode ? #25272b : #ffffff;
    // Inputs, tracks and wells inside a card
    out property <color> elevated: dark-mode ? #1b1c1f : #f0f0f4;
    // 1px borders and separators
    out property <color> hairline: dark-mode ? #ffffff14 : #00000014;
    // Backdrop behind dialogs
    out property <color> scrim: dark-mode ? #000000aa : #1a1b2066;
    out property <color> shadow: dark-mode ? #00000080 : #1a1b2033;
    out property <color> shadow-soft: dark-mode ? #00000040 : #1a1b201f;

    // ── Text ──
    out property <color> text-primary: dark-mode ? #f4f4f5 : #16171a;
    out property <color> text-secondary: dark-mode ? #a0a2a8 : #5c5f66;
    out property <color> text-tertiary: dark-mode ? #6c6f76 : #8d9097;

    // ── Accent ──
    in-out property <color> accent-base: #f7931e;
    out property <color> accent: accent-base;
    out property <color> accent-hover: accent-base.darker(0.15);
    // Accent for text and icons on surfaces; darker in light mode so it stays readable
    out property <color> accent-text: dark-mode ? accent-base : accent-base.darker(0.5);
    // Tints for badges, selected rows and header glows
    out property <color> accent-soft: accent-base.with-alpha(dark-mode ? 0.16 : 0.12);
    out property <color> accent-glow: accent-base.with-alpha(dark-mode ? 0.18 : 0.14);

    // ── Status ──
    out property <color> danger: dark-mode ? #ef5b5b : #d33b3b;
    out property <color> danger-hover: danger.darker(0.15);
    out property <color> success: dark-mode ? #4cc38a : #1f9d5a;

    // ── Buttons ──
    out property <color> button-text: #1a1a1a;  // dark text on accent buttons (both themes)
    out property <color> disabled-bg: dark-mode ? #3a3c40 : #e1e2e6;
    out property <color> disabled-text: dark-mode ? #7a7d83 : #a3a6ac;

    // ── Menus and hover states ──
    out property <color> popup-bg: card;
    out property <color> menu-hover: dark-mode ? #33363b : #ebebef;
    out property <color> menu-bar-hover: dark-mode ? #2d3034 : #f0f0f4;
    out property <color> menu-text: dark-mode ? #c8c9cc : #3a3c41;

    // ── Visualizer ──
    // Selected text in inputs: an accent tint, not the style's own colour
    out property <color> selection-bg: accent.with-alpha(dark-mode ? 0.4 : 0.3);
    out property <color> selection-fg: text-primary;
    out property <color> viz-bg: dark-mode ? #141517 : #f0f0f4;
    out property <color> viz-track: dark-mode ? #ffffff0d : #0000000d;

    // ── Text sizes ──
    out property <length> font-2xs: 9px;       // equalizer scale, signal bars
    out property <length> font-xs: 10px;       // captions and badges
    out property <length> font-sm: 11px;       // second lines, stats, hints
    out property <length> font-md: 12px;       // labels, list details
    out property <length> font-base: 13px;     // body text, menus, inputs
    out property <length> font-lg: 14px;       // buttons, section headings
    out property <length> font-xl: 15px;       // stats bubble total
    out property <length> font-2xl: 16px;      // on-screen keyboard keys
    out property <length> font-title: 17px;    // dialog titles, stats tiles
    out property <length> font-station: 18px;  // station name in the header
    out property <length> font-hero: 22px;     // app name in About

    // ── Shape ──
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;

    // ── Motion ──
    out property <duration> fast: 120ms;
    out property <duration> normal: 180ms;
}

export global Defaults {
    // ── Main window ──
    out property <length> window-width: 800px;
    out property <length> window-height: 600px;
    out property <length> window-min-width: 640px;
    out property <length> window-min-height: 480px;
    // Edges to grab for resizing with the app's own title bar
    out property <length> resize-border: 8px;

    // ── Dialogs: card width, and height where it doesn't follow the content ──
    out property <length> dialog-width: 440px;
    out property <length> about-width: 680px;
    out property <length> accent-color-width: 400px;
    out property <length> country-picker-width: 360px;
    out property <length> country-picker-height: 640px;
    out property <length> edit-favorite-width: 460px;
    out property <length> equalizer-width: 580px;
    out property <length> network-stream-width: 460px;
    out property <length> recording-width: 480px;
    out property <length> station-browser-width: 700px;
    out property <length> station-browser-height: 640px;
    out property <length> statistics-width: 540px;

    // ── Delays ──
    // Resting the pointer this long shows a hover bubble
    out property <duration> hover-delay: 400ms;
    // Holding a favorite this long opens its menu (touch screens)
    out property <duration> hold-menu-delay: 500ms;
    // Holding a favorite's logo this long picks the row up (touch screens)
    out property <duration> hold-drag-delay: 300ms;
    // How long "Copied to clipboard" shows
    out property <duration> copied-time: 1500ms;
    // How long a slider moved by keys or the wheel shows its value
    out property <duration> value-hint-time: 900ms;
    // A second click on the same station or Play/Stop this soon after the
    // first is ignored (touchpad double taps); also read by the Rust side
    out property <duration> repeat-click-guard: 500ms;
}
