// UI defaults in one place: colours, text sizes, shapes and animation
// speeds (Theme), and window and dialog sizes and delays (Defaults).
// Change a value here and rebuild; nothing else needs to change.
//
// Components use these instead of literal values, so both themes (and the
// accent color) apply everywhere.

import { Palette } from "std-widgets.slint";

export global Theme {
    // The theme picked in the View menu: "system" follows the OS, or
    // "dark" / "light"
    in-out property <string> theme-mode: "system";
    // Whether the OS is dark, live: the Windows app mode, the Linux
    // desktop's dark style (freedesktop portal). Anything else is light, as
    // in GTK and Chromium apps: GNOME with Dark Style off says "no
    // preference", which Slint can't tell from desktops that say nothing.
    out property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;
    out property <bool> dark-mode: theme-mode == "system"
        ? system-dark
        : theme-mode != "light";
    // Soft accent glow on the header, the controls and dialogs
    in-out property <bool> panel-gradient: true;

    // ── Layers, back to front ──
    // Main list area
    out property <color> surface: dark-mode ? #18191b : #f3f3f6;
    // Header and bottom bar
    out property <color> panel: dark-mode ? #222427 : #ffffff;
    // Dialogs and popups
    out property <color> card: dark-mode ? #25272b : #ffffff;
    // Inputs, tracks and wells inside a card
    out property <color> elevated: dark-mode ? #1b1c1f : #f0f0f4;
    // 1px borders and separators
    out property <color> hairline: dark-mode ? #ffffff14 : #00000014;
    // Backdrop behind dialogs
    out property <color> scrim: dark-mode ? #000000aa : #1a1b2066;
    out property <color> shadow: dark-mode ? #00000080 : #1a1b2033;
    out property <color> shadow-soft: dark-mode ? #00000040 : #1a1b201f;

    // ── Text ──
    // All reach 4.5:1 (WCAG AA) on the surfaces they are used on;
    // tertiary is the faintest grey that still does on the card and inputs
    out property <color> text-primary: dark-mode ? #f4f4f5 : #16171a;
    out property <color> text-secondary: dark-mode ? #a0a2a8 : #5c5f66;
    out property <color> text-tertiary: dark-mode ? #8b8e95 : #696c73;

    // ── Accent ──
    // Default accent, also what "Restore Default" goes back to
    out property <color> accent-default: #f7931e;
    // Colours offered in the Accent Color dialog, two rows of five
    out property <[color]> accent-swatches: [
        #f7931e, #ed5b00, #e62d42, #d56199, #9141ac,
        #3584e4, #2190a4, #3a944a, #c88800, #6f8396,
    ];
    // Their names, in the same order, for screen readers
    out property <[string]> accent-swatch-names: [
        "Orange", "Dark orange", "Red", "Pink", "Purple",
        "Blue", "Teal", "Green", "Gold", "Slate",
    ];
    // The accent in use (the user's choice, saved in settings)
    in-out property <color> accent-base: accent-default;
    out property <color> accent: accent-base;
    out property <color> accent-hover: accent-base.darker(0.15);
    // Accent for text and icons on surfaces: the accent itself in the dark
    // theme and a darker one in the light theme, moved toward white (dark)
    // or black (light) only as far as it takes to reach 4.5:1 there
    out property <color> accent-text: readable(dark-mode ? accent-base : accent-base.darker(0.5),
        dark-mode ? #ffffff : #000000);
    out property <color> accent-pressed: accent-hover.darker(0.1);
    out property <color> on-accent: text-on(accent);
    out property <color> on-accent-hover: text-on(accent-hover);
    out property <color> on-accent-pressed: text-on(accent-pressed);
    // Accent for graphics that carry meaning (switches, fills, the playing
    // bars): the accent itself where it reaches 3:1 on every plain layer,
    // else moved toward white (dark) or black (light) only as far as it
    // takes. Buttons and text keep `accent` and `accent-text`.
    out property <color> accent-graphic: visible(accent-base, dark-mode ? #ffffff : #000000);
    out property <color> on-accent-graphic: text-on(accent-graphic);
    // Tints for badges, selected rows and header glows
    out property <color> accent-soft: accent-base.with-alpha(dark-mode ? 0.16 : 0.12);
    out property <color> accent-glow: accent-base.with-alpha(dark-mode ? 0.18 : 0.14);

    // ── Status ──
    out property <color> danger: dark-mode ? #ef5b5b : #d33b3b;
    out property <color> success: dark-mode ? #4cc38a : #1f9d5a;
    out property <color> warning: dark-mode ? #e6ae59 : #a16812;
    out property <color> danger-text: dark-mode ? #ff9c9c : #8c1616;
    out property <color> success-text: dark-mode ? #82e1ad : #11552f;
    out property <color> warning-text: dark-mode ? #ffcf83 : #684000;
    out property <color> neutral-text: dark-mode ? #c1c3c8 : #4d5057;
    out property <color> danger-tint: danger.with-alpha(0.14);
    out property <color> success-tint: success.with-alpha(0.14);
    out property <color> warning-tint: warning.with-alpha(0.14);
    out property <color> neutral-tint: text-secondary.with-alpha(0.14);
    // A stronger tint for a destructive action awaiting a second press.
    out property <color> danger-armed: danger.with-alpha(0.22);
    out property <color> danger-pressed: danger.with-alpha(0.30);

    // ── Buttons ──
    // Unavailable controls are quieter than enabled ones: the card's own
    // colour in the dark theme, a faint grey in the light one, with a
    // border at half the hairline's strength
    out property <color> disabled-bg: dark-mode ? #25272b : #f5f5f7;
    out property <color> disabled-border: dark-mode ? #ffffff0a : #0000000a;
    out property <color> disabled-text: dark-mode ? #7a7d83 : #a3a6ac;

    // ── Keyboard focus ──
    // Ring around the control that has keyboard focus
    out property <color> focus-ring: text-primary;
    out property <length> focus-ring-width: 2px;
    // How far the ring sits outside the control's edge
    out property <length> focus-ring-offset: 3px;

    // ── Menus and hover states ──
    out property <color> popup-surface: card;
    out property <color> popup-border: dark-mode ? #ffffff29 : #00000029;
    out property <color> popup-shadow: dark-mode ? #00000099 : #1a1b2040;
    out property <length> popup-shadow-blur: 12px;
    out property <length> popup-shadow-offset: 3px;
    out property <color> hover-bg: dark-mode ? #2d3034 : elevated;
    out property <color> pressed-bg: dark-mode ? #33363b : #ebebef;
    out property <color> selected-bg: accent-soft;
    out property <color> selection-mark: accent-text;
    // Edge of a text field or dropdown: 3:1 against the card, so the
    // control can be found without relying on its fill
    out property <color> field-border: dark-mode ? #75777c : #8e9096;
    out property <color> menu-text: dark-mode ? #c8c9cc : #3a3c41;

    // ── Visualizer ──
    // Selected text in inputs: an accent tint, not the style's own colour
    out property <color> selection-bg: accent.with-alpha(dark-mode ? 0.4 : 0.3);
    out property <color> selection-fg: text-primary;
    out property <color> viz-bg: dark-mode ? #141517 : elevated;
    out property <color> viz-track: dark-mode ? #ffffff0d : #0000000d;

    // ── Text sizes ──
    out property <length> font-2xs: 10px;      // equalizer scale, signal bars
    out property <length> font-xs: 11px;       // captions and badges
    out property <length> font-sm: 12px;       // second lines, stats, hints
    out property <length> font-md: 12px;       // labels, list details
    out property <length> font-base: 13px;     // body text, menus, inputs
    out property <length> font-lg: 14px;       // buttons, section headings
    out property <length> font-xl: 15px;       // stats bubble total
    out property <length> font-title: 17px;    // dialog titles, stats tiles
    out property <length> font-station: 18px;  // station name in the header
    out property <length> font-hero: 22px;     // app name in About

    out property <int> weight-regular: 400;
    out property <int> weight-semibold: 600;
    out property <length> font-timer: 34px;
    out property <length> font-code: 44px;

    // ── Layout ──
    out property <length> space-2: 2px;
    out property <length> space-4: 4px;
    out property <length> space-6: 6px;
    out property <length> space-8: 8px;
    out property <length> space-12: 12px;
    out property <length> space-16: 16px;
    out property <length> space-20: 20px;
    out property <length> space-24: 24px;
    out property <length> icon-sm: 12px;
    out property <length> icon-compact: 14px;
    out property <length> icon-md: 16px;
    out property <length> icon-lg: 20px;
    out property <length> control-button: 34px;
    out property <length> control-field: 36px;
    out property <length> control-touch: 44px;
    out property <length> row-menu: 28px;
    out property <length> row-dense: 48px;
    out property <length> row-media: 56px;
    out property <length> row-touch: 64px;
    out property <length> dialog-padding: space-20;
    out property <length> dialog-gap: icon-compact;
    out property <length> viewport-inset: space-12;

    // ── Shape ──
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    // View > Rounded Corners: dialogs follow the window, square when it's off
    in-out property <bool> rounded-corners: true;
    out property <length> dialog-radius: rounded-corners ? radius-lg : 0px;

    // ── Motion ──
    out property <duration> fast: 120ms;
    out property <duration> normal: 180ms;
    // Status animations, one cycle each. The bouncing now-playing bars:
    // the first bar, and how much slower each next one is
    out property <duration> bars-period: 520ms;
    out property <duration> bars-period-step: 140ms;
    // A pulsing status dot
    out property <duration> pulse-period: 1400ms;
    // One turn of a loading spinner
    out property <duration> spin-period: 900ms;
    // The visualizer's tuning needle crossing the dial once
    out property <duration> tune-period: 1600ms;

    // ── Contrast (WCAG 2) ──
    // Relative luminance: 0 for black, 1 for white
    pure function luminance(c: color) -> float {
        return 0.2126 * linear(c.red) + 0.7152 * linear(c.green) + 0.0722 * linear(c.blue);
    }

    // An sRGB channel (0-255) in linear light (0-1)
    pure function linear(channel: int) -> float {
        let v = channel / 255;
        return v <= 0.04045 ? v / 12.92 : pow((v + 0.055) / 1.055, 2.4);
    }

    // Contrast ratio of two colours: 1 (none) to 21 (black on white)
    pure function contrast(a: color, b: color) -> float {
        let la = luminance(a);
        let lb = luminance(b);
        return (max(la, lb) + 0.05) / (min(la, lb) + 0.05);
    }

    // Black or white, whichever has more contrast on `fill`
    public pure function text-on(fill: color) -> color {
        return contrast(#000000, fill) >= contrast(#ffffff, fill) ? #000000 : #ffffff;
    }

    // Accent text reads at 4.5:1 on the lightest (dark theme) or darkest
    // (light theme) background it sits on: an accent-tinted card or list
    // (selected rows, dialog glow), and its own 14% tint on the panel (chips)
    pure function reads-well(c: color) -> bool {
        // Bound hue and surface blending by the brightest or darkest
        // surface used for text, then account for the strongest tint.
        let surface-limit = pressed-bg;
        let accent-limit = accent.mix(surface-limit, 0.26);
        let chip-base = dark-mode ? card : surface;
        let chip-limit = c.mix(chip-base, 0.26);
        let composite-limit = (dark-mode ? luminance(accent-limit) >= luminance(chip-limit)
                                    : luminance(accent-limit) <= luminance(chip-limit))
            ? accent-limit : chip-limit;
        let tint-limit = (dark-mode ? luminance(composite-limit) >= luminance(surface-limit)
                                    : luminance(composite-limit) <= luminance(surface-limit))
            ? composite-limit : surface-limit;
        return contrast(c, tint-limit) >= 4.5
            && (dark-mode ? luminance(c) > luminance(tint-limit) : luminance(c) < luminance(tint-limit));
    }

    // WCAG foreground for a custom status color over the strongest
    // supported status tint. Opaque color math mirrors alpha compositing.
    public pure function status-text(tone: color) -> color {
        let base = dark-mode ? pressed-bg : surface;
        let opaque = tone.with-alpha(1);
        let tint = opaque.mix(base, 0.30);
        let limit = (dark-mode ? luminance(tint) > luminance(base) : luminance(tint) < luminance(base))
            ? tint : base;
        if contrast(opaque, limit) >= 4.5
            && (dark-mode ? luminance(opaque) > luminance(limit) : luminance(opaque) < luminance(limit)) {
            return opaque;
        }
        return dark-mode ? text-on(limit) : #000000;
    }

    // `c` if it reads well, else `c` moved toward `to` just far enough
    // (to within 1/64 of the way, by halving the step six times)
    pure function readable(c: color, to: color) -> color {
        if reads-well(c) {
            return c;
        }
        // `lo`: a share of `to` that is not enough; lo + step is
        let lo1 = reads-well(c.mix(to, 0.5)) ? 0.0 : 0.5;
        let lo2 = reads-well(c.mix(to, 1 - lo1 - 0.25)) ? lo1 : lo1 + 0.25;
        let lo3 = reads-well(c.mix(to, 1 - lo2 - 0.125)) ? lo2 : lo2 + 0.125;
        let lo4 = reads-well(c.mix(to, 1 - lo3 - 0.0625)) ? lo3 : lo3 + 0.0625;
        let lo5 = reads-well(c.mix(to, 1 - lo4 - 0.03125)) ? lo4 : lo4 + 0.03125;
        let lo6 = reads-well(c.mix(to, 1 - lo5 - 0.015625)) ? lo5 : lo5 + 0.015625;
        return c.mix(to, 1 - lo6 - 0.015625);
    }

    // A graphic shows at 3:1 on the plain layer closest to it in
    // brightness: the card in the dark theme, inputs in the light one
    pure function shows-well(c: color) -> bool {
        return contrast(c, dark-mode ? card : elevated) >= 3.0;
    }

    // `c` if it shows well, else `c` moved toward `to` just far enough
    // (the same search as `readable`)
    pure function visible(c: color, to: color) -> color {
        if shows-well(c) {
            return c;
        }
        let lo1 = shows-well(c.mix(to, 0.5)) ? 0.0 : 0.5;
        let lo2 = shows-well(c.mix(to, 1 - lo1 - 0.25)) ? lo1 : lo1 + 0.25;
        let lo3 = shows-well(c.mix(to, 1 - lo2 - 0.125)) ? lo2 : lo2 + 0.125;
        let lo4 = shows-well(c.mix(to, 1 - lo3 - 0.0625)) ? lo3 : lo3 + 0.0625;
        let lo5 = shows-well(c.mix(to, 1 - lo4 - 0.03125)) ? lo4 : lo4 + 0.03125;
        let lo6 = shows-well(c.mix(to, 1 - lo5 - 0.015625)) ? lo5 : lo5 + 0.015625;
        return c.mix(to, 1 - lo6 - 0.015625);
    }
}

// Options of the View and Tools menus that the Rust side shows, saves and
// follows (src/view_options.rs)
export global ViewOptions {
    // View > Zoom, in percent: the choice, which applies at the next
    // start, and the zoom this run started with
    in-out property <int> zoom: 100;
    in property <int> zoom-in-use: 100;
    // Under the choices while another zoom than the window's is picked
    out property <string> zoom-note: root.zoom != root.zoom-in-use
        ? "Restart Radiotrope to apply \{root.zoom}%" : "";
    // The percentages offered
    out property <[int]> zoom-choices: [90, 100, 115, 130, 150];
    // The largest of them whose smallest window fits the screen the
    // window is on; the larger ones are greyed
    in property <int> zoom-fits: 150;
    // Stations > Report Plays: off until the user allows it in its dialog
    // (dialogs/report-plays.slint), which switching it on opens
    in-out property <bool> report-plays: false;
    in-out property <bool> report-plays-asking: false;
    callback report-plays-changed(bool);
}

export global Defaults {
    // ── Main window ──
    out property <length> window-width: 800px;
    out property <length> window-height: 600px;
    // 4:3. View > Zoom multiplies it: the zooms it would make larger than
    // the screen are greyed (960 x 720 at 150% needs more than 1280 x 720)
    out property <length> window-min-width: 640px;
    out property <length> window-min-height: 480px;
    // Edges to grab for resizing with the app's own title bar
    out property <length> resize-border: 8px;
    // Rounded corners with the app's own title bar (Windows 11 uses its own)
    out property <length> window-radius: Theme.radius-lg;

    // ── Dialogs: card width, and height where it doesn't follow the content ──
    out property <length> dialog-width: 440px;
    out property <length> about-width: 680px;
    // As wide as the search, up to the window: the command lines are long
    out property <length> agents-width: station-browser-width;
    // Width of an ⓘ help bubble
    out property <length> info-tip-width: 280px;
    out property <length> accent-color-width: 400px;
    // Height of the custom colour square in the Accent Color dialog
    out property <length> accent-picker-height: 120px;
    out property <length> dialog-width-compact: 360px;
    out property <length> filter-picker-width: dialog-width-compact;
    out property <length> filter-picker-height: 640px;
    out property <length> dialog-width-form: 460px;
    out property <length> edit-favorite-width: dialog-width-form;
    out property <length> equalizer-width: 580px;
    out property <length> network-stream-width: dialog-width-form;
    out property <length> import-favorites-width: dialog-width-form;
    out property <length> recording-width: 480px;
    out property <length> remote-control-width: 520px;
    // The Remote Control dialog's height without its list of phones
    // (window margin, padding, title, settings), so the list scrolls once
    // the window is too short for all of them
    out property <length> remote-devices-chrome: 360px;
    out property <length> pairing-code-width: dialog-width-compact;
    // The pairing QR code (on a white tile in the dark theme); fits the Pi's 480 px height
    out property <length> pairing-qr-size: 220px;
    out property <length> schedule-width: 560px;
    // The Scheduler's list is at least this tall (the empty box too) and
    // grows with its entries while the window has room, then scrolls
    out property <length> schedule-empty-height: 200px;
    out property <length> sleep-timer-width: 520px;
    // Dropdowns show at most eight rows before scrolling. Give short
    // triggers room to show an option label and its check side by side.
    out property <length> dropdown-max-height: 8 * Theme.row-menu + 2 * Theme.space-4;
    out property <length> dropdown-min-popup-width: 136px;
    // The Sleep Timer's length in the middle, wide enough for "12 h 55 min"
    out property <length> sleep-readout-width: 190px;
    // The Sleep Timer's − and + step by the big step, and by the small
    // step below it (5, 10, 15, 30, 45...); it goes from the small step up
    // to a day
    out property <int> sleep-step-minutes: 5;
    out property <int> sleep-big-step-minutes: 15;
    out property <int> sleep-max-minutes: 1440;
    out property <length> station-browser-width: 700px;
    out property <length> station-browser-height: 640px;
    out property <length> dialog-width-wide: 540px;
    out property <length> statistics-width: dialog-width-wide;
    out property <length> keyboard-shortcuts-width: dialog-width-wide;
    out property <length> keyboard-shortcuts-height: 480px;
    // The volume slider in the controls bar: its track and knob (bigger
    // while hovered or dragged). Clicks and drags land anywhere in the
    // bar's height and this far past each end of the track.
    out property <length> volume-width: 140px;
    out property <length> volume-track: 8px;
    out property <length> volume-knob: 14px;
    out property <length> volume-knob-active: 18px;
    out property <length> volume-grab: 8px;

    // ── Delays ──
    // Resting the pointer this long shows a hover bubble
    out property <duration> hover-delay: 400ms;
    // Holding a favorite this long opens its menu (touch screens)
    out property <duration> hold-menu-delay: 500ms;
    // Holding a favorite's logo this long picks the row up (touch screens)
    out property <duration> hold-drag-delay: 300ms;
    // How long "Copied to clipboard" shows
    out property <duration> copied-time: 1500ms;
    // How long a slider moved by keys or the wheel shows its value
    out property <duration> value-hint-time: 900ms;
    // A second click on the same station or Play/Stop this soon after the
    // first is ignored (touchpad double taps); also read by the Rust side
    out property <duration> repeat-click-guard: 500ms;
    // The small status animations (bouncing bars, pulsing dots, spinners)
    // move this often (25 times a second): smooth to the eye, and a
    // playing station doesn't redraw the window on every frame
    out property <duration> motion-step: 40ms;
    // A favorite dragged near the list's top or bottom scrolls the list
    // this often (60 times a second)
    out property <duration> drag-scroll-step: 16ms;
}
