import { Theme, Defaults } from "defaults.slint";
import { IconButton, Icon } from "components.slint";
import { Platform } from "@platform/wifi.slint";

component VolumeSlider inherits Rectangle {
    in-out property <float> value: 50;  // 0–100
    in property <bool> muted;
    out property <bool> touch-pressed: touch.pressed;
    callback value-changed(float);
    callback mute-toggled();

    width: 120px;
    height: 20px;

    property <bool> active: touch.has-hover || touch.pressed;
    property <float> shown: Math.clamp(root.value, 0, 100) / 100;
    property <color> fill-color: root.muted ? Theme.text-tertiary : Theme.accent;
    property <length> knob: root.active ? 16px : 12px;
    animate knob { duration: Theme.fast; }
    // Keeps the value bubble up briefly after a scroll or key press
    property <bool> nudged;

    public function scroll-by(delta: length) {
        root.set(root.value + (delta / 1px / 24));
    }

    function set(v: float) {
        root.value-changed(Math.clamp(v, 0, 100));
        root.nudged = true;
        nudge-timer.running = false;
        nudge-timer.running = true;
    }

    nudge-timer := Timer {
        interval: Defaults.value-hint-time;
        running: false;
        triggered => {
            root.nudged = false;
            self.running = false;
        }
    }

    track := Rectangle {
        height: 6px;
        y: (root.height - self.height) / 2;
        border-radius: self.height / 2;
        background: Theme.text-primary.with-alpha(0.12);

        // Filled portion, greyed while muted
        Rectangle {
            x: 0;
            width: Math.max(self.height, (root.width - root.knob) * root.shown + root.knob / 2);
            border-radius: self.height / 2;
            background: root.fill-color;
            animate background { duration: Theme.fast; }
        }
    }

    // Knob: panel-coloured centre with a ring in the fill colour
    thumb := Rectangle {
        x: (root.width - root.knob) * root.shown;
        y: (root.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: Theme.panel;
        border-width: 2px;
        border-color: root.fill-color;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
    }

    // Value bubble above the knob while hovered, dragging, scrolling or using keys
    bubble := Rectangle {
        property <bool> visible-now: touch.has-hover || touch.pressed || root.nudged;
        opacity: visible-now ? 1 : 0;
        animate opacity { duration: Theme.fast; }
        width: 44px;
        height: 20px;
        x: thumb.x + thumb.width / 2 - self.width / 2;
        y: -self.height - 4px;
        border-radius: 5px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.hairline;
        drop-shadow-blur: 6px;
        drop-shadow-color: Theme.shadow-soft;

        Text {
            text: root.muted && !touch.pressed ? "Muted" : Math.round(root.value) + "%";
            font-size: Theme.font-sm;
            font-weight: 600;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                keys.focus();
            }
        }

        moved => {
            if (self.pressed) {
                root.value-changed(Math.clamp((self.mouse-x - root.knob / 2) / (root.width - root.knob) * 100, 0, 100));
            }
        }

        clicked => {
            root.value-changed(Math.clamp((self.mouse-x - root.knob / 2) / (root.width - root.knob) * 100, 0, 100));
        }

        scroll-event(e) => {
            root.scroll-by(e.delta-y);
            return accept;
        }
    }

    // Arrow keys, Page Up/Down, Home/End and M once the slider has focus
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.UpArrow || e.text == Key.RightArrow) {
                root.set(Math.round(root.value) + (e.modifiers.shift ? 1 : 5));
                return accept;
            }
            if (e.text == Key.DownArrow || e.text == Key.LeftArrow) {
                root.set(Math.round(root.value) - (e.modifiers.shift ? 1 : 5));
                return accept;
            }
            if (e.text == Key.PageUp) {
                root.set(root.value + 20);
                return accept;
            }
            if (e.text == Key.PageDown) {
                root.set(root.value - 20);
                return accept;
            }
            if (e.text == Key.Home) {
                root.set(0);
                return accept;
            }
            if (e.text == Key.End) {
                root.set(100);
                return accept;
            }
            if (e.text == "m" || e.text == "M") {
                root.mute-toggled();
                return accept;
            }
            return reject;
        }
    }
}

export component Controls inherits Rectangle {
    in property <bool> is-playing;
    // A station is connecting: the button offers Stop, so pressing it
    // again cancels the connection instead of starting it over
    in property <bool> is-loading;
    in property <bool> has-station;
    in property <string> now-playing-title;
    in-out property <float> volume: 1.0;   // 0.0–1.0
    in-out property <bool> is-muted;

    callback play-clicked();
    callback stop-clicked();
    callback volume-changed(float);        // 0.0–1.0
    callback mute-clicked();

    out property <bool> volume-dragging: vol-slider.touch-pressed;

    // Title copied to the clipboard just now: the label says so briefly
    property <bool> copied: false;
    // Hovered long enough to show the full title bubble
    property <bool> title-hover-ready: false;
    property <bool> title-cut: title-measure.preferred-width > np-area.width;

    function copy-title() {
        clipboard-text.select-all();
        clipboard-text.copy();
        clipboard-text.clear-selection();
        root.copied = true;
        copied-timer.running = false;
        copied-timer.running = true;
    }

    copied-timer := Timer {
        interval: Defaults.copied-time;
        running: false;
        triggered => {
            self.running = false;
            root.copied = false;
        }
    }

    // Hidden: copies the title and measures its full width
    clipboard-text := TextInput {
        visible: false;
        text: root.now-playing-title;
        read-only: true;
        single-line: true;
    }
    title-measure := Text {
        visible: false;
        text: root.now-playing-title;
        font-size: Theme.font-md;
    }

    height: 64px;
    background: Theme.panel;

    // Same soft accent glow from the left as the header
    Rectangle {
        visible: Theme.panel-gradient;
        background: @linear-gradient(90deg, Theme.accent-glow 0%, Theme.accent.with-alpha(0) 45%);
    }

    // 1px top separator — shadow edge at bottom of favorites groove
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.hairline;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 16px;

        // ── Play / Stop button (left) ──
        VerticalLayout {
            alignment: center;
            Rectangle {
                property <bool> shows-stop: root.is-playing || root.is-loading;
                property <bool> can-interact: self.shows-stop || root.has-station;

                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: !can-interact ? Theme.disabled-bg
                    : play-touch.pressed ? Theme.accent-hover.darker(0.1)
                    : play-touch.has-hover ? Theme.accent-hover
                    : Theme.accent;
                animate background { duration: Theme.fast; }
                // Glow while playing or hovered
                drop-shadow-blur: can-interact && (self.shows-stop || play-touch.has-hover) ? 16px : 0px;
                drop-shadow-color: Theme.accent.with-alpha(0.45);
                animate drop-shadow-blur { duration: Theme.normal; }

                Icon {
                    width: 18px;
                    height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: parent.shows-stop ? @image-url("icons/stop.svg") : @image-url("icons/play.svg");
                    colorize: !can-interact ? Theme.disabled-text
                        : Theme.dark-mode ? Theme.button-text : #ffffff;
                }

                // A second press right after the first is ignored: a
                // touchpad double tap would stop and restart the station
                repeat-guard := Timer {
                    interval: Defaults.repeat-click-guard;
                    running: false;
                    triggered => { self.running = false; }
                }

                play-touch := TouchArea {
                    enabled: can-interact;
                    mouse-cursor: can-interact ? pointer : default;
                    clicked => {
                        if repeat-guard.running {
                            return;
                        }
                        repeat-guard.running = true;
                        if (parent.shows-stop) {
                            root.stop-clicked();
                        } else {
                            root.play-clicked();
                        }
                    }
                }
            }
        }

        // ── Now Playing (fills available space, left-aligned, collapses first) ──
        // Clicking the title copies it; a cut-off title shows in full in a
        // bubble on hover
        np-area := Rectangle {
            horizontal-stretch: 1;
            clip: true;

            if now-playing-title != "" : VerticalLayout {
                spacing: 6px;
                alignment: center;
                height: parent.height;
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Icon {
                        width: 12px;
                        height: 12px;
                        source: root.copied ? @image-url("icons/tick.svg") : @image-url("icons/music.svg");
                        colorize: root.copied ? Theme.accent-text : Theme.text-secondary;
                    }
                    Text {
                        text: root.copied ? "Copied to clipboard" : "Now Playing";
                        font-size: Theme.font-xs;
                        color: root.copied ? Theme.accent-text : Theme.text-secondary;
                    }
                }
                title-text := Text {
                    text: root.now-playing-title;
                    font-size: Theme.font-md;
                    color: title-touch.has-hover && Platform.has-clipboard ? Theme.text-primary : Theme.text-secondary;
                    overflow: elide;

                    title-touch := TouchArea {
                        mouse-cursor: Platform.has-clipboard ? pointer : default;
                        clicked => {
                            if Platform.has-clipboard {
                                root.copy-title();
                            }
                        }
                        changed has-hover => {
                            if !self.has-hover {
                                root.title-hover-ready = false;
                            }
                        }
                    }

                    Timer {
                        interval: Defaults.hover-delay;
                        running: title-touch.has-hover && !root.title-hover-ready;
                        triggered => { root.title-hover-ready = true; }
                    }
                }
            }
        }

        // ── Volume controls (right, fixed size) ──
        // Scrolling anywhere here (icon and label too) changes the volume
        volume-area := TouchArea {
            horizontal-stretch: 0;
            width: vol-row.preferred-width;
            scroll-event(e) => {
                vol-slider.scroll-by(e.delta-y);
                return accept;
            }

            vol-row := HorizontalLayout {
                spacing: 8px;

                // Mute button
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: root.is-muted ? @image-url("icons/volume-xmark.svg")
                            : root.volume < 0.01 ? @image-url("icons/volume-off.svg")
                            : root.volume < 0.33 ? @image-url("icons/volume-low.svg")
                            : root.volume < 0.66 ? @image-url("icons/volume-medium.svg")
                            : @image-url("icons/volume-high.svg");
                        // The volume SVGs carry a margin, so the loudest
                        // wave isn't clipped by Icon's 1px edge trim
                        icon-size: 20px;
                        icon-color: root.is-muted ? Theme.danger : Theme.text-secondary;
                        hover-color: root.is-muted ? Theme.danger : Theme.text-primary;
                        clicked => { root.mute-clicked(); }
                    }
                }

                // Volume slider
                VerticalLayout {
                    alignment: center;
                    vol-slider := VolumeSlider {
                        value: root.volume * 100;
                        muted: root.is-muted;
                        mute-toggled => { root.mute-clicked(); }
                        value-changed(val) => {
                            root.volume = val / 100;
                            root.volume-changed(root.volume);
                        }
                    }
                }
            }
        }
    }
    // Full title above a cut-off one, styled like the favorites stats bubble
    title-bubble := Rectangle {
        property <bool> shown: root.title-cut && root.title-hover-ready && root.now-playing-title != "";
        visible: self.opacity > 0;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.fast; }
        x: np-area.x;
        y: -self.height - 6px;
        width: min(bubble-layout.preferred-width, root.width - np-area.x - 14px);
        height: bubble-layout.preferred-height;
        background: Theme.popup-bg;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.hairline;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: Theme.shadow-soft;

        bubble-layout := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 3px;

            Text {
                text: root.now-playing-title;
                font-size: Theme.font-md;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
            if Platform.has-clipboard: Text {
                text: root.copied ? "Copied" : "Click to copy";
                font-size: Theme.font-xs;
                color: Theme.text-tertiary;
            }
        }
    }
}
