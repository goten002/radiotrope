import { Theme, Defaults } from "defaults.slint";
import { IconButton, Icon, ButtonKeys, FocusRing, PopupCard } from "components.slint";
import { Platform } from "@platform/wifi.slint";

component VolumeSlider inherits Rectangle {
    in-out property <float> value: 50;  // 0–100
    in property <bool> muted;
    // How loud a fade lets it play now, 0–1 (1 with no fade): the fill
    // shows it while the knob stays at the volume
    in property <float> level: 1;
    out property <bool> touch-pressed: touch.pressed;
    callback value-changed(float);
    // How far clicks and drags reach above and below the slider's own
    // height (the parent's padding), so the whole bar height takes them
    in property <length> grab-y: 0px;

    // The slider is the track plus a grab margin at each end; its height
    // comes from the parent, all of it clickable
    width: Defaults.volume-width + 2 * Defaults.volume-grab;
    min-height: 20px;

    property <bool> active: touch.has-hover || touch.pressed;
    property <float> shown: Math.clamp(root.value, 0, 100) / 100;
    // Off while a dialog is open: the slider leaves the Tab order
    in property <bool> enabled: true;
    // accent-graphic keeps 3:1 against the bar in both themes
    property <color> fill-color: root.muted ? Theme.text-tertiary : Theme.accent-graphic;
    property <length> knob: root.active ? Defaults.volume-knob-active : Defaults.volume-knob;
    animate knob { duration: Theme.fast; }
    // Keeps the value bubble up briefly after a scroll or key press
    in-out property <bool> nudged;
    // The focus came from the keyboard (Tab, or keys used after a click),
    // so the focus ring shows
    property <bool> key-focus;

    accessible-role: slider;
    // A plain number, so screen readers get a numeric value; the unit is
    // in the label
    accessible-label: "Volume, percent";
    accessible-value: Math.round(root.value);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: 5;
    accessible-action-increment => { root.set(Math.round(root.value) + 5); }
    accessible-action-decrement => { root.set(Math.round(root.value) - 5); }
    accessible-action-set-value(v) => { root.set(v.to-float()); }

    public function step(points: float) {
        root.set(root.value + points);
    }

    public function scroll-by(delta: length) {
        root.set(root.value + (delta / 1px / 24));
    }

    function set(v: float) {
        root.value-changed(Math.clamp(v, 0, 100));
        root.nudged = true;
        nudge-timer.running = false;
        nudge-timer.running = true;
    }

    nudge-timer := Timer {
        interval: Defaults.value-hint-time;
        running: false;
        triggered => {
            root.nudged = false;
            self.running = false;
        }
    }

    // The track, knob and value bubble, centred in the grab area
    bar := Rectangle {
        x: Defaults.volume-grab;
        y: (root.height - self.height) / 2;
        width: Defaults.volume-width;
        height: 20px;

        track := Rectangle {
            height: Defaults.volume-track;
            y: (bar.height - self.height) / 2;
            border-radius: self.height / 2;
            // Visible against the bar (3:1) so the slider can be found
            background: Theme.text-tertiary.with-alpha(0.5);

            // Up to the knob, faint, while a fade holds the sound below it
            if root.level < 0.999: Rectangle {
                x: 0;
                width: Math.max(self.height, (bar.width - root.knob) * root.shown + root.knob / 2);
                border-radius: self.height / 2;
                background: root.fill-color.with-alpha(0.35);
            }

            // Filled portion, greyed while muted; during a fade, as loud as it
            // plays now
            Rectangle {
                x: 0;
                width: Math.max(self.height, (bar.width - root.knob) * root.shown * Math.clamp(root.level, 0, 1) + root.knob / 2);
                border-radius: self.height / 2;
                background: root.fill-color;
                animate background { duration: Theme.fast; }
            }
        }

        // Knob: panel-coloured centre with a ring in the fill colour
        thumb := Rectangle {
            x: (bar.width - root.knob) * root.shown;
            y: (bar.height - root.knob) / 2;
            width: root.knob;
            height: root.knob;
            border-radius: root.knob / 2;
            background: Theme.panel;
            border-width: 2px;
            border-color: root.fill-color;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000040;
        }

        // Value bubble above the knob while hovered, dragging, scrolling or using keys
        bubble := PopupCard {
            property <bool> visible-now: touch.has-hover || touch.pressed || root.nudged;
            opacity: visible-now ? 1 : 0;
            animate opacity { duration: Theme.fast; }
            width: 44px;
            height: 20px;
            x: thumb.x + thumb.width / 2 - self.width / 2;
            y: -self.height - 4px;
            

            Text {
                text: root.muted && !touch.pressed ? "Muted" : Math.round(root.value) + "%";
                font-size: Theme.font-sm;
                font-weight: Theme.weight-semibold;
                color: Theme.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        y: -root.grab-y;
        height: root.height + 2 * root.grab-y;
        mouse-cursor: pointer;
        // Where the pointer is along the track, as a volume
        property <float> at: Math.clamp((self.mouse-x - Defaults.volume-grab - root.knob / 2) / (bar.width - root.knob) * 100, 0, 100);

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.key-focus = false;
                keys.focus();
            }
        }

        moved => {
            if (self.pressed) {
                root.value-changed(self.at);
            }
        }

        clicked => {
            root.value-changed(self.at);
        }

        scroll-event(e) => {
            root.scroll-by(e.delta-y);
            return accept;
        }
    }

    // Slider navigation here. M bubbles to the main shortcuts scope.
    keys := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                root.key-focus = true;
            }
        }
        key-pressed(e) => {
            root.key-focus = true;
            if (e.text == Key.UpArrow || e.text == Key.RightArrow) {
                root.set(Math.round(root.value) + (e.modifiers.shift ? 1 : 5));
                return accept;
            }
            if (e.text == Key.DownArrow || e.text == Key.LeftArrow) {
                root.set(Math.round(root.value) - (e.modifiers.shift ? 1 : 5));
                return accept;
            }
            if (e.text == Key.PageUp) {
                root.set(root.value + 20);
                return accept;
            }
            if (e.text == Key.PageDown) {
                root.set(root.value - 20);
                return accept;
            }
            if (e.text == Key.Home) {
                root.set(0);
                return accept;
            }
            if (e.text == Key.End) {
                root.set(100);
                return accept;
            }
            return reject;
        }
    }

    if keys.has-focus && root.key-focus: FocusRing {
        x: bar.x;
        y: bar.y;
        width: bar.width;
        height: bar.height;
        radius: bar.height / 2;
    }
}

export component Controls inherits Rectangle {
    in property <string> snapshot-overlay;
    changed snapshot-overlay => {
        if root.snapshot-overlay == "volume-bubble" { vol-slider.nudged = true; }
        if root.snapshot-overlay == "title-bubble" { root.title-hover-ready = true; }
        if root.snapshot-overlay == "title-copied" { root.copied = true; }
    }

    in property <bool> is-playing;
    // A station is connecting: the button offers Stop, so pressing it
    // again cancels the connection instead of starting it over
    in property <bool> is-loading;
    in property <bool> has-station;
    in property <string> now-playing-title;
    in-out property <float> volume: 1.0;   // 0.0–1.0
    // How loud a fade lets it play now, 0.0–1.0 (1 with no fade)
    in property <float> volume-level: 1.0;
    in-out property <bool> is-muted;
    // Recording: the record button left of the volume
    in property <bool> is-recording;
    in property <bool> can-toggle-recording;
    // Off while a dialog is open: the bar's own buttons leave the Tab order
    // (the window ignores keys behind a dialog; see app.slint)
    in property <bool> enabled: true;

    callback play-clicked();
    callback stop-clicked();
    callback volume-changed(float);        // 0.0–1.0
    callback mute-clicked();
    callback toggle-recording();

    out property <bool> volume-dragging: vol-slider.touch-pressed;

    // Title copied to the clipboard just now: the label says so briefly
    property <bool> copied: false;
    // Hovered long enough to show the full title bubble
    property <bool> title-hover-ready: false;
    // Touch screens have no hover: a tap shows the bubble until the next
    // tap or the next title
    property <bool> title-pinned: false;
    // The press on the title came from a touch screen
    property <bool> title-touch-press: false;
    // The title has the keyboard focus: the full-title bubble shows
    property <bool> title-key-focus: false;
    property <bool> title-cut: title-measure.preferred-width > np-area.width;

    public function step-volume(points: float) {
        vol-slider.step(points);
    }

    // Play, or stop while playing or connecting (the button, or Space)
    public function play-or-stop() {
        // A second press right after the first is ignored: a touchpad
        // double tap would stop and restart the station
        if repeat-guard.running || !play-button.can-interact {
            return;
        }
        repeat-guard.running = true;
        if play-button.shows-stop {
            root.stop-clicked();
        } else {
            root.play-clicked();
        }
    }

    function copy-title() {
        clipboard-text.select-all();
        clipboard-text.copy();
        clipboard-text.clear-selection();
        root.copied = true;
        copied-timer.running = false;
        copied-timer.running = true;
    }

    copied-timer := Timer {
        interval: Defaults.copied-time;
        running: false;
        triggered => {
            self.running = false;
            root.copied = false;
        }
    }

    changed now-playing-title => {
        root.title-pinned = false;
    }

    // Hidden: copies the title and measures its full width
    clipboard-text := TextInput {
        visible: false;
        text: root.now-playing-title;
        read-only: true;
        single-line: true;
    }
    title-measure := Text {
        visible: false;
        text: root.now-playing-title;
        font-size: Theme.font-md;
    }

    height: 64px;
    background: Theme.panel;

    // Same soft accent glow from the left as the header
    Rectangle {
        visible: Theme.panel-gradient;
        background: @linear-gradient(90deg, Theme.accent-glow 0%, Theme.accent.with-alpha(0) 45%);
    }

    // 1px top separator — shadow edge at bottom of favorites groove
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.hairline;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 16px;

        // ── Play / Stop button (left) ──
        VerticalLayout {
            alignment: center;
            play-button := Rectangle {
                property <bool> shows-stop: root.is-playing || root.is-loading;
                property <bool> can-interact: self.shows-stop || root.has-station;

                width: Theme.control-touch;
                height: Theme.control-touch;
                border-radius: self.width / 2;
                background: !can-interact ? Theme.disabled-bg
                    : play-touch.pressed ? Theme.accent-pressed
                    : play-touch.has-hover ? Theme.accent-hover
                    : Theme.accent;
                animate background { duration: Theme.fast; }
                // Glow while playing or hovered
                drop-shadow-blur: can-interact && (self.shows-stop || play-touch.has-hover) ? 16px : 0px;
                drop-shadow-color: Theme.accent.with-alpha(0.45);
                animate drop-shadow-blur { duration: Theme.normal; }

                accessible-role: button;
                accessible-label: self.shows-stop ? "Stop" : "Play";
                accessible-enabled: self.can-interact;
                accessible-action-default => { root.play-or-stop(); }

                Icon {
                    width: Theme.icon-lg;
                    height: Theme.icon-lg;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: parent.shows-stop ? @image-url("icons/stop.svg") : @image-url("icons/play.svg");
                    colorize: !can-interact ? Theme.disabled-text
                        : play-touch.pressed ? Theme.on-accent-pressed
                        : play-touch.has-hover ? Theme.on-accent-hover : Theme.on-accent;
                }

                repeat-guard := Timer {
                    interval: Defaults.repeat-click-guard;
                    running: false;
                    triggered => { self.running = false; }
                }

                play-touch := TouchArea {
                    enabled: can-interact;
                    mouse-cursor: can-interact ? pointer : default;
                    clicked => { root.play-or-stop(); }
                }

                play-keys := ButtonKeys {
                    enabled: parent.can-interact && root.enabled;
                    activated => { root.play-or-stop(); }
                }

                if play-keys.has-focus: FocusRing {
                    radius: parent.border-radius;
                }
            }
        }

        // ── Now Playing (fills available space, left-aligned, collapses first) ──
        // Clicking the title copies it; a cut-off title shows in full in a
        // bubble on hover, or after a tap on a touch screen
        np-area := Rectangle {
            horizontal-stretch: 1;
            clip: true;

            if now-playing-title != "" : VerticalLayout {
                spacing: Theme.space-6;
                alignment: center;
                height: parent.height;
                HorizontalLayout {
                    spacing: Theme.space-4;
                    alignment: start;
                    Icon {
                        width: Theme.icon-sm;
                        height: Theme.icon-sm;
                        source: root.copied ? @image-url("icons/tick.svg") : @image-url("icons/music.svg");
                        colorize: root.copied ? Theme.accent-text : Theme.text-secondary;
                    }
                    Text {
                        text: root.copied ? "Copied to clipboard" : "Now Playing";
                        font-size: Theme.font-xs;
                        color: root.copied ? Theme.accent-text : Theme.text-secondary;
                        // Read out when the title has been copied
                        accessible-live-region: polite;
                    }
                }
                title-text := Text {
                    text: root.now-playing-title;
                    font-size: Theme.font-md;
                    color: (title-touch.has-hover || title-keys.has-focus) && Platform.has-clipboard
                        ? Theme.text-primary : Theme.text-secondary;
                    overflow: elide;
                    // A button that copies the title (no action without a clipboard)
                    accessible-role: button;
                    accessible-label: Platform.has-clipboard ? "Copy title: " + root.now-playing-title
                        : root.now-playing-title;
                    accessible-action-default => {
                        if Platform.has-clipboard {
                            root.copy-title();
                        }
                    }

                    title-keys := ButtonKeys {
                        enabled: Platform.has-clipboard && root.enabled;
                        activated => { root.copy-title(); }
                        changed has-focus => { root.title-key-focus = self.has-focus; }
                    }

                    if title-keys.has-focus: FocusRing {
                        radius: Theme.radius-sm;
                        // Inside the edge: the area around the title clips
                        offset: -1px;
                    }

                    title-touch := TouchArea {
                        mouse-cursor: Platform.has-clipboard ? pointer : default;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down {
                                root.title-touch-press = e.touch-finger-id != 0;
                            }
                        }
                        clicked => {
                            if root.title-touch-press && root.title-cut {
                                root.title-pinned = !root.title-pinned;
                            }
                            if Platform.has-clipboard {
                                root.copy-title();
                            }
                        }
                        changed has-hover => {
                            if !self.has-hover {
                                root.title-hover-ready = false;
                            }
                        }
                    }

                    Timer {
                        interval: Defaults.hover-delay;
                        running: title-touch.has-hover && !root.title-hover-ready;
                        triggered => { root.title-hover-ready = true; }
                    }
                }
            }
        }

        // ── Record button, left of the volume ──
        VerticalLayout {
            alignment: center;
            record-button := IconButton {
                // Idle, the grey record icon. While recording, a steady red
                // dot with a soft red glow around it, drawn below; nothing
                // moves (the header's REC chip counts the time).
                width: Theme.control-field;
                height: Theme.control-field;
                icon: root.is-recording ? @image-url("") : @image-url("icons/record.svg");
                icon-size: Theme.icon-lg;
                label: root.is-recording ? "Stop Recording" : "Start Recording";
                icon-color: Theme.text-secondary;
                hover-color: Theme.text-primary;
                enabled: root.can-toggle-recording;
                clicked => { root.toggle-recording(); }

                // The glow, fading out to the idle ring's outer edge (r 10
                // of 24), so the button keeps its size
                if root.is-recording: Rectangle {
                    width: record-button.icon-size * 10 / 12;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: @radial-gradient(circle, Theme.danger.with-alpha(0.45) 0%, Theme.danger.with-alpha(0.3) 50%, Theme.danger.with-alpha(0) 100%);
                    accessible-role: none;
                }
                // The dot, a little bigger than the idle one (r 4 of 24)
                if root.is-recording: Rectangle {
                    width: record-button.icon-size * 0.46;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.danger;
                    accessible-role: none;
                }
            }
        }

        // ── Volume controls (right, fixed size) ──
        // Scrolling anywhere here (icon and label too) changes the volume
        volume-area := TouchArea {
            horizontal-stretch: 0;
            width: vol-row.preferred-width;
            scroll-event(e) => {
                vol-slider.scroll-by(e.delta-y);
                return accept;
            }

            vol-row := HorizontalLayout {
                // The slider's grab margin keeps the track 8 px from the icon
                spacing: 0px;

                // Mute button. The whole column clicks it, down to the bar's
                // edges like the slider, so the pointer is the hand all over
                // the volume controls
                Rectangle {
                    width: mute-button.width;

                    mute-touch := TouchArea {
                        y: -6px;
                        height: parent.height + 12px;
                        mouse-cursor: pointer;
                        clicked => { root.mute-clicked(); }
                    }

                    mute-button := IconButton {
                        y: (parent.height - self.height) / 2;
                        outer-hover: mute-touch.has-hover;
                        icon: root.is-muted ? @image-url("icons/volume-xmark.svg")
                            : root.volume < 0.01 ? @image-url("icons/volume-off.svg")
                            : root.volume < 0.33 ? @image-url("icons/volume-low.svg")
                            : root.volume < 0.66 ? @image-url("icons/volume-medium.svg")
                            : @image-url("icons/volume-high.svg");
                        // The volume SVGs keep clear of their edge, so the
                        // loudest wave isn't clipped by Icon's 1px edge trim
                        icon-size: Theme.icon-lg;
                        label: root.is-muted ? "Unmute" : "Mute";
                        icon-color: Theme.text-secondary;
                        hover-color: Theme.text-primary;
                        clicked => { root.mute-clicked(); }
                    }
                }

                // Volume slider, as tall as the bar's row
                vol-slider := VolumeSlider {
                    // Down to the bar's edges, past the row's 6 px padding
                    grab-y: 6px;
                    value: root.volume * 100;
                    muted: root.is-muted;
                    level: root.volume-level;
                    enabled: root.enabled;
                    value-changed(val) => {
                        root.volume = val / 100;
                        root.volume-changed(root.volume);
                    }
                }
            }
        }
    }
    // Full title above a cut-off one, styled like the favorites stats bubble
    title-bubble := PopupCard {
        property <bool> shown: root.title-cut && (root.title-hover-ready || root.title-pinned || root.title-key-focus)
            && root.now-playing-title != "";
        visible: self.opacity > 0;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.fast; }
        x: np-area.x;
        y: -self.height - Theme.space-8;
        width: min(bubble-layout.preferred-width, root.width - np-area.x - 14px);
        height: bubble-layout.preferred-height;

        bubble-layout := VerticalLayout {
            padding-left: Theme.space-12;
            padding-right: Theme.space-12;
            padding-top: Theme.space-8;
            padding-bottom: Theme.space-8;
            spacing: 3px;

            Text {
                text: root.now-playing-title;
                font-size: Theme.font-md;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
            if Platform.has-clipboard: Text {
                text: root.copied ? "Copied" : "Click to copy";
                font-size: Theme.font-xs;
                color: Theme.text-secondary;
            }
        }
    }
}
