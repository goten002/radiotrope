

// Shared building blocks for the modern look (dialog shell, section
// headers, info rows, chips, icon buttons, form fields)

import { Theme, Defaults } from "defaults.slint";
import { Icon, FocusRing, ButtonKeys } from "component-primitives.slint";
export { Icon, FocusRing, ButtonKeys }
import { ScrollBar } from "scroll-bar.slint";
import { AccentButton, SecondaryButton, DangerButton } from "buttons.slint";

// Clock for the small status animations: steps by Defaults.motion-step
// while something plays, connects or records (the window runs the timer)
export global Motion {
    in-out property <duration> tick;
}

// Background of a menu or a hover bubble: the popup colour, a hairline
// edge and a soft shadow. Put the content inside.
export component PopupCard inherits Rectangle {
    background: Theme.popup-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.popup-border;
    drop-shadow-blur: Theme.popup-shadow-blur;
    drop-shadow-offset-y: Theme.popup-shadow-offset;
    drop-shadow-color: Theme.popup-shadow;

    // Fades in when it appears
    property <bool> shown: false;
    init => { self.shown = true; }
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: Theme.fast; }
}

// Line between groups of menu items
export component MenuSeparator inherits Rectangle {
    height: 9px;

    Rectangle {
        y: 4px;
        height: 1px;
        background: Theme.pressed-bg;
    }
}

// Three small bars that bounce while a station plays
export component NowPlayingBars inherits HorizontalLayout {
    spacing: 2px;
    alignment: start;
    height: 12px;

    for i in [0, 1, 2]: VerticalLayout {
        alignment: end;
        Rectangle {
            width: 3px;
            height: 3px + 9px * abs(sin(Motion.tick / (Theme.bars-period + i * Theme.bars-period-step) * 180deg + i * 50deg));
            border-radius: 1.5px;
            background: Theme.accent-graphic;
        }
    }
}

// Round, borderless button with an icon
export component IconButton inherits Rectangle {
    in property <image> icon;
    // What the button does, for screen readers (it shows only the icon)
    in property <string> label;
    in property <length> icon-size: Theme.icon-md;
    in property <color> icon-color: Theme.text-secondary;
    in property <color> hover-color: Theme.text-primary;
    in property <bool> active: false;
    // Use for a destructive action waiting for its second press.
    in property <bool> danger-armed: false;
    // Greyed out and not clickable, but keeps its place
    in property <bool> enabled: true;
    // A bigger click area around the button is hovered: it lights up too
    in property <bool> outer-hover: false;
    out property <bool> has-focus: focus.has-focus;
    callback clicked();

    property <bool> hovered: touch.has-hover || root.outer-hover;

    width: 30px;
    height: 30px;
    border-radius: self.height / 2;
    // Borderless at rest, so a disabled one only dims its icon
    background: !root.enabled ? transparent
        : root.danger-armed ? (touch.pressed ? Theme.danger-pressed : Theme.danger-armed)
        : touch.pressed ? Theme.pressed-bg
        : root.hovered ? Theme.hover-bg
        : root.active ? Theme.accent-tint : transparent;
    animate background { duration: Theme.fast; }
    forward-focus: focus;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    Icon {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        colorize: !root.enabled ? Theme.disabled-text
            : root.danger-armed ? Theme.danger-text
            : root.active ? Theme.accent-graphic
            : root.hovered ? root.hover-color : root.icon-color;
        animate colorize { duration: Theme.fast; }
    }

    focus := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if focus.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

// Small uppercase accent heading inside a card
export component SectionHeader inherits Rectangle {
    in property <string> title;

    height: 26px;

    Text {
        x: 0;
        y: parent.height - self.height - 2px;
        text: root.title;
        color: Theme.accent-text;
        font-size: Theme.font-xs;
        font-weight: Theme.weight-semibold;
        letter-spacing: 1px;
    }
}

// Label and value on one line
export component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> label-width: 88px;
    // Let the value be selected and copied; long values scroll
    // sideways while selecting instead of eliding
    in property <bool> selectable: false;

    height: 24px;

    HorizontalLayout {
        spacing: 12px;

        Text {
            width: root.label-width;
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }

        if !root.selectable: Text {
            text: root.value;
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.selectable: Rectangle {
            horizontal-stretch: 1;

            Rectangle {
                clip: true;

                value-input := TextInput {
                    width: 100%;
                    text: root.value;
                    color: Theme.text-primary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    read-only: true;
                    single-line: true;
                    selection-background-color: Theme.selection-bg;
                    selection-foreground-color: Theme.selection-fg;
                    // A Tab stop: named after the row and read as text
                    // that can't be changed
                    accessible-label: root.label;
                    accessible-read-only: true;
                }
            }

            if value-input.has-focus: FocusRing {
                offset: 1px;
                radius: Theme.radius-sm;
            }
        }
    }
}

export struct CreditLink {
    name: string,
    url: string,
}

// Label and a comma-separated list of links, e.g. credits
export component LinkRow inherits Rectangle {
    in property <string> label;
    in property <[CreditLink]> links;
    // Plain text after the links, e.g. a license
    in property <string> note;
    in property <length> label-width: 88px;
    callback open-url(string);

    height: 24px;

    HorizontalLayout {
        spacing: 12px;

        Text {
            width: root.label-width;
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;

            for link[i] in root.links: HorizontalLayout {
                Rectangle {
                    width: name.preferred-width;

                    accessible-role: button;
                    accessible-label: link.name;
                    accessible-description: link.url;
                    accessible-action-default => { root.open-url(link.url); }

                    name := Text {
                        text: link.name;
                        color: Theme.accent-text;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    // Underline on hover (Text can't underline)
                    Rectangle {
                        y: parent.height / 2 + 8px;
                        height: 1px;
                        background: name.color;
                        visible: touch.has-hover || keys.has-focus;
                    }
                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-url(link.url); }
                    }

                    // Enter or Space opens the link
                    keys := ButtonKeys {
                        activated => { root.open-url(link.url); }
                    }

                    if keys.has-focus: FocusRing {
                        offset: 1px;
                        radius: Theme.radius-sm;
                    }
                }
                if i < root.links.length - 1: Text {
                    text: ", ";
                    color: Theme.text-primary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }
            }

            if root.note != "": Text {
                text: " " + root.note;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// Text helpers implemented in Rust
export global TextUtil {
    // The text with every digit replaced by the widest one ("4" in Inter).
    // Sizing a label to this keeps it from shifting as a counter ticks,
    // since Inter's digits have different widths.
    pure callback steady-digits(string) -> string;
}

export enum ChipVariant { neutral, accent, danger, success, warning }

// A text of a chip. Its width comes from the text itself, so what is drawn
// is what was measured. `floor` is room kept beyond that (wider digits);
// `whole` never shortens the text.
component ChipText inherits VerticalLayout {
    in property <string> text;
    in property <color> color;
    in property <bool> whole: false;
    in property <length> floor: 0px;
    out property <length> text-width: label.preferred-width;

    label := Text {
        text: root.text;
        accessible-role: none;
        color: root.color;
        font-size: Theme.font-sm;
        font-weight: Theme.weight-semibold;
        vertical-alignment: center;
        // A whole text can't be given less than its width, so it never
        // ends in "…"
        overflow: root.whole ? TextOverflow.clip : TextOverflow.elide;
    }

    Rectangle {
        height: 0px;
        preferred-width: root.floor;
        min-width: root.whole ? root.floor : 0px;
    }
}

// Pill with short text; `variant` colors the text and a soft background
export component Chip inherits Rectangle {
    in property <string> text;
    // Optional second part after the text, behind a centred "·" and laid
    // out on its own so digits changing in the text don't push it around
    // (e.g. a size after a timer)
    in property <string> detail;
    // Keep the width steady while digits in the text change (timers, sizes)
    in property <bool> steady: false;
    in property <ChipVariant> variant: ChipVariant.neutral;
    property <color> foreground: root.variant == ChipVariant.accent ? Theme.accent-text
        : root.variant == ChipVariant.danger ? Theme.danger-text
        : root.variant == ChipVariant.success ? Theme.success-text
        : root.variant == ChipVariant.warning ? Theme.warning-text
        : Theme.neutral-text;
    property <color> tint: root.variant == ChipVariant.accent ? Theme.accent-graphic
        : root.variant == ChipVariant.danger ? Theme.danger
        : root.variant == ChipVariant.success ? Theme.success
        : root.variant == ChipVariant.warning ? Theme.warning : Theme.text-secondary;
    // Show a dot before the text (e.g. a live status)
    in property <bool> dot: false;
    // Optional icon before the text, in the chip's tone
    in property <image> icon;
    in property <bool> pulse: false;
    // Clickable chips get a thin edge, a pointer and a stronger background
    // on hover
    in property <bool> clickable: false;
    // Shows a small x after the text: a click closes it
    in property <bool> closable: false;
    // Always show the whole text: the chip never gets narrower than it,
    // and the other chips in the row give way and elide (e.g. Playing and
    // REC stay whole while a Scheduler label shortens)
    in property <bool> keep: false;
    // The owner says the text to screen readers itself (a live region):
    // the chip's own text is then not read a second time
    in property <bool> silent: false;
    // The chip has the keyboard focus (only one that is a button can)
    out property <bool> has-focus: keys.has-focus;
    // The text doesn't fit and ends in "…" (never with `keep`)
    out property <bool> cut: !root.keep && root.width + 0.5px < root.preferred-width;
    callback clicked();

    // As wide as its text. It gives way (eliding) when space runs out,
    // unless it is one to `keep`.
    preferred-width: row.preferred-width + 16px;
    max-width: self.preferred-width;
    min-width: root.keep ? self.preferred-width : 40px;
    horizontal-stretch: root.keep ? 0 : 1;
    height: 22px;
    border-radius: Theme.radius-sm;
    border-width: root.clickable ? 1px : 0px;
    border-color: root.tint.with-alpha(0.35);
    property <color> resting-tint: root.variant == ChipVariant.accent
        ? Theme.accent-tint
        : root.variant == ChipVariant.danger ? Theme.danger-tint
        : root.variant == ChipVariant.success ? Theme.success-tint
        : root.variant == ChipVariant.warning ? Theme.warning-tint : Theme.neutral-tint;
    background: touch.pressed ? root.tint.with-alpha(0.26)
        : touch.has-hover && root.interactive
            ? (root.variant == ChipVariant.accent ? Theme.accent-tint-strong : root.tint.with-alpha(0.22))
        : root.resting-tint;
    property <bool> interactive: root.clickable || root.closable;
    forward-focus: keys;

    if root.interactive: Rectangle {
        accessible-role: button;
        accessible-label: root.detail == "" ? root.text : root.text + ", " + root.detail;
        accessible-action-default => { root.clicked(); }
    }

    // Read once: here, as the button above, or by the owner (`silent`).
    // The texts drawn below are not read themselves.
    if !root.interactive && !root.silent: Rectangle {
        accessible-role: AccessibleRole.text;
        accessible-label: root.detail == "" ? root.text : root.text + ", " + root.detail;
    }

    keys := ButtonKeys {
        enabled: root.interactive;
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }
    animate background { duration: Theme.fast; }

    // The click area is taller than the pill
    touch := TouchArea {
        y: -4px;
        height: parent.height + 8px;
        enabled: root.interactive;
        mouse-cursor: root.interactive ? pointer : default;
        clicked => { root.clicked(); }
    }

    row := HorizontalLayout {
        x: 8px;
        width: parent.width - 16px;
        spacing: Theme.space-4;
        alignment: start;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                width: Theme.icon-sm;
                height: self.width;
                source: root.icon;
                colorize: root.foreground;
            }
        }

        if root.dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.foreground;
                opacity: root.pulse ? 0.45 + 0.55 * abs(sin(Motion.tick / Theme.pulse-period * 180deg)) : 1;
            }
        }

        // Text, separator and detail sit closer together than the dot
        HorizontalLayout {
            spacing: 3px;
            horizontal-stretch: 1;

            // With a detail, the text takes its real width and the room kept
            // for wider digits goes around the separator instead
            label := ChipText {
                text: root.text;
                color: root.foreground;
                whole: root.keep;
                horizontal-stretch: 1;
                floor: root.steady && root.detail == "" ? measure.preferred-width : 0px;
            }

            // Separator between the text and the detail. Its box also holds the
            // room kept for wider digits, with the "·" centred in it, so the gaps
            // on both sides stay equal and the detail stays put.
            if root.detail != "": Rectangle {
                width: separator.preferred-width + root.digit-room;
                horizontal-stretch: 0;

                separator := Text {
                    text: "·";
                    accessible-role: none;
                    color: root.foreground;
                    font-size: Theme.font-sm;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            if root.detail != "": ChipText {
                text: root.detail;
                color: root.foreground;
                whole: root.keep;
                floor: root.steady ? detail-measure.preferred-width : 0px;
            }
        }

        if root.closable: VerticalLayout {
            alignment: center;
            Icon {
                width: 8px;
                height: 8px;
                source: @image-url("icons/xmark.svg");
                colorize: root.foreground;
            }
        }
    }

    // The widths with the widest digits, for a steady chip (not shown).
    // They only add room: the text's own width never comes from them.
    measure := Text {
        visible: false;
        text: TextUtil.steady-digits(root.text);
        font-size: Theme.font-sm;
        font-weight: Theme.weight-semibold;
    }

    // Room the text keeps for wider digits than it shows now
    property <length> digit-room: root.steady ? max(0px, measure.preferred-width - label.text-width) : 0px;

    detail-measure := Text {
        visible: false;
        text: TextUtil.steady-digits(root.detail);
        font-size: Theme.font-sm;
        font-weight: Theme.weight-semibold;
    }
}

// Form field: a small label above its input. Every label has the same
// colour; a field that may stay empty says "Optional" after its label.
export component Field inherits VerticalLayout {
    in property <string> label;
    // The field must be filled in. Not shown here: pass the same value to
    // the input (`StyledLineEdit.required`), which says it to screen readers.
    in property <bool> required: false;
    // The field may stay empty
    in property <bool> optional: false;

    spacing: 6px;

    HorizontalLayout {
        alignment: start;
        spacing: Theme.space-6;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-md;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }

        if root.optional: Text {
            text: "Optional";
            color: Theme.text-tertiary;
            font-size: Theme.font-md;
            vertical-alignment: center;
        }
    }

    @children
}

// Keep dismiss and primary actions together, with destructive actions separate.
export component DialogFooter inherits HorizontalLayout {
    in property <string> primary-label;
    in property <bool> primary-enabled: true;
    in property <string> cancel-label;
    in property <string> destructive-label;
    in property <bool> destructive-enabled: true;
    in property <bool> destructive-armed: false;
    in property <string> destructive-armed-label;
    in property <bool> close-only: false;
    in property <bool> full-width: false;
    callback primary-clicked();
    callback cancel-clicked();
    callback destructive-clicked();
    callback close-clicked();

    spacing: Theme.space-8;
    property <int> action-count: root.close-only ? 1 : (root.destructive-label != "" ? 1 : 0)
        + (root.cancel-label != "" ? 1 : 0) + (root.primary-label != "" ? 1 : 0);
    property <length> action-width: (root.width - max(0, root.action-count - 1) * root.spacing)
        / max(1, root.action-count);

    if !root.close-only && root.destructive-label != "": DangerButton {
        label: root.destructive-label;
        enabled: root.destructive-enabled;
        armed: root.destructive-armed;
        armed-label: root.destructive-armed-label;
        clicked => { root.destructive-clicked(); }
        width: root.full-width ? root.action-width : self.natural-width;
        height: root.full-width ? Theme.control-touch : Theme.control-button;
    }

    if !root.full-width: Rectangle { horizontal-stretch: 1; }

    if root.close-only || root.cancel-label != "": SecondaryButton {
        label: root.close-only ? "Close" : root.cancel-label;
        width: root.full-width ? root.action-width : self.natural-width;
        height: root.full-width ? Theme.control-touch : Theme.control-button;
        clicked => {
            if root.close-only { root.close-clicked(); }
            else { root.cancel-clicked(); }
        }
    }

    if !root.close-only && root.primary-label != "": AccentButton {
        label: root.primary-label;
        enabled: root.primary-enabled;
        width: root.full-width ? root.action-width : self.natural-width;
        height: root.full-width ? Theme.control-touch : Theme.control-button;
        clicked => { root.primary-clicked(); }
    }
}

// Empty, loading, error or result state: an icon, a short title, an
// optional explanation and one optional action
export component StatusPanel inherits VerticalLayout {
    // Shown for the neutral, accent and warning variants. An error always
    // shows the alert circle and a success the check circle, so every
    // panel uses the same pair.
    in property <image> icon;
    in property <string> title;
    in property <string> message;
    in property <string> action-label;
    in property <ChipVariant> variant: ChipVariant.neutral;
    in property <bool> busy: false;
    callback action();

    padding: Theme.space-16;
    spacing: Theme.space-8;
    alignment: center;

    property <duration> spinner-time;
    Timer {
        running: root.busy;
        interval: Defaults.motion-step;
        triggered => { root.spinner-time += self.interval; }
    }

    property <image> shown-icon: root.busy ? @image-url("icons/spinner.svg")
        : root.variant == ChipVariant.danger ? @image-url("icons/circle-alert.svg")
        : root.variant == ChipVariant.success ? @image-url("icons/circle-check.svg")
        : root.icon;

    if root.shown-icon.width > 0: HorizontalLayout {
        alignment: center;

        Icon {
            width: Theme.icon-lg;
            height: Theme.icon-lg;
            source: root.shown-icon;
            colorize: root.variant == ChipVariant.danger ? Theme.danger-text
                : root.variant == ChipVariant.success ? Theme.success-text
                : root.variant == ChipVariant.warning ? Theme.warning-text
                : root.busy || root.variant == ChipVariant.accent ? Theme.accent-graphic
                : Theme.text-secondary;
            rotation: root.busy ? root.spinner-time / Theme.spin-period * 360deg : 0deg;
        }
    }

    Text {
        text: root.title;
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: center;
        wrap: word-wrap;
        // Read out when the state changes (loading, an error, a result)
        accessible-live-region: polite;
    }

    if root.message != "": Text {
        text: root.message;
        color: Theme.text-secondary;
        font-size: Theme.font-base;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if root.action-label != "": HorizontalLayout {
        alignment: center;

        SecondaryButton {
            label: root.action-label;
            clicked => { root.action(); }
        }
    }
}

// Window-space bounds of the card body, excluding the header and footer,
// and the window's own top and bottom limits (a dropdown's list may cover
// the footer, a help bubble stays in the body). Without window limits
// (both 0), the body's are used.
export struct PopupBounds {
    left: length,
    top: length,
    right: length,
    bottom: length,
    dialog-id: int,
    window-top: length,
    window-bottom: length,
}

struct InfoTipRequest {
    id: int,
    dialog-id: int,
    text: string,
    x: length,
    y: length,
    width: length,
    height: length,
    open-right: bool,
    open-below: bool,
}

// Most screens have one modal. Bind popup-bounds explicitly for controls in a
// nested modal, or when presenting a popup outside DialogShell.
global DialogPopupBounds {
    in-out property <int> next-id;
    in-out property <InfoTipRequest> tip;
    in-out property <PopupBounds> current: {
        left: Theme.viewport-inset,
        top: Theme.viewport-inset,
        right: Defaults.window-min-width - Theme.viewport-inset,
        bottom: Defaults.window-min-height - Theme.viewport-inset,
    };
}

component InfoTipBubble inherits PopupCard {
    in property <PopupBounds> bounds;
    in property <InfoTipRequest> tip;
    in property <length> origin-x;
    in property <length> origin-y;

    property <length> above: root.tip.y - root.height - Theme.space-6;
    property <length> below: root.tip.y + root.tip.height + Theme.space-6;
    property <length> target-y: (root.tip.open-below || root.above < root.bounds.top)
        && (root.below + root.height <= root.bounds.bottom || root.above < root.bounds.top)
        ? root.below : root.above;
    visible: root.tip.y >= root.bounds.top && root.tip.y + root.tip.height <= root.bounds.bottom;
    x: clamp(root.tip.x + (root.tip.open-right ? 0px : root.tip.width - root.width),
        root.bounds.left, root.bounds.right - root.width) - root.origin-x;
    y: clamp(root.target-y, root.bounds.top, root.bounds.bottom - root.height) - root.origin-y;
    width: min(Defaults.info-tip-width, root.bounds.right - root.bounds.left);
    height: min(tip-layout.preferred-height, root.bounds.bottom - root.bounds.top);

    tip-layout := VerticalLayout {
        padding-left: Theme.space-12;
        padding-right: Theme.space-12;
        padding-top: Theme.space-8;
        padding-bottom: Theme.space-8;

        Text {
            text: root.tip.text;
            font-size: Theme.font-md;
            color: Theme.text-primary;
            wrap: word-wrap;
        }
    }
}

// Modal dialog: dimmed backdrop and a rounded card with an accent glow,
// a title and a close button. Use it as `if show-dialog: DialogShell { ... }`
// and put the content inside; Esc or a backdrop click raise close-requested,
// once the dialog has faded out.
export component DialogShell inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    // Optional image before the title (e.g. a flag)
    in property <image> icon;
    in property <length> card-width: Defaults.dialog-width;
    // Fixed card height; 0 sizes the card to its content
    in property <length> card-height: 0px;
    in property <bool> close-on-backdrop: true;
    in property <length> content-padding: Theme.dialog-padding;
    in property <string> primary-label;
    in property <bool> primary-enabled: true;
    in property <string> cancel-label;
    in property <string> destructive-label;
    in property <bool> destructive-enabled: true;
    in property <bool> destructive-armed: false;
    in property <string> destructive-armed-label;
    in property <bool> close-footer: false;
    in property <bool> full-width-actions: false;
    callback primary-requested();
    callback cancel-requested();
    callback destructive-requested();
    cancel-requested => { root.leave(); }

    property <int> dialog-id;
    out property <PopupBounds> popup-bounds: {
        left: card.absolute-position.x + Theme.space-4,
        right: card.absolute-position.x + card.width - Theme.space-4,
        top: max(body.absolute-position.y, close.absolute-position.y + close.height + Theme.space-4),
        bottom: body.absolute-position.y + body.height,
        dialog-id: root.dialog-id,
        window-top: root.absolute-position.y + Theme.viewport-inset,
        window-bottom: root.absolute-position.y + root.height - Theme.viewport-inset,
    };
    // Take keyboard focus on open so Esc works. Turn off only when a child
    // input focuses itself on open (Esc then reaches the shell from the
    // input): with nothing focused, Esc does nothing.
    in property <bool> auto-focus: true;
    // Show a back arrow at the start of the title row
    in property <bool> show-back: false;
    // Raised by Esc, the close button, a backdrop click and Cancel, after
    // the fade-out. The handler normally drops the dialog.
    callback close-requested();
    // Set while close-requested only leaves an inner page (an editor back
    // to its list) and the dialog stays: it is then raised at once, with
    // no fade-out.
    in property <bool> close-goes-back: false;
    // A mouse drag in the body scrolls it. Off where the body has things
    // to drag (a colour picker): the wheel and the scroll bar still scroll.
    in property <bool> mouse-drag-scroll: true;
    callback back-requested();
    callback capture-key(KeyEvent) -> EventResult;
    capture-key(event) => { return reject; }

    // For a control that goes away while it has the focus: with nothing
    // focused, Esc would do nothing, so the dialog takes the focus back
    public function take-focus() {
        keys.focus();
    }

    // Drives the fade and slide-in when the dialog appears, and the fade-out
    // before it goes
    property <bool> shown: false;
    // Fading out: close-requested follows after Theme.fast. Keys and clicks
    // are ignored meanwhile.
    property <bool> closing: false;

    // Every close from inside the shell comes through here. The owner drops
    // the dialog in close-requested (`if show-dialog`), so the fade-out has
    // to come first.
    function leave() {
        if root.closing {
            return;
        }
        if root.close-goes-back || Theme.fast <= 0ms {
            root.close-requested();
            return;
        }
        root.closing = true;
        root.shown = false;
    }

    Timer {
        interval: Theme.fast;
        running: root.closing;
        triggered => {
            root.close-requested();
            // Still here: the owner kept the dialog open, show it again
            root.shown = true;
            root.closing = false;
        }
    }

    init => {
        self.dialog-id = DialogPopupBounds.next-id + 1;
        DialogPopupBounds.next-id = self.dialog-id;
        self.shown = true;
        DialogPopupBounds.current = root.popup-bounds;
        if self.auto-focus {
            keys.focus();
        }
    }

    changed popup-bounds => { DialogPopupBounds.current = root.popup-bounds; }

    width: 100%;
    height: 100%;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: root.closing ? Theme.fast : Theme.normal; }

    Rectangle {
        background: Theme.scrim;
    }

    TouchArea {
        clicked => {
            if root.close-on-backdrop {
                root.leave();
            }
        }
    }

    // Tab stays inside the dialog: from the close button (the last stop)
    // it goes round to the first control, Shift+Tab from the first control
    // goes round to the close button. The dialog itself (focused on open)
    // is not a stop of its own.
    keys := FocusScope {
        focus-on-tab-navigation: false;
        // A backdrop click closes the dialog at once, rather than first
        // taking the focus from a text field
        focus-on-click: false;
        // Slint has no dialog role. The dialog takes the focus on open, so
        // a screen reader then reads the group's name: the title, and the
        // subtitle as its description. With the focus in a field instead
        // (auto-focus off), the group is announced as the field's context.
        accessible-role: groupbox;
        accessible-label: root.title;
        accessible-description: root.subtitle;
        capture-key-pressed(event) => {
            if root.closing {
                return accept;
            }
            DialogPopupBounds.current = root.popup-bounds;
            return root.capture-key(event);
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.leave();
                return accept;
            }
            if body.content-height > body.height {
                if event.text == Key.PageDown {
                    body.content-y = max(body.height - body.content-height, body.content-y - body.height);
                    return accept;
                }
                if event.text == Key.PageUp {
                    body.content-y = min(0px, body.content-y + body.height);
                    return accept;
                }
                // With nothing inside focused (a read-only dialog), the
                // arrows, Home and End scroll the body too
                if self.has-focus && !event.modifiers.control && !event.modifiers.alt
                    && !event.modifiers.meta && !event.modifiers.shift {
                    if event.text == Key.UpArrow {
                        body.content-y = min(0px, body.content-y + 24px);
                        return accept;
                    }
                    if event.text == Key.DownArrow {
                        body.content-y = max(body.height - body.content-height, body.content-y - 24px);
                        return accept;
                    }
                    if event.text == Key.Home {
                        body.content-y = 0px;
                        return accept;
                    }
                    if event.text == Key.End {
                        body.content-y = body.height - body.content-height;
                        return accept;
                    }
                }
            }
            if event.text == Key.Tab && !event.modifiers.shift
                && (self.has-focus || close.has-focus) {
                // Slint's own Tab handling then moves on from the start
                head.focus();
                return reject;
            }
            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift))
                && self.has-focus {
                close.focus();
                return accept;
            }
            return reject;
        }

        // Start of the dialog's Tab order; reached by Tab only going back
        // from the first control
        head := FocusScope {
            focus-on-click: false;
            focus-gained(reason) => {
                if reason == FocusReason.tab-navigation {
                    close.focus();
                }
            }
        }

        card := Rectangle {
            // Slides in on open only; closing is a plain fade
            property <length> slide: root.shown || root.closing ? 0px : 14px;
            animate slide { duration: Theme.normal; easing: ease-out; }

            width: min(root.card-width, root.width - 2 * Theme.viewport-inset);
            height: min(root.height - 2 * Theme.viewport-inset,
                root.card-height > 0 ? root.card-height : layout.preferred-height);
            x: (root.width - self.width) / 2;
            y: max(Theme.viewport-inset, (root.height - self.height) / 2) + self.slide;
            background: Theme.card;
            border-radius: Theme.dialog-radius;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.shadow;
            clip: true;

            // Swallow clicks so they don't reach the backdrop
            TouchArea {}

            // Accent glow at the top
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 110px;
                visible: Theme.panel-gradient;
                background: @linear-gradient(180deg, Theme.accent-glow 0%, Theme.accent-glow.with-alpha(0) 100%);
            }

            layout := VerticalLayout {
                padding: root.content-padding;
                spacing: Theme.dialog-gap;

                if root.title != "": HorizontalLayout {
                    spacing: 10px;
                    padding-right: 32px;

                    if root.show-back: VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("icons/chevron-left.svg");
                            label: "Back";
                            icon-size: Theme.icon-md;
                            clicked => { root.back-requested(); }
                        }
                    }

                    if root.icon.width > 0: VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.icon;
                            width: 26px;
                            height: 20px;
                            image-fit: contain;
                            // Decoration: the title names the dialog
                            accessible-role: none;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: root.title;
                            color: Theme.text-primary;
                            font-size: Theme.font-title;
                            font-weight: Theme.weight-semibold;
                            overflow: elide;
                        }

                        if root.subtitle != "": Text {
                            text: root.subtitle;
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    preferred-height: body-content.preferred-height;

                    body := Flickable {
                        mouse-drag-pan-enabled: root.mouse-drag-scroll;
                        content-width: self.width;
                        content-height: body-content.height;
                        width: parent.width;

                        body-content := VerticalLayout {
                            width: body.width;
                            height: max(body.height, self.preferred-height);
                            spacing: Theme.dialog-gap;
                            @children
                        }
                    }

                    ScrollBar {
                        x: parent.width + Theme.space-4;
                        viewport-height: body.height;
                        content-height: body.content-height;
                        content-y <=> body.content-y;
                    }
                }

                if root.close-footer || root.primary-label != "" || root.cancel-label != ""
                    || root.destructive-label != "": DialogFooter {
                    close-only: root.close-footer;
                    primary-label: root.primary-label;
                    primary-enabled: root.primary-enabled;
                    cancel-label: root.cancel-label;
                    destructive-label: root.destructive-label;
                    destructive-armed: root.destructive-armed;
                    destructive-armed-label: root.destructive-armed-label;
                    destructive-enabled: root.destructive-enabled;
                    full-width: root.full-width-actions;
                    primary-clicked => { root.primary-requested(); }
                    cancel-clicked => { root.cancel-requested(); }
                    destructive-clicked => { root.destructive-requested(); }
                    close-clicked => { root.leave(); }
                }
            }

            // Draw help above every row in the card. An inline bubble nested
            // in a row can be covered by the following rows.
            if DialogPopupBounds.tip.dialog-id == root.dialog-id && DialogPopupBounds.tip.id > 0: InfoTipBubble {
                origin-x: card.absolute-position.x;
                origin-y: card.absolute-position.y;
                bounds: root.popup-bounds;
                tip: DialogPopupBounds.tip;
            }

            // Close button, top right
            close := IconButton {
                x: parent.width - self.width - 12px;
                y: 12px;
                icon: @image-url("icons/xmark.svg");
                label: "Close";
                icon-size: Theme.icon-sm;
                clicked => { root.leave(); }
            }
        }
    }

    // Nothing is clickable while the dialog fades out
    if root.closing: TouchArea { }
}

// On/off switch
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    // Greyed out and not clickable; keeps showing its state
    in property <bool> enabled: true;
    // Shown on (and greyed out) while something else keeps it on; `checked`
    // keeps the choice for when that ends
    in property <bool> forced-on: false;
    // The label names the switch for screen readers without being shown
    in property <bool> show-label: true;
    callback toggled(bool);
    // On: a filled track in the accent (kept at 3:1 on the panel) with a
    // white knob in both themes; black only on an accent so light that
    // white would not show. Off: an outlined track
    // with a smaller grey knob, so it doesn't vanish into the panel.
    // Disabled: the same shapes, fainter.
    property <bool> on: root.checked || root.forced-on;
    property <color> on-fill: touch.pressed ? Theme.accent-graphic.darker(0.25)
        : touch.has-hover ? Theme.accent-graphic.darker(0.15) : Theme.accent-graphic;
    // By the resting fill, so the knob doesn't flip under the pointer
    property <color> on-knob: root.luminance(Theme.accent-graphic) > 0.6 ? #000000 : #ffffff;

    // An sRGB channel (0-255) in linear light (0-1)
    pure function linear(channel: int) -> float {
        let v = channel / 255;
        return v <= 0.04045 ? v / 12.92 : pow((v + 0.055) / 1.055, 2.4);
    }

    // Relative luminance (WCAG 2): 0 for black, 1 for white. White on 0.6
    // is 1.6:1, about the least a white knob can do.
    pure function luminance(c: color) -> float {
        return 0.2126 * root.linear(c.red) + 0.7152 * root.linear(c.green) + 0.0722 * root.linear(c.blue);
    }

    width: row.preferred-width;
    height: 28px;
    forward-focus: focus;

    accessible-role: switch;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.flip(); }

    function flip() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.flip(); }
    }

    focus := ButtonKeys {
        enabled: root.enabled;
        activated => { root.flip(); }
    }

    row := HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 36px;
                height: 20px;
                border-radius: 10px;
                background: !root.enabled ? Theme.disabled-bg
                    : root.on ? root.on-fill
                    : touch.pressed ? Theme.pressed-bg : touch.has-hover ? Theme.hover-bg
                    : Theme.elevated;
                border-width: !root.on || !root.enabled ? 1.5px : 0;
                border-color: root.enabled ? Theme.text-tertiary : Theme.disabled-text.with-alpha(0.5);
                animate background { duration: Theme.normal; }

                if focus.has-focus: FocusRing {
                    radius: parent.border-radius;
                }

                Rectangle {
                    property <length> size: root.on ? 14px : 10px;
                    animate size { duration: Theme.normal; easing: ease-out; }
                    x: root.on ? parent.width - self.width - 3px : (parent.height - self.height) / 2;
                    animate x { duration: Theme.normal; easing: ease-out; }
                    y: (parent.height - self.height) / 2;
                    width: self.size;
                    height: self.size;
                    border-radius: self.size / 2;
                    background: !root.enabled ? Theme.disabled-text
                        : !root.on ? Theme.text-tertiary
                        : root.on-knob;
                    animate background { duration: Theme.normal; }
                }
            }
        }

        if root.label != "" && root.show-label: Text {
            text: root.label;
            color: root.enabled ? Theme.text-primary : Theme.disabled-text;
            font-size: Theme.font-base;
            vertical-alignment: center;
            // Read as the switch's name
            accessible-role: none;
        }
    }
}

// Small ⓘ that shows a line of help in a bubble above it: after a short
// hover, or on tap (touch screens have no hover). Keeps help text out of
// the layout. The bubble opens upward, over what comes before it, unless
// told otherwise.
export component InfoTip inherits Rectangle {
    in property <string> text;
    // Where the bubble opens: by default above, ending at the icon's right
    // edge. Near the left or top of a dialog it can grow to the right of
    // the icon, or open below it, so the dialog doesn't cut it off.
    in property <bool> open-right: false;
    in property <bool> open-below: false;

    in property <PopupBounds> popup-bounds: DialogPopupBounds.current;
    in-out property <bool> open: false;
    // The press came from a touch screen, which leaves hover as the finger
    // lifts: a tap keeps the bubble open until the next tap
    property <bool> touch-press: false;
    property <int> tip-id;
    property <InfoTipRequest> request: {
        id: root.tip-id,
        dialog-id: root.popup-bounds.dialog-id,
        text: root.text,
        x: root.absolute-position.x,
        y: root.absolute-position.y,
        width: root.width,
        height: root.height,
        open-right: root.open-right,
        open-below: root.open-below,
    };

    init => {
        self.tip-id = DialogPopupBounds.next-id + 1;
        DialogPopupBounds.next-id = self.tip-id;
        self.update-tip();
    }

    changed open => { root.update-tip(); }

    changed request => {
        if DialogPopupBounds.tip.id == root.tip-id && root.tip-id > 0
            && (DialogPopupBounds.tip.dialog-id == root.request.dialog-id || DialogPopupBounds.tip.dialog-id == 0) {
            root.update-tip();
        }
    }

    function update-tip() {
        if root.open && root.tip-id > 0 {
            DialogPopupBounds.tip = root.request;
        } else if DialogPopupBounds.tip.id == root.tip-id {
            DialogPopupBounds.tip = { id: 0 };
        }
    }

    width: 18px;
    height: 18px;
    border-radius: self.width / 2;

    accessible-role: button;
    accessible-label: "More information";
    accessible-description: root.text;
    accessible-action-default => { root.open = !root.open; }

    Icon {
        x: 1px;
        y: 1px;
        width: 16px;
        height: 16px;
        source: @image-url("icons/circle-info.svg");
        colorize: touch.has-hover || root.open ? Theme.text-primary : Theme.text-tertiary;
    }

    // Space or Enter shows or hides the bubble; it hides when the focus moves on
    keys := ButtonKeys {
        activated => { root.open = !root.open; }
        focus-lost => { root.open = false; }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }

    // The click area is bigger than the drawing
    touch := TouchArea {
        x: -5px;
        y: -5px;
        width: 28px;
        height: 28px;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.touch-press = e.touch-finger-id != 0;
            }
        }
        clicked => {
            delay.running = false;
            root.open = !root.open;
        }
        changed has-hover => {
            delay.running = self.has-hover && !root.open;
            if !self.has-hover && !root.touch-press {
                root.open = false;
            }
        }
    }

    delay := Timer {
        interval: Defaults.hover-delay;
        running: false;
        triggered => {
            self.running = false;
            root.open = true;
        }
    }

    // Outside a DialogShell there is no card layer to draw the bubble.
    if root.open && root.popup-bounds.dialog-id == 0: InfoTipBubble {
        origin-x: root.absolute-position.x;
        origin-y: root.absolute-position.y;
        bounds: root.popup-bounds;
        tip: root.request;
    }
}

// How many agents use the player (or phones listen to it). Hovering it, or
// moving the keyboard focus to it, lists them in an AgentsBubble
// (ListenersBubble); Space or Enter hides and shows the list. The window
// draws the bubble (over the header under the menu bar), at the chip's
// right edge: a popup would take the mouse and close it on any move.
export component AgentsChip inherits Rectangle {
    in property <bool> snapshot-bubble;
    changed snapshot-bubble => {
        if root.snapshot-bubble { root.open-bubble(); }
    }

    function open-bubble() {
        root.bubble-open = true;
        root.show-bubble(root.absolute-position.x + root.width, root.absolute-position.y + root.height + 6px);
    }

    function close-bubble() {
        root.bubble-open = false;
        root.hide-bubble();
    }

    in property <int> count;
    in property <image> icon: @image-url("icons/bot.svg");
    // What the chip counts, for screen readers ("2 agents using the
    // player"), and who they are (the names in the bubble, joined)
    in property <string> label;
    in property <string> description;
    // Show the bubble with its top right corner here (window coordinates),
    // or hide it
    callback show-bubble(/* right */ length, /* top */ length);
    callback hide-bubble();

    property <bool> bubble-open: false;

    width: row.preferred-width + 14px;
    height: 22px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover || keys.has-focus ? Theme.accent-tint-strong : Theme.accent-tint;
    animate background { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: button;
    accessible-label: root.label != "" ? root.label : "" + root.count;
    accessible-description: root.description;
    accessible-expandable: true;
    accessible-expanded: root.bubble-open;
    accessible-action-default => {
        if root.bubble-open { root.close-bubble(); } else { root.open-bubble(); }
    }

    // The hover area is taller than the pill
    touch := TouchArea {
        y: -4px;
        height: parent.height + 8px;
        changed has-hover => {
            delay.running = self.has-hover;
            if !self.has-hover && !keys.has-focus {
                root.close-bubble();
            }
        }
    }

    delay := Timer {
        interval: Defaults.hover-delay;
        running: false;
        triggered => {
            self.running = false;
            root.open-bubble();
        }
    }

    keys := ButtonKeys {
        activated => {
            if root.bubble-open { root.close-bubble(); } else { root.open-bubble(); }
        }
        changed has-focus => {
            if self.has-focus {
                root.open-bubble();
            } else if !touch.has-hover {
                root.close-bubble();
            }
        }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }

    row := HorizontalLayout {
        x: 7px;
        spacing: 4px;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 11px;
                height: 11px;
                source: root.icon;
                colorize: Theme.accent-text;
            }
        }
        Text {
            text: root.count;
            color: Theme.accent-text;
            font-size: Theme.font-sm;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// One agent in the agents bubble
export struct AgentRow {
    name: string,
    // "This computer" or the address it calls from
    place: string,
    // Over the network (an agent on this computer may use it too)
    network: bool,
    // "connected", or when a network agent without an open connection
    // last called: "just now", "4 min ago"
    seen: string,
    connected: bool,
}

// The agents chip's list, in the same style as the other hover bubbles:
// a caption, then one row per agent with where it calls from and whether
// it is connected or when it last called
export component AgentsBubble inherits PopupCard {
    in property <[AgentRow]> agents;

    width: max(Defaults.info-tip-width, bubble.preferred-width);
    height: bubble.preferred-height;

    bubble := VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 10px;
        spacing: 6px;

        Text {
            text: root.agents.length == 1 ? "AGENT USING THE PLAYER" : "AGENTS USING THE PLAYER";
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            font-weight: Theme.weight-semibold;
            letter-spacing: 0.5px;
        }

        GridLayout {
            spacing-horizontal: 8px;
            spacing-vertical: 5px;

            for agent in root.agents: Row {
                VerticalLayout {
                    alignment: center;
                    Icon {
                        width: 13px;
                        height: 13px;
                        source: agent.network ? @image-url("icons/network-wired.svg") : @image-url("icons/desktop.svg");
                        colorize: agent.connected ? Theme.accent-graphic : Theme.text-tertiary;
                    }
                }
                Text {
                    text: agent.name;
                    color: Theme.text-primary;
                    font-size: Theme.font-md;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }
                Text {
                    min-width: self.preferred-width;
                    text: agent.place;
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Text {
                    min-width: self.preferred-width;
                    text: agent.seen;
                    color: agent.connected ? Theme.accent-text : Theme.text-tertiary;
                    font-size: Theme.font-sm;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// The listeners chip's list: the phones listening to the player
export component ListenersBubble inherits PopupCard {
    in property <[string]> phones;

    width: max(Defaults.info-tip-width, bubble.preferred-width);
    height: bubble.preferred-height;

    bubble := VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 10px;
        spacing: 6px;

        Text {
            text: root.phones.length == 1 ? "PHONE LISTENING" : "PHONES LISTENING";
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            font-weight: Theme.weight-semibold;
            letter-spacing: 0.5px;
        }

        for phone in root.phones: HorizontalLayout {
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                Icon {
                    width: 13px;
                    height: 13px;
                    source: @image-url("icons/mobile-screen-button.svg");
                    colorize: Theme.accent-graphic;
                }
            }
            Text {
                text: phone;
                color: Theme.text-primary;
                font-size: Theme.font-md;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
            }
        }
    }
}

// One option in a menu, picker or dropdown. Rows managed by a containing
// keyboard scope can supply highlighted and set tab-stop to false.
export component ChoiceRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <string> trailing-text;
    in property <bool> selected: false;
    in property <bool> checkable: true;
    in property <bool> enabled: true;
    in property <bool> highlighted: false;
    in property <bool> tab-stop: true;
    in property <bool> danger-armed: false;
    callback clicked();

    height: Theme.row-menu;
    border-radius: Theme.radius-sm;
    // Disabled rows only dim their text: a filled row is too heavy in a menu
    background: !root.enabled ? transparent
        : root.danger-armed ? (touch.pressed ? Theme.danger-pressed : Theme.danger-armed)
        : touch.pressed ? Theme.pressed-bg
        : touch.has-hover ? Theme.hover-bg
        : root.selected && root.checkable ? Theme.accent-tint : transparent;
    animate background { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.selected;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }

    property <color> foreground: !root.enabled ? Theme.disabled-text
        : root.danger-armed ? Theme.danger-text
        : touch.has-hover || root.highlighted ? Theme.text-primary : Theme.menu-text;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        spacing: Theme.space-8;

        if root.icon.width > 0: Rectangle {
            width: Theme.icon-md;
            Icon {
                width: Theme.icon-md;
                height: self.width;
                source: root.icon;
                colorize: root.foreground;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.foreground;
            font-size: Theme.font-md;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        if root.trailing-text != "": Text {
            text: root.trailing-text;
            // Tertiary text drops under 4.5:1 on a hovered or selected row
            color: !root.enabled ? Theme.disabled-text
                : touch.has-hover || touch.pressed || root.highlighted
                    || (root.selected && root.checkable) ? Theme.text-secondary
                : Theme.text-tertiary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }

        if root.checkable: Rectangle {
            width: Theme.icon-sm;
            if root.selected: Icon {
                width: Theme.icon-sm;
                height: self.width;
                source: @image-url("icons/tick.svg");
                colorize: root.enabled ? Theme.accent-graphic : Theme.disabled-text;
            }
        }
    }

    keys := ButtonKeys {
        enabled: root.enabled && root.tab-stop;
        activated => { root.clicked(); }
    }

    if root.enabled && (keys.has-focus || root.highlighted): FocusRing {
        offset: -1px;
        radius: root.border-radius;
    }
}

// A field with a list in a window-space popup. The list opens downward,
// as wide as the card allows and as tall as the window allows, and shows
// whole rows; it opens upward only when fewer than four rows (or the whole
// list, if shorter) fit below and there is more room above. The popup owns keyboard navigation while open.
export component Dropdown inherits Rectangle {
    in property <bool> show-popup;
    in property <[string]> items;
    in-out property <int> selected;
    in property <bool> enabled: true;
    in property <string> label;
    in property <PopupBounds> popup-bounds: DialogPopupBounds.current;
    in property <length> popup-min-width: Defaults.dropdown-min-popup-width;
    callback changed(int);

    property <bool> can-open: root.enabled && root.items.length > 0;
    property <bool> open: popup.is-open;
    property <int> active;
    property <bool> keyboard-open;

    changed show-popup => {
        if root.show-popup { root.open-list(false); }
        else if root.open { popup.close(); }
    }

    changed can-open => {
        if !root.can-open && root.open { popup.close(); }
    }

    function open-list(keyboard: bool) {
        if root.can-open && !root.open {
            root.active = clamp(root.selected, 0, root.items.length - 1);
            root.keyboard-open = keyboard;
            field-keys.focus();
            popup.show();
        }
    }

    function pick(index: int) {
        if index >= 0 && index < root.items.length && root.selected != index {
            root.selected = index;
            root.changed(index);
        }
    }

    height: Theme.control-button;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.enabled ? Theme.field-border : Theme.disabled-border;
    background: !root.enabled ? Theme.disabled-bg
        : touch.pressed ? Theme.pressed-bg
        : touch.has-hover || root.open ? Theme.hover-bg : Theme.elevated;
    animate background { duration: Theme.fast; }
    forward-focus: field-keys;

    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.selected >= 0 && root.selected < root.items.length ? root.items[root.selected] : "";
    accessible-enabled: root.can-open;
    accessible-action-default => { root.open-list(true); }

    touch := TouchArea {
        enabled: root.can-open;
        mouse-cursor: root.can-open ? pointer : default;
        clicked => { root.open-list(false); }
    }

    field-keys := ButtonKeys {
        enabled: root.can-open;
        activated => { root.open-list(true); }
        capture-key-pressed(event) => {
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                root.open-list(true);
                return accept;
            }
            return reject;
        }
    }

    if field-keys.has-focus: FocusRing {
        offset: 0px;
        radius: root.border-radius;
    }

    HorizontalLayout {
        padding-left: Theme.space-12;
        padding-right: Theme.space-12;
        spacing: Theme.space-6;

        Text {
            text: root.selected >= 0 && root.selected < root.items.length ? root.items[root.selected] : "";
            color: root.enabled ? Theme.text-primary : Theme.disabled-text;
            font-size: Theme.font-md;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            accessible-role: none;
        }

        // The arrow turns while the list is open
        Rectangle {
            width: Theme.icon-compact;
            Icon {
                width: Theme.icon-sm;
                height: self.width;
                source: @image-url("icons/chevron-down.svg");
                colorize: root.enabled ? Theme.text-secondary : Theme.disabled-text;
                rotation: root.open ? 180deg : 0deg;
                animate rotation { duration: Theme.fast; }
            }
        }
    }

    property <length> list-height: root.items.length * Theme.row-menu + 2 * Theme.space-4;
    // Up and down the list may use the window, not only the card's body
    property <bool> window-limits: root.popup-bounds.window-bottom > root.popup-bounds.window-top;
    property <length> limit-top: root.window-limits ? root.popup-bounds.window-top : root.popup-bounds.top;
    property <length> limit-bottom: root.window-limits ? root.popup-bounds.window-bottom : root.popup-bounds.bottom;
    property <length> above: root.absolute-position.y - root.limit-top - Theme.space-2;
    property <length> below: root.limit-bottom - root.absolute-position.y - root.height - Theme.space-2;
    property <length> wanted-height: min(root.list-height, Defaults.dropdown-max-height);
    // A long list scrolls, so room for four rows below is enough to stay
    // below
    property <bool> flip: root.below < min(root.wanted-height, 4 * Theme.row-menu + 2 * Theme.space-4)
        && root.above > root.below;
    // Whole rows only, and at least one
    property <length> room: root.flip ? root.above : root.below;
    property <length> popup-height: min(root.wanted-height,
        max(1, floor((root.room - 2 * Theme.space-4) / Theme.row-menu)) * Theme.row-menu + 2 * Theme.space-4);

    property <length> popup-width: min(max(root.width, root.popup-min-width),
        root.popup-bounds.right - root.popup-bounds.left);

    popup := PopupWindow {
        x: clamp(root.absolute-position.x, root.popup-bounds.left,
            root.popup-bounds.right - root.popup-width) - root.absolute-position.x;
        y: root.flip ? -root.popup-height - Theme.space-2 : root.height + Theme.space-2;
        width: root.popup-width;
        height: root.popup-height;
        close-policy: close-on-click-outside;

        PopupCard {
            keys := FocusScope {
                focus-on-tab-navigation: false;
                focus-on-click: false;
                init => { self.focus(); }

                key-pressed(event) => {
                    if event.text == Key.Escape {
                        popup.close();
                        return accept;
                    }
                    if event.text == Key.Return || event.text == Key.Space {
                        if !event.repeat {
                            root.pick(root.active);
                            popup.close();
                        }
                        return accept;
                    }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow
                        || event.text == Key.Home || event.text == Key.End {
                        root.keyboard-open = true;
                        root.active = event.text == Key.Home ? 0
                            : event.text == Key.End ? root.items.length - 1
                            : clamp(root.active + (event.text == Key.UpArrow ? -1 : 1), 0, root.items.length - 1);
                        flick.reveal(root.active, false);
                        return accept;
                    }
                    return reject;
                }

                flick := Flickable {
                    content-width: self.width;
                    content-height: root.list-height;
                    width: parent.width - (scroll.visible ? Theme.space-12 : 0px);
                    x: 0;

                    function reveal(index: int, center: bool) {
                        let top = Theme.space-4 + index * Theme.row-menu;
                        let offset = -self.content-y;
                        self.content-y = -clamp(center ? top - (self.height - Theme.row-menu) / 2
                            : clamp(offset, top + Theme.row-menu - self.height, top),
                            0px, max(0px, self.content-height - self.height));
                    }

                    init => { self.reveal(root.active, true); }

                    list := VerticalLayout {
                        width: flick.width;
                        padding: Theme.space-4;

                        for option[index] in root.items: ChoiceRow {
                            label: option;
                            selected: index == root.selected;
                            highlighted: root.keyboard-open && index == root.active;
                            tab-stop: false;
                            clicked => {
                                root.pick(index);
                                popup.close();
                            }
                        }
                    }
                }

                scroll := ScrollBar {
                    x: parent.width - self.width - Theme.space-4;
                    y: Theme.space-4;
                    height: parent.height - 2 * Theme.space-4;
                    viewport-height: flick.height;
                    content-height: flick.content-height;
                    content-y <=> flick.content-y;
                }
            }
        }
    }
}

// One option of a Picker
export component PickerOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <length> option-width: 56px;
    // Optional icon before the label, red for a recording's dot
    in property <image> icon;
    in property <bool> red-icon: false;
    // Lower, with smaller text, for a choice inside a list row
    in property <bool> compact: false;
    callback clicked();

    min-width: root.option-width;
    height: root.compact ? 24px : 30px;
    border-radius: Theme.radius-sm;
    // Disabled: only the selected option keeps a (quiet) fill
    background: !root.enabled ? (root.selected ? Theme.pressed-bg : transparent)
        : root.selected ? (touch.pressed ? Theme.accent-fill-pressed : touch.has-hover ? Theme.accent-fill-hover : Theme.accent-fill)
        : touch.pressed ? Theme.pressed-bg
        : touch.has-hover ? Theme.hover-bg : transparent;
    animate background { duration: Theme.fast; }
    property <color> foreground: !root.enabled ? Theme.disabled-text
        : !root.selected ? Theme.text-primary
        : touch.pressed ? Theme.on-accent-pressed
        : touch.has-hover ? Theme.on-accent-hover : Theme.on-accent;
    forward-focus: keys;

    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: root.icon.width > 0 ? 8px : 0px;
        padding-right: root.icon.width > 0 ? 10px : 0px;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                width: 11px;
                height: 11px;
                source: root.icon;
                colorize: root.enabled && !root.selected && root.red-icon ? Theme.danger-text : root.foreground;
            }
        }

        Text {
            text: root.label;
            color: root.foreground;
            font-size: root.compact ? Theme.font-md : Theme.font-base;
            font-weight: root.selected ? Theme.weight-semibold : Theme.weight-regular;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

// A PickerOption where several can be on at once (weekdays): read as a
// checkbox instead of a radio button. (A role can't depend on a property,
// so this is a component of its own.)
export component MultiPickerOption inherits PickerOption {
    accessible-role: checkbox;
}

export struct PickerChoice {
    id: string,
    label: string,
    // Optional icon before the label
    icon: image,
    red-icon: bool,
    // Greyed out while the rest can be picked
    disabled: bool,
}

// A row of options, one selected
export component Picker inherits HorizontalLayout {
    // The setting's name, for screen readers ("Format", "Theme")
    in property <string> label;
    in property <[PickerChoice]> choices;
    in-out property <string> selected;
    in property <bool> enabled: true;
    in property <length> option-width: 56px;
    // Lower, with smaller text (see PickerOption)
    in property <bool> compact: false;
    callback changed(string);

    alignment: start;

    Rectangle {
        background: Theme.elevated;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.hairline;
        width: row.preferred-width;
        height: row.preferred-height;

        accessible-role: radio-group;
        accessible-label: root.label;

        row := HorizontalLayout {
            padding: root.compact ? 2px : 3px;
            spacing: root.compact ? 2px : 3px;

            for choice in root.choices: PickerOption {
                label: choice.label;
                icon: choice.icon;
                red-icon: choice.red-icon && root.selected != choice.id;
                selected: root.selected == choice.id;
                enabled: root.enabled && !choice.disabled;
                option-width: root.option-width;
                compact: root.compact;
                clicked => {
                    if root.selected != choice.id {
                        root.selected = choice.id;
                        root.changed(choice.id);
                    }
                }
            }
        }
    }
}
