

// Shared building blocks for the modern look (dialog shell, section
// headers, info rows, chips, icon buttons, form fields)

import { Theme, Defaults } from "defaults.slint";

// Clock for the small status animations: steps by Defaults.motion-step
// while something plays, connects or records (the window runs the timer)
export global Motion {
    in-out property <duration> tick;
}

// Colorized icon. Draws the image 1px larger on every side and clips that
// edge off: the femtovg renderer builds colorized textures without clearing
// them, so their outermost pixels can hold leftover garbage that shows as a
// thin bar beside the icon. So a drawing that reaches the edge of its SVG
// loses that 1px: keep icons at least 1px clear of the edge (spinner.svg).
export component Icon inherits Rectangle {
    in property <image> source;
    in property <brush> colorize;
    in property <angle> rotation: 0deg;

    clip: true;

    Image {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        source: root.source;
        colorize: root.colorize;
        transform-rotation: root.rotation;
        // Decoration: the control around it carries the name
        accessible-role: none;
    }
}

// Ring around a control that has keyboard focus. Put it in the control as
// `if focus.has-focus: FocusRing { radius: root.border-radius; }`; it takes
// the control's size and draws just outside its edge (a negative offset
// draws inside, for controls at an edge that clips).
export component FocusRing inherits Rectangle {
    in property <length> radius;
    in property <length> offset: Theme.focus-ring-offset;

    Rectangle {
        x: -root.offset;
        y: -root.offset;
        width: root.width + 2 * root.offset;
        height: root.height + 2 * root.offset;
        border-radius: max(0px, root.radius + root.offset);
        border-width: Theme.focus-ring-width;
        border-color: Theme.focus-ring;
    }
}

// Background of a menu or a hover bubble: the popup colour, a hairline
// edge and a soft shadow. Put the content inside.
export component PopupCard inherits Rectangle {
    background: Theme.popup-bg;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.hairline;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow-soft;
}

// Line between groups of menu items
export component MenuSeparator inherits Rectangle {
    height: 9px;

    Rectangle {
        y: 4px;
        height: 1px;
        background: Theme.menu-hover;
    }
}

// Keyboard side of a button: takes focus by Tab (a click doesn't move the
// focus) and presses the button on Space or Enter
export component ButtonKeys inherits FocusScope {
    callback activated();

    focus-on-click: false;
    key-pressed(event) => {
        if event.text == Key.Space || event.text == Key.Return {
            root.activated();
            return accept;
        }
        return reject;
    }
}

// Three small bars that bounce while a station plays
export component NowPlayingBars inherits HorizontalLayout {
    spacing: 2px;
    alignment: start;
    height: 12px;

    for i in [0, 1, 2]: VerticalLayout {
        alignment: end;
        Rectangle {
            width: 3px;
            height: 3px + 9px * abs(sin(Motion.tick / (Theme.bars-period + i * Theme.bars-period-step) * 180deg + i * 50deg));
            border-radius: 1.5px;
            background: Theme.accent;
        }
    }
}

// Round, borderless button with an icon
export component IconButton inherits Rectangle {
    in property <image> icon;
    // What the button does, for screen readers (it shows only the icon)
    in property <string> label;
    in property <length> icon-size: 16px;
    in property <color> icon-color: Theme.text-secondary;
    in property <color> hover-color: Theme.text-primary;
    in property <bool> active: false;
    // Greyed out and not clickable, but keeps its place
    in property <bool> enabled: true;
    out property <bool> has-focus: focus.has-focus;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: self.height / 2;
    background: !root.enabled ? transparent
        : touch.pressed ? Theme.menu-hover
        : touch.has-hover ? Theme.menu-bar-hover
        : root.active ? Theme.accent-soft : transparent;
    animate background { duration: Theme.fast; }
    forward-focus: focus;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    Icon {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        colorize: !root.enabled ? Theme.disabled-text
            : root.active ? Theme.accent-text
            : touch.has-hover ? root.hover-color : root.icon-color;
        animate colorize { duration: Theme.fast; }
    }

    focus := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if focus.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

// Small uppercase accent heading inside a card
export component SectionHeader inherits Rectangle {
    in property <string> title;

    height: 26px;

    Text {
        x: 0;
        y: parent.height - self.height - 2px;
        text: root.title;
        color: Theme.accent-text;
        font-size: Theme.font-xs;
        font-weight: 600;
        letter-spacing: 1px;
    }
}

// Label and value on one line
export component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> label-width: 88px;
    // Let the value be selected and copied; long values scroll
    // sideways while selecting instead of eliding
    in property <bool> selectable: false;

    height: 22px;

    HorizontalLayout {
        spacing: 12px;

        Text {
            width: root.label-width;
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }

        if !root.selectable: Text {
            text: root.value;
            color: Theme.text-primary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.selectable: Rectangle {
            horizontal-stretch: 1;
            clip: true;

            TextInput {
                width: 100%;
                text: root.value;
                color: Theme.text-primary;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                read-only: true;
                single-line: true;
                selection-background-color: Theme.selection-bg;
                selection-foreground-color: Theme.selection-fg;
            }
        }
    }
}

export struct CreditLink {
    name: string,
    url: string,
}

// Label and a comma-separated list of links, e.g. credits
export component LinkRow inherits Rectangle {
    in property <string> label;
    in property <[CreditLink]> links;
    // Plain text after the links, e.g. a license
    in property <string> note;
    in property <length> label-width: 88px;
    callback open-url(string);

    height: 22px;

    HorizontalLayout {
        spacing: 12px;

        Text {
            width: root.label-width;
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;

            for link[i] in root.links: HorizontalLayout {
                Rectangle {
                    width: name.preferred-width;

                    accessible-role: button;
                    accessible-label: link.name;
                    accessible-description: link.url;
                    accessible-action-default => { root.open-url(link.url); }

                    name := Text {
                        text: link.name;
                        color: touch.has-hover ? Theme.accent-hover : Theme.accent-text;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    // Underline on hover (Text can't underline)
                    Rectangle {
                        y: parent.height / 2 + 7px;
                        height: 1px;
                        background: name.color;
                        visible: touch.has-hover;
                    }
                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-url(link.url); }
                    }

                    // Enter or Space opens the link
                    keys := ButtonKeys {
                        activated => { root.open-url(link.url); }
                    }

                    if keys.has-focus: FocusRing {
                        offset: 1px;
                        radius: Theme.radius-sm;
                    }
                }
                if i < root.links.length - 1: Text {
                    text: ", ";
                    color: Theme.text-primary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }
            }

            if root.note != "": Text {
                text: " " + root.note;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// Pill with short text; `tone` colors the text and a soft background
// Text helpers implemented in Rust
export global TextUtil {
    // The text with every digit replaced by the widest one ("4" in Inter).
    // Sizing a label to this keeps it from shifting as a counter ticks,
    // since Inter's digits have different widths.
    pure callback steady-digits(string) -> string;
}

export component Chip inherits Rectangle {
    in property <string> text;
    // Optional second part after the text, behind a centred "·" and laid
    // out on its own so digits changing in the text don't push it around
    // (e.g. a size after a timer)
    in property <string> detail;
    // Keep the width steady while digits in the text change (timers, sizes)
    in property <bool> steady: false;
    in property <color> tone: Theme.text-secondary;
    // Show a dot before the text (e.g. a live status)
    in property <bool> dot: false;
    // Optional icon before the text, in the chip's tone
    in property <image> icon;
    in property <bool> pulse: false;
    // Clickable chips get a pointer and a stronger background on hover
    in property <bool> clickable: false;
    // Shows a small x after the text: a click closes it
    in property <bool> closable: false;
    // Keep the full text while other chips in the row still have room to
    // give: those elide first (e.g. Playing and REC stay whole while a
    // Scheduler label shortens)
    in property <bool> keep: false;
    callback clicked();

    // Grows with its text but gives way (eliding) when space runs out
    preferred-width: row.preferred-width + 16px;
    max-width: self.preferred-width;
    min-width: 40px;
    horizontal-stretch: root.keep ? 0 : 1;
    height: 20px;
    border-radius: Theme.radius-sm;
    background: root.tone.with-alpha(root.clickable && touch.has-hover ? 0.26 : 0.14);
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }

    row := HorizontalLayout {
        x: 8px;
        width: parent.width - 16px;
        spacing: 5px;
        alignment: start;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                width: 11px;
                height: 11px;
                source: root.icon;
                colorize: root.tone;
            }
        }

        if root.dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.tone;
                opacity: root.pulse ? 0.45 + 0.55 * abs(sin(Motion.tick / Theme.pulse-period * 180deg)) : 1;
            }
        }

        // Text, separator and detail sit closer together than the dot
        HorizontalLayout {
            spacing: 3px;
            horizontal-stretch: 1;

            Text {
                text: root.text;
                color: root.tone;
                font-size: Theme.font-sm;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                // Sized from the measuring copies below, so it can still shrink
                // and elide when space runs out. With a detail, the text takes
                // its real width and the room kept for wider digits goes around
                // the separator instead.
                preferred-width: root.detail != "" ? plain-measure.preferred-width : measure.preferred-width;
            }

            // Separator between the text and the detail. Its box also holds the
            // room kept for wider digits, with the "·" centred in it, so the gaps
            // on both sides stay equal and the detail stays put.
            if root.detail != "": Rectangle {
                width: separator.preferred-width + root.digit-room;
                horizontal-stretch: 0;

                separator := Text {
                    text: "·";
                    color: root.tone;
                    font-size: Theme.font-sm;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            if root.detail != "": Text {
                text: root.detail;
                color: root.tone;
                font-size: Theme.font-sm;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                preferred-width: detail-measure.preferred-width;
            }
        }

        if root.closable: VerticalLayout {
            alignment: center;
            Icon {
                width: 8px;
                height: 8px;
                source: @image-url("icons/xmark.svg");
                colorize: root.tone;
            }
        }
    }

    // Measures the text, with its widest digits when steady (not shown)
    measure := Text {
        visible: false;
        text: root.steady ? TextUtil.steady-digits(root.text) : root.text;
        font-size: Theme.font-sm;
        font-weight: 600;
    }

    plain-measure := Text {
        visible: false;
        text: root.text;
        font-size: Theme.font-sm;
        font-weight: 600;
    }

    // Room the text keeps for wider digits than it shows now
    property <length> digit-room: max(0px, measure.preferred-width - plain-measure.preferred-width);

    detail-measure := Text {
        visible: false;
        text: root.steady ? TextUtil.steady-digits(root.detail) : root.detail;
        font-size: Theme.font-sm;
        font-weight: 600;
    }
}

// Form field: a small label above its input
export component Field inherits VerticalLayout {
    in property <string> label;
    // A field that must be filled in: its label is bold
    in property <bool> required: false;

    spacing: 6px;

    Text {
        text: root.label;
        color: root.required ? Theme.text-primary : Theme.text-secondary;
        font-size: Theme.font-md;
        font-weight: root.required ? 700 : 500;
    }

    @children
}

// Modal dialog: dimmed backdrop and a rounded card with an accent glow,
// a title and a close button. Use it as `if show-dialog: DialogShell { ... }`
// and put the content inside; Esc or a backdrop click raise close-requested.
export component DialogShell inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    // Optional image before the title (e.g. a flag)
    in property <image> icon;
    in property <length> card-width: Defaults.dialog-width;
    // Fixed card height; 0 sizes the card to its content
    in property <length> card-height: 0px;
    in property <bool> close-on-backdrop: true;
    in property <length> content-padding: 20px;
    // Take keyboard focus on open so Esc works. Turn off only when a child
    // input focuses itself on open (Esc then reaches the shell from the
    // input): with nothing focused, Esc does nothing.
    in property <bool> auto-focus: true;
    // Show a back arrow at the start of the title row
    in property <bool> show-back: false;
    callback close-requested();
    callback back-requested();

    // For a control that goes away while it has the focus: with nothing
    // focused, Esc would do nothing, so the dialog takes the focus back
    public function take-focus() {
        keys.focus();
    }

    // Drives the fade and slide-in when the dialog appears
    property <bool> shown: false;
    init => {
        self.shown = true;
        if self.auto-focus {
            keys.focus();
        }
    }

    width: 100%;
    height: 100%;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.normal; }

    Rectangle {
        background: Theme.scrim;
    }

    TouchArea {
        clicked => {
            if root.close-on-backdrop {
                root.close-requested();
            }
        }
    }

    // Tab stays inside the dialog: from the close button (the last stop)
    // it goes round to the first control, Shift+Tab from the first control
    // goes round to the close button. The dialog itself (focused on open)
    // is not a stop of its own.
    keys := FocusScope {
        focus-on-tab-navigation: false;
        // A backdrop click closes the dialog at once, rather than first
        // taking the focus from a text field
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-requested();
                return accept;
            }
            if event.text == Key.Tab && !event.modifiers.shift
                && (self.has-focus || close.has-focus) {
                // Slint's own Tab handling then moves on from the start
                head.focus();
                return reject;
            }
            if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift))
                && self.has-focus {
                close.focus();
                return accept;
            }
            return reject;
        }

        // Start of the dialog's Tab order; reached by Tab only going back
        // from the first control
        head := FocusScope {
            focus-on-click: false;
            focus-gained(reason) => {
                if reason == FocusReason.tab-navigation {
                    close.focus();
                }
            }
        }

        card := Rectangle {
            property <length> slide: root.shown ? 0px : 14px;
            animate slide { duration: Theme.normal; easing: ease-out; }

            width: min(root.card-width, root.width - 24px);
            height: min(root.height - 24px,
                root.card-height > 0 ? root.card-height : layout.preferred-height);
            x: (root.width - self.width) / 2;
            y: max(12px, (root.height - self.height) / 2) + self.slide;
            background: Theme.card;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.shadow;
            clip: true;

            // Swallow clicks so they don't reach the backdrop
            TouchArea {}

            // Accent glow at the top
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 110px;
                visible: Theme.panel-gradient;
                background: @linear-gradient(180deg, Theme.accent-glow 0%, Theme.accent.with-alpha(0) 100%);
            }

            layout := VerticalLayout {
                padding: root.content-padding;
                spacing: 14px;

                if root.title != "": HorizontalLayout {
                    spacing: 10px;
                    padding-right: 32px;

                    if root.show-back: VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("icons/chevron-left.svg");
                            label: "Back";
                            icon-size: 16px;
                            clicked => { root.back-requested(); }
                        }
                    }

                    if root.icon.width > 0: VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.icon;
                            width: 26px;
                            height: 20px;
                            image-fit: contain;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: root.title;
                            color: Theme.text-primary;
                            font-size: Theme.font-title;
                            font-weight: 600;
                            overflow: elide;
                        }

                        if root.subtitle != "": Text {
                            text: root.subtitle;
                            color: Theme.text-secondary;
                            font-size: Theme.font-sm;
                            overflow: elide;
                        }
                    }
                }

                @children
            }

            // Close button, top right
            close := IconButton {
                x: parent.width - self.width - 12px;
                y: 12px;
                icon: @image-url("icons/xmark.svg");
                label: "Close";
                icon-size: 12px;
                clicked => { root.close-requested(); }
            }
        }
    }
}

// On/off switch
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    // Greyed out and not clickable; keeps showing its state
    in property <bool> enabled: true;
    callback toggled(bool);
    // Dark knob in the dark theme (like the volume knob), white in the light
    // one. Off in the dark theme: an outlined track with a smaller grey knob,
    // so it doesn't vanish into the panel
    property <bool> dark-off: Theme.dark-mode && !root.checked;

    width: row.preferred-width;
    height: 28px;
    opacity: root.enabled ? 1 : 0.45;
    animate opacity { duration: Theme.fast; }
    forward-focus: focus;

    accessible-role: switch;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.flip(); }

    function flip() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.flip(); }
    }

    focus := ButtonKeys {
        enabled: root.enabled;
        activated => { root.flip(); }
    }

    row := HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 36px;
                height: 20px;
                border-radius: 10px;
                background: root.checked ? Theme.accent : Theme.dark-mode ? Theme.elevated : Theme.disabled-bg;
                border-width: root.dark-off ? 1.5px : 0;
                border-color: Theme.text-tertiary;
                animate background { duration: Theme.normal; }

                if focus.has-focus: FocusRing {
                    radius: parent.border-radius;
                }

                Rectangle {
                    property <length> size: root.dark-off ? 10px : 14px;
                    animate size { duration: Theme.normal; easing: ease-out; }
                    x: root.checked ? parent.width - self.width - 3px : (parent.height - self.height) / 2;
                    animate x { duration: Theme.normal; easing: ease-out; }
                    y: (parent.height - self.height) / 2;
                    width: self.size;
                    height: self.size;
                    border-radius: self.size / 2;
                    background: !Theme.dark-mode ? #ffffff : root.checked ? Theme.panel : Theme.text-tertiary;
                    animate background { duration: Theme.normal; }
                    drop-shadow-blur: Theme.dark-mode ? 0 : 3px;
                    drop-shadow-color: #00000040;
                }
            }
        }

        if root.label != "": Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.font-base;
            vertical-alignment: center;
            // Read as the switch's name
            accessible-role: none;
        }
    }
}

// Small ⓘ that shows a line of help in a bubble above it: after a short
// hover, or on tap (touch screens have no hover). Keeps help text out of
// the layout. The bubble opens upward, over what comes before it.
export component InfoTip inherits Rectangle {
    in property <string> text;

    property <bool> open: false;
    // The press came from a touch screen, which leaves hover as the finger
    // lifts: a tap keeps the bubble open until the next tap
    property <bool> touch-press: false;

    width: 18px;
    height: 18px;
    border-radius: self.width / 2;

    accessible-role: button;
    accessible-label: "More information";
    accessible-description: root.text;
    accessible-action-default => { root.open = !root.open; }

    Icon {
        x: 1px;
        y: 1px;
        width: 16px;
        height: 16px;
        source: @image-url("icons/circle-info.svg");
        colorize: touch.has-hover || root.open ? Theme.text-primary : Theme.text-tertiary;
    }

    // Space or Enter shows or hides the bubble; it hides when the focus moves on
    keys := ButtonKeys {
        activated => { root.open = !root.open; }
        focus-lost => { root.open = false; }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }

    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.touch-press = e.touch-finger-id != 0;
            }
        }
        clicked => {
            delay.running = false;
            root.open = !root.open;
        }
        changed has-hover => {
            delay.running = self.has-hover && !root.open;
            if !self.has-hover && !root.touch-press {
                root.open = false;
            }
        }
    }

    delay := Timer {
        interval: Defaults.hover-delay;
        running: false;
        triggered => {
            self.running = false;
            root.open = true;
        }
    }

    // Same style as the other hover bubbles
    PopupCard {
        visible: self.opacity > 0;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: Theme.fast; }
        width: Defaults.info-tip-width;
        height: tip-layout.preferred-height;
        x: root.width - self.width;
        y: -self.height - 6px;

        tip-layout := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;

            Text {
                text: root.text;
                font-size: Theme.font-md;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
        }
    }
}

// How many agents use the player; hovering lists them in an AgentsBubble.
// The window draws the bubble (over the header under the menu bar), at the
// chip's right edge: a popup would take the mouse and close it on any move.
export component AgentsChip inherits Rectangle {
    in property <int> count;
    // Show the bubble with its top right corner here (window coordinates),
    // or hide it
    callback show-bubble(/* right */ length, /* top */ length);
    callback hide-bubble();

    width: row.preferred-width + 14px;
    height: 20px;
    border-radius: Theme.radius-sm;
    background: Theme.accent-text.with-alpha(0.14);

    touch := TouchArea {
        changed has-hover => {
            delay.running = self.has-hover;
            if !self.has-hover {
                root.hide-bubble();
            }
        }
    }

    delay := Timer {
        interval: Defaults.hover-delay;
        running: false;
        triggered => {
            self.running = false;
            root.show-bubble(root.absolute-position.x + root.width, root.absolute-position.y + root.height + 6px);
        }
    }

    row := HorizontalLayout {
        x: 7px;
        spacing: 4px;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 11px;
                height: 11px;
                source: @image-url("icons/robot.svg");
                colorize: Theme.accent-text;
            }
        }
        Text {
            text: root.count;
            color: Theme.accent-text;
            font-size: Theme.font-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// One agent in the agents bubble
export struct AgentRow {
    name: string,
    // "This computer" or the address it calls from
    place: string,
    // Over the network (an agent on this computer may use it too)
    network: bool,
    // "connected", or when a network agent without an open connection
    // last called: "just now", "4 min ago"
    seen: string,
    connected: bool,
}

// The agents chip's list, in the same style as the other hover bubbles:
// a caption, then one row per agent with where it calls from and whether
// it is connected or when it last called
export component AgentsBubble inherits PopupCard {
    in property <[AgentRow]> agents;

    width: max(Defaults.info-tip-width, bubble.preferred-width);
    height: bubble.preferred-height;

    bubble := VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 10px;
        spacing: 6px;

        Text {
            text: root.agents.length == 1 ? "AGENT USING THE PLAYER" : "AGENTS USING THE PLAYER";
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        GridLayout {
            spacing-horizontal: 8px;
            spacing-vertical: 5px;

            for agent in root.agents: Row {
                VerticalLayout {
                    alignment: center;
                    Icon {
                        width: 13px;
                        height: 13px;
                        source: agent.network ? @image-url("icons/network-wired.svg") : @image-url("icons/desktop.svg");
                        colorize: agent.connected ? Theme.accent-text : Theme.text-tertiary;
                    }
                }
                Text {
                    text: agent.name;
                    color: Theme.text-primary;
                    font-size: Theme.font-md;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    min-width: self.preferred-width;
                    text: agent.place;
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Text {
                    min-width: self.preferred-width;
                    text: agent.seen;
                    color: agent.connected ? Theme.accent-text : Theme.text-tertiary;
                    font-size: Theme.font-sm;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// One choice in a dropdown's list, with the menus' tick when picked
component DropdownItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 28px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.menu-hover : transparent;
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: touch.has-hover ? Theme.text-primary : Theme.menu-text;
            font-size: Theme.font-md;
            vertical-alignment: center;
        }
        Rectangle {
            width: 12px;
            if root.selected: Icon {
                width: 12px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                source: @image-url("icons/tick.svg");
                colorize: Theme.accent;
            }
        }
    }
}

// A dropdown like the EQ presets: a closed field showing the pick, and
// the list in a popup (Agents dialog, recording bitrate)
export component Dropdown inherits Rectangle {
    in property <[string]> items;
    in-out property <int> selected;
    in property <bool> enabled: true;
    callback changed(int);

    // As tall as CopyLine and the buttons, so a row lines up
    height: 34px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.hairline;
    background: root.enabled && touch.has-hover ? Theme.menu-hover : Theme.elevated;
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { popup.show(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        Text {
            text: root.items[root.selected];
            color: root.enabled ? Theme.text-primary : Theme.disabled-text;
            font-size: Theme.font-md;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // Chevron, as on the EQ preset list
        Rectangle {
            width: 14px;
            Text {
                text: "\u{2304}";
                color: root.enabled ? Theme.text-secondary : Theme.disabled-text;
                font-size: Theme.font-lg;
                y: (parent.height - self.preferred-height) / 2 - 2px;
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;

        PopupCard {
            VerticalLayout {
                padding: 4px;
                for label[index] in root.items: DropdownItem {
                    label: label;
                    selected: index == root.selected;
                    // Picks before closing: the list's rows (and their
                    // index) go away with the popup
                    clicked => {
                        if root.selected != index {
                            root.selected = index;
                            root.changed(index);
                        }
                        popup.close();
                    }
                }
            }
        }
    }
}

// One option of a Picker
export component PickerOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <length> option-width: 56px;
    // Optional icon before the label, red for a recording's dot
    in property <image> icon;
    in property <bool> red-icon: false;
    callback clicked();

    min-width: root.option-width;
    height: 30px;
    border-radius: Theme.radius-sm;
    background: root.selected && root.enabled ? Theme.accent
        : root.selected ? Theme.disabled-bg
        : touch.has-hover ? Theme.menu-hover
        : transparent;
    animate background { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: root.icon.width > 0 ? 8px : 0px;
        padding-right: root.icon.width > 0 ? 10px : 0px;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                width: 11px;
                height: 11px;
                source: root.icon;
                colorize: !root.enabled ? Theme.disabled-text
                    : root.red-icon ? Theme.danger
                    : root.selected ? Theme.on-accent : Theme.text-primary;
            }
        }

        Text {
            text: root.label;
            color: !root.enabled ? Theme.disabled-text
                : root.selected ? Theme.on-accent : Theme.text-primary;
            font-size: Theme.font-base;
            font-weight: root.selected ? 600 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

export struct PickerChoice {
    id: string,
    label: string,
    // Optional icon before the label
    icon: image,
    red-icon: bool,
    // Greyed out while the rest can be picked
    disabled: bool,
}

// A row of options, one selected
export component Picker inherits HorizontalLayout {
    in property <[PickerChoice]> choices;
    in-out property <string> selected;
    in property <bool> enabled: true;
    in property <length> option-width: 56px;
    callback changed(string);

    alignment: start;

    Rectangle {
        background: Theme.elevated;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.hairline;
        width: row.preferred-width;
        height: row.preferred-height;

        row := HorizontalLayout {
            padding: 3px;
            spacing: 3px;

            for choice in root.choices: PickerOption {
                label: choice.label;
                icon: choice.icon;
                red-icon: choice.red-icon && root.selected != choice.id;
                selected: root.selected == choice.id;
                enabled: root.enabled && !choice.disabled;
                option-width: root.option-width;
                clicked => {
                    if root.selected != choice.id {
                        root.selected = choice.id;
                        root.changed(choice.id);
                    }
                }
            }
        }
    }
}
