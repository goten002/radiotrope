// WiFi settings for the Raspberry Pi build (`embedded` feature).
// build.rs maps `@platform` to this folder or to ../desktop.
export global Platform {
    // The Tools menu offers WiFi settings
    out property <bool> has-wifi: true;
    // No folder picker or file manager on the kiosk
    out property <bool> has-file-manager: false;
    // Full screen on the Pi: no title bar or window buttons
    out property <bool> has-window-frame: false;
}

export { WifiSettingsDialog, WifiNetworkEntry } from "../../dialogs/wifi-settings.slint";
