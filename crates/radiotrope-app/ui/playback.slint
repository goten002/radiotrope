import { Theme } from "theme.slint";
import { Visualization } from "visualization.slint";
import { Chip, IconButton, Icon } from "components.slint";

export component Playback inherits Rectangle {
    in property <string> station-name;
    in property <string> codec-info;
    in property <string> status-text;
    // Time on the current station, shown in the chip while playing
    in property <string> playtime;
    in property <bool> is-loading;
    in property <bool> is-error;
    in property <image> station-logo;
    in property <bool> is-station-favorited;
    in property <bool> has-station;
    // Recording: "12:34 · 11.8 MB" while recording, and a short message
    // after a recording ends or fails
    in property <bool> is-recording;
    in property <string> recording-text;
    in property <string> recording-notice;
    in property <bool> recording-notice-error;
    callback toggle-favorite();
    in-out property <string> viz-mode: "mirror";

    height: 108px;
    // No background of its own: it sits on the header (app.slint), which
    // draws the panel colour and the accent glow behind the menu bar too

    // 1px bottom separator — shadow edge casting onto favorites
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }

    HorizontalLayout {
        padding: 14px;
        padding-left: 16px;
        spacing: 14px;
        alignment: stretch;

        // Station logo / placeholder
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 76px;
                height: 76px;
                background: Theme.elevated;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.hairline;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: Theme.shadow-soft;
                clip: true;

                if root.station-logo.width > 0: Image {
                    source: root.station-logo;
                    width: 76px;
                    height: 76px;
                    image-fit: contain;
                }

                if root.station-logo.width == 0: Icon {
                    source: @image-url("icons/music-note.svg");
                    width: 30px;
                    height: 30px;
                    colorize: Theme.accent;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Station info (center, stretches)
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 5px;

            Text {
                text: root.station-name;
                color: Theme.text-primary;
                font-size: 18px;
                font-weight: 600;
                overflow: elide;
            }

            if root.codec-info != "": Text {
                text: root.codec-info;
                color: Theme.text-secondary;
                font-size: 12px;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 6px;

                Chip {
                    text: root.status-text == "Playing" && root.playtime != "--" && root.playtime != ""
                        ? "Playing " + root.playtime : root.status-text;
                    tone: root.is-error ? Theme.danger : Theme.accent-text;
                    dot: true;
                    pulse: root.status-text == "Playing" || root.is-loading;
                }

                // Recording progress, or what happened to the last recording
                if root.is-recording || root.recording-notice != "": Chip {
                    text: root.is-recording ? "REC " + root.recording-text : root.recording-notice;
                    tone: root.is-recording || root.recording-notice-error ? Theme.danger : Theme.text-secondary;
                    dot: root.is-recording;
                    pulse: root.is-recording;
                }

                // Takes the spare width, so a long status elides in the chip
                // instead of capping the whole column
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Star (favorite) button
        if root.has-station: VerticalLayout {
            alignment: center;
            IconButton {
                width: 36px;
                height: 36px;
                icon: @image-url("icons/star.svg");
                icon-size: 20px;
                active: root.is-station-favorited;
                clicked => { root.toggle-favorite(); }
            }
        }

        // Visualization tile
        VerticalLayout {
            alignment: center;
            viz := Visualization {
                viz-mode <=> root.viz-mode;
                is-loading: root.is-loading;
            }
        }
    }
}
