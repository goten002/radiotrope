import { Theme, Defaults } from "defaults.slint";
import { Visualization } from "visualization.slint";
import { Chip, IconButton, Icon } from "components.slint";
import { LogoFog, LogoFogLayer } from "logo-fog.slint";

// How many agents use the player; hovering (or a tap) lists them in a
// bubble above, a click opens the Agents dialog
component AgentsChip inherits Rectangle {
    in property <int> count;
    in property <string> list;
    callback clicked();

    property <bool> open: false;

    width: row.preferred-width + 14px;
    height: 20px;
    border-radius: Theme.radius-sm;
    background: Theme.accent-text.with-alpha(touch.has-hover ? 0.26 : 0.14);
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            delay.running = false;
            root.open = false;
            root.clicked();
        }
        changed has-hover => {
            delay.running = self.has-hover;
            if !self.has-hover {
                root.open = false;
            }
        }
    }

    delay := Timer {
        interval: Defaults.hover-delay;
        running: false;
        triggered => {
            self.running = false;
            root.open = true;
        }
    }

    row := HorizontalLayout {
        x: 7px;
        spacing: 4px;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 11px;
                height: 11px;
                source: @image-url("icons/link.svg");
                colorize: Theme.accent-text;
            }
        }
        Text {
            text: root.count;
            color: Theme.accent-text;
            font-size: Theme.font-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    // Same style as the other hover bubbles
    Rectangle {
        visible: self.opacity > 0;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: Theme.fast; }
        x: 0;
        y: -self.height - 6px;
        width: max(Defaults.info-tip-width, bubble.preferred-width);
        height: bubble.preferred-height;
        background: Theme.popup-bg;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.hairline;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: Theme.shadow-soft;

        bubble := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 3px;

            Text {
                text: root.count == 1 ? "1 agent is using the player" : root.count + " agents are using the player";
                font-size: Theme.font-md;
                font-weight: 600;
                color: Theme.text-primary;
            }
            Text {
                text: root.list;
                font-size: Theme.font-md;
                color: Theme.text-secondary;
            }
        }
    }
}

export component Playback inherits Rectangle {
    in property <string> station-name;
    in property <string> codec-info;
    in property <string> status-text;
    // Time on the current station, shown in the chip while playing
    in property <string> playtime;
    in property <bool> is-loading;
    in property <bool> is-error;
    in property <image> station-logo;
    // Colour fog behind a logo that would vanish on the tile
    in property <LogoFog> station-logo-fog;
    in property <bool> is-station-favorited;
    in property <bool> has-station;
    // Recording: "12:34 · 11.8 MB" while recording, and a short message
    // after a recording ends or fails
    in property <bool> is-recording;
    // Recording time and file size, shown apart so the size stays put
    in property <string> recording-text;
    in property <string> recording-size;
    in property <string> recording-notice;
    in property <bool> recording-notice-error;
    // A "Saved ..." notice opens the recordings folder when clicked
    in property <bool> can-open-recordings;
    callback open-recordings-folder();
    callback toggle-favorite();
    in-out property <string> viz-mode: "wave";
    // Off (View > Visualizer), the tile is left out of the header
    in-out property <bool> show-visualizer: true;
    // Agents (MCP) using the player now, and one line about each
    in property <int> agent-count;
    in property <string> agent-list;
    callback open-agents();

    height: 108px;
    // No background of its own: it sits on the header (app.slint), which
    // draws the panel colour and the accent glow behind the menu bar too

    // 1px bottom separator — shadow edge casting onto favorites
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }

    HorizontalLayout {
        padding: 14px;
        padding-left: 16px;
        spacing: 14px;
        alignment: stretch;

        // Station logo / placeholder
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 76px;
                height: 76px;
                background: Theme.elevated;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.hairline;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: Theme.shadow-soft;
                clip: true;

                if root.station-logo.width > 0: LogoFogLayer {
                    fog: root.station-logo-fog;
                }

                if root.station-logo.width > 0: Image {
                    source: root.station-logo;
                    width: 76px;
                    height: 76px;
                    image-fit: contain;
                }

                if root.station-logo.width == 0: Icon {
                    source: @image-url("icons/radio.svg");
                    width: 30px;
                    height: 30px;
                    colorize: Theme.accent;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Station info (center, stretches)
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 5px;

            Text {
                text: root.station-name;
                color: Theme.text-primary;
                font-size: Theme.font-station;
                font-weight: 600;
                overflow: elide;
            }

            if root.codec-info != "": Text {
                text: root.codec-info;
                color: Theme.text-secondary;
                font-size: Theme.font-md;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 6px;

                Chip {
                    text: root.status-text == "Playing" && root.playtime != "--" && root.playtime != ""
                        ? "Playing " + root.playtime : root.status-text;
                    tone: root.is-error ? Theme.danger : Theme.accent-text;
                    dot: true;
                    pulse: root.status-text == "Playing" || root.is-loading;
                    steady: true;
                }

                // Recording progress, or what happened to the last recording
                if root.is-recording || root.recording-notice != "": Chip {
                    text: root.is-recording ? "REC " + root.recording-text : root.recording-notice;
                    detail: root.is-recording ? root.recording-size : "";
                    tone: root.is-recording || root.recording-notice-error ? Theme.danger : Theme.text-secondary;
                    dot: root.is-recording;
                    pulse: root.is-recording;
                    steady: root.is-recording;
                    clickable: !root.is-recording && !root.recording-notice-error && root.can-open-recordings;
                    clicked => { root.open-recordings-folder(); }
                }

                // Shown only while agents use the player
                if root.agent-count > 0: AgentsChip {
                    count: root.agent-count;
                    list: root.agent-list;
                    clicked => { root.open-agents(); }
                }

                // Takes the spare width, so a long status elides in the chip
                // instead of capping the whole column
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Star (favorite) button
        if root.has-station: VerticalLayout {
            alignment: center;
            IconButton {
                width: 36px;
                height: 36px;
                icon: @image-url("icons/star.svg");
                icon-size: 20px;
                active: root.is-station-favorited;
                clicked => { root.toggle-favorite(); }
            }
        }

        // Visualization tile
        if root.show-visualizer: VerticalLayout {
            alignment: center;
            viz := Visualization {
                viz-mode <=> root.viz-mode;
                is-loading: root.is-loading;
            }
        }
    }
}
