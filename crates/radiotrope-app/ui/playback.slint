import { Theme, Defaults } from "defaults.slint";
import { Visualization } from "visualization.slint";
import { Chip, ChipVariant, IconButton, Icon, PopupCard } from "components.slint";

// A chip of the status row that can show its whole text in a bubble: it
// says when the pointer is on it and whether its text is cut. It takes the
// chip's place in the row (same widths, same giving way).
component RowChip inherits TouchArea {
    in property <string> text;
    in property <ChipVariant> variant: ChipVariant.neutral;
    in property <image> icon;
    in property <bool> dot: false;
    in property <bool> pulse: false;
    in property <bool> steady: false;
    in property <bool> keep: false;
    in property <bool> clickable: false;
    in property <bool> closable: false;
    // What a screen reader is told when it changes ("" for nothing). The
    // status passes its text without the running time, which changes every
    // second.
    in property <string> spoken;
    // Said at once, over what is being read (an error)
    in property <bool> urgent: false;
    // The text doesn't fit and ends in "…"
    out property <bool> cut: chip.width + 0.5px < chip.preferred-width;
    // The chip has the keyboard focus (one that is a button)
    out property <bool> focused: chip.has-focus;
    // A click on a chip that is a button
    callback pressed-chip();

    preferred-width: chip.preferred-width;
    max-width: chip.preferred-width;
    min-width: 40px;
    horizontal-stretch: root.keep ? 0 : 1;
    height: chip.height;

    chip := Chip {
        width: 100%;
        text: root.text;
        variant: root.variant;
        icon: root.icon;
        dot: root.dot;
        pulse: root.pulse;
        steady: root.steady;
        keep: root.keep;
        clickable: root.clickable;
        closable: root.closable;
        // `spoken` below is what a screen reader hears
        silent: root.spoken != "";
        clicked => { root.pressed-chip(); }
    }

    if root.spoken != "": Rectangle {
        accessible-role: AccessibleRole.text;
        accessible-label: root.spoken;
        accessible-live-region: root.urgent ? assertive : polite;
    }
}

export component Playback inherits Rectangle {
    in property <string> station-name;
    in property <string> codec-info;
    // Shown in the codec line's place while there is no live codec info
    in property <string> station-country;
    in property <string> status-text;
    // Time on the current station, shown in the chip while playing
    in property <string> playtime;
    in property <bool> is-playing;
    in property <bool> is-loading;
    in property <bool> is-error;
    in property <image> station-logo;
    in property <bool> is-station-favorited;
    in property <bool> has-station;
    // Recording: "12:34 · 11.8 MB" while recording, and a short message
    // after a recording ends or fails
    in property <bool> is-recording;
    // Recording time and file size, shown apart so the size stays put
    in property <string> recording-text;
    in property <string> recording-size;
    // What happened while nobody may have been watching: a recording saved
    // or failed, a scheduled entry missed ("" for none)
    in property <string> recording-notice;
    // What the notice is about, for its icon and what a click does: "saved"
    // opens the recordings folder, "scheduler" the Scheduler, "sleep" the
    // Sleep Timer, and "error" only closes
    in property <string> recording-notice-kind;
    // The notice stays until it is clicked away (errors and missed entries)
    in property <bool> recording-notice-stays;
    callback recording-notice-dismiss();
    // A "Saved ..." notice opens the recordings folder when clicked
    in property <bool> can-open-recordings;
    callback open-recordings-folder();
    // The favorites or the settings can't be saved ("" once a save works)
    in property <string> save-error;
    // The REC chip stops the recording on a second press
    callback stop-recording();
    // Time left on the Sleep Timer, "23:12" ("" when none runs)
    in property <string> sleep-left;
    // The Scheduler's label around an entry's start ("" when none), and
    // whether it is for the fallback sound
    in property <string> schedule-label;
    in property <bool> schedule-label-bell;
    // The label tells what just happened, and a click closes it
    in property <bool> schedule-label-closable;
    callback schedule-label-dismiss();
    callback open-sleep-timer();
    callback open-schedule();
    callback toggle-favorite();
    in-out property <string> viz-mode: "wave";
    // Off (View > Visualizer), the tile is left out of the header
    in-out property <bool> show-visualizer: true;
    // Off while a dialog is open: the visualizer tile leaves the Tab order
    // (the window ignores keys behind a dialog; see app.slint)
    in property <bool> enabled: true;

    // Headless capture: "recording-confirm" arms the REC chip, "viz-name"
    // shows the visualizer style's name, "chip-bubble" shows the full text
    // of the chip under the pointer without the wait
    in property <string> snapshot-overlay;

    property <image> empty-image;
    // The REC chip was pressed once and waits for a second press to stop
    property <bool> confirm-stop-recording: false;
    changed is-recording => { root.confirm-stop-recording = false; }
    property <bool> stop-armed: root.is-recording
        && (root.confirm-stop-recording || root.snapshot-overlay == "recording-confirm");

    // The full text of a cut chip shows in a bubble above it, like the
    // title's in the bottom bar: after the pointer rests on the chip, or on
    // a tap where there is no pointer (a chip that isn't a button).
    // The chip: 0 none, 1 the status, 2 the notice, 3 the save error.
    property <int> hovered-chip: 0;
    property <int> pinned-chip: 0;
    property <bool> hover-ready: false;
    property <length> bubble-x;
    property <length> bubble-bottom;
    property <int> bubble-chip: root.pinned-chip != 0 ? root.pinned-chip
        : root.hover-ready || root.snapshot-overlay == "chip-bubble" ? root.hovered-chip : 0;
    property <string> bubble-text: root.bubble-chip == 1 ? root.status-text
        : root.bubble-chip == 2 ? root.recording-notice
        : root.bubble-chip == 3 ? root.save-error : "";
    // A text that changes takes its bubble down. The notice and the save
    // error can go away under the pointer, without telling that it left.
    changed status-text => { if root.pinned-chip == 1 { root.pinned-chip = 0; } }
    changed recording-notice => { root.chip-gone(2); }
    changed save-error => { root.chip-gone(3); }

    function chip-gone(chip: int) {
        if root.pinned-chip == chip {
            root.pinned-chip = 0;
        }
        if root.hovered-chip == chip {
            root.hovered-chip = 0;
            root.hover-ready = false;
        }
    }

    // The pointer came onto a cut chip (at `x`, `y` in the window) or left it
    function chip-hovered(chip: int, on: bool, x: length, y: length) {
        if on {
            root.hovered-chip = chip;
            root.bubble-x = x - root.absolute-position.x;
            root.bubble-bottom = y - root.absolute-position.y;
        } else if root.hovered-chip == chip {
            root.hovered-chip = 0;
            root.hover-ready = false;
        }
    }

    // A tap on a cut chip that isn't a button shows its text until the next
    function chip-tapped(chip: int, cut: bool, x: length, y: length) {
        if root.pinned-chip == chip || !cut {
            root.pinned-chip = 0;
        } else {
            root.pinned-chip = chip;
            root.bubble-x = x - root.absolute-position.x;
            root.bubble-bottom = y - root.absolute-position.y;
        }
    }

    hover-timer := Timer {
        interval: Defaults.hover-delay;
        running: root.hovered-chip != 0 && !root.hover-ready;
        triggered => { root.hover-ready = true; }
    }

    // Disarms the REC chip when no second press follows
    disarm-timer := Timer {
        interval: 4s;
        running: root.confirm-stop-recording;
        triggered => { root.confirm-stop-recording = false; }
    }

    height: 108px;
    // No background of its own: it sits on the header (app.slint), which
    // draws the panel colour and the accent glow behind the menu bar too

    // 1px bottom separator — shadow edge casting onto favorites
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }

    HorizontalLayout {
        padding: Theme.space-12;
        padding-left: Theme.space-16;
        spacing: Theme.space-16;
        alignment: stretch;

        // Station logo / placeholder
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 76px;
                height: 76px;
                background: Theme.elevated;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.hairline;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: Theme.shadow-soft;
                clip: true;

                if root.station-logo.width > 0: Image {
                    source: root.station-logo;
                    width: 76px;
                    height: 76px;
                    image-fit: contain;
                    // Decoration: the station name is the text beside it
                    accessible-role: none;
                }

                if root.station-logo.width == 0: Icon {
                    source: @image-url("icons/radio.svg");
                    width: 30px;
                    height: 30px;
                    colorize: Theme.accent;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Station info (center, stretches)
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.space-6;

            Text {
                text: root.station-name;
                color: Theme.text-primary;
                font-size: Theme.font-station;
                font-weight: Theme.weight-semibold;
                overflow: elide;
            }

            // The live codec line, or the station's country until there is one
            Text {
                text: root.codec-info != "" ? root.codec-info
                    : root.station-country != "" ? root.station-country : " ";
                color: root.codec-info != "" ? Theme.text-secondary : Theme.text-tertiary;
                font-size: Theme.font-md;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: Theme.space-6;

                // Grey for Ready and Stopped, accent and pulsing while connecting
                // or playing, red for errors. The state comes from the player's
                // flags, never from the wording of the status text.
                status-chip := RowChip {
                    text: root.is-playing && root.playtime != "—" && root.playtime != ""
                        ? root.status-text + " " + root.playtime : root.status-text;
                    variant: root.is-error ? ChipVariant.danger
                        : self.pulse ? ChipVariant.accent : ChipVariant.neutral;
                    dot: true;
                    pulse: !root.is-error && (root.is-playing || root.is-loading);
                    steady: true;
                    // A long error may shorten like the others
                    keep: !root.is-error;
                    // Without the time on the station
                    spoken: root.status-text;
                    changed has-hover => {
                        root.chip-hovered(1, self.has-hover && self.cut, self.absolute-position.x, self.absolute-position.y);
                    }
                    clicked => {
                        root.chip-tapped(1, self.cut, self.absolute-position.x, self.absolute-position.y);
                    }
                }

                // Recording progress. A press asks to confirm, the second stops it.
                if root.is-recording: Chip {
                    text: root.stop-armed ? "Press Again to Stop" : "REC " + root.recording-text;
                    detail: !root.stop-armed ? root.recording-size : "";
                    variant: ChipVariant.danger;
                    dot: true;
                    pulse: true;
                    steady: true;
                    keep: true;
                    clickable: true;
                    clicked => {
                        if root.confirm-stop-recording {
                            root.confirm-stop-recording = false;
                            root.stop-recording();
                        } else {
                            root.confirm-stop-recording = true;
                        }
                    }
                }

                // A save that failed: it stays until a save works again
                if root.save-error != "": RowChip {
                    text: root.save-error;
                    variant: ChipVariant.danger;
                    icon: @image-url("icons/circle-alert.svg");
                    spoken: root.save-error;
                    urgent: true;
                    changed has-hover => {
                        root.chip-hovered(3, self.has-hover && self.cut, self.absolute-position.x, self.absolute-position.y);
                    }
                    clicked => {
                        root.chip-tapped(3, self.cut, self.absolute-position.x, self.absolute-position.y);
                    }
                }

                // What happened to a recording or a scheduled entry. Only a
                // saved recording has the record icon and opens the folder;
                // the Scheduler's and the Sleep Timer's news open those. One
                // that stays has an x, and the click closes it.
                if root.recording-notice != "": RowChip {
                    property <bool> is-error: root.recording-notice-kind == "error";
                    text: root.recording-notice;
                    variant: self.is-error ? ChipVariant.danger : ChipVariant.neutral;
                    icon: self.is-error ? @image-url("icons/circle-alert.svg")
                        : root.recording-notice-kind == "scheduler" ? @image-url("icons/calendar.svg")
                        : root.recording-notice-kind == "sleep" ? @image-url("icons/moon.svg")
                        : @image-url("icons/record.svg");
                    closable: root.recording-notice-stays;
                    clickable: root.recording-notice-stays
                        || root.recording-notice-kind == "scheduler"
                        || root.recording-notice-kind == "sleep"
                        || (root.recording-notice-kind == "saved" && root.can-open-recordings);
                    spoken: root.recording-notice;
                    urgent: self.is-error;
                    changed has-hover => {
                        root.chip-hovered(2, (self.has-hover || self.focused) && self.cut, self.absolute-position.x, self.absolute-position.y);
                    }
                    // Reached with Tab: the whole text shows as on hover
                    changed focused => {
                        root.chip-hovered(2, (self.focused || self.has-hover) && self.cut, self.absolute-position.x, self.absolute-position.y);
                    }
                    pressed-chip => {
                        if root.recording-notice-kind == "saved" {
                            root.open-recordings-folder();
                        } else if root.recording-notice-kind == "sleep" {
                            root.open-sleep-timer();
                        } else if root.recording-notice-kind == "scheduler" {
                            // Its row there says how the entry's last run went
                            root.open-schedule();
                        }
                        if root.recording-notice-stays {
                            root.recording-notice-dismiss();
                        }
                    }
                }

                if root.sleep-left != "": Chip {
                    text: "Sleep " + root.sleep-left;
                    icon: @image-url("icons/moon.svg");
                    steady: true;
                    keep: true;
                    clickable: true;
                    clicked => { root.open-sleep-timer(); }
                }

                if root.schedule-label != "": Chip {
                    text: root.schedule-label;
                    icon: root.schedule-label-bell ? @image-url("icons/bell.svg") : @image-url("icons/calendar.svg");
                    steady: true;
                    clickable: true;
                    // After an entry started it is only news: a click closes it
                    closable: root.schedule-label-closable;
                    clicked => {
                        if root.schedule-label-closable {
                            root.schedule-label-dismiss();
                        } else {
                            root.open-schedule();
                        }
                    }
                }

                // Takes the spare width, so a long status elides in the chip
                // instead of capping the whole column
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Star (favorite) button
        if root.has-station: VerticalLayout {
            alignment: center;
            IconButton {
                width: Theme.control-field;
                height: Theme.control-field;
                // Outline when not a favorite, filled when it is, in the same
                // colour as the star in Search
                icon: root.is-station-favorited ? @image-url("icons/star.svg")
                    : @image-url("icons/star-regular.svg");
                label: root.is-station-favorited ? "Remove from Favorites" : "Add to Favorites";
                icon-size: Theme.icon-lg;
                icon-color: root.is-station-favorited ? Theme.selection-mark : Theme.text-secondary;
                hover-color: root.is-station-favorited ? Theme.selection-mark : Theme.text-primary;
                clicked => { root.toggle-favorite(); }
            }
        }

        // Visualization tile
        if root.show-visualizer && root.has-station: VerticalLayout {
            alignment: center;
            viz := Visualization {
                viz-mode <=> root.viz-mode;
                is-loading: root.is-loading;
                enabled: root.enabled;
                snapshot-name: root.snapshot-overlay == "viz-name";
            }
        }
    }

    // Full text above a cut-off chip, styled like the title's bubble
    chip-bubble := PopupCard {
        property <bool> shown: root.bubble-chip != 0 && root.bubble-text != "";
        visible: self.opacity > 0;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.fast; }
        width: min(bubble-layout.preferred-width, root.width - 2 * Theme.space-12);
        height: bubble-layout.preferred-height;
        x: max(Theme.space-12, min(root.bubble-x, root.width - self.width - Theme.space-12));
        y: root.bubble-bottom - self.height - Theme.space-6;

        bubble-layout := VerticalLayout {
            padding-left: Theme.space-12;
            padding-right: Theme.space-12;
            padding-top: Theme.space-8;
            padding-bottom: Theme.space-8;

            Text {
                text: root.bubble-text;
                font-size: Theme.font-md;
                color: Theme.text-primary;
                wrap: word-wrap;
                // The chip says it already
                accessible-role: none;
            }
        }
    }
}
