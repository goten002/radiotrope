import { Theme } from "defaults.slint";
import { Visualization } from "visualization.slint";
import { Chip, ChipVariant, IconButton, Icon } from "components.slint";

export component Playback inherits Rectangle {
    in property <string> station-name;
    in property <string> codec-info;
    // Shown in the codec line's place while there is no live codec info
    in property <string> station-country;
    in property <string> status-text;
    // Time on the current station, shown in the chip while playing
    in property <string> playtime;
    in property <bool> is-playing;
    in property <bool> is-loading;
    in property <bool> is-error;
    in property <image> station-logo;
    in property <bool> is-station-favorited;
    in property <bool> has-station;
    // Recording: "12:34 · 11.8 MB" while recording, and a short message
    // after a recording ends or fails
    in property <bool> is-recording;
    // Recording time and file size, shown apart so the size stays put
    in property <string> recording-text;
    in property <string> recording-size;
    in property <string> recording-notice;
    in property <bool> recording-notice-error;
    // A "Saved ..." notice opens the recordings folder when clicked
    in property <bool> can-open-recordings;
    callback open-recordings-folder();
    // The REC chip stops the recording on a second press
    callback stop-recording();
    // Time left on the Sleep Timer, "23:12" ("" when none runs)
    in property <string> sleep-left;
    // The Scheduler's label around an entry's start ("" when none), and
    // whether it is for the fallback sound
    in property <string> schedule-label;
    in property <bool> schedule-label-bell;
    // The label tells what just happened, and a click closes it
    in property <bool> schedule-label-closable;
    callback schedule-label-dismiss();
    callback open-sleep-timer();
    callback open-schedule();
    callback toggle-favorite();
    in-out property <string> viz-mode: "wave";
    // Off (View > Visualizer), the tile is left out of the header
    in-out property <bool> show-visualizer: true;
    // Off while a dialog is open: the visualizer tile leaves the Tab order
    // (the window ignores keys behind a dialog; see app.slint)
    in property <bool> enabled: true;

    // Headless capture: "recording-confirm" arms the REC chip, "viz-name"
    // shows the visualizer style's name
    in property <string> snapshot-overlay;

    property <image> empty-image;
    // The REC chip was pressed once and waits for a second press to stop
    property <bool> confirm-stop-recording: false;
    changed is-recording => { root.confirm-stop-recording = false; }
    property <bool> stop-armed: root.is-recording
        && (root.confirm-stop-recording || root.snapshot-overlay == "recording-confirm");

    // Disarms the REC chip when no second press follows
    disarm-timer := Timer {
        interval: 4s;
        running: root.confirm-stop-recording;
        triggered => { root.confirm-stop-recording = false; }
    }

    height: 108px;
    // No background of its own: it sits on the header (app.slint), which
    // draws the panel colour and the accent glow behind the menu bar too

    // 1px bottom separator — shadow edge casting onto favorites
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }

    HorizontalLayout {
        padding: Theme.space-12;
        padding-left: Theme.space-16;
        spacing: Theme.space-16;
        alignment: stretch;

        // Station logo / placeholder
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 76px;
                height: 76px;
                background: Theme.elevated;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.hairline;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: Theme.shadow-soft;
                clip: true;

                if root.station-logo.width > 0: Image {
                    source: root.station-logo;
                    width: 76px;
                    height: 76px;
                    image-fit: contain;
                    // Decoration: the station name is the text beside it
                    accessible-role: none;
                }

                if root.station-logo.width == 0: Icon {
                    source: @image-url("icons/radio.svg");
                    width: 30px;
                    height: 30px;
                    colorize: Theme.accent;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Station info (center, stretches)
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.space-6;

            Text {
                text: root.station-name;
                color: Theme.text-primary;
                font-size: Theme.font-station;
                font-weight: Theme.weight-semibold;
                overflow: elide;
            }

            // The live codec line, or the station's country until there is one
            Text {
                text: root.codec-info != "" ? root.codec-info
                    : root.station-country != "" ? root.station-country : " ";
                color: root.codec-info != "" ? Theme.text-secondary : Theme.text-tertiary;
                font-size: Theme.font-md;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: Theme.space-6;

                // Grey for Ready and Stopped, accent and pulsing while connecting
                // or playing, red for errors. The state comes from the player's
                // flags, never from the wording of the status text.
                Chip {
                    text: root.is-playing && root.playtime != "—" && root.playtime != ""
                        ? root.status-text + " " + root.playtime : root.status-text;
                    variant: root.is-error ? ChipVariant.danger
                        : self.pulse ? ChipVariant.accent : ChipVariant.neutral;
                    dot: true;
                    pulse: !root.is-error && (root.is-playing || root.is-loading);
                    steady: true;
                    // A long error may shorten like the others
                    keep: !root.is-error;
                }

                // Recording progress, or what happened to the last recording.
                // While recording a press asks to confirm, the second stops it.
                if root.is-recording || root.recording-notice != "": Chip {
                    text: root.stop-armed ? "Press Again to Stop"
                        : root.is-recording ? "REC " + root.recording-text : root.recording-notice;
                    detail: root.is-recording && !root.stop-armed ? root.recording-size : "";
                    variant: root.is-recording || root.recording-notice-error ? ChipVariant.danger : ChipVariant.neutral;
                    icon: root.is-recording ? empty-image : root.recording-notice-error
                        ? @image-url("icons/circle-alert.svg") : @image-url("icons/record.svg");
                    dot: root.is-recording;
                    pulse: root.is-recording;
                    steady: root.is-recording;
                    keep: root.is-recording;
                    clickable: root.is-recording
                        || (!root.recording-notice-error && root.can-open-recordings);
                    clicked => {
                        if !root.is-recording {
                            root.open-recordings-folder();
                        } else if root.confirm-stop-recording {
                            root.confirm-stop-recording = false;
                            root.stop-recording();
                        } else {
                            root.confirm-stop-recording = true;
                        }
                    }
                }

                if root.sleep-left != "": Chip {
                    text: "Sleep " + root.sleep-left;
                    icon: @image-url("icons/moon.svg");
                    steady: true;
                    keep: true;
                    clickable: true;
                    clicked => { root.open-sleep-timer(); }
                }

                if root.schedule-label != "": Chip {
                    text: root.schedule-label;
                    icon: root.schedule-label-bell ? @image-url("icons/bell.svg") : @image-url("icons/calendar.svg");
                    steady: true;
                    clickable: true;
                    // After an entry started it is only news: a click closes it
                    closable: root.schedule-label-closable;
                    clicked => {
                        if root.schedule-label-closable {
                            root.schedule-label-dismiss();
                        } else {
                            root.open-schedule();
                        }
                    }
                }

                // Takes the spare width, so a long status elides in the chip
                // instead of capping the whole column
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Star (favorite) button
        if root.has-station: VerticalLayout {
            alignment: center;
            IconButton {
                width: Theme.control-field;
                height: Theme.control-field;
                // Outline when not a favorite, filled when it is, in the same
                // colour as the star in Search
                icon: root.is-station-favorited ? @image-url("icons/star.svg")
                    : @image-url("icons/star-regular.svg");
                label: root.is-station-favorited ? "Remove from Favorites" : "Add to Favorites";
                icon-size: Theme.icon-lg;
                icon-color: root.is-station-favorited ? Theme.selection-mark : Theme.text-secondary;
                hover-color: root.is-station-favorited ? Theme.selection-mark : Theme.text-primary;
                clicked => { root.toggle-favorite(); }
            }
        }

        // Visualization tile
        if root.show-visualizer && root.has-station: VerticalLayout {
            alignment: center;
            viz := Visualization {
                viz-mode <=> root.viz-mode;
                is-loading: root.is-loading;
                enabled: root.enabled;
                snapshot-name: root.snapshot-overlay == "viz-name";
            }
        }
    }
}
