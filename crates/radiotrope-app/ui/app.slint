import "fonts/Inter/static/Inter_18pt-Regular.ttf";
import "fonts/Inter/static/Inter_18pt-SemiBold.ttf";
import { MenuBar } from "menu-bar.slint";
import { Playback } from "playback.slint";
import { Favorites, FavoriteStation } from "favorites.slint";
import { Controls } from "controls.slint";
import { Theme, Defaults } from "defaults.slint";
import { NetworkStreamDialog } from "dialogs/network-stream.slint";
import { ImportFavoritesDialog } from "dialogs/import-favorites.slint";
import { StatisticsDialog } from "dialogs/statistics.slint";
import { StationBrowserDialog, BrowseStation } from "dialogs/station-browser.slint";
import { CountryPickerDialog, CountryEntry } from "dialogs/country-picker.slint";
import { EditFavoriteDialog } from "dialogs/edit-favorite.slint";
import { RecordingSettingsDialog } from "dialogs/recording.slint";
import { AgentsDialog } from "dialogs/agents.slint";
import { RemoteControlDialog, PairingCodeDialog, PairingQrDialog, RemoteDevice } from "dialogs/remote-control.slint";
import { SleepTimerDialog } from "dialogs/sleep-timer.slint";
import { ScheduleDialog, ScheduleRow, ScheduleDraft } from "dialogs/schedule.slint";
import { EqualizerDialog, EqPresetGroup } from "dialogs/equalizer.slint";
import { AccentColorDialog } from "dialogs/accent-color.slint";
import { WifiSettingsDialog, WifiNetworkEntry, Platform } from "@platform/wifi.slint";
import { AboutDialog, AboutInfo } from "dialogs/about.slint";
import { TextUtil, AgentsBubble, AgentRow, ListenersBubble, Motion } from "components.slint";
import { VizData, VizStyle } from "visualization.slint";
import { LogoFog, FogColors } from "logo-fog.slint";
export { AboutInfo, LogoFog, FogColors, Defaults, TextUtil, VizData, VizStyle, BrowseStation, CountryEntry, FavoriteStation, WifiNetworkEntry, AgentRow, EqPresetGroup, ScheduleRow, ScheduleDraft, RemoteDevice }

export component App inherits Window {
    title: "Radiotrope";
    // Taskbar / Alt+Tab icon on X11 and Windows (Wayland uses the app_id)
    icon: @image-url("../../../assets/icons/icon-256.png");
    default-font-family: "Inter 18pt";
    background: Theme.surface;
    min-width: Defaults.window-min-width;
    min-height: Defaults.window-min-height;
    preferred-width: Defaults.window-width;
    preferred-height: Defaults.window-height;

    // Own title bar in place of the system frame (desktop; saved in settings)
    in-out property <bool> custom-frame: Platform.has-window-frame;
    in-out property <bool> keep-on-top: false;
    no-frame: root.custom-frame;
    // Edges to grab for resizing, since there is no system frame
    resize-border-width: root.custom-frame && !root.maximized ? Defaults.resize-border : 0px;
    always-on-top: root.keep-on-top;
    callback minimize-window();
    // Use our title bar (true) or the system one; Rust keeps the content size
    callback switch-title-bar(bool);
    // The OS window menu on right-click; false when there is none
    callback show-system-menu(length, length, bool) -> bool;
    // System tray (desktop; saved in settings). Rust sets tray-available:
    // false when the desktop shows no tray icons (GNOME without the
    // AppIndicator extension)
    in-out property <bool> tray-icon: Platform.has-tray;
    in-out property <bool> close-to-tray;
    in-out property <bool> start-in-tray;
    in-out property <bool> hide-on-minimize;
    in property <bool> tray-available: true;
    // End the app (Quit in the Open menu, Ctrl+Q); closing may only hide
    callback quit-app();
    // The play button, for the tray icon's menu and middle click
    public function play-or-stop() {
        controls.play-or-stop();
    }

    callback play-url(string);
    // Open Network Stream: url, name, logo url, country (all but the url optional)
    callback play-stream(string, string, string, string);
    callback stop-clicked();
    callback volume-changed(float);
    callback mute-clicked();
    callback search-stations(string);
    // Stations in a country: name, ISO code (may be empty), name query (may be empty)
    callback browse-country(string, string, string);
    callback load-more-stations();
    callback play-station(BrowseStation);
    callback toggle-favorite();
    callback play-favorite(FavoriteStation);
    callback delete-favorite(FavoriteStation);
    // Saves an edited favorite; returns why it couldn't, or "" when saved
    callback edit-favorite(FavoriteStation) -> string;
    callback reset-favorite-stats(string);
    callback reorder-favorites(/* from */ int, /* to */ int);
    callback move-favorite(FavoriteStation, /* to-top */ bool);
    // Listening stats on favorites rows (View menu)
    in-out property <bool> show-station-stats: true;
    in-out property <bool> show-visualizer <=> playback.show-visualizer;
    // The visualizer was shown or hidden, or the statistics dialog opened or
    // closed: Rust runs the timers that feed them only while they show
    callback live-views-changed();
    out property <bool> stats-open: stats-dialog.show-dialog;
    changed show-visualizer => { root.live-views-changed(); }
    changed stats-open => { root.live-views-changed(); }
    callback load-top-stations();
    callback load-countries();
    callback open-url(string);
    callback filter-countries(string);
    callback eq-band-changed(int, float);
    callback eq-preamp-changed(float);
    callback eq-preset-selected(string);
    callback eq-enabled-toggled(bool);
    callback accent-color-changed(color);
    callback apply-custom-hex(string);
    // Recording
    callback toggle-recording();
    callback open-recordings-folder();
    callback browse-recording-folder();
    callback apply-recording-folder(string);
    callback restore-recording-folder();
    callback record-with-eq-toggled(bool);
    callback recording-format-changed(string);
    callback recording-bitrate-changed(int);
    in-out property <bool> is-recording;
    in-out property <bool> can-record;
    // Phones listening over Remote Control, for the chip in the menu bar
    in property <[string]> listeners;
    in-out property <string> recording-text;
    in-out property <string> recording-size;
    in-out property <string> recording-notice;
    in-out property <bool> recording-notice-error;
    in-out property <string> recording-folder <=> recording-dialog.folder;
    in-out property <string> recording-default-folder <=> recording-dialog.default-folder;
    in-out property <string> recording-folder-error <=> recording-dialog.error;
    in-out property <string> recording-folder-edit <=> recording-dialog.edit-path;
    in-out property <bool> record-with-eq <=> recording-dialog.with-eq;
    in-out property <string> recording-format <=> recording-dialog.format;
    in-out property <int> recording-bitrate <=> recording-dialog.bitrate;

    // Timer
    callback sleep-start(int);
    callback sleep-off();
    callback sleep-fade-toggled(bool);
    in-out property <bool> sleep-active;
    // Time left, "23:12", and when it stops, "23:30"
    in-out property <string> sleep-left;
    in-out property <string> sleep-until;
    // Seconds left, and the length it started with in minutes
    in-out property <int> sleep-left-secs;
    in-out property <int> sleep-length;
    // The length started last time, in minutes: the Sleep Timer opens on it
    in-out property <int> sleep-last: 30;
    in-out property <bool> sleep-fade <=> sleep-dialog.fade;

    // Scheduler
    callback schedule-opened();
    callback schedule-draft(int) -> ScheduleDraft;
    callback schedule-save(ScheduleDraft) -> string;
    callback schedule-toggled(int, bool);
    callback schedule-remove(int);
    in-out property <[ScheduleRow]> schedule-rows;
    in-out property <string> schedule-next;
    in-out property <[string]> schedule-stations;
    // Days a one-off can be on ("Today", "Tomorrow", "Sun 5 Oct", ...), and
    // today's place in the week (Monday 0)
    in-out property <[string]> schedule-dates;
    in-out property <int> schedule-today;
    // The Scheduler's label: "Play in 0:08", "Play · Jazz FM" ("" when none)
    in-out property <string> schedule-label;
    // The label is for the fallback sound (a bell, not the calendar)
    in-out property <bool> schedule-label-bell;
    // It says what started or the fallback sound: a click closes it
    in-out property <bool> schedule-label-closable;
    callback schedule-label-dismiss();

    // Agents (MCP)
    callback agents-network-toggled(bool);
    callback agents-apply-port(string);
    callback agents-listen-changed(int);
    callback agents-refresh-listen();
    callback agents-regenerate-token();
    in-out property <bool> agents-available <=> agents-dialog.available;
    in-out property <bool> agents-network <=> agents-dialog.network-on;
    in-out property <[string]> agents-listen-options <=> agents-dialog.listen-options;
    in-out property <int> agents-listen <=> agents-dialog.listen;
    in-out property <bool> agents-listen-local <=> agents-dialog.listen-local;
    in-out property <string> agents-port <=> agents-dialog.port;
    in-out property <string> agents-token <=> agents-dialog.token;
    in-out property <string> agents-edit-port <=> agents-dialog.edit-port;
    in-out property <string> agents-status <=> agents-dialog.status;
    in-out property <bool> agents-status-error <=> agents-dialog.status-error;
    in-out property <string> agents-command <=> agents-dialog.command;
    in-out property <string> agents-network-placeholder <=> agents-dialog.network-placeholder;
    in-out property <string> agents-local-command <=> agents-dialog.local-command;
    in-out property <string> agents-local-note <=> agents-dialog.local-note;
    in-out property <string> agents-network-note <=> agents-dialog.network-note;
    in-out property <[string]> agents-apps <=> agents-dialog.apps;
    in-out property <int> agents-app <=> agents-dialog.app;
    // Where network agents connect, for the setup lines (Rust side)
    in-out property <string> agents-url;
    callback agents-app-changed(int);
    in-out property <[string]> agents-auths <=> agents-dialog.auths;
    in-out property <int> agents-auth <=> agents-dialog.auth;
    callback agents-auth-changed(int);
    // Remote Control (Radiotrope Remote)
    callback remote-opened();
    callback remote-toggled(bool);
    callback remote-apply-name(string);
    callback remote-remove-device(string);
    callback remote-cancel-pairing();
    callback remote-pair-qr();
    callback remote-cancel-qr();
    callback remote-share-toggled(bool);
    in-out property <bool> remote-share-recordings <=> remote-dialog.share-recordings;
    in-out property <[string]> remote-activity <=> remote-dialog.activity;
    in-out property <bool> remote-on <=> remote-dialog.enabled-on;
    in-out property <string> remote-status <=> remote-dialog.status;
    in-out property <bool> remote-status-error <=> remote-dialog.status-error;
    in-out property <string> remote-address <=> remote-dialog.address;
    in-out property <string> remote-address-note <=> remote-dialog.address-note;
    in-out property <string> remote-name <=> remote-dialog.name;
    in-out property <string> remote-edit-name <=> remote-dialog.edit-name;
    in-out property <string> remote-name-placeholder <=> remote-dialog.name-placeholder;
    in-out property <[RemoteDevice]> remote-devices <=> remote-dialog.devices;
    // A phone is pairing: the code to show, and for how long
    in-out property <bool> pairing-shown;
    in-out property <string> pairing-device;
    in-out property <string> pairing-code;
    in-out property <int> pairing-seconds;
    in-out property <bool> pairing-qr-shown;
    in-out property <image> pairing-qr;
    in-out property <int> pairing-qr-seconds;
    // Agents using the player now, for the chip in the menu bar
    in property <int> agent-count;
    in property <[AgentRow]> agent-list;

    // WiFi (embedded only — connected from Rust when feature = "embedded")
    callback wifi-opened();
    callback wifi-scan-requested();
    callback wifi-connect-requested(string, string); // object-path, password
    callback wifi-disconnect-requested();
    callback wifi-forget-requested(string); // object-path
    callback wifi-power-requested(bool);
    callback wifi-backspace(string) -> string;

    in-out property <string> station-name;
    in-out property <string> codec-info;
    in-out property <string> status-text;
    in-out property <bool> is-loading;
    in-out property <bool> is-error;
    in-out property <string> viz-mode <=> playback.viz-mode;
    in-out property <bool> is-playing;
    in-out property <string> now-playing-title;
    in-out property <float> volume: 1.0;
    // How loud a fade (Scheduler or Sleep Timer) lets it play now, 0–1
    in-out property <float> volume-level: 1.0;
    in-out property <bool> is-muted;
    in-out property <string> station-url;
    in-out property <image> current-logo;
    // The station logo changed (the visualizer samples its colours)
    callback logo-changed();
    changed current-logo => { root.logo-changed(); }
    // Colour fog behind the logo when it would vanish on its tile
    in-out property <LogoFog> current-logo-fog;
    in-out property <bool> is-station-favorited;
    in-out property <string> station-logo-url;
    in-out property <string> station-country;
    in-out property <[FavoriteStation]> favorites-list;
    in-out property <[image]> favorite-logos;
    in-out property <[LogoFog]> favorite-logo-fogs;
    out property <bool> volume-dragging: controls.volume-dragging;

    // Station browser proxy properties (for Rust access)
    in-out property <[BrowseStation]> search-results <=> browser-dialog.search-results;
    in-out property <[image]> browse-logos <=> browser-dialog.browse-logos;
    in-out property <[LogoFog]> browse-logo-fogs <=> browser-dialog.browse-logo-fogs;
    in-out property <bool> search-loading <=> browser-dialog.search-loading;
    in-out property <bool> search-loading-more <=> browser-dialog.search-loading-more;
    in-out property <string> search-error <=> browser-dialog.search-error;
    in-out property <int> search-retry-in <=> browser-dialog.retry-in;
    in-out property <bool> has-more <=> browser-dialog.has-more;
    // What the station browser shows, so Rust can put a mode's list aside
    // and bring it back when that mode is opened again
    in-out property <string> browse-mode <=> browser-dialog.search-mode;
    in-out property <string> browse-typed <=> browser-dialog.search-query;
    in-out property <string> browse-shown <=> browser-dialog.shown-query;
    in-out property <length> browse-scroll <=> browser-dialog.list-scroll;
    // Rows of the station browser on screen, and when they change
    out property <int> browse-visible-first: browser-dialog.visible-first;
    out property <int> browse-visible-count: browser-dialog.visible-count;
    callback browse-rows-changed();
    callback browse-closed();
    // Try the station browser's failed request again
    callback retry-browse();
    in-out property <string> browse-country-name <=> browser-dialog.country-name;
    // Put the current list aside (per mode) before showing another one
    callback stash-browse();
    // Bring back the list kept for a mode ("search", or "country" with its
    // name); false when there is none and it has to be loaded
    callback restore-browse(/* mode */ string, /* country */ string) -> bool;
    // Star on a search result: add it to favorites or remove it
    callback toggle-browse-favorite(BrowseStation);

    // Favorites to and from a file, and undoing a list taken in
    callback export-favorites();
    callback import-favorites();
    callback import-favorites-chosen(/* replace */ bool);
    callback undo-favorites-import();
    in property <bool> can-undo-import;
    in-out property <bool> show-import-favorites <=> import-dialog.show-dialog;
    in-out property <string> import-title <=> import-dialog.title;
    in-out property <string> import-subtitle <=> import-dialog.subtitle;
    in-out property <string> import-add-summary <=> import-dialog.add-summary;
    in-out property <string> import-replace-summary <=> import-dialog.replace-summary;
    in-out property <string> import-message <=> import-dialog.message;
    in-out property <bool> import-message-error <=> import-dialog.message-error;
    in-out property <string> import-message-detail <=> import-dialog.message-detail;

    // Country picker proxy properties (for Rust access)
    in-out property <[CountryEntry]> countries <=> picker-dialog.countries;
    in-out property <string> country-filter <=> picker-dialog.filter-text;
    in-out property <bool> country-loading <=> picker-dialog.loading;
    in-out property <string> country-error <=> picker-dialog.error;

    // Equalizer proxy properties
    in-out property <bool> eq-enabled <=> eq-dialog.eq-enabled;
    in-out property <string> eq-preset-name <=> eq-dialog.preset-name;
    in-out property <float> eq-preamp <=> eq-dialog.preamp-gain;
    in-out property <float> eq-band0 <=> eq-dialog.band0;
    in-out property <float> eq-band1 <=> eq-dialog.band1;
    in-out property <float> eq-band2 <=> eq-dialog.band2;
    in-out property <float> eq-band3 <=> eq-dialog.band3;
    in-out property <float> eq-band4 <=> eq-dialog.band4;
    in-out property <float> eq-band5 <=> eq-dialog.band5;
    in-out property <float> eq-band6 <=> eq-dialog.band6;
    in-out property <float> eq-band7 <=> eq-dialog.band7;
    in-out property <float> eq-band8 <=> eq-dialog.band8;
    in-out property <float> eq-band9 <=> eq-dialog.band9;
    // The preset menu, from the engine's preset list
    in property <[string]> eq-top-presets;
    in property <[EqPresetGroup]> eq-preset-groups;

    // WiFi proxy properties (embedded only)
    in-out property <bool> show-wifi-settings: false;
    // Touch screen build: lists scroll by dragging
    in property <bool> touch-scroll: false;
    in-out property <[WifiNetworkEntry]> wifi-networks <=> wifi-dialog.networks;
    in-out property <bool> wifi-scanning <=> wifi-dialog.is-scanning;
    in-out property <string> wifi-current-ssid <=> wifi-dialog.current-ssid;
    in-out property <string> wifi-connection-status <=> wifi-dialog.connection-status;
    in-out property <bool> wifi-status-is-error <=> wifi-dialog.status-is-error;
    // The radio is on (off: the list is greyed)
    in-out property <bool> wifi-powered <=> wifi-dialog.powered;
    // Our address on the Wi-Fi network, "" while there is none
    in-out property <string> wifi-ip <=> wifi-dialog.ip;
    // "no-adapter", "off", "disconnected", "connecting" or "connected"
    in-out property <string> wifi-state <=> wifi-dialog.state;

    // Theme proxy: the View menu's choice, and the theme it gives
    in-out property <string> theme-mode <=> Theme.theme-mode;
    out property <bool> dark-mode: Theme.dark-mode;
    changed dark-mode => { root.logo-changed(); }
    // The choice or the OS theme changed: Rust matches the Windows title bar
    callback window-theme-changed();
    property <bool> system-dark: Theme.system-dark;
    changed theme-mode => { root.window-theme-changed(); }
    changed system-dark => { root.window-theme-changed(); }

    // Accent color proxy — two-way bind to Theme global
    in-out property <color> accent-color <=> Theme.accent-base;
    in-out property <bool> panel-gradient <=> Theme.panel-gradient;

    in-out property <string> stat-health;
    in-out property <string> stat-playtime;
    in-out property <string> stat-codec;
    in-out property <string> stat-bitrate;
    in-out property <string> stat-sample-rate;
    in-out property <string> stat-channels;
    in-out property <string> stat-received;
    in-out property <string> stat-segments;
    in-out property <string> stat-throughput;
    in-out property <string> stat-buffer-level;
    in-out property <string> stat-buffer-capacity;
    in-out property <string> stat-frames-played;
    in-out property <string> stat-decode-errors;
    in-out property <string> stat-underruns;

    // Shortcuts in the main window: Space plays or stops, Ctrl+F searches
    // stations, M mutes. Keys reach it only when the focused control
    // doesn't use them (text fields keep theirs), and dialogs sit outside
    // it, so it is quiet while one is open.
    forward-focus: shortcuts;
    shortcuts := FocusScope {
        // Not a Tab stop itself: Tab goes round the controls only
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                if event.modifiers.control && !event.modifiers.alt && (event.text == "f" || event.text == "F") {
                    menu-bar.open-station-search();
                    return accept;
                }
                if event.modifiers.control && !event.modifiers.alt && (event.text == "q" || event.text == "Q") {
                    root.quit-app();
                    return accept;
                }
                return reject;
            }
            if event.text == Key.Space {
                controls.play-or-stop();
                return accept;
            }
            if event.text == "m" || event.text == "M" {
                root.mute-clicked();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // Header: menu bar and playback panel on one background, with the
            // soft accent glow from the left running through both
            Rectangle {
                background: Theme.panel;

                Rectangle {
                    visible: Theme.panel-gradient;
                    background: @linear-gradient(90deg, Theme.accent-glow 0%, Theme.accent.with-alpha(0) 45%);
                }

                VerticalLayout {
                menu-bar := MenuBar {
                    show-station-stats <=> root.show-station-stats;
                    show-visualizer <=> root.show-visualizer;
                    custom-frame: root.custom-frame;
                    maximized <=> root.maximized;
                    always-on-top <=> root.keep-on-top;
                    minimize => { root.minimize-window(); }
                    show-system-menu(x, y, pressed) => { return root.show-system-menu(x, y, pressed); }
                    close-window => { root.close(); }
                    tray-icon <=> root.tray-icon;
                    close-to-tray <=> root.close-to-tray;
                    start-in-tray <=> root.start-in-tray;
                    hide-on-minimize <=> root.hide-on-minimize;
                    tray-available: root.tray-available;
                    quit-app => { root.quit-app(); }
                    toggle-custom-frame => { root.switch-title-bar(!root.custom-frame); }
                    open-wifi-settings => {
                        root.show-wifi-settings = true;
                        root.wifi-opened();
                    }
                    open-network-stream => {
                        stream-dialog.show-dialog = true;
                    }
                    open-station-search => {
                        // Keep the last search when reopening; load top stations on
                        // first open or when coming back from a country list
                        if browser-dialog.search-mode != "search" || browser-dialog.search-results.length == 0 {
                            root.stash-browse();
                            if !root.restore-browse("search", "") {
                                browser-dialog.search-mode = "search";
                                browser-dialog.reset-query();
                                browser-dialog.search-loading = true;
                                root.load-top-stations();
                            }
                        }
                        browser-dialog.show-dialog = true;
                    }
                    // Reopen the country picked earlier in this session; the
                    // browser's "Countries" button goes back to the list
                    export-favorites => { root.export-favorites(); }
                    import-favorites => { root.import-favorites(); }
                    undo-favorites-import => { root.undo-favorites-import(); }
                    can-undo-import: root.can-undo-import;
                    open-country-picker => {
                        if browser-dialog.country-name != "" {
                            root.open-country(browser-dialog.country-name, browser-dialog.country-code, browser-dialog.country-flag);
                        } else {
                            root.show-country-list();
                        }
                    }
                    open-about => {
                        about-dialog.show-dialog = true;
                    }
                    open-statistics => {
                        stats-dialog.show-dialog = true;
                    }
                    open-equalizer => {
                        eq-dialog.show-dialog = true;
                    }
                    open-accent-color => {
                        accent-dialog.show-dialog = true;
                    }
                    is-recording: root.is-recording;
                    can-record: root.can-record;
                    toggle-recording => { root.toggle-recording(); }
                    open-recording-settings => {
                        root.recording-folder-error = "";
                        recording-dialog.open();
                    }
                    open-recordings-folder => { root.open-recordings-folder(); }
                    open-agents => { agents-dialog.open(); }
                    open-remote-control => { remote-dialog.open(); }
                    open-sleep-timer => { sleep-dialog.open(); }
                    open-schedule => { schedule-dialog.open(); }
                    menus-enabled: !root.dialog-open;
                    agent-count: root.agent-count;
                    listeners: root.listeners;
                }
                playback := Playback {
                    station-name: root.station-name;
                    codec-info: root.codec-info;
                    status-text: root.status-text;
                    playtime: root.stat-playtime;
                    is-loading: root.is-loading;
                    is-error: root.is-error;
                    station-logo: root.current-logo;
                    station-logo-fog: root.current-logo-fog;
                    is-station-favorited: root.is-station-favorited;
                    has-station: root.station-url != "";
                    is-recording: root.is-recording;
                    recording-text: root.recording-text;
                    recording-size: root.recording-size;
                    recording-notice: root.recording-notice;
                    recording-notice-error: root.recording-notice-error;
                    can-open-recordings: Platform.has-file-manager;
                    open-recordings-folder => { root.open-recordings-folder(); }
                    sleep-left: root.sleep-active ? root.sleep-left : "";
                    schedule-label: root.schedule-label;
                    schedule-label-bell: root.schedule-label-bell;
                    schedule-label-closable: root.schedule-label-closable;
                    schedule-label-dismiss => { root.schedule-label-dismiss(); }
                    open-sleep-timer => { sleep-dialog.open(); }
                    open-schedule => { schedule-dialog.open(); }
                    toggle-favorite => { root.toggle-favorite(); }
                }
                }
            }
            Favorites {
                vertical-stretch: 1;
                favorites: root.favorites-list;
                favorite-logos: root.favorite-logos;
                favorite-logo-fogs: root.favorite-logo-fogs;
                current-station-url: root.station-url;
                is-playing: root.is-playing;
                play-loading: root.is-loading;
                play-error: root.is-error;
                touch-scroll: root.touch-scroll;
                show-stats: root.show-station-stats;
                favorite-move-requested(station, to-top) => { root.move-favorite(station, to-top); }
                favorite-remove-requested(station) => { root.delete-favorite(station); }
                favorite-reset-stats-requested(station) => { root.reset-favorite-stats(station.id); }
                favorite-clicked(station) => { root.play-favorite(station); }
                favorite-edit-requested(station) => { edit-dialog.open(station); }
                favorites-reordered(from, to) => { root.reorder-favorites(from, to); }
            }
            controls := Controls {
                is-playing: root.is-playing;
                is-loading: root.is-loading;
                has-station: root.station-url != "";
                now-playing-title: root.now-playing-title;
                volume <=> root.volume;
                volume-level: root.volume-level;
                is-muted <=> root.is-muted;
                play-clicked => { root.play-url(root.station-url); }
                stop-clicked => { root.stop-clicked(); }
                volume-changed(vol) => { root.volume-changed(vol); }
                mute-clicked => { root.mute-clicked(); }
            }
        }
    }

    // Station browser listing one country's stations. Stations already
    // listed for that country are kept, so reopening it is instant.
    function open-country(name: string, code: string, flag: image) {
        if browser-dialog.search-mode != "country" || browser-dialog.country-name != name || browser-dialog.search-results.length == 0 {
            root.stash-browse();
            if !root.restore-browse("country", name) {
                browser-dialog.search-mode = "country";
                browser-dialog.reset-query();
                browser-dialog.search-results = [];
                browser-dialog.browse-logos = [];
                browser-dialog.browse-logo-fogs = [];
                browser-dialog.search-error = "";
                browser-dialog.has-more = false;
                browser-dialog.search-loading = true;
                root.browse-country(name, code, "");
            }
            browser-dialog.country-name = name;
            browser-dialog.country-code = code;
            browser-dialog.country-flag = flag;
        }
        browser-dialog.show-dialog = true;
    }

    function show-country-list() {
        picker-dialog.loading = true;
        picker-dialog.filter-text = "";
        picker-dialog.show-dialog = true;
        root.load-countries();
    }

    // The dialogs. With our own title bar they leave it uncovered, so the
    // window can still be moved, minimised, maximised and closed while one
    // is open (the menus are greyed out meanwhile).
    Rectangle {
        y: root.custom-frame ? menu-bar.height : 0;
        height: root.height - self.y;

        import-dialog := ImportFavoritesDialog {
            add-missing => { root.import-favorites-chosen(false); }
            replace => { root.import-favorites-chosen(true); }
        }

        stream-dialog := NetworkStreamDialog {
            accepted(url, name, logo, country) => {
                root.play-stream(url, name, logo, country);
            }
        }

        stats-dialog := StatisticsDialog {
            stat-health: root.stat-health;
            stat-playtime: root.stat-playtime;
            stat-codec: root.stat-codec;
            stat-bitrate: root.stat-bitrate;
            stat-sample-rate: root.stat-sample-rate;
            stat-channels: root.stat-channels;
            stat-received: root.stat-received;
            stat-segments: root.stat-segments;
            stat-throughput: root.stat-throughput;
            stat-buffer-level: root.stat-buffer-level;
            stat-buffer-capacity: root.stat-buffer-capacity;
            stat-frames-played: root.stat-frames-played;
            stat-decode-errors: root.stat-decode-errors;
            stat-underruns: root.stat-underruns;
        }

        eq-dialog := EqualizerDialog {
            top-presets: root.eq-top-presets;
            preset-groups: root.eq-preset-groups;
            enabled-toggled(val) => { root.eq-enabled-toggled(val); }
            preset-selected(name) => { root.eq-preset-selected(name); }
            preamp-changed(val) => { root.eq-preamp-changed(val); }
            band-changed(band, gain) => { root.eq-band-changed(band, gain); }
        }

        browser-dialog := StationBrowserDialog {
            playing-url: root.station-url;
            is-playing: root.is-playing;
            play-loading: root.is-loading;
            play-error: root.is-error;
            play-status: root.status-text;
            search-stations(query) => { root.search-stations(query); }
            search-in-country(name, code, query) => { root.browse-country(name, code, query); }
            change-country() => {
                browser-dialog.show-dialog = false;
                root.show-country-list();
            }
            load-more() => { root.load-more-stations(); }
            retry() => { root.retry-browse(); }
            station-selected(station) => { root.play-station(station); }
            favorite-toggled(station) => { root.toggle-browse-favorite(station); }
            visible-rows-changed() => { root.browse-rows-changed(); }
            closed() => { root.browse-closed(); }
        }

        edit-dialog := EditFavoriteDialog {
            accepted(station) => {
                return root.edit-favorite(station);
            }
            deleted(station) => {
                root.delete-favorite(station);
            }
        }

        accent-dialog := AccentColorDialog {
            color-changed(color) => { root.accent-color-changed(color); }
            custom-hex-requested(hex) => { root.apply-custom-hex(hex); }
        }

        picker-dialog := CountryPickerDialog {
            country-selected(country) => {
                root.open-country(country.name, country.code, country.flag);
            }
            load-countries() => { root.load-countries(); }
            filter-countries(text) => { root.filter-countries(text); }
        }

        recording-dialog := RecordingSettingsDialog {
            browse() => { root.browse-recording-folder(); }
            apply-folder(path) => { root.apply-recording-folder(path); }
            restore-default() => { root.restore-recording-folder(); }
            open-folder() => { root.open-recordings-folder(); }
            eq-on: root.eq-enabled;
            with-eq-toggled(on) => { root.record-with-eq-toggled(on); }
            format-changed(id) => { root.recording-format-changed(id); }
            bitrate-changed(kbps) => { root.recording-bitrate-changed(kbps); }
        }

        sleep-dialog := SleepTimerDialog {
            active: root.sleep-active;
            left: root.sleep-left;
            until: root.sleep-until;
            left-secs: root.sleep-left-secs;
            length-minutes: root.sleep-length;
            last: root.sleep-last;
            start(minutes) => { root.sleep-start(minutes); }
            turn-off() => { root.sleep-off(); }
            fade-toggled(on) => { root.sleep-fade-toggled(on); }
        }

        schedule-dialog := ScheduleDialog {
            rows: root.schedule-rows;
            next: root.schedule-next;
            stations: root.schedule-stations;
            dates: root.schedule-dates;
            today: root.schedule-today;
            opened() => { root.schedule-opened(); }
            draft(id) => { return root.schedule-draft(id); }
            save(draft) => { return root.schedule-save(draft); }
            toggled(id, on) => { root.schedule-toggled(id, on); }
            remove(id) => { root.schedule-remove(id); }
        }

        agents-dialog := AgentsDialog {
            network-toggled(on) => { root.agents-network-toggled(on); }
            apply-port(text) => { root.agents-apply-port(text); }
            listen-changed(index) => { root.agents-listen-changed(index); }
            refresh-listen() => { root.agents-refresh-listen(); }
            regenerate-token() => { root.agents-regenerate-token(); }
            app-changed(index) => { root.agents-app-changed(index); }
            auth-changed(index) => { root.agents-auth-changed(index); }
        }

        remote-dialog := RemoteControlDialog {
            opened() => { root.remote-opened(); }
            toggled(on) => { root.remote-toggled(on); }
            apply-name(text) => { root.remote-apply-name(text); }
            remove-device(id) => { root.remote-remove-device(id); }
            pair-qr => { root.remote-pair-qr(); }
            share-toggled(on) => { root.remote-share-toggled(on); }
        }

        about-dialog := AboutDialog {
            open-url(url) => { root.open-url(url); }
        }

        // WiFi settings dialog (an empty stand-in on desktop builds)
        wifi-dialog := WifiSettingsDialog {
            show-dialog <=> root.show-wifi-settings;
            scan-requested() => { root.wifi-scan-requested(); }
            connect-requested(path, password) => { root.wifi-connect-requested(path, password); }
            disconnect-requested() => { root.wifi-disconnect-requested(); }
            forget-requested(path) => { root.wifi-forget-requested(path); }
            power-requested(on) => { root.wifi-power-requested(on); }
            close-requested() => { root.show-wifi-settings = false; }
            wifi-backspace-requested(text) => { return root.wifi-backspace(text); }
        }

        // Over every other dialog: a phone waits for this code
        PairingCodeDialog {
            show-dialog: root.pairing-shown;
            device-name: root.pairing-device;
            code: root.pairing-code;
            seconds-left: root.pairing-seconds;
            cancel => { root.remote-cancel-pairing(); }
        }

        PairingQrDialog {
            show-dialog: root.pairing-qr-shown;
            qr: root.pairing-qr;
            seconds-left: root.pairing-qr-seconds;
            cancel => { root.remote-cancel-qr(); }
        }
    }

    // Steps the status animations (Motion), only while there is one to show
    Timer {
        interval: Defaults.motion-step;
        running: root.is-playing || root.is-loading || root.is-recording;
        triggered => { Motion.tick += self.interval; }
    }

    // The menu bar's listeners bubble, over the header below it
    if menu-bar.listeners-bubble-open: ListenersBubble {
        x: menu-bar.listeners-bubble-right - self.width;
        y: menu-bar.listeners-bubble-top;
        phones: root.listeners;
    }

    // The menu bar's agents bubble, over the header below it
    if menu-bar.agents-bubble-open: AgentsBubble {
        x: menu-bar.agents-bubble-right - self.width;
        y: menu-bar.agents-bubble-top;
        agents: root.agent-list;
    }

    // A dialog is open; when the last one closes, the main window takes
    // the keyboard back (its shortcuts work again)
    property <bool> dialog-open: stream-dialog.show-dialog || stats-dialog.show-dialog
        || eq-dialog.show-dialog || browser-dialog.show-dialog || edit-dialog.show-dialog
        || accent-dialog.show-dialog || picker-dialog.show-dialog || recording-dialog.show-dialog
        || agents-dialog.show-dialog || about-dialog.show-dialog || root.show-wifi-settings
        || sleep-dialog.show-dialog || schedule-dialog.show-dialog || remote-dialog.show-dialog
        || root.pairing-shown || root.pairing-qr-shown;
    changed dialog-open => {
        if !self.dialog-open {
            shortcuts.focus();
        }
    }

    // Thin outline so the edge stays visible without the system frame
    if root.custom-frame && !root.maximized && !root.full-screen: Rectangle {
        border-width: 1px;
        border-color: Theme.dark-mode ? #ffffff1f : #0000002e;
    }
}
