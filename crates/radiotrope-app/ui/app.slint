import "fonts/Inter/static/Inter_18pt-Regular.ttf";
import "fonts/Inter/static/Inter_18pt-SemiBold.ttf";
import { MenuBar } from "menu-bar.slint";
import { Playback } from "playback.slint";
import { Favorites, FavoriteStation } from "favorites.slint";
import { Controls } from "controls.slint";
import { Theme } from "theme.slint";
import { NetworkStreamDialog } from "dialogs/network-stream.slint";
import { StatisticsDialog } from "dialogs/statistics.slint";
import { StationBrowserDialog, BrowseStation } from "dialogs/station-browser.slint";
import { CountryPickerDialog, CountryEntry } from "dialogs/country-picker.slint";
import { EditFavoriteDialog } from "dialogs/edit-favorite.slint";
import { EqualizerDialog } from "dialogs/equalizer.slint";
import { AccentColorDialog } from "dialogs/accent-color.slint";
import { WifiSettingsDialog, WifiNetworkEntry } from "dialogs/wifi-settings.slint";
export { BrowseStation, CountryEntry, FavoriteStation, WifiNetworkEntry }

export component App inherits Window {
    title: "Radiotrope";
    default-font-family: "Inter 18pt";
    background: Theme.surface;
    min-width: 640px;
    min-height: 480px;
    preferred-width: 800px;
    preferred-height: 600px;

    callback play-url(string);
    callback stop-clicked();
    callback volume-changed(float);
    callback mute-clicked();
    callback search-stations(string);
    callback browse-country(string);
    callback load-more-stations();
    callback play-station(BrowseStation);
    callback toggle-favorite();
    callback play-favorite(FavoriteStation);
    callback delete-favorite(FavoriteStation);
    callback edit-favorite(FavoriteStation);
    callback reorder-favorites(/* from */ int, /* to */ int);
    callback load-top-stations();
    callback load-countries();
    callback eq-band-changed(int, float);
    callback eq-preamp-changed(float);
    callback eq-preset-selected(string);
    callback eq-enabled-toggled(bool);
    callback accent-color-changed(color);
    callback apply-custom-hex(string);

    // WiFi (embedded only — connected from Rust when feature = "embedded")
    callback wifi-scan-requested();
    callback wifi-connect-requested(string, string); // object-path, password
    callback wifi-disconnect-requested();
    callback wifi-backspace(string) -> string;

    in-out property <string> station-name;
    in-out property <string> codec-info;
    in-out property <string> status-text;
    in-out property <float> vu-left;
    in-out property <float> vu-right;
    in-out property <[float]> spectrum;
    in-out property <bool> is-loading;
    in-out property <bool> is-error;
    in-out property <string> viz-mode <=> playback.viz-mode;
    in-out property <bool> is-playing;
    in-out property <string> now-playing-title;
    in-out property <float> volume: 1.0;
    in-out property <bool> is-muted;
    in-out property <string> station-url;
    in-out property <image> current-logo;
    in-out property <bool> is-station-favorited;
    in-out property <string> station-logo-url;
    in-out property <string> station-country;
    in-out property <[FavoriteStation]> favorites-list;
    in-out property <[image]> favorite-logos;
    out property <bool> volume-dragging: controls.volume-dragging;

    // Station browser proxy properties (for Rust access)
    in-out property <[BrowseStation]> search-results <=> browser-dialog.search-results;
    in-out property <[image]> browse-logos <=> browser-dialog.browse-logos;
    in-out property <bool> search-loading <=> browser-dialog.search-loading;
    in-out property <bool> search-loading-more <=> browser-dialog.search-loading-more;
    in-out property <string> search-error <=> browser-dialog.search-error;
    in-out property <bool> has-more <=> browser-dialog.has-more;

    // Country picker proxy properties (for Rust access)
    in-out property <[CountryEntry]> countries <=> picker-dialog.countries;
    in-out property <bool> country-loading <=> picker-dialog.loading;
    in-out property <string> country-error <=> picker-dialog.error;

    // Equalizer proxy properties
    in-out property <bool> eq-enabled <=> eq-dialog.eq-enabled;
    in-out property <string> eq-preset-name <=> eq-dialog.preset-name;
    in-out property <float> eq-preamp <=> eq-dialog.preamp-gain;
    in-out property <float> eq-band0 <=> eq-dialog.band0;
    in-out property <float> eq-band1 <=> eq-dialog.band1;
    in-out property <float> eq-band2 <=> eq-dialog.band2;
    in-out property <float> eq-band3 <=> eq-dialog.band3;
    in-out property <float> eq-band4 <=> eq-dialog.band4;
    in-out property <float> eq-band5 <=> eq-dialog.band5;
    in-out property <float> eq-band6 <=> eq-dialog.band6;
    in-out property <float> eq-band7 <=> eq-dialog.band7;
    in-out property <float> eq-band8 <=> eq-dialog.band8;
    in-out property <float> eq-band9 <=> eq-dialog.band9;

    // WiFi proxy properties (embedded only)
    in-out property <bool> show-wifi-settings: false;
    in-out property <bool> wifi-embedded-mode: false; // set true from Rust on embedded
    in-out property <[WifiNetworkEntry]> wifi-networks <=> wifi-dialog.networks;
    in-out property <bool> wifi-scanning <=> wifi-dialog.is-scanning;
    in-out property <string> wifi-current-ssid <=> wifi-dialog.current-ssid;
    in-out property <string> wifi-connection-status <=> wifi-dialog.connection-status;

    // Theme proxy — two-way bind to Theme global
    in-out property <bool> dark-mode <=> Theme.dark-mode;

    // Accent color proxy — two-way bind to Theme global
    in-out property <color> accent-color <=> Theme.accent-base;

    in-out property <string> stat-health;
    in-out property <string> stat-uptime;
    in-out property <string> stat-codec;
    in-out property <string> stat-bitrate;
    in-out property <string> stat-sample-rate;
    in-out property <string> stat-channels;
    in-out property <string> stat-received;
    in-out property <string> stat-segments;
    in-out property <string> stat-throughput;
    in-out property <string> stat-buffer-level;
    in-out property <string> stat-buffer-capacity;
    in-out property <string> stat-frames-played;
    in-out property <string> stat-decode-errors;
    in-out property <string> stat-underruns;

    VerticalLayout {
        MenuBar {
            show-wifi-option: root.wifi-embedded-mode;
            open-wifi-settings => {
                root.show-wifi-settings = true;
                root.wifi-scan-requested();
            }
            open-network-stream => {
                stream-dialog.show-dialog = true;
            }
            open-station-search => {
                browser-dialog.search-mode = "search";
                browser-dialog.show-dialog = true;
                // Only load top stations on first open (no existing results)
                if browser-dialog.search-results.length == 0 {
                    browser-dialog.search-loading = true;
                    root.load-top-stations();
                }
            }
            open-country-picker => {
                picker-dialog.loading = true;
                picker-dialog.show-dialog = true;
                root.load-countries();
            }
            open-statistics => {
                stats-dialog.show-dialog = true;
            }
            open-equalizer => {
                eq-dialog.show-dialog = true;
            }
            open-accent-color => {
                accent-dialog.show-dialog = true;
            }
        }
        playback := Playback {
            station-name: root.station-name;
            codec-info: root.codec-info;
            status-text: root.status-text;
            vu-left: root.vu-left;
            vu-right: root.vu-right;
            spectrum: root.spectrum;
            is-loading: root.is-loading;
            is-error: root.is-error;
            station-logo: root.current-logo;
            is-station-favorited: root.is-station-favorited;
            has-station: root.station-url != "";
            toggle-favorite => { root.toggle-favorite(); }
        }
        Favorites {
            vertical-stretch: 1;
            favorites: root.favorites-list;
            favorite-logos: root.favorite-logos;
            current-station-url: root.station-url;
            favorite-clicked(station) => { root.play-favorite(station); }
            favorite-edit-requested(station) => { edit-dialog.open(station); }
            favorites-reordered(from, to) => { root.reorder-favorites(from, to); }
        }
        controls := Controls {
            is-playing: root.is-playing;
            has-station: root.station-url != "";
            now-playing-title: root.now-playing-title;
            volume <=> root.volume;
            is-muted <=> root.is-muted;
            play-clicked => { root.play-url(root.station-url); }
            stop-clicked => { root.stop-clicked(); }
            volume-changed(vol) => { root.volume-changed(vol); }
            mute-clicked => { root.mute-clicked(); }
        }
    }

    stream-dialog := NetworkStreamDialog {
        accepted(url) => {
            root.play-url(url);
        }
    }

    stats-dialog := StatisticsDialog {
        stat-health: root.stat-health;
        stat-uptime: root.stat-uptime;
        stat-codec: root.stat-codec;
        stat-bitrate: root.stat-bitrate;
        stat-sample-rate: root.stat-sample-rate;
        stat-channels: root.stat-channels;
        stat-received: root.stat-received;
        stat-segments: root.stat-segments;
        stat-throughput: root.stat-throughput;
        stat-buffer-level: root.stat-buffer-level;
        stat-buffer-capacity: root.stat-buffer-capacity;
        stat-frames-played: root.stat-frames-played;
        stat-decode-errors: root.stat-decode-errors;
        stat-underruns: root.stat-underruns;
    }

    eq-dialog := EqualizerDialog {
        enabled-toggled(val) => { root.eq-enabled-toggled(val); }
        preset-selected(name) => { root.eq-preset-selected(name); }
        preamp-changed(val) => { root.eq-preamp-changed(val); }
        band-changed(band, gain) => { root.eq-band-changed(band, gain); }
    }

    browser-dialog := StationBrowserDialog {
        search-stations(query) => { root.search-stations(query); }
        search-by-country(country) => { root.browse-country(country); }
        load-more() => { root.load-more-stations(); }
        station-selected(station) => { root.play-station(station); }
    }

    edit-dialog := EditFavoriteDialog {
        accepted(station) => {
            root.edit-favorite(station);
        }
        deleted(station) => {
            root.delete-favorite(station);
        }
    }

    accent-dialog := AccentColorDialog {
        color-changed(color) => { root.accent-color-changed(color); }
        custom-hex-requested(hex) => { root.apply-custom-hex(hex); }
    }

    picker-dialog := CountryPickerDialog {
        country-selected(country) => {
            browser-dialog.search-mode = "country";
            browser-dialog.country-name = country.name;
            browser-dialog.country-flag = country.flag;
            browser-dialog.search-results = [];
            browser-dialog.browse-logos = [];
            browser-dialog.search-error = "";
            browser-dialog.has-more = false;
            browser-dialog.search-loading = true;
            browser-dialog.show-dialog = true;
            root.browse-country(country.name);
        }
        load-countries() => { root.load-countries(); }
    }

    // WiFi settings dialog (visible only on embedded)
    wifi-dialog := WifiSettingsDialog {
        show-dialog <=> root.show-wifi-settings;
        scan-requested() => { root.wifi-scan-requested(); }
        connect-requested(path, password) => { root.wifi-connect-requested(path, password); }
        disconnect-requested() => { root.wifi-disconnect-requested(); }
        close-requested() => { root.show-wifi-settings = false; }
        wifi-backspace-requested(text) => { return root.wifi-backspace(text); }
    }
}
