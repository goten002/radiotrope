import { Theme } from "defaults.slint";
import { Icon, ButtonKeys, FocusRing } from "component-primitives.slint";

export component AccentButton inherits Rectangle {
    in property <string> label;
    // Optional icon before the label
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();

    height: Theme.control-button;
    out property <length> natural-width: row.preferred-width + 2 * Theme.space-16;
    width: root.natural-width;
    border-radius: Theme.radius-sm;
    property <color> foreground: !root.enabled ? Theme.disabled-text
        : touch.pressed ? Theme.on-accent-pressed
        : touch.has-hover ? Theme.on-accent-hover : Theme.on-accent;
    background: !root.enabled ? Theme.disabled-bg
                : touch.pressed ? Theme.accent-pressed
                : touch.has-hover ? Theme.accent-hover
                : Theme.accent;
    drop-shadow-blur: root.enabled && touch.has-hover ? 12px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.35);
    animate drop-shadow-blur { duration: Theme.fast; }
    forward-focus: focus;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    row := HorizontalLayout {
        alignment: center;
        spacing: Theme.space-6;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                width: Theme.icon-sm;
                height: Theme.icon-sm;
                source: root.icon;
                colorize: root.foreground;
            }
        }

        Text {
            text: root.label;
            color: root.foreground;
            font-size: Theme.font-base;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    focus := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if focus.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

export component SecondaryButton inherits Rectangle {
    in property <string> label;
    // Optional icon before the label
    in property <image> icon;
    in property <bool> enabled: true;
    out property <bool> has-focus: focus.has-focus;
    callback clicked();

    height: Theme.control-button;
    out property <length> natural-width: row.preferred-width + 2 * Theme.space-16;
    width: root.natural-width;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.hairline;
    background: !root.enabled ? Theme.disabled-bg
                : touch.pressed ? Theme.pressed-bg
                : touch.has-hover ? Theme.hover-bg
                : Theme.elevated;
    animate background { duration: Theme.fast; }
    forward-focus: focus;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    row := HorizontalLayout {
        alignment: center;
        spacing: Theme.space-6;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                width: Theme.icon-sm;
                height: Theme.icon-sm;
                source: root.icon;
                colorize: !root.enabled ? Theme.disabled-text
                    : touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            }
        }

        Text {
            text: root.label;
            color: !root.enabled ? Theme.disabled-text
                : touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            font-size: Theme.font-base;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    focus := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if focus.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

// Destructive action, with an optional icon before the label
export component DangerButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    // Greyed out and not clickable, but keeps its place
    in property <bool> enabled: true;
    // Its colour: red, or Theme.success for a go button
    in property <color> tone: Theme.danger;
    // Set while a destructive action is waiting for its second press.
    in property <bool> armed: false;
    // Supplying both labels reserves room for the longer one before arming.
    in property <string> armed-label;
    property <string> displayed-label: root.armed && root.armed-label != "" ? root.armed-label : root.label;
    property <color> foreground: !root.enabled ? Theme.disabled-text
        : root.tone == Theme.danger ? Theme.danger-text
        : root.tone == Theme.success ? Theme.success-text
        : root.tone == Theme.warning ? Theme.warning-text : Theme.status-text(root.tone);
    callback clicked();

    height: Theme.control-button;
    out property <length> natural-width: row.preferred-width + 28px
        + max(0px, alternate-measure.preferred-width - caption.preferred-width);
    width: root.natural-width;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? Theme.disabled-bg
                : touch.pressed ? root.tone.with-alpha(0.3)
                : root.armed ? Theme.danger-armed
                : touch.has-hover ? root.tone.with-alpha(0.18)
                : root.tone.with-alpha(0.14);
    animate background { duration: Theme.fast; }
    forward-focus: focus;

    accessible-role: button;
    accessible-label: root.displayed-label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    row := HorizontalLayout {
        alignment: center;
        spacing: Theme.space-6;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: Theme.icon-sm;
                height: Theme.icon-sm;
                colorize: root.foreground;
            }
        }

        caption := Text {
            text: root.displayed-label;
            color: root.foreground;
            font-size: Theme.font-base;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    alternate-measure := Text {
        visible: false;
        text: root.armed ? root.label : root.armed-label;
        font-size: Theme.font-base;
        font-weight: Theme.weight-semibold;
    }

    focus := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if focus.has-focus: FocusRing {
        radius: root.border-radius;
    }
}
