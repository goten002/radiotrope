import { Theme } from "theme.slint";
import { Icon } from "components.slint";

export component AccentButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    width: btn-text.preferred-width + 32px;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? Theme.disabled-bg
                : touch.pressed ? Theme.accent-hover.darker(0.1)
                : touch.has-hover ? Theme.accent-hover
                : Theme.accent;
    animate background { duration: Theme.fast; }
    drop-shadow-blur: root.enabled && touch.has-hover ? 12px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.35);
    animate drop-shadow-blur { duration: Theme.fast; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    btn-text := Text {
        text: root.label;
        color: root.enabled ? Theme.button-text : Theme.disabled-text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SecondaryButton inherits Rectangle {
    in property <string> label;
    // Greyed out and not clickable
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    width: btn-text.preferred-width + 32px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.hairline;
    background: touch.pressed ? Theme.menu-hover
                : touch.has-hover ? Theme.menu-bar-hover
                : Theme.elevated;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    btn-text := Text {
        text: root.label;
        color: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Destructive action, with an optional icon before the label
export component DangerButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    callback clicked();

    height: 34px;
    width: row.preferred-width + 28px;
    border-radius: Theme.radius-sm;
    background: touch.pressed ? Theme.danger.with-alpha(0.3)
                : touch.has-hover ? Theme.danger.with-alpha(0.22)
                : Theme.danger.with-alpha(0.14);
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    row := HorizontalLayout {
        x: 14px;
        spacing: 6px;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: 11px;
                height: 11px;
                colorize: Theme.danger;
            }
        }

        Text {
            text: root.label;
            color: Theme.danger;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}
