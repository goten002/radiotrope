import { Theme } from "defaults.slint";
import { Icon, ButtonKeys, FocusRing } from "components.slint";

export component AccentButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    width: btn-text.preferred-width + 32px;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? Theme.disabled-bg
                : touch.pressed ? Theme.accent-hover.darker(0.1)
                : touch.has-hover ? Theme.accent-hover
                : Theme.accent;
    animate background { duration: Theme.fast; }
    drop-shadow-blur: root.enabled && touch.has-hover ? 12px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.35);
    animate drop-shadow-blur { duration: Theme.fast; }
    forward-focus: focus;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    btn-text := Text {
        text: root.label;
        color: root.enabled ? Theme.on-accent : Theme.disabled-text;
        font-size: Theme.font-base;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    focus := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if focus.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

export component SecondaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    out property <bool> has-focus: focus.has-focus;
    callback clicked();

    height: 34px;
    width: btn-text.preferred-width + 32px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.hairline;
    background: touch.pressed ? Theme.menu-hover
                : touch.has-hover ? Theme.menu-bar-hover
                : Theme.elevated;
    animate background { duration: Theme.fast; }
    forward-focus: focus;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    btn-text := Text {
        text: root.label;
        color: !root.enabled ? Theme.disabled-text
            : touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        font-size: Theme.font-base;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    focus := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if focus.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

// Destructive action, with an optional icon before the label
export component DangerButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    // Greyed out and not clickable, but keeps its place
    in property <bool> enabled: true;
    // Its colour: red, or Theme.success for a go button
    in property <color> tone: Theme.danger;
    callback clicked();

    height: 34px;
    width: row.preferred-width + 28px;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? Theme.disabled-bg
                : touch.pressed ? root.tone.with-alpha(0.3)
                : touch.has-hover ? root.tone.with-alpha(0.22)
                : root.tone.with-alpha(0.14);
    animate background { duration: Theme.fast; }
    forward-focus: focus;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }

    row := HorizontalLayout {
        x: 14px;
        spacing: 6px;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: 11px;
                height: 11px;
                colorize: root.enabled ? root.tone : Theme.disabled-text;
            }
        }

        Text {
            text: root.label;
            color: root.enabled ? root.tone : Theme.disabled-text;
            font-size: Theme.font-base;
            font-weight: 600;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    focus := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if focus.has-focus: FocusRing {
        radius: root.border-radius;
    }
}
