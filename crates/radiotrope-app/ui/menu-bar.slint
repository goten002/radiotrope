import { DesktopShortcuts, ShortcutAction } from "shortcuts.slint";
import { Theme, Defaults, ViewOptions } from "defaults.slint";
import { ScrollBar } from "scroll-bar.slint";
import { Icon, AgentsChip, ButtonKeys, FocusRing, PopupCard, MenuSeparator, Picker, Chip, ChipVariant } from "components.slint";
import { VizStyle } from "visualization.slint";
import { Platform } from "@platform/wifi.slint";
import { Updates } from "updates.slint";
import { ConnectedPhone, MenuCommand, MenuState } from "menu-model.slint";
import { NativeMenu } from "@platform/window.slint";
export { ConnectedPhone }

// A connected phone as screen readers hear it in the chip's description
global PhoneNames {
    pure public function name(phone: ConnectedPhone) -> string {
        phone.listening ? phone.name + " (listening)" : phone.name
    }
}

// The phones chip's list: the phones connected, each listening one with a
// "Listening" chip (as in the Remote Control dialog)
export component PhonesBubble inherits PopupCard {
    in property <[ConnectedPhone]> phones;

    width: max(Defaults.info-tip-width, bubble.preferred-width);
    height: bubble.preferred-height;

    bubble := VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 10px;
        spacing: 6px;

        Text {
            text: root.phones.length == 1 ? "PHONE CONNECTED" : "PHONES CONNECTED";
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            font-weight: Theme.weight-semibold;
            letter-spacing: 0.5px;
        }

        for phone in root.phones: HorizontalLayout {
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                Icon {
                    width: 13px;
                    height: 13px;
                    source: @image-url("icons/phone.svg");
                    colorize: Theme.text-secondary;
                }
            }
            Text {
                text: phone.name;
                color: Theme.text-primary;
                font-size: Theme.font-md;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if phone.listening: VerticalLayout {
                alignment: center;
                Chip {
                    text: "Listening";
                    variant: ChipVariant.success;
                    keep: true;
                }
            }
        }
    }
}

// Where the arrow keys are in the open menu. Every row has a slot number
// in its menu; one menu is open at a time, so one place holds the active
// slot. A row takes the keyboard focus when its slot becomes the active
// one, so the focus ring, Space and Enter and screen readers all follow.
global MenuNav {
    // -1: no row yet (a menu opened with the mouse)
    in-out property <int> active: -1;
    // Counts the menus opened. A row belongs to the menu that was opening
    // when it was made: the rows of the menu being replaced are still
    // there for a moment, and one with the same slot would take the focus.
    out property <int> opening;
    public function begin() {
        self.opening += 1;
        self.active = -1;
    }

    // The row the arrow keys moved to (its place in the window), for a
    // menu taller than the window to scroll it into view
    out property <length> reached-y;
    out property <length> reached-height;
    out property <int> reached;
    public function reveal(y: length, height: length) {
        self.reached-y = y;
        self.reached-height = height;
        self.reached += 1;
    }

    pure function hit(usable: [bool], slot: int) -> bool {
        return slot >= 0 && slot < usable.length && usable[slot];
    }
    // The first usable slot from `from` on, going `dir` (1 or -1); -1 when
    // none. Slint functions have no loops, so the search is written out:
    // 4, 8, 16, then 32 slots, more than the longest menu has.
    pure function scan4(usable: [bool], from: int, dir: int) -> int {
        return hit(usable, from) ? from
            : hit(usable, from + dir) ? from + dir
            : hit(usable, from + 2 * dir) ? from + 2 * dir
            : hit(usable, from + 3 * dir) ? from + 3 * dir : -1;
    }
    pure function scan8(usable: [bool], from: int, dir: int) -> int {
        let near = scan4(usable, from, dir);
        return near >= 0 ? near : scan4(usable, from + 4 * dir, dir);
    }
    pure function scan16(usable: [bool], from: int, dir: int) -> int {
        let near = scan8(usable, from, dir);
        return near >= 0 ? near : scan8(usable, from + 8 * dir, dir);
    }
    public pure function scan(usable: [bool], from: int, dir: int) -> int {
        let near = scan16(usable, from, dir);
        return near >= 0 ? near : scan16(usable, from + 16 * dir, dir);
    }
    // The slot one step from the active one, going round at the ends;
    // rows that are greyed out or folded away are skipped
    public pure function step(usable: [bool], dir: int) -> int {
        let edge = dir > 0 ? 0 : usable.length - 1;
        if active < 0 {
            return scan(usable, edge, dir);
        }
        let next = scan(usable, active + dir, dir);
        return next >= 0 ? next : scan(usable, edge, dir);
    }
}

// What every menu row shows, laid out like the shared ChoiceRow: icon,
// label, then an optional note, shortcut, swatch, tick or arrow on the right
component MenuRowContent inherits HorizontalLayout {
    // Moved right under the group row that shows it (GroupMenuItem)
    in property <length> indent;
    in property <string> label;
    in property <image> icon;
    in property <bool> enabled: true;
    // Hovered or reached with Tab
    in property <bool> lit;
    // A faint note or a keyboard shortcut on the right ("Ctrl+Q")
    in property <string> trailing-text;
    // The text says why the row is greyed out, so it stays readable then
    in property <bool> trailing-note;
    // A small colour square on the right (Accent Color shows the accent)
    in property <bool> has-swatch;
    in property <color> swatch;
    // Keeps room for a tick, shown while checked
    in property <bool> checkable;
    in property <bool> checked;
    // A faint tick while not checked: an option to turn on, not a command
    in property <bool> placeholder;
    // An arrow that turns as the group opens and folds
    in property <bool> expandable;
    in property <bool> expanded;

    property <color> foreground: !root.enabled ? Theme.disabled-text
        : root.lit ? Theme.text-primary : Theme.menu-text;

    padding-left: Theme.space-8 + root.indent;
    padding-right: Theme.space-8;
    spacing: Theme.space-8;

    VerticalLayout {
        alignment: center;
        Icon {
            width: Theme.icon-md;
            height: Theme.icon-md;
            source: root.icon;
            colorize: root.foreground;
        }
    }

    Text {
        horizontal-stretch: 1;
        text: root.label;
        color: root.foreground;
        font-size: Theme.font-md;
        vertical-alignment: center;
        accessible-role: none;
    }

    // At least 24px after the label, so the shortcuts read as a column
    if root.trailing-text != "": HorizontalLayout {
        padding-left: Theme.space-16;
        Text {
            text: root.trailing-text;
            // Tertiary text drops under 4.5:1 on a hovered or focused row
            color: !root.enabled && !root.trailing-note ? Theme.disabled-text
                : root.enabled && root.lit ? Theme.text-secondary : Theme.text-tertiary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    if root.has-swatch: VerticalLayout {
        alignment: center;
        Rectangle {
            width: Theme.icon-sm;
            height: Theme.icon-sm;
            border-radius: Theme.radius-sm - 1px;
            background: root.swatch;
        }
    }

    if root.checkable: Rectangle {
        width: Theme.icon-sm;
        if root.checked || root.placeholder: Icon {
            width: Theme.icon-sm;
            height: Theme.icon-sm;
            source: @image-url("icons/tick.svg");
            colorize: !root.checked ? Theme.text-tertiary.with-alpha(0.3)
                : root.enabled ? Theme.selection-mark : Theme.disabled-text;
        }
    }

    // Points down while folded and up while open: the items show in
    // place, under the group, not in a side menu
    if root.expandable: VerticalLayout {
        alignment: center;
        Icon {
            width: Theme.icon-sm;
            height: Theme.icon-sm;
            source: root.expanded ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg");
            colorize: root.foreground;
        }
    }
}

// Background of a menu row: the same hover and press colours as ChoiceRow
component MenuRowBase inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> hovered;
    in property <bool> pressed;
    // Its place in the menu for the arrow keys (see MenuNav); -1: none
    in property <int> slot: -1;
    property <int> menu: -1;
    out property <bool> current: root.slot >= 0 && root.menu == MenuNav.opening && MenuNav.active == root.slot;
    init => { self.menu = MenuNav.opening; }
    // Reached with the keyboard: a scrolled menu brings the row into view
    property <bool> reached: root.current;
    changed reached => {
        if self.reached { MenuNav.reveal(self.absolute-position.y, self.height); }
    }

    height: Theme.row-menu;
    min-width: 200px;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? transparent
        : root.pressed ? Theme.pressed-bg
        : root.hovered ? Theme.hover-bg : transparent;
    animate background { duration: Theme.fast; }
}

component MenuItem inherits MenuRowBase {
    in property <length> indent;
    in property <string> label;
    in property <image> icon;
    // Its keyboard shortcut, shown on the right ("Ctrl+Q")
    in property <string> shortcut;
    in property <bool> has-swatch;
    in property <color> swatch;
    callback clicked();

    hovered: touch.has-hover || keys.has-focus;
    pressed: touch.pressed;

    changed current => {
        if self.current { keys.focus(); }
    }
    init => {
        if self.current { keys.focus(); }
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.shortcut;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
        // Reached with Tab: the arrow keys go on from here
        changed has-focus => {
            if self.has-focus && root.slot >= 0 { MenuNav.active = root.slot; }
        }
    }

    MenuRowContent {
        indent: root.indent;
        label: root.label;
        icon: root.icon;
        enabled: root.enabled;
        lit: root.hovered;
        trailing-text: root.shortcut;
        has-swatch: root.has-swatch;
        swatch: root.swatch;
    }

    if keys.has-focus: FocusRing {
        offset: -1px;
        radius: root.border-radius;
    }
}

// Why the items above it are greyed out, in the menu itself
component MenuNote inherits Rectangle {
    // Moved right under the group row that shows it (GroupMenuItem)
    in property <length> indent;
    in property <[string]> lines;

    VerticalLayout {
        // Lined up with the item labels (padding, icon, spacing)
        padding-left: Theme.space-8 + Theme.icon-md + Theme.space-8 + root.indent;
        padding-right: Theme.space-12;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-4;

        for line in root.lines: Text {
            text: line;
            color: Theme.text-tertiary;
            font-size: Theme.font-sm;
        }
    }
}

component CheckMenuItem inherits MenuRowBase {
    in property <length> indent;
    in property <string> label;
    in property <image> icon;
    in property <bool> checked;
    // A faint note on the right, before the tick
    in property <string> hint;
    // What the option does, for screen readers only (the menu stays short)
    in property <string> description;
    // One of a set where another is always ticked (the zoom percentages):
    // no faint tick while this one is off
    in property <bool> one-of-set;
    callback clicked();

    hovered: touch.has-hover || keys.has-focus;
    pressed: touch.pressed;

    changed current => {
        if self.current { keys.focus(); }
    }
    init => {
        if self.current { keys.focus(); }
    }

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-description: root.hint != "" ? root.hint : root.description;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
        // Reached with Tab: the arrow keys go on from here
        changed has-focus => {
            if self.has-focus && root.slot >= 0 { MenuNav.active = root.slot; }
        }
    }

    MenuRowContent {
        indent: root.indent;
        label: root.label;
        icon: root.icon;
        enabled: root.enabled;
        lit: root.hovered;
        trailing-text: root.hint;
        trailing-note: true;
        checkable: true;
        checked: root.checked;
        placeholder: !root.one-of-set;
    }

    if keys.has-focus: FocusRing {
        offset: -1px;
        radius: root.border-radius;
    }
}

// A group of set-once options, folded: a click (or Space, Enter, Right)
// shows its items right under it, indented, and another click folds them
// (Left folds too). The arrow points up while it is open.
component GroupMenuItem inherits MenuRowBase {
    in property <string> label;
    in property <image> icon;
    in property <bool> open;
    callback toggled();

    hovered: touch.has-hover || keys.has-focus;
    pressed: touch.pressed;

    changed current => {
        if self.current { keys.focus(); }
    }
    init => {
        if self.current { keys.focus(); }
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.toggled(); }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }

    keys := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return
                || (event.text == Key.RightArrow && !root.open)
                || (event.text == Key.LeftArrow && root.open) {
                root.toggled();
                return accept;
            }
            return reject;
        }
        // Reached with Tab: the arrow keys go on from here
        changed has-focus => {
            if self.has-focus && root.slot >= 0 { MenuNav.active = root.slot; }
        }
    }

    MenuRowContent {
        label: root.label;
        icon: root.icon;
        lit: root.hovered;
        expandable: true;
        expanded: root.open;
    }

    if keys.has-focus: FocusRing {
        offset: -1px;
        radius: root.border-radius;
    }
}

// View > Theme: the three choices in the row itself, one click each
// The arrow keys stop on the row as on any other; Space or Enter there
// moves to the next theme. Tab reaches the three choices themselves.
component ThemeMenuRow inherits Rectangle {
    in property <int> slot: -1;
    property <int> menu: -1;
    property <bool> current: root.slot >= 0 && root.menu == MenuNav.opening && MenuNav.active == root.slot;
    changed current => {
        if self.current { keys.focus(); }
    }
    init => {
        self.menu = MenuNav.opening;
        if self.current { keys.focus(); }
    }

    function next() {
        Theme.theme-mode = Theme.theme-mode == "system" ? "dark"
            : Theme.theme-mode == "dark" ? "light"
            : Platform.has-system-theme ? "system" : "dark";
    }

    height: Theme.control-button;
    min-width: 200px;
    border-radius: Theme.radius-sm;

    accessible-role: button;
    accessible-label: "Theme";
    accessible-description: Theme.theme-mode == "system" ? "System"
        : Theme.theme-mode == "dark" ? "Dark" : "Light";
    accessible-action-default => { root.next(); }

    keys := ButtonKeys {
        activated => { root.next(); }
        changed has-focus => {
            if self.has-focus && root.slot >= 0 { MenuNav.active = root.slot; }
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-8;
        padding-right: Theme.space-4;
        spacing: Theme.space-8;

        VerticalLayout {
            alignment: center;
            Icon {
                width: Theme.icon-md;
                height: Theme.icon-md;
                source: Theme.dark-mode ? @image-url("icons/moon.svg") : @image-url("icons/sun.svg");
                colorize: Theme.menu-text;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: "Theme";
            color: Theme.menu-text;
            font-size: Theme.font-md;
            vertical-alignment: center;
            accessible-role: none;
        }

        VerticalLayout {
            alignment: center;
            // System follows the OS; greyed where the OS can't say
            Picker {
                label: "Theme";
                compact: true;
                option-width: 54px;
                choices: [
                    { id: "system", label: "System", disabled: !Platform.has-system-theme },
                    { id: "dark", label: "Dark" },
                    { id: "light", label: "Light" },
                ];
                selected: Theme.theme-mode;
                changed(id) => { Theme.theme-mode = id; }
            }
        }
    }

    if keys.has-focus: FocusRing {
        offset: -1px;
        radius: root.border-radius;
    }
}

// Window button in our own title bar (minimize, maximize, close). Like
// system title bars, it is left out of the Tab order.
component CaptionButton inherits Rectangle {
    in property <string> label;
    // Close: turns red under the pointer, as window buttons do
    in property <bool> danger;
    callback clicked();
    out property <color> glyph: root.danger && (touch.pressed || touch.has-hover) ? #ffffff : Theme.menu-text;

    width: 42px;
    height: 32px;
    background: touch.pressed ? (root.danger ? Theme.danger.darker(0.2) : Theme.pressed-bg)
        : touch.has-hover ? (root.danger ? Theme.danger : Theme.hover-bg) : transparent;
    animate background { duration: Theme.fast; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    @children
}

// A menu's name in the bar; opens the menu on click, or on Space, Enter
// or Down once reached with Tab or F10 (the first row then has the focus).
// Left and Right go to the next title. It stays lit while its menu is open.
component MenuTitle inherits Rectangle {
    in property <string> label;
    // Greyed out and not clickable when false
    in property <bool> enabled: true;
    in property <bool> open;
    // A small accent dot beside the name: something new in the menu
    in property <bool> dot;
    // What the dot means, for screen readers
    in property <string> dot-label;
    // true: with the keyboard
    callback opened(bool);
    // Left (-1) or Right (1) on the title
    callback step(int);

    width: title.preferred-width + 20px;
    height: 32px;
    background: !root.enabled ? transparent
        : root.open || touch.pressed ? Theme.pressed-bg
        : touch.has-hover || keys.has-focus ? Theme.hover-bg : transparent;
    animate background { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.dot ? root.dot-label : "";
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => {
        if root.enabled {
            root.opened(true);
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.opened(false); }
    }

    title := Text {
        text: root.label;
        color: !root.enabled ? Theme.disabled-text
            : root.open ? Theme.text-primary : Theme.menu-text;
        font-size: Theme.font-base;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    if root.dot: Rectangle {
        x: parent.width - self.width - 3px;
        y: 8px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }

    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            if event.text == Key.Space || event.text == Key.Return || event.text == Key.DownArrow {
                root.opened(true);
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                root.step(event.text == Key.LeftArrow ? -1 : 1);
                return accept;
            }
            return reject;
        }
    }

    // Inside the edge: the bar is at the top of the window
    if keys.has-focus: FocusRing {
        offset: -Theme.focus-ring-width;
        radius: Theme.radius-sm;
    }
}

// What an open menu shows. Its popup starts at the bar's top left corner
// and covers the menu titles, so that moving onto another title opens that
// menu, as menu bars do (the window gets no pointer events outside an open
// popup). The card with the rows sits under its own title. A press on the
// empty parts closes the menu, like a press outside it.
//
// The card owns the arrow keys: Up, Down, Home and End move through the
// rows (see MenuNav), Left and Right open the neighbour menu, and Left on
// a row inside an open group folds the group.
component MenuPane inherits Rectangle {
    // Which menu this is (its place in `title-x`), or -1 for a menu that
    // is not in the bar (the window menu)
    in property <int> index: -1;
    // The menu's name, for screen readers: its rows are read as a group
    in property <string> label;
    // Where the titles are in the bar; empty for a menu not in the bar
    in property <[length]> title-x;
    in property <[length]> title-width;
    in property <length> bar-height: 32px;
    // Per slot: the row is shown and not greyed out
    in property <[bool]> usable;
    // While the active row is inside an open group: the group row's slot
    in property <int> fold-to: -1;
    callback fold();
    // (menu, with the keyboard): open that menu instead
    callback switch(int, bool);
    callback close();
    // Room for the rows under the bar: a taller menu scrolls (a short
    // window, a high zoom, a group unfolded)
    in property <length> room: 10000px;
    property <length> card-height: min(rows.preferred-height, root.room);
    // A scrolling menu is wider by its scroll bar, which then covers no row
    property <length> bar-room: rows.preferred-height > root.room ? Theme.space-8 + Theme.space-2 : 0px;
    property <length> card-width: rows.preferred-width + root.bar-room;

    property <int> reached: MenuNav.reached;
    changed reached => {
        let above = flick.absolute-position.y - MenuNav.reached-y;
        let below = MenuNav.reached-y + MenuNav.reached-height - flick.absolute-position.y - flick.height;
        if above > 0 {
            flick.content-y = min(0px, flick.content-y + above + Theme.space-4);
        } else if below > 0 {
            flick.content-y = max(flick.height - flick.content-height, flick.content-y - below - Theme.space-4);
        }
    }

    property <length> card-x: root.index >= 0 ? root.title-x[root.index] : 0;
    property <length> strip-height: root.index >= 0 ? root.bar-height : 0;
    property <length> titles-end: root.index >= 0
        ? root.title-x[root.title-x.length - 1] + root.title-width[root.title-x.length - 1] : 0;
    out property <length> wanted-width: max(root.titles-end, root.card-x + root.card-width);
    out property <length> wanted-height: root.strip-height + root.card-height;

    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.close();
            }
        }
    }

    for x[i] in root.title-x: TouchArea {
        x: x;
        width: root.title-width[i];
        height: root.strip-height;
        changed has-hover => {
            if self.has-hover && i != root.index {
                root.switch(i, false);
            }
        }
        // On its own title: closes the menu, as a second click does
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.close();
            }
        }
    }

    PopupCard {
        x: root.card-x;
        y: root.strip-height;
        width: root.card-width;
        height: root.card-height;
        accessible-role: groupbox;
        accessible-label: root.label;

        // A click between the rows (a line, a note) does nothing
        TouchArea { }

        FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: false;
            // Opened with the mouse: the keys work at once, with no row
            // marked until an arrow is pressed
            init => {
                if MenuNav.active < 0 { self.focus(); }
            }
            key-pressed(event) => {
                if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                    return reject;
                }
                if event.text == Key.DownArrow || event.text == Key.UpArrow {
                    MenuNav.active = MenuNav.step(root.usable, event.text == Key.DownArrow ? 1 : -1);
                    return accept;
                }
                if event.text == Key.Home {
                    MenuNav.active = MenuNav.scan(root.usable, 0, 1);
                    return accept;
                }
                if event.text == Key.End {
                    MenuNav.active = MenuNav.scan(root.usable, root.usable.length - 1, -1);
                    return accept;
                }
                if event.text == Key.LeftArrow && root.fold-to >= 0 {
                    MenuNav.active = root.fold-to;
                    root.fold();
                    return accept;
                }
                if (event.text == Key.LeftArrow || event.text == Key.RightArrow) && root.index >= 0 {
                    root.switch(Math.mod(root.index + (event.text == Key.LeftArrow ? -1 : 1) + root.title-x.length,
                        root.title-x.length), true);
                    return accept;
                }
                return reject;
            }

            // Scrolls with the wheel, the bar and the arrow keys; a drag
            // would take the rows' clicks
            flick := Flickable {
                width: parent.width - root.bar-room;
                interactive: false;
                content-width: self.width;
                content-height: rows.preferred-height;

                rows := VerticalLayout {
                    width: flick.width;
                    height: self.preferred-height;
                    padding: Theme.space-4;
                    @children
                }
            }

            ScrollBar {
                x: parent.width - self.width - Theme.space-2;
                y: Theme.space-4;
                height: parent.height - 2 * Theme.space-4;
                viewport-height: flick.height;
                content-height: flick.content-height;
                content-y <=> flick.content-y;
            }
        }
    }
}

export component MenuBar inherits Rectangle {
    // Not in the window where the menus are in the system's menu bar
    // (macOS): the bar still runs the commands and knows the items' state
    height: NativeMenu.active ? 0px : 32px;
    visible: !NativeMenu.active;
    // Transparent: drawn on the header background shared with the playback
    // panel (app.slint)

    // What a menu item does, for the items here and for those of the
    // system's menu bar (platform/macos/window.slint)
    public function run(command: MenuCommand) {
        if command == MenuCommand.network-stream { root.open-network-stream(); }
        if command == MenuCommand.quit { root.quit-app(); }
        if command == MenuCommand.search-stations { root.open-station-search(); }
        if command == MenuCommand.find-favorites { root.find-favorites(); }
        if command == MenuCommand.export-favorites { root.export-favorites(); }
        if command == MenuCommand.import-favorites { root.import-favorites(); }
        // On asks first (the dialog sets it); off is at once
        if command == MenuCommand.report-plays {
            if ViewOptions.report-plays {
                ViewOptions.report-plays = false;
                ViewOptions.report-plays-changed(false);
            } else {
                ViewOptions.report-plays-asking = true;
            }
        }
        if command == MenuCommand.accent-color { root.open-accent-color(); }
        if command == MenuCommand.visualizer { root.show-visualizer = !root.show-visualizer; }
        if command == MenuCommand.station-colors {
            VizStyle.palette = VizStyle.palette == "logo" ? "accent" : "logo";
        }
        if command == MenuCommand.station-stats { root.show-station-stats = !root.show-station-stats; }
        if command == MenuCommand.tray-icon { root.tray-icon = !root.tray-icon; }
        if command == MenuCommand.close-to-tray { root.close-to-tray = !root.close-to-tray; }
        if command == MenuCommand.start-in-tray { root.start-in-tray = !root.start-in-tray; }
        if command == MenuCommand.recording { root.toggle-recording(); }
        if command == MenuCommand.recording-settings { root.open-recording-settings(); }
        if command == MenuCommand.recordings-folder { root.open-recordings-folder(); }
        if command == MenuCommand.sleep-timer { root.open-sleep-timer(); }
        if command == MenuCommand.scheduler { root.open-schedule(); }
        if command == MenuCommand.filters { root.open-filters(); }
        if command == MenuCommand.equalizer { root.open-equalizer(); }
        if command == MenuCommand.statistics { root.open-statistics(); }
        if command == MenuCommand.agents { root.open-agents(); }
        if command == MenuCommand.remote-control { root.open-remote-control(); }
        if command == MenuCommand.keyboard-shortcuts { root.open-keyboard-shortcuts(); }
        // The answer shows in About
        if command == MenuCommand.check-for-updates {
            Updates.check-now();
            root.open-about();
        }
        if command == MenuCommand.auto-check-updates {
            Updates.auto-check = !Updates.auto-check;
            Updates.auto-check-changed(Updates.auto-check);
        }
        if command == MenuCommand.about { root.open-about(); }
        if command == MenuCommand.minimize { root.minimize(); }
        if command == MenuCommand.maximize { root.maximized = !root.maximized; }
    }
    // What the items show, for the system's menu bar
    out property <MenuState> state: {
        enabled: root.menus-enabled,
        has-favorites: root.has-favorites,
        recording: root.is-recording,
        can-record: root.can-toggle-recording,
        visualizer: root.show-visualizer,
        station-stats: root.show-station-stats,
        tray-icon: root.tray-icon,
        close-to-tray: root.close-to-tray,
        start-in-tray: root.start-in-tray,
        tray-available: root.tray-available,
        agents-label: root.agents-label,
        phones-label: root.phones-label,
        phones: root.phones,
    };
    // The chips' labels: "2 phones connected, 1 listening"; "" for none
    property <string> phones-label: root.phones.length == 0 ? ""
        : (root.phones.length == 1 ? "1 phone connected" : root.phones.length + " phones connected")
            + (root.phones-listening > 0 ? ", " + root.phones-listening + " listening" : "");
    property <string> agents-label: root.agent-count == 0 ? ""
        : root.agent-count == 1 ? "1 agent using the player" : root.agent-count + " agents using the player";

    callback open-network-stream();
    callback open-station-search();
    // Stations > Find in Favorites: the favorites' find field (as `/`),
    // greyed with no favorites
    callback find-favorites();
    in property <bool> has-favorites: true;
    callback export-favorites();
    callback import-favorites();
    callback open-statistics();
    callback open-equalizer();
    callback open-filters();
    callback open-accent-color();
    in-out property <bool> show-station-stats: true;
    // The header visualizer tile (View > Visualizer)
    in-out property <bool> show-visualizer: true;
    callback open-wifi-settings();
    callback open-about();
    callback open-keyboard-shortcuts();
    in property <bool> is-recording;
    in property <bool> can-toggle-recording;
    callback toggle-recording();
    callback open-recording-settings();
    callback open-recordings-folder();
    callback open-agents();
    callback open-remote-control();
    callback open-sleep-timer();
    callback open-schedule();
    // The menus are greyed out while a dialog is open; the window buttons
    // and moving the window still work
    in property <bool> menus-enabled: true;
    // The window's height: a menu taller than the room under the bar scrolls
    in property <length> window-height: 10000px;
    property <length> menu-room: root.window-height - root.height - Theme.space-8;
    // Agents (MCP) using the player now, and one line about each: a chip
    // at the end of the bar, only while there are any
    in property <int> agent-count;
    // The chip's hover bubble, drawn by the window (see AgentsChip)
    out property <bool> agents-bubble-open: root.agent-count > 0 && root.agents-hover;
    out property <length> agents-bubble-right;
    out property <length> agents-bubble-top;
    property <bool> agents-hover: false;
    // Phones with the Radiotrope Remote app connected (Remote Control): a
    // chip beside the agents chip, only while there are any
    in property <[ConnectedPhone]> phones;
    // How many of them listen to the station
    in property <int> phones-listening;
    out property <bool> phones-bubble-open: root.phones.length > 0 && root.phones-hover;
    out property <length> phones-bubble-right;
    out property <length> phones-bubble-top;
    property <bool> phones-hover: false;
    changed phones => {
        if root.phones.length == 0 {
            root.phones-hover = false;
        }
    }
    // The chip goes away with the last agent, and its hover with it
    changed agent-count => {
        if root.agent-count == 0 {
            root.agents-hover = false;
        }
    }

    // Our own title bar: the bar moves the window and ends with the window
    // buttons (desktop only, when the system frame is turned off)
    in property <bool> custom-frame;
    in-out property <bool> maximized;
    callback minimize();
    callback toggle-custom-frame();
    in-out property <bool> rounded-corners;
    in property <bool> corners-available;
    in property <string> corners-hint;
    callback rounded-corners-changed();
    // (x, y, pressed) -> whether the system shows its menu (on press or on
    // the release that follows)
    callback show-system-menu(length, length, bool) -> bool;

    // Open a menu, with one of its groups unfolded ("zoom", "window" or
    // "tray" in View; "recordings" or "connections" in Tools)
    public function open-menu(menu: string, group: string) {
        if menu == "open" { root.show-menu(0, false); }
        if menu == "stations" { root.show-menu(1, false); }
        if menu == "view" {
            root.show-menu(2, false);
            root.view-group = group;
        }
        if menu == "tools" {
            root.show-menu(3, false);
            root.tools-group = group;
        }
        if menu == "help" { root.show-menu(4, false); }
        if menu == "window" {
            root.window-menu-x = move-area.x + 2px;
            root.window-menu-y = 29px;
            MenuNav.begin();
            window-popup.show();
        }
    }

    // F10: the keyboard goes to the first menu title
    public function focus-menus() {
        if root.menus-enabled && !NativeMenu.active {
            open-menu.focus();
        }
    }

    // Menus in the bar, by number: 0 Open, 1 Stations, 2 View, 3 Tools,
    // 4 Help. Opening one closes the one that was open. With the keyboard
    // the first row gets the focus.
    function show-menu(index: int, keyboard: bool) {
        MenuNav.begin();
        root.view-group = "";
        root.tools-group = "";
        root.confirm-power-off = false;
        root.confirm-restart = false;
        if index == 0 { open-popup.show(); }
        if index == 1 { stations-popup.show(); }
        if index == 2 { view-popup.show(); }
        if index == 3 { tools-popup.show(); }
        if index == 4 { help-popup.show(); }
        if keyboard {
            MenuNav.active = MenuNav.scan(index == 0 ? root.open-usable
                : index == 1 ? root.stations-usable
                : index == 2 ? root.view-usable
                : index == 3 ? root.tools-usable : root.help-usable, 0, 1);
        }
    }

    function focus-title(index: int) {
        if index == 0 { open-menu.focus(); }
        if index == 1 { stations-menu.focus(); }
        if index == 2 { view-menu.focus(); }
        if index == 3 { tools-menu.focus(); }
        if index == 4 { help-menu.focus(); }
    }

    in property <string> snapshot-bubble;
    property <length> window-menu-x;
    // Where the first menu starts (the bar's left padding)
    property <length> menu-start: 4px;
    property <length> window-menu-y;
    // Where the titles are, for the open menu (see MenuPane)
    property <[length]> title-x: [
        root.menu-start,
        root.menu-start + open-menu.width,
        root.menu-start + open-menu.width + stations-menu.width,
        root.menu-start + open-menu.width + stations-menu.width + view-menu.width,
        root.menu-start + open-menu.width + stations-menu.width + view-menu.width + tools-menu.width,
    ];
    property <[length]> title-width: [
        open-menu.width, stations-menu.width, view-menu.width, tools-menu.width, help-menu.width,
    ];
    callback close-window();
    // System tray options (View menu) and Quit (Open menu)
    in-out property <bool> tray-icon;
    in-out property <bool> close-to-tray;
    in-out property <bool> start-in-tray;
    in-out property <bool> start-at-login;
    callback start-at-login-changed(bool);
    in-out property <bool> hide-on-minimize;
    in property <bool> tray-available: true;
    callback quit-app();
    // Power Off and Restart (the Pi's Open menu); each asks twice
    callback power-off();
    callback restart();
    property <bool> confirm-power-off: false;
    property <bool> confirm-restart: false;

    // The unfolded group of the View menu ("", "zoom", "window" or
    // "tray") and of the Tools menu ("", "recordings" or "connections"):
    // one at a time, folded again when the menu is opened
    property <string> view-group;
    property <string> tools-group;
    // The zoom is the window's scale: not on the Pi's full screen
    property <bool> zoom-open: Platform.has-window-frame && root.view-group == "zoom";
    property <bool> window-open: Platform.has-frame-choice && root.view-group == "window";
    property <bool> tray-open: Platform.has-tray && root.view-group == "tray";
    property <bool> tray-usable: root.tray-open && root.tray-icon && root.tray-available;

    // For the arrow keys: which rows of each menu are shown and not greyed
    // out, by slot (the `slot` of each row below). Keep the two in step.
    property <[bool]> open-usable: [
        true, !Platform.has-power-off, Platform.has-power-off, Platform.has-power-off,
    ];
    property <[bool]> stations-usable: [true, root.has-favorites, Platform.has-file-manager, Platform.has-file-manager, true];
    property <[bool]> window-usable: [true, true, true];
    property <[bool]> view-usable: [
        // 0 Theme, 1 Accent Color, 2 Visualizer, 3 Station Colors in Visualizer
        true, true, true, root.show-visualizer,
        // 4 Show Listening Stats
        true,
        // 5 Zoom, 6-10 its percentages (those too large for the screen greyed)
        Platform.has-window-frame,
        root.zoom-open && ViewOptions.zoom-choices[0] <= ViewOptions.zoom-fits,
        root.zoom-open && ViewOptions.zoom-choices[1] <= ViewOptions.zoom-fits,
        root.zoom-open && ViewOptions.zoom-choices[2] <= ViewOptions.zoom-fits,
        root.zoom-open && ViewOptions.zoom-choices[3] <= ViewOptions.zoom-fits,
        root.zoom-open && ViewOptions.zoom-choices[4] <= ViewOptions.zoom-fits,
        // 11 Window, 12 Use System Title Bar, 13 Rounded Corners (not on
        // macOS, where the system's title bar is the only one)
        Platform.has-frame-choice, root.window-open,
        root.window-open && root.custom-frame && root.corners-available,
        // 14 System Tray, 15 Show Tray Icon, 16-18 the three tray choices
        // (17 Minimize to Tray not on macOS), 19 Start at Login (nor that)
        Platform.has-tray, root.tray-open, root.tray-usable,
        root.tray-usable && Platform.has-minimize-to-tray, root.tray-usable,
        root.tray-open && Platform.has-start-at-login,
    ];
    property <[bool]> tools-usable: [
        // 0 Start Recording, 1 Recordings, 2 Settings, 3 Open Folder
        root.can-toggle-recording, true, root.tools-group == "recordings",
        Platform.has-file-manager && root.tools-group == "recordings",
        // 4 Sleep Timer, 5 Scheduler
        true, true,
        // 6 Filters, 7 Equalizer, 8 Statistics
        true, true, true,
        // 9 Connections, 10 Agents (MCP), 11 Remote Control
        true, root.tools-group == "connections", root.tools-group == "connections",
        // 12 Wi-Fi Settings
        Platform.has-wifi,
    ];
    // 0 Update Available, 1 Keyboard Shortcuts, 2 Check for Updates,
    // 3 Check for Updates Automatically, 4 About Radiotrope
    property <[bool]> help-usable: [
        Updates.enabled && Updates.available != "", DesktopShortcuts.enabled,
        Updates.enabled, Updates.enabled, true,
    ];

    HorizontalLayout {
        padding-left: 4px;
        padding-right: root.custom-frame ? 0 : 4px;
        alignment: stretch;

        open-menu := MenuTitle {
            label: "Open";
            enabled: root.menus-enabled;
            open: open-popup.is-open;
            opened(keyboard) => { root.show-menu(0, keyboard); }
            step(by) => { root.focus-title(by < 0 ? 4 : 1); }
        }

        stations-menu := MenuTitle {
            label: "Stations";
            enabled: root.menus-enabled;
            open: stations-popup.is-open;
            opened(keyboard) => { root.show-menu(1, keyboard); }
            step(by) => { root.focus-title(1 + by); }
        }

        view-menu := MenuTitle {
            label: "View";
            enabled: root.menus-enabled;
            open: view-popup.is-open;
            opened(keyboard) => { root.show-menu(2, keyboard); }
            step(by) => { root.focus-title(2 + by); }
        }

        tools-menu := MenuTitle {
            label: "Tools";
            enabled: root.menus-enabled;
            open: tools-popup.is-open;
            opened(keyboard) => { root.show-menu(3, keyboard); }
            step(by) => { root.focus-title(3 + by); }
        }

        help-menu := MenuTitle {
            label: "Help";
            enabled: root.menus-enabled;
            open: help-popup.is-open;
            // Quiet: a newer version is out (the menu's first row says which)
            dot: Updates.enabled && Updates.available != "";
            dot-label: "Update available";
            opened(keyboard) => { root.show-menu(4, keyboard); }
            step(by) => { root.focus-title(by < 0 ? 3 : 0); }
        }

        // Empty part of the bar: drag to move, double-click to maximize
        move-area := WindowMoveArea {
            horizontal-stretch: 1;
            enabled: root.custom-frame;

            move-touch := TouchArea {
                enabled: root.custom-frame;
                double-clicked => { root.maximized = !root.maximized; }
                // Right-click: the system window menu, or ours where the
                // system has none (ours opens on press: X11 window managers
                // can close a popup opened on release)
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        if !root.show-system-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, true) {
                            root.window-menu-x = move-area.x + self.mouse-x + 2px;
                            root.window-menu-y = self.mouse-y + 2px;
                            MenuNav.begin();
                            window-popup.show();
                        }
                    } else if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                        root.show-system-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
                    }
                }
            }
        }

        if root.phones.length > 0: VerticalLayout {
            alignment: center;
            padding-right: 6px;
            AgentsChip {
                count: root.phones.length;
                label: root.phones-label;
                // The names in the bubble (the first three)
                description: PhoneNames.name(root.phones[0])
                    + (root.phones.length > 1 ? ", " + PhoneNames.name(root.phones[1]) : "")
                    + (root.phones.length > 2 ? ", " + PhoneNames.name(root.phones[2]) : "")
                    + (root.phones.length > 3 ? " and " + (root.phones.length - 3) + " more" : "");
                snapshot-bubble: root.snapshot-bubble == "phones";
                icon: @image-url("icons/phone.svg");
                show-bubble(right, top) => {
                    root.phones-bubble-right = right;
                    root.phones-bubble-top = top;
                    root.phones-hover = true;
                }
                hide-bubble => { root.phones-hover = false; }
            }
        }

        if root.agent-count > 0: VerticalLayout {
            alignment: center;
            padding-right: 6px;
            AgentsChip {
                count: root.agent-count;
                label: root.agents-label;
                description: "Tools > Connections > Agents (MCP) has the details";
                snapshot-bubble: root.snapshot-bubble == "agents";
                show-bubble(right, top) => {
                    root.agents-bubble-right = right;
                    root.agents-bubble-top = top;
                    root.agents-hover = true;
                }
                hide-bubble => { root.agents-hover = false; }
            }
        }

        if root.custom-frame: HorizontalLayout {
            padding-left: 6px;

            min := CaptionButton {
                label: "Minimize";
                clicked => { root.minimize(); }

                Rectangle {
                    width: 10px;
                    height: 1px;
                    background: min.glyph;
                }
            }

            max := CaptionButton {
                label: root.maximized ? "Restore" : "Maximize";
                clicked => { root.maximized = !root.maximized; }

                if !root.maximized: Rectangle {
                    width: 10px;
                    height: 10px;
                    border-width: 1px;
                    border-radius: 1px;
                    border-color: max.glyph;
                }
                // Restore: two overlapping squares
                if root.maximized: Rectangle {
                    width: 10px;
                    height: 10px;

                    Rectangle {
                        x: 2px;
                        y: 0;
                        width: 8px;
                        height: 8px;
                        border-width: 1px;
                        border-radius: 1px;
                        border-color: max.glyph;
                    }
                    Rectangle {
                        x: 0;
                        y: 2px;
                        width: 8px;
                        height: 8px;
                        border-width: 1px;
                        border-radius: 1px;
                        border-color: max.glyph;
                        background: Theme.panel;
                    }
                }
            }

            close := CaptionButton {
                label: "Close";
                danger: true;
                clicked => { root.close-window(); }

                Path {
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                    stroke: close.glyph;
                    stroke-width: 1.2px;
                }
            }
        }
    }

    // An item acts first and closes its menu after: closing drops the
    // popup's elements, and a statement after close() in an item under an
    // `if` (Quit, Restart, Power Off) never ran
    open-popup := PopupWindow {
        x: 0;
        y: 0;
        width: open-pane.wanted-width;
        height: open-pane.wanted-height;
        // Clicks inside don't close the menu: commands and dialogs close it
        // themselves, ticks stay open to show the change. Esc still closes.
        close-policy: close-on-click-outside;

        open-pane := MenuPane {
            room: root.menu-room;
            index: 0;
            label: "Open";
            title-x: root.title-x;
            title-width: root.title-width;
            usable: root.open-usable;
            switch(menu, keyboard) => { root.show-menu(menu, keyboard); }
            close => { open-popup.close(); }

            MenuItem {
                slot: 0;
                label: "Network Stream";
                shortcut: DesktopShortcuts.enabled ? DesktopShortcuts.label(ShortcutAction.network-stream) : "";
                icon: @image-url("icons/link.svg");
                clicked => {
                    root.run(MenuCommand.network-stream);
                    open-popup.close();
                }
            }
            MenuSeparator {}
            if !Platform.has-power-off: MenuItem {
                slot: 1;
                label: "Quit";
                icon: @image-url("icons/power-off.svg");
                shortcut: DesktopShortcuts.enabled ? DesktopShortcuts.label(ShortcutAction.quit) : "";
                clicked => {
                    root.run(MenuCommand.quit);
                    open-popup.close();
                }
            }
            // The Pi: Power Off and Restart ask twice, and the first
            // press stays until the menu is opened again. Wide enough
            // for the longer label, so asking doesn't move the menu
            if Platform.has-power-off: MenuItem {
                slot: 2;
                label: root.confirm-restart ? "Press Again to Restart" : "Restart";
                icon: @image-url("icons/rotate-right.svg");
                min-width: 230px;
                clicked => {
                    if root.confirm-restart {
                        root.restart();
                        open-popup.close();
                    } else {
                        root.confirm-restart = true;
                        root.confirm-power-off = false;
                    }
                }
            }
            if Platform.has-power-off: MenuItem {
                slot: 3;
                label: root.confirm-power-off ? "Press Again to Power Off" : "Power Off";
                icon: @image-url("icons/power-off.svg");
                min-width: 230px;
                clicked => {
                    if root.confirm-power-off {
                        root.power-off();
                        open-popup.close();
                    } else {
                        root.confirm-power-off = true;
                        root.confirm-restart = false;
                    }
                }
            }
        }
    }

    stations-popup := PopupWindow {
        x: 0;
        y: 0;
        width: stations-pane.wanted-width;
        height: stations-pane.wanted-height;
        close-policy: close-on-click-outside;

        stations-pane := MenuPane {
            room: root.menu-room;
            index: 1;
            label: "Stations";
            title-x: root.title-x;
            title-width: root.title-width;
            usable: root.stations-usable;
            switch(menu, keyboard) => { root.show-menu(menu, keyboard); }
            close => { stations-popup.close(); }

            MenuItem {
                slot: 0;
                label: "Search Stations";
                shortcut: DesktopShortcuts.enabled ? DesktopShortcuts.label(ShortcutAction.search) : "";
                icon: @image-url("icons/magnifying-glass.svg");
                clicked => {
                    root.run(MenuCommand.search-stations);
                    stations-popup.close();
                }
            }
            MenuItem {
                slot: 1;
                label: "Find in Favorites";
                enabled: root.has-favorites;
                shortcut: DesktopShortcuts.enabled ? DesktopShortcuts.label(ShortcutAction.find-favorites) : "";
                icon: @image-url("icons/star-regular.svg");
                clicked => {
                    stations-popup.close();
                    root.run(MenuCommand.find-favorites);
                }
            }
            MenuSeparator {}
            // Need a file dialog, which the kiosk build lacks
            MenuItem {
                slot: 2;
                label: "Export Favorites";
                enabled: Platform.has-file-manager;
                icon: @image-url("icons/file-export.svg");
                clicked => {
                    root.run(MenuCommand.export-favorites);
                    stations-popup.close();
                }
            }
            MenuItem {
                slot: 3;
                label: "Import Favorites";
                enabled: Platform.has-file-manager;
                icon: @image-url("icons/file-import.svg");
                clicked => {
                    root.run(MenuCommand.import-favorites);
                    stations-popup.close();
                }
            }
            MenuSeparator {}
            // A play of a station from the directory (Search Stations or a
            // favorite saved from it) tells the directory its id, for its
            // "most played" lists
            CheckMenuItem {
                slot: 4;
                label: "Report Play Count";
                icon: @image-url("icons/chart-column.svg");
                description: "Tells the station directory which station you play, to rank popular stations.";
                checked: ViewOptions.report-plays;
                // On asks first, in a dialog; off is at once
                clicked => {
                    root.run(MenuCommand.report-plays);
                    if ViewOptions.report-plays-asking {
                        stations-popup.close();
                    }
                }
            }
        }
    }

    // Our window menu, for systems without one (some X11 window managers)
    window-popup := PopupWindow {
        x: root.window-menu-x;
        y: root.window-menu-y;
        width: window-pane.wanted-width;
        height: window-pane.wanted-height;
        close-policy: close-on-click-outside;

        window-pane := MenuPane {
            label: "Window";
            usable: root.window-usable;
            close => { window-popup.close(); }

            MenuItem {
                slot: 0;
                label: "Minimize";
                icon: @image-url("icons/window-minimize.svg");
                clicked => {
                    root.minimize();
                    window-popup.close();
                }
            }
            MenuItem {
                slot: 1;
                label: root.maximized ? "Restore" : "Maximize";
                icon: root.maximized ? @image-url("icons/window-restore.svg") : @image-url("icons/window-maximize.svg");
                clicked => {
                    root.maximized = !root.maximized;
                    window-popup.close();
                }
            }
            MenuSeparator {}
            MenuItem {
                slot: 2;
                label: "Close";
                icon: @image-url("icons/xmark.svg");
                clicked => {
                    root.close-window();
                    window-popup.close();
                }
            }
        }
    }

    view-popup := PopupWindow {
        x: 0;
        y: 0;
        width: view-pane.wanted-width;
        height: view-pane.wanted-height;
        close-policy: close-on-click-outside;

        view-pane := MenuPane {
            room: root.menu-room;
            index: 2;
            label: "View";
            title-x: root.title-x;
            title-width: root.title-width;
            usable: root.view-usable;
            // Left on a row of an open group folds it
            fold-to: root.zoom-open && MenuNav.active >= 6 && MenuNav.active <= 10 ? 5
                : root.window-open && MenuNav.active >= 12 && MenuNav.active <= 13 ? 11
                : root.tray-open && MenuNav.active >= 15 && MenuNav.active <= 19 ? 14 : -1;
            fold => { root.view-group = ""; }
            switch(menu, keyboard) => { root.show-menu(menu, keyboard); }
            close => { view-popup.close(); }

            ThemeMenuRow {
                slot: 0;
            }
            MenuItem {
                slot: 1;
                label: "Accent Color";
                icon: @image-url("icons/palette.svg");
                has-swatch: true;
                swatch: Theme.accent;
                clicked => {
                    root.run(MenuCommand.accent-color);
                    view-popup.close();
                }
            }
            MenuSeparator {}
            CheckMenuItem {
                slot: 2;
                label: "Visualizer";
                icon: @image-url("icons/visualizer.svg");
                checked: root.show-visualizer;
                clicked => {
                    root.run(MenuCommand.visualizer);
                }
            }
            // Keeps its choice while the visualizer is off
            CheckMenuItem {
                slot: 3;
                label: "Station Colors in Visualizer";
                icon: @image-url("icons/fill-drip.svg");
                enabled: root.show-visualizer;
                checked: VizStyle.palette == "logo";
                clicked => {
                    root.run(MenuCommand.station-colors);
                }
            }
            MenuSeparator {}
            CheckMenuItem {
                slot: 4;
                label: "Show Listening Stats";
                icon: @image-url("icons/clock.svg");
                checked: root.show-station-stats;
                clicked => {
                    root.run(MenuCommand.station-stats);
                }
            }
            // The whole window larger or smaller. Slint takes the scale
            // when the window is made, so a choice waits for the next start.
            if Platform.has-window-frame: GroupMenuItem {
                slot: 5;
                label: "Zoom";
                icon: @image-url("icons/magnifying-glass.svg");
                open: root.zoom-open;
                toggled => { root.view-group = root.zoom-open ? "" : "zoom"; }
            }
            if root.zoom-open: VerticalLayout {
                for percent[i] in ViewOptions.zoom-choices: CheckMenuItem {
                    slot: 6 + i;
                    label: percent + "%";
                    indent: Theme.space-16;
                    one-of-set: true;
                    // Greyed when its smallest window is larger than the screen
                    enabled: percent <= ViewOptions.zoom-fits;
                    hint: percent > ViewOptions.zoom-fits ? "Too large for this screen" : "";
                    checked: ViewOptions.zoom == percent;
                    clicked => { ViewOptions.zoom = percent; }
                }
                // Only while a zoom other than the window's is picked;
                // picking the window's own again cancels it
                if ViewOptions.zoom-note != "": MenuNote {
                    indent: Theme.space-16;
                    lines: [ViewOptions.zoom-note];
                }
            }
            // The set-once options, folded into groups (desktop only)
            if Platform.has-window-frame || Platform.has-tray: MenuSeparator {}
            if Platform.has-frame-choice: GroupMenuItem {
                slot: 11;
                label: "Window";
                icon: @image-url("icons/window-maximize.svg");
                open: root.window-open;
                toggled => { root.view-group = root.window-open ? "" : "window"; }
            }
            if root.window-open: VerticalLayout {
                CheckMenuItem {
                    slot: 12;
                    // Chrome's wording: ticked means the system frame
                    label: "Use System Title Bar";
                    icon: @image-url("icons/window-maximize.svg");
                    indent: Theme.space-16;
                    checked: !root.custom-frame;
                    clicked => {
                        root.toggle-custom-frame();
                        view-popup.close();
                    }
                }
                CheckMenuItem {
                    slot: 13;
                    // The system title bar has its own corners
                    label: "Rounded Corners";
                    icon: @image-url("icons/rounded-corner.svg");
                    indent: Theme.space-16;
                    enabled: root.custom-frame && root.corners-available;
                    hint: root.corners-available ? "" : root.corners-hint;
                    checked: root.rounded-corners;
                    clicked => {
                        root.rounded-corners = !root.rounded-corners;
                        root.rounded-corners-changed();
                    }
                }
            }
            if Platform.has-tray: GroupMenuItem {
                slot: 14;
                label: "System Tray";
                icon: @image-url("icons/window-restore.svg");
                open: root.tray-open;
                toggled => { root.view-group = root.tray-open ? "" : "tray"; }
            }
            if root.tray-open: VerticalLayout {
                CheckMenuItem {
                    slot: 15;
                    label: "Show Tray Icon";
                    icon: @image-url("icons/window-restore.svg");
                    indent: Theme.space-16;
                    checked: root.tray-icon;
                    clicked => {
                        root.run(MenuCommand.tray-icon);
                    }
                }
                // Greyed with no tray to hide in; they keep their ticks
                CheckMenuItem {
                    slot: 16;
                    label: "Close to Tray";
                    icon: @image-url("icons/rectangle-xmark.svg");
                    indent: Theme.space-16;
                    enabled: root.tray-icon && root.tray-available;
                    checked: root.close-to-tray;
                    clicked => {
                        root.run(MenuCommand.close-to-tray);
                    }
                }
                if Platform.has-minimize-to-tray: CheckMenuItem {
                    slot: 17;
                    label: "Minimize to Tray";
                    icon: @image-url("icons/square-minus.svg");
                    indent: Theme.space-16;
                    enabled: root.tray-icon && root.tray-available;
                    checked: root.hide-on-minimize;
                    clicked => {
                        root.hide-on-minimize = !root.hide-on-minimize;
                    }
                }
                CheckMenuItem {
                    slot: 18;
                    label: "Start Hidden in Tray";
                    icon: @image-url("icons/eye-slash.svg");
                    indent: Theme.space-16;
                    enabled: root.tray-icon && root.tray-available;
                    checked: root.start-in-tray;
                    clicked => {
                        root.run(MenuCommand.start-in-tray);
                    }
                }
                // Saved in the autostart file or the Run key, not the settings
                if Platform.has-start-at-login: CheckMenuItem {
                    slot: 19;
                    label: "Start at Login";
                    icon: @image-url("icons/desktop.svg");
                    indent: Theme.space-16;
                    checked: root.start-at-login;
                    clicked => {
                        root.start-at-login = !root.start-at-login;
                        root.start-at-login-changed(root.start-at-login);
                    }
                }
                if root.tray-icon && !root.tray-available: MenuNote {
                    indent: Theme.space-16;
                    lines: ["This desktop doesn't show tray icons.", "On GNOME, turn on the AppIndicator extension."];
                }
            }
        }
    }

    help-popup := PopupWindow {
        x: 0;
        y: 0;
        width: help-pane.wanted-width;
        height: help-pane.wanted-height;
        close-policy: close-on-click-outside;

        help-pane := MenuPane {
            room: root.menu-room;
            index: 4;
            label: "Help";
            title-x: root.title-x;
            title-width: root.title-width;
            usable: root.help-usable;
            switch(menu, keyboard) => { root.show-menu(menu, keyboard); }
            close => { help-popup.close(); }

            // Only while a newer version is out: About says more, and
            // installs it where the build can
            if Updates.enabled && Updates.available != "": MenuItem {
                slot: 0;
                label: "Update Available: \{Updates.available}";
                icon: @image-url("icons/bell.svg");
                clicked => {
                    root.run(MenuCommand.about);
                    help-popup.close();
                }
            }
            if Updates.enabled && Updates.available != "": MenuSeparator {}
            if DesktopShortcuts.enabled: MenuItem {
                slot: 1;
                label: "Keyboard Shortcuts";
                icon: @image-url("icons/keyboard.svg");
                shortcut: DesktopShortcuts.label(ShortcutAction.help);
                // Open first: closing the popup takes this item with it
                clicked => {
                    root.run(MenuCommand.keyboard-shortcuts);
                    help-popup.close();
                }
            }
            // Not in builds a package manager updates
            if Updates.enabled && DesktopShortcuts.enabled: MenuSeparator {}
            // The answer shows in About
            if Updates.enabled: MenuItem {
                slot: 2;
                label: "Check for Updates";
                icon: @image-url("icons/rotate-right.svg");
                clicked => {
                    root.run(MenuCommand.check-for-updates);
                    help-popup.close();
                }
            }
            if Updates.enabled: CheckMenuItem {
                slot: 3;
                label: "Check for Updates Automatically";
                icon: @image-url("icons/clock.svg");
                checked: Updates.auto-check;
                clicked => {
                    root.run(MenuCommand.auto-check-updates);
                }
            }
            if Updates.enabled: MenuSeparator {}
            MenuItem {
                slot: 4;
                label: "About Radiotrope";
                icon: @image-url("icons/circle-info.svg");
                clicked => {
                    root.run(MenuCommand.about);
                    help-popup.close();
                }
            }
        }
    }

    tools-popup := PopupWindow {
        x: 0;
        y: 0;
        width: tools-pane.wanted-width;
        height: tools-pane.wanted-height;
        close-policy: close-on-click-outside;

        tools-pane := MenuPane {
            room: root.menu-room;
            index: 3;
            label: "Tools";
            title-x: root.title-x;
            title-width: root.title-width;
            usable: root.tools-usable;
            fold-to: root.tools-group == "recordings" && MenuNav.active >= 2 && MenuNav.active <= 3 ? 1
                : root.tools-group == "connections" && MenuNav.active >= 10 && MenuNav.active <= 11 ? 9 : -1;
            fold => { root.tools-group = ""; }
            switch(menu, keyboard) => { root.show-menu(menu, keyboard); }
            close => { tools-popup.close(); }

            MenuItem {
                slot: 0;
                label: root.is-recording ? "Stop Recording" : "Start Recording";
                shortcut: DesktopShortcuts.enabled ? DesktopShortcuts.label(ShortcutAction.record) : "";
                // Greyed out until a station plays
                enabled: root.can-toggle-recording;
                icon: @image-url("icons/record.svg");
                clicked => {
                    root.run(MenuCommand.recording);
                    tools-popup.close();
                }
            }
            GroupMenuItem {
                slot: 1;
                label: "Recordings";
                icon: @image-url("icons/folder.svg");
                open: root.tools-group == "recordings";
                toggled => { root.tools-group = root.tools-group == "recordings" ? "" : "recordings"; }
            }
            if root.tools-group == "recordings": VerticalLayout {
                MenuItem {
                    slot: 2;
                    label: "Settings";
                    icon: @image-url("icons/gear.svg");
                    indent: Theme.space-16;
                    clicked => {
                        root.run(MenuCommand.recording-settings);
                        tools-popup.close();
                    }
                }
                if Platform.has-file-manager: MenuItem {
                    slot: 3;
                    label: "Open Folder";
                    icon: @image-url("icons/folder-open.svg");
                    indent: Theme.space-16;
                    clicked => {
                        root.run(MenuCommand.recordings-folder);
                        tools-popup.close();
                    }
                }
            }
            MenuSeparator {}
            MenuItem {
                slot: 4;
                label: "Sleep Timer";
                icon: @image-url("icons/moon.svg");
                clicked => {
                    root.run(MenuCommand.sleep-timer);
                    tools-popup.close();
                }
            }
            MenuItem {
                slot: 5;
                label: "Scheduler";
                icon: @image-url("icons/calendar.svg");
                clicked => {
                    root.run(MenuCommand.scheduler);
                    tools-popup.close();
                }
            }
            MenuSeparator {}
            MenuItem {
                slot: 6;
                label: "Filters";
                icon: @image-url("icons/wave-square.svg");
                clicked => {
                    root.run(MenuCommand.filters);
                    tools-popup.close();
                }
            }
            MenuItem {
                slot: 7;
                label: "Equalizer";
                icon: @image-url("icons/sliders.svg");
                clicked => {
                    root.run(MenuCommand.equalizer);
                    tools-popup.close();
                }
            }
            MenuItem {
                slot: 8;
                label: "Statistics";
                icon: @image-url("icons/chart-column.svg");
                clicked => {
                    root.run(MenuCommand.statistics);
                    tools-popup.close();
                }
            }
            MenuSeparator {}
            GroupMenuItem {
                slot: 9;
                label: "Connections";
                icon: @image-url("icons/network-wired.svg");
                open: root.tools-group == "connections";
                toggled => { root.tools-group = root.tools-group == "connections" ? "" : "connections"; }
            }
            if root.tools-group == "connections": VerticalLayout {
                MenuItem {
                    slot: 10;
                    label: "Agents (MCP)";
                    icon: @image-url("icons/bot.svg");
                    indent: Theme.space-16;
                    clicked => {
                        root.run(MenuCommand.agents);
                        tools-popup.close();
                    }
                }
                MenuItem {
                    slot: 11;
                    label: "Remote Control";
                    icon: @image-url("icons/mobile-screen-button.svg");
                    indent: Theme.space-16;
                    clicked => {
                        root.run(MenuCommand.remote-control);
                        tools-popup.close();
                    }
                }
            }
            if Platform.has-wifi: MenuSeparator {}
            if Platform.has-wifi: MenuItem {
                slot: 12;
                label: "Wi-Fi Settings";
                icon: @image-url("icons/wifi.svg");
                clicked => {
                    root.open-wifi-settings();
                    tools-popup.close();
                }
            }
        }
    }
}
