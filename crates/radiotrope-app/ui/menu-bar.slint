import { Theme } from "theme.slint";
import { Icon } from "components.slint";
import { VizStyle } from "visualization.slint";
import { Platform } from "@platform/wifi.slint";

component MenuItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    callback clicked();

    height: 28px;
    min-width: 160px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.menu-hover : transparent;
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 15px;
                height: 15px;
                source: root.icon;
                colorize: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            }
        }

        Text {
            text: root.label;
            color: touch.has-hover ? Theme.text-primary : Theme.menu-text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

component CheckMenuItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> checked;
    callback clicked();

    height: 28px;
    min-width: 160px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.menu-hover : transparent;
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 15px;
                height: 15px;
                source: root.icon;
                colorize: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: touch.has-hover ? Theme.text-primary : Theme.menu-text;
            font-size: 13px;
            vertical-alignment: center;
        }

        // Tick on the right while the option is on
        Rectangle {
            width: 12px;

            if root.checked: Icon {
                width: 12px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                source: @image-url("icons/tick.svg");
                colorize: Theme.accent;
            }
        }
    }
}

// Window button in our own title bar (minimize, maximize, close)
component CaptionButton inherits Rectangle {
    callback clicked();
    out property <color> glyph: Theme.menu-text;

    width: 42px;
    height: 32px;
    background: touch.pressed ? Theme.menu-hover
        : touch.has-hover ? Theme.menu-bar-hover : transparent;
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    @children
}

export component MenuBar inherits Rectangle {
    height: 32px;
    // Transparent: drawn on the header background shared with the playback
    // panel (app.slint)

    callback open-network-stream();
    callback open-station-search();
    callback open-country-picker();
    callback open-statistics();
    callback open-equalizer();
    callback open-accent-color();
    in-out property <bool> show-station-stats: true;
    callback open-wifi-settings();
    callback open-about();

    // Our own title bar: the bar moves the window and ends with the window
    // buttons (desktop only, when the system frame is turned off)
    in property <bool> custom-frame;
    in-out property <bool> maximized;
    in-out property <bool> always-on-top;
    callback minimize();
    callback toggle-custom-frame();
    // (x, y, pressed) -> whether the system shows its menu (on press or on
    // the release that follows)
    callback show-system-menu(length, length, bool) -> bool;
    property <length> window-menu-x;
    property <length> window-menu-y;
    callback close-window();


    HorizontalLayout {
        padding-left: 4px;
        padding-right: root.custom-frame ? 0 : 4px;
        alignment: stretch;

        Rectangle {
            width: open-label.preferred-width + 20px;
            height: 32px;
            background: open-touch.has-hover ? Theme.menu-bar-hover : transparent;
            animate background { duration: Theme.fast; }

            open-touch := TouchArea {
                clicked => { open-popup.show(); }
            }

            open-label := Text {
                text: "Open";
                color: Theme.menu-text;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: stations-label.preferred-width + 20px;
            height: 32px;
            background: stations-touch.has-hover ? Theme.menu-bar-hover : transparent;
            animate background { duration: Theme.fast; }

            stations-touch := TouchArea {
                clicked => { stations-popup.show(); }
            }

            stations-label := Text {
                text: "Stations";
                color: Theme.menu-text;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: view-label.preferred-width + 20px;
            height: 32px;
            background: view-touch.has-hover ? Theme.menu-bar-hover : transparent;
            animate background { duration: Theme.fast; }

            view-touch := TouchArea {
                clicked => { view-popup.show(); }
            }

            view-label := Text {
                text: "View";
                color: Theme.menu-text;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: tools-label.preferred-width + 20px;
            height: 32px;
            background: tools-touch.has-hover ? Theme.menu-bar-hover : transparent;
            animate background { duration: Theme.fast; }

            tools-touch := TouchArea {
                clicked => { tools-popup.show(); }
            }

            tools-label := Text {
                text: "Tools";
                color: Theme.menu-text;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Empty part of the bar: drag to move, double-click to maximize
        move-area := WindowMoveArea {
            horizontal-stretch: 1;
            enabled: root.custom-frame;

            move-touch := TouchArea {
                enabled: root.custom-frame;
                double-clicked => { root.maximized = !root.maximized; }
                // Right-click: the system window menu, or ours where the
                // system has none (ours opens on press: X11 window managers
                // can close a popup opened on release)
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        if !root.show-system-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, true) {
                            root.window-menu-x = move-area.x + self.mouse-x + 2px;
                            root.window-menu-y = self.mouse-y + 2px;
                            window-popup.show();
                        }
                    } else if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                        root.show-system-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
                    }
                }
            }
        }

        // About button at the right end
        Rectangle {
            width: 32px;
            height: 32px;

            about-touch := TouchArea {
                clicked => { root.open-about(); }
                mouse-cursor: pointer;
            }

            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: about-touch.has-hover ? Theme.menu-bar-hover : transparent;
                animate background { duration: Theme.fast; }

                Icon {
                    width: 16px;
                    height: 16px;
                    source: @image-url("icons/circle-info.svg");
                    colorize: about-touch.has-hover ? Theme.accent : Theme.menu-text;
                }
            }
        }

        if root.custom-frame: HorizontalLayout {
            padding-left: 6px;

            min := CaptionButton {
                clicked => { root.minimize(); }

                Rectangle {
                    width: 10px;
                    height: 1px;
                    background: min.glyph;
                }
            }

            max := CaptionButton {
                clicked => { root.maximized = !root.maximized; }

                if !root.maximized: Rectangle {
                    width: 10px;
                    height: 10px;
                    border-width: 1px;
                    border-radius: 1px;
                    border-color: max.glyph;
                }
                // Restore: two overlapping squares
                if root.maximized: Rectangle {
                    width: 10px;
                    height: 10px;

                    Rectangle {
                        x: 2px;
                        y: 0;
                        width: 8px;
                        height: 8px;
                        border-width: 1px;
                        border-radius: 1px;
                        border-color: max.glyph;
                    }
                    Rectangle {
                        x: 0;
                        y: 2px;
                        width: 8px;
                        height: 8px;
                        border-width: 1px;
                        border-radius: 1px;
                        border-color: max.glyph;
                        background: Theme.panel;
                    }
                }
            }

            close := CaptionButton {
                clicked => { root.close-window(); }

                Path {
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                    stroke: close.glyph;
                    stroke-width: 1.2px;
                }
            }
        }
    }

    open-popup := PopupWindow {
        x: 4px;
        y: 32px;
        width: popup-layout.preferred-width;

        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.shadow-soft;
            drop-shadow-offset-y: 2px;

            popup-layout := VerticalLayout {
                padding: 4px;

                MenuItem {
                    label: "Network Stream...";
                    icon: @image-url("icons/link.svg");
                    clicked => {
                        open-popup.close();
                        root.open-network-stream();
                    }
                }
            }
        }
    }

    stations-popup := PopupWindow {
        x: 4px + open-label.preferred-width + 20px;
        y: 32px;
        width: stations-popup-layout.preferred-width;

        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.shadow-soft;
            drop-shadow-offset-y: 2px;

            stations-popup-layout := VerticalLayout {
                padding: 4px;

                MenuItem {
                    label: "Search Stations...";
                    icon: @image-url("icons/magnifying-glass.svg");
                    clicked => {
                        stations-popup.close();
                        root.open-station-search();
                    }
                }
                MenuItem {
                    label: "By Country...";
                    icon: @image-url("icons/earth-europe.svg");
                    clicked => {
                        stations-popup.close();
                        root.open-country-picker();
                    }
                }
            }
        }
    }

    // Our window menu, for systems without one (some X11 window managers)
    window-popup := PopupWindow {
        x: root.window-menu-x;
        y: root.window-menu-y;
        width: window-popup-layout.preferred-width;

        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.shadow-soft;
            drop-shadow-offset-y: 2px;

            window-popup-layout := VerticalLayout {
                padding: 4px;

                MenuItem {
                    label: "Minimize";
                    icon: @image-url("icons/window-minimize.svg");
                    clicked => {
                        window-popup.close();
                        root.minimize();
                    }
                }
                MenuItem {
                    label: root.maximized ? "Restore" : "Maximize";
                    icon: root.maximized ? @image-url("icons/window-restore.svg") : @image-url("icons/window-maximize.svg");
                    clicked => {
                        window-popup.close();
                        root.maximized = !root.maximized;
                    }
                }
                CheckMenuItem {
                    label: "Always on Top";
                    icon: @image-url("icons/thumbtack.svg");
                    checked: root.always-on-top;
                    clicked => {
                        window-popup.close();
                        root.always-on-top = !root.always-on-top;
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Theme.menu-hover;
                    }
                }
                MenuItem {
                    label: "Close";
                    icon: @image-url("icons/xmark.svg");
                    clicked => {
                        window-popup.close();
                        root.close-window();
                    }
                }
            }
        }
    }

    view-popup := PopupWindow {
        x: 4px + open-label.preferred-width + 20px + stations-label.preferred-width + 20px;
        y: 32px;
        width: view-popup-layout.preferred-width;

        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.shadow-soft;
            drop-shadow-offset-y: 2px;

            view-popup-layout := VerticalLayout {
                padding: 4px;

                CheckMenuItem {
                    label: "Dark Theme";
                    icon: @image-url("icons/moon.svg");
                    checked: Theme.dark-mode;
                    clicked => {
                        view-popup.close();
                        Theme.dark-mode = true;
                    }
                }
                CheckMenuItem {
                    label: "Light Theme";
                    icon: @image-url("icons/sun.svg");
                    checked: !Theme.dark-mode;
                    clicked => {
                        view-popup.close();
                        Theme.dark-mode = false;
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Theme.menu-hover;
                    }
                }
                MenuItem {
                    label: "Accent Color...";
                    icon: @image-url("icons/palette.svg");
                    clicked => {
                        view-popup.close();
                        root.open-accent-color();
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Theme.menu-hover;
                    }
                }
                if Platform.has-window-frame: CheckMenuItem {
                    label: "Custom Title Bar";
                    icon: @image-url("icons/window-maximize.svg");
                    checked: root.custom-frame;
                    clicked => {
                        root.toggle-custom-frame();
                        view-popup.close();
                    }
                }
                if Platform.has-window-frame: Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Theme.menu-hover;
                    }
                }
                CheckMenuItem {
                    label: "Show Station Stats";
                    icon: @image-url("icons/clock.svg");
                    checked: root.show-station-stats;
                    clicked => {
                        view-popup.close();
                        root.show-station-stats = !root.show-station-stats;
                    }
                }
                CheckMenuItem {
                    label: "Station Colors in Visualizer";
                    icon: @image-url("icons/wave-square.svg");
                    checked: VizStyle.palette == "logo";
                    clicked => {
                        view-popup.close();
                        VizStyle.palette = VizStyle.palette == "logo" ? "accent" : "logo";
                    }
                }
            }
        }
    }

    tools-popup := PopupWindow {
        x: 4px + open-label.preferred-width + 20px + stations-label.preferred-width + 20px + view-label.preferred-width + 20px;
        y: 32px;
        width: tools-popup-layout.preferred-width;

        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.shadow-soft;
            drop-shadow-offset-y: 2px;

            tools-popup-layout := VerticalLayout {
                padding: 4px;

                MenuItem {
                    label: "Equalizer";
                    icon: @image-url("icons/sliders.svg");
                    clicked => {
                        tools-popup.close();
                        root.open-equalizer();
                    }
                }
                MenuItem {
                    label: "Statistics";
                    icon: @image-url("icons/chart-column.svg");
                    clicked => {
                        tools-popup.close();
                        root.open-statistics();
                    }
                }
                if Platform.has-wifi: Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Theme.menu-hover;
                    }
                }
                if Platform.has-wifi: MenuItem {
                    label: "WiFi Settings...";
                    icon: @image-url("icons/wifi.svg");
                    clicked => {
                        root.open-wifi-settings();
                        tools-popup.close();
                    }
                }
            }
        }
    }
}
