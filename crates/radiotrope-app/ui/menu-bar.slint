import { DesktopShortcuts, ShortcutAction } from "shortcuts.slint";
import { Theme } from "defaults.slint";
import { Icon, AgentsChip, ButtonKeys, FocusRing, PopupCard, MenuSeparator, Picker } from "components.slint";
import { VizStyle } from "visualization.slint";
import { Platform } from "@platform/wifi.slint";

// What every menu row shows, laid out like the shared ChoiceRow: icon,
// label, then an optional note, shortcut, swatch, tick or arrow on the right
component MenuRowContent inherits HorizontalLayout {
    // Moved right under the group row that shows it (GroupMenuItem)
    in property <length> indent;
    in property <string> label;
    in property <image> icon;
    in property <bool> enabled: true;
    // Hovered or reached with Tab
    in property <bool> lit;
    // A faint note or a keyboard shortcut on the right ("Ctrl+Q")
    in property <string> trailing-text;
    // A small colour square on the right (Accent Color shows the accent)
    in property <bool> has-swatch;
    in property <color> swatch;
    // Keeps room for a tick, shown while checked
    in property <bool> checkable;
    in property <bool> checked;
    // An arrow that turns as the group opens and folds
    in property <bool> expandable;
    in property <bool> expanded;

    property <color> foreground: !root.enabled ? Theme.disabled-text
        : root.lit ? Theme.text-primary : Theme.menu-text;

    padding-left: Theme.space-8 + root.indent;
    padding-right: Theme.space-8;
    spacing: Theme.space-8;

    VerticalLayout {
        alignment: center;
        Icon {
            width: Theme.icon-md;
            height: Theme.icon-md;
            source: root.icon;
            colorize: root.foreground;
        }
    }

    Text {
        horizontal-stretch: 1;
        text: root.label;
        color: root.foreground;
        font-size: Theme.font-md;
        vertical-alignment: center;
        accessible-role: none;
    }

    if root.trailing-text != "": Text {
        text: root.trailing-text;
        color: root.enabled ? Theme.text-tertiary : Theme.disabled-text;
        font-size: Theme.font-sm;
        vertical-alignment: center;
        accessible-role: none;
    }

    if root.has-swatch: VerticalLayout {
        alignment: center;
        Rectangle {
            width: Theme.icon-sm;
            height: Theme.icon-sm;
            border-radius: Theme.radius-sm - 1px;
            background: root.swatch;
        }
    }

    if root.checkable: Rectangle {
        width: Theme.icon-sm;
        if root.checked: Icon {
            width: Theme.icon-sm;
            height: Theme.icon-sm;
            source: @image-url("icons/tick.svg");
            colorize: root.enabled ? Theme.selection-mark : Theme.disabled-text;
        }
    }

    // Points down while folded and up while open: the items show in
    // place, under the group, not in a side menu
    if root.expandable: VerticalLayout {
        alignment: center;
        Icon {
            width: Theme.icon-sm;
            height: Theme.icon-sm;
            source: root.expanded ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg");
            colorize: root.foreground;
        }
    }
}

// Background of a menu row: the same hover and press colours as ChoiceRow
component MenuRowBase inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> hovered;
    in property <bool> pressed;

    height: Theme.row-menu;
    min-width: 160px;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? transparent
        : root.pressed ? Theme.pressed-bg
        : root.hovered ? Theme.hover-bg : transparent;
    animate background { duration: Theme.fast; }
}

component MenuItem inherits MenuRowBase {
    in property <length> indent;
    in property <string> label;
    in property <image> icon;
    // Its keyboard shortcut, shown on the right ("Ctrl+Q")
    in property <string> shortcut;
    in property <bool> has-swatch;
    in property <color> swatch;
    callback clicked();

    hovered: touch.has-hover || keys.has-focus;
    pressed: touch.pressed;

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.shortcut;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    MenuRowContent {
        indent: root.indent;
        label: root.label;
        icon: root.icon;
        enabled: root.enabled;
        lit: root.hovered;
        trailing-text: root.shortcut;
        has-swatch: root.has-swatch;
        swatch: root.swatch;
    }
}

// Why the items above it are greyed out, in the menu itself
component MenuNote inherits Rectangle {
    // Moved right under the group row that shows it (GroupMenuItem)
    in property <length> indent;
    in property <[string]> lines;

    VerticalLayout {
        // Lined up with the item labels (padding, icon, spacing)
        padding-left: Theme.space-8 + Theme.icon-md + Theme.space-8 + root.indent;
        padding-right: Theme.space-12;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-4;

        for line in root.lines: Text {
            text: line;
            color: Theme.text-tertiary;
            font-size: Theme.font-sm;
        }
    }
}

component CheckMenuItem inherits MenuRowBase {
    in property <length> indent;
    in property <string> label;
    in property <image> icon;
    in property <bool> checked;
    // A faint note on the right, before the tick
    in property <string> hint;
    callback clicked();

    hovered: touch.has-hover || keys.has-focus;
    pressed: touch.pressed;

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    MenuRowContent {
        indent: root.indent;
        label: root.label;
        icon: root.icon;
        enabled: root.enabled;
        lit: root.hovered;
        trailing-text: root.hint;
        checkable: true;
        checked: root.checked;
    }
}

// A group of set-once options, folded: a click (or Space, Enter, Right)
// shows its items right under it, indented, and another click folds them
// (Left folds too). The arrow points up while it is open.
component GroupMenuItem inherits MenuRowBase {
    in property <string> label;
    in property <image> icon;
    in property <bool> open;
    callback toggled();

    hovered: touch.has-hover || keys.has-focus;
    pressed: touch.pressed;

    accessible-role: button;
    accessible-label: root.label;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.toggled(); }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }

    keys := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return
                || (event.text == Key.RightArrow && !root.open)
                || (event.text == Key.LeftArrow && root.open) {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }

    MenuRowContent {
        label: root.label;
        icon: root.icon;
        lit: root.hovered;
        expandable: true;
        expanded: root.open;
    }

    if keys.has-focus: FocusRing {
        offset: -1px;
        radius: root.border-radius;
    }
}

// View > Theme: the three choices in the row itself, one click each
component ThemeMenuRow inherits Rectangle {
    height: Theme.control-button;
    min-width: 160px;

    HorizontalLayout {
        padding-left: Theme.space-8;
        padding-right: Theme.space-4;
        spacing: Theme.space-8;

        VerticalLayout {
            alignment: center;
            Icon {
                width: Theme.icon-md;
                height: Theme.icon-md;
                source: Theme.dark-mode ? @image-url("icons/moon.svg") : @image-url("icons/sun.svg");
                colorize: Theme.menu-text;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: "Theme";
            color: Theme.menu-text;
            font-size: Theme.font-md;
            vertical-alignment: center;
            accessible-role: none;
        }

        VerticalLayout {
            alignment: center;
            // System follows the OS; greyed where the OS can't say
            Picker {
                compact: true;
                option-width: 54px;
                choices: [
                    { id: "system", label: "System", disabled: !Platform.has-system-theme },
                    { id: "dark", label: "Dark" },
                    { id: "light", label: "Light" },
                ];
                selected: Theme.theme-mode;
                changed(id) => { Theme.theme-mode = id; }
            }
        }
    }
}

// Window button in our own title bar (minimize, maximize, close). Like
// system title bars, it is left out of the Tab order.
component CaptionButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    out property <color> glyph: Theme.menu-text;

    width: 42px;
    height: 32px;
    background: touch.pressed ? Theme.pressed-bg
        : touch.has-hover ? Theme.hover-bg : transparent;
    animate background { duration: Theme.fast; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    @children
}

// A menu's name in the bar; opens the menu on click, or on Space, Enter
// or Down once reached with Tab
component MenuTitle inherits Rectangle {
    in property <string> label;
    // Greyed out and not clickable when false
    in property <bool> enabled: true;
    callback clicked();

    width: title.preferred-width + 20px;
    height: 32px;
    background: root.enabled && (touch.has-hover || keys.has-focus) ? Theme.hover-bg : transparent;
    animate background { duration: Theme.fast; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    title := Text {
        text: root.label;
        color: root.enabled ? Theme.menu-text : Theme.disabled-text;
        font-size: Theme.font-base;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return || event.text == Key.DownArrow {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    // Inside the edge: the bar is at the top of the window
    if keys.has-focus: FocusRing {
        offset: -Theme.focus-ring-width;
        radius: Theme.radius-sm;
    }
}

export component MenuBar inherits Rectangle {
    height: 32px;
    // Transparent: drawn on the header background shared with the playback
    // panel (app.slint)

    callback open-network-stream();
    callback open-station-search();
    callback export-favorites();
    callback import-favorites();
    callback open-statistics();
    callback open-equalizer();
    callback open-filters();
    callback open-accent-color();
    in-out property <bool> show-station-stats: true;
    // The header visualizer tile (View > Visualizer)
    in-out property <bool> show-visualizer: true;
    callback open-wifi-settings();
    callback open-about();
    callback open-keyboard-shortcuts();
    in property <bool> is-recording;
    in property <bool> can-toggle-recording;
    callback toggle-recording();
    callback open-recording-settings();
    callback open-recordings-folder();
    callback open-agents();
    callback open-remote-control();
    callback open-sleep-timer();
    callback open-schedule();
    // The menus are greyed out while a dialog is open; the window buttons
    // and moving the window still work
    in property <bool> menus-enabled: true;
    // Agents (MCP) using the player now, and one line about each: a chip
    // at the end of the bar, only while there are any
    in property <int> agent-count;
    // The chip's hover bubble, drawn by the window (see AgentsChip)
    out property <bool> agents-bubble-open: root.agent-count > 0 && root.agents-hover;
    out property <length> agents-bubble-right;
    out property <length> agents-bubble-top;
    property <bool> agents-hover: false;
    // Phones listening to the player (Remote Control): a chip beside the
    // agents chip, only while there are any
    in property <[string]> listeners;
    out property <bool> listeners-bubble-open: root.listeners.length > 0 && root.listeners-hover;
    out property <length> listeners-bubble-right;
    out property <length> listeners-bubble-top;
    property <bool> listeners-hover: false;
    changed listeners => {
        if root.listeners.length == 0 {
            root.listeners-hover = false;
        }
    }
    // The chip goes away with the last agent, and its hover with it
    changed agent-count => {
        if root.agent-count == 0 {
            root.agents-hover = false;
        }
    }

    // Our own title bar: the bar moves the window and ends with the window
    // buttons (desktop only, when the system frame is turned off)
    in property <bool> custom-frame;
    in-out property <bool> maximized;
    in-out property <bool> always-on-top;
    callback minimize();
    callback toggle-custom-frame();
    in-out property <bool> rounded-corners;
    in property <bool> corners-available;
    in property <string> corners-hint;
    callback rounded-corners-changed();
    // (x, y, pressed) -> whether the system shows its menu (on press or on
    // the release that follows)
    callback show-system-menu(length, length, bool) -> bool;
    public function open-menu(menu: string, group: string) {
        if menu == "open" { open-menu.clicked(); }
        if menu == "stations" { stations-menu.clicked(); }
        if menu == "view" {
            root.snapshot-menu-group = group;
            view-menu.clicked();
        }
        if menu == "tools" {
            root.snapshot-menu-group = group;
            tools-menu.clicked();
        }
        if menu == "help" { help-menu.clicked(); }
        if menu == "window" {
            root.window-menu-x = move-area.x + 2px;
            root.window-menu-y = 29px;
            window-popup.show();
        }
    }

    in property <string> snapshot-bubble;
    property <string> snapshot-menu-group;
    property <length> window-menu-x;
    // Where the first menu starts (the bar's left padding)
    property <length> menu-start: 4px;
    property <length> window-menu-y;
    callback close-window();
    // System tray options (View menu) and Quit (Open menu)
    in-out property <bool> tray-icon;
    in-out property <bool> close-to-tray;
    in-out property <bool> start-in-tray;
    in-out property <bool> hide-on-minimize;
    in property <bool> tray-available: true;
    callback quit-app();
    // Power Off and Restart (the Pi's Open menu); each asks twice
    callback power-off();
    callback restart();
    property <bool> confirm-power-off: false;
    property <bool> confirm-restart: false;


    HorizontalLayout {
        padding-left: 4px;
        padding-right: root.custom-frame ? 0 : 4px;
        alignment: stretch;

        open-menu := MenuTitle {
            label: "Open";
            enabled: root.menus-enabled;
            clicked => {
                root.confirm-power-off = false;
                root.confirm-restart = false;
                open-popup.show();
            }
        }

        stations-menu := MenuTitle {
            label: "Stations";
            enabled: root.menus-enabled;
            clicked => { stations-popup.show(); }
        }

        view-menu := MenuTitle {
            label: "View";
            enabled: root.menus-enabled;
            clicked => { view-popup.show(); }
        }

        tools-menu := MenuTitle {
            label: "Tools";
            enabled: root.menus-enabled;
            clicked => { tools-popup.show(); }
        }

        help-menu := MenuTitle {
            label: "Help";
            enabled: root.menus-enabled;
            clicked => { help-popup.show(); }
        }

        // Empty part of the bar: drag to move, double-click to maximize
        move-area := WindowMoveArea {
            horizontal-stretch: 1;
            enabled: root.custom-frame;

            move-touch := TouchArea {
                enabled: root.custom-frame;
                double-clicked => { root.maximized = !root.maximized; }
                // Right-click: the system window menu, or ours where the
                // system has none (ours opens on press: X11 window managers
                // can close a popup opened on release)
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        if !root.show-system-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, true) {
                            root.window-menu-x = move-area.x + self.mouse-x + 2px;
                            root.window-menu-y = self.mouse-y + 2px;
                            window-popup.show();
                        }
                    } else if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                        root.show-system-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
                    }
                }
            }
        }

        if root.listeners.length > 0: VerticalLayout {
            alignment: center;
            padding-right: 6px;
            AgentsChip {
                count: root.listeners.length;
                snapshot-bubble: root.snapshot-bubble == "listeners";
                icon: @image-url("icons/headphones.svg");
                show-bubble(right, top) => {
                    root.listeners-bubble-right = right;
                    root.listeners-bubble-top = top;
                    root.listeners-hover = true;
                }
                hide-bubble => { root.listeners-hover = false; }
            }
        }

        if root.agent-count > 0: VerticalLayout {
            alignment: center;
            padding-right: 6px;
            AgentsChip {
                count: root.agent-count;
                snapshot-bubble: root.snapshot-bubble == "agents";
                show-bubble(right, top) => {
                    root.agents-bubble-right = right;
                    root.agents-bubble-top = top;
                    root.agents-hover = true;
                }
                hide-bubble => { root.agents-hover = false; }
            }
        }

        if root.custom-frame: HorizontalLayout {
            padding-left: 6px;

            min := CaptionButton {
                label: "Minimize";
                clicked => { root.minimize(); }

                Rectangle {
                    width: 10px;
                    height: 1px;
                    background: min.glyph;
                }
            }

            max := CaptionButton {
                label: root.maximized ? "Restore" : "Maximize";
                clicked => { root.maximized = !root.maximized; }

                if !root.maximized: Rectangle {
                    width: 10px;
                    height: 10px;
                    border-width: 1px;
                    border-radius: 1px;
                    border-color: max.glyph;
                }
                // Restore: two overlapping squares
                if root.maximized: Rectangle {
                    width: 10px;
                    height: 10px;

                    Rectangle {
                        x: 2px;
                        y: 0;
                        width: 8px;
                        height: 8px;
                        border-width: 1px;
                        border-radius: 1px;
                        border-color: max.glyph;
                    }
                    Rectangle {
                        x: 0;
                        y: 2px;
                        width: 8px;
                        height: 8px;
                        border-width: 1px;
                        border-radius: 1px;
                        border-color: max.glyph;
                        background: Theme.panel;
                    }
                }
            }

            close := CaptionButton {
                label: "Close";
                clicked => { root.close-window(); }

                Path {
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                    stroke: close.glyph;
                    stroke-width: 1.2px;
                }
            }
        }
    }

    // An item acts first and closes its menu after: closing drops the
    // popup's elements, and a statement after close() in an item under an
    // `if` (Quit, Restart, Power Off) never ran
    open-popup := PopupWindow {
        x: root.menu-start;
        y: 32px;
        width: popup-layout.preferred-width;
        // Clicks inside don't close the menu: commands and dialogs close it
        // themselves, ticks stay open to show the change. Esc still closes.
        close-policy: close-on-click-outside;

        PopupCard {
            popup-layout := VerticalLayout {
                padding: Theme.space-4;

                MenuItem {
                    label: "Network Stream";
                    shortcut: DesktopShortcuts.enabled ? DesktopShortcuts.label(ShortcutAction.network-stream) : "";
                    icon: @image-url("icons/link.svg");
                    clicked => {
                        root.open-network-stream();
                        open-popup.close();
                    }
                }
                MenuSeparator {}
                if !Platform.has-power-off: MenuItem {
                    label: "Quit";
                    icon: @image-url("icons/power-off.svg");
                    shortcut: DesktopShortcuts.enabled ? DesktopShortcuts.label(ShortcutAction.quit) : "";
                    clicked => {
                        root.quit-app();
                        open-popup.close();
                    }
                }
                // The Pi: Power Off and Restart ask twice, and the first
                // press stays until the menu is opened again. Wide enough
                // for the longer label, so asking doesn't move the menu
                if Platform.has-power-off: MenuItem {
                    label: root.confirm-restart ? "Press Again to Restart" : "Restart";
                    icon: @image-url("icons/rotate-right.svg");
                    min-width: 230px;
                    clicked => {
                        if root.confirm-restart {
                            root.restart();
                            open-popup.close();
                        } else {
                            root.confirm-restart = true;
                            root.confirm-power-off = false;
                        }
                    }
                }
                if Platform.has-power-off: MenuItem {
                    label: root.confirm-power-off ? "Press Again to Power Off" : "Power Off";
                    icon: @image-url("icons/power-off.svg");
                    min-width: 230px;
                    clicked => {
                        if root.confirm-power-off {
                            root.power-off();
                            open-popup.close();
                        } else {
                            root.confirm-power-off = true;
                            root.confirm-restart = false;
                        }
                    }
                }
            }
        }
    }

    stations-popup := PopupWindow {
        x: root.menu-start + open-menu.width;
        y: 32px;
        width: stations-popup-layout.preferred-width;
        close-policy: close-on-click-outside;

        PopupCard {
            stations-popup-layout := VerticalLayout {
                padding: Theme.space-4;

                MenuItem {
                    label: "Search Stations";
                    shortcut: DesktopShortcuts.enabled ? DesktopShortcuts.label(ShortcutAction.search) : "";
                    icon: @image-url("icons/magnifying-glass.svg");
                    clicked => {
                        root.open-station-search();
                        stations-popup.close();
                    }
                }
                MenuSeparator {}
                // Need a file dialog, which the kiosk build lacks
                MenuItem {
                    label: "Export Favorites";
                    enabled: Platform.has-file-manager;
                    icon: @image-url("icons/file-export.svg");
                    clicked => {
                        root.export-favorites();
                        stations-popup.close();
                    }
                }
                MenuItem {
                    label: "Import Favorites";
                    enabled: Platform.has-file-manager;
                    icon: @image-url("icons/file-import.svg");
                    clicked => {
                        root.import-favorites();
                        stations-popup.close();
                    }
                }
            }
        }
    }

    // Our window menu, for systems without one (some X11 window managers)
    window-popup := PopupWindow {
        x: root.window-menu-x;
        y: root.window-menu-y;
        width: window-popup-layout.preferred-width;
        close-policy: close-on-click-outside;

        PopupCard {
            window-popup-layout := VerticalLayout {
                padding: Theme.space-4;

                MenuItem {
                    label: "Minimize";
                    icon: @image-url("icons/window-minimize.svg");
                    clicked => {
                        root.minimize();
                        window-popup.close();
                    }
                }
                MenuItem {
                    label: root.maximized ? "Restore" : "Maximize";
                    icon: root.maximized ? @image-url("icons/window-restore.svg") : @image-url("icons/window-maximize.svg");
                    clicked => {
                        root.maximized = !root.maximized;
                        window-popup.close();
                    }
                }
                CheckMenuItem {
                    label: "Always on Top";
                    icon: @image-url("icons/thumbtack.svg");
                    checked: root.always-on-top;
                    clicked => {
                        root.always-on-top = !root.always-on-top;
                    }
                }
                MenuSeparator {}
                MenuItem {
                    label: "Close";
                    icon: @image-url("icons/xmark.svg");
                    clicked => {
                        root.close-window();
                        window-popup.close();
                    }
                }
            }
        }
    }

    view-popup := PopupWindow {
        x: root.menu-start + open-menu.width + stations-menu.width;
        y: 32px;
        width: view-popup-layout.preferred-width;
        close-policy: close-on-click-outside;

        // The open group: "", "window" or "tray"; one at a time
        property <string> group: root.snapshot-menu-group;

        PopupCard {
            view-popup-layout := VerticalLayout {
                padding: Theme.space-4;

                ThemeMenuRow {}
                MenuItem {
                    label: "Accent Color";
                    icon: @image-url("icons/palette.svg");
                    has-swatch: true;
                    swatch: Theme.accent;
                    clicked => {
                        root.open-accent-color();
                        view-popup.close();
                    }
                }
                MenuSeparator {}
                CheckMenuItem {
                    label: "Show Listening Stats";
                    icon: @image-url("icons/clock.svg");
                    checked: root.show-station-stats;
                    clicked => {
                        root.show-station-stats = !root.show-station-stats;
                    }
                }
                MenuSeparator {}
                CheckMenuItem {
                    label: "Visualizer";
                    icon: @image-url("icons/visualizer.svg");
                    checked: root.show-visualizer;
                    clicked => {
                        root.show-visualizer = !root.show-visualizer;
                    }
                }
                // Keeps its choice while the visualizer is off
                CheckMenuItem {
                    label: "Station Colors in Visualizer";
                    icon: @image-url("icons/fill-drip.svg");
                    enabled: root.show-visualizer;
                    checked: VizStyle.palette == "logo";
                    clicked => {
                        VizStyle.palette = VizStyle.palette == "logo" ? "accent" : "logo";
                    }
                }
                // The set-once options, folded into groups (desktop only)
                if Platform.has-window-frame || Platform.has-tray: MenuSeparator {}
                if Platform.has-window-frame: GroupMenuItem {
                    label: "Window";
                    icon: @image-url("icons/window-maximize.svg");
                    open: view-popup.group == "window";
                    toggled => { view-popup.group = view-popup.group == "window" ? "" : "window"; }
                }
                if Platform.has-window-frame && view-popup.group == "window": CheckMenuItem {
                    // Chrome's wording: ticked means the system frame
                    label: "Use System Title Bar";
                    icon: @image-url("icons/window-maximize.svg");
                    indent: Theme.space-16;
                    checked: !root.custom-frame;
                    clicked => {
                        root.toggle-custom-frame();
                        view-popup.close();
                    }
                }
                if Platform.has-window-frame && view-popup.group == "window": CheckMenuItem {
                    // The system title bar has its own corners
                    label: "Rounded Corners";
                    icon: @image-url("icons/rounded-corner.svg");
                    indent: Theme.space-16;
                    enabled: root.custom-frame && root.corners-available;
                    hint: root.corners-available ? "" : root.corners-hint;
                    checked: root.rounded-corners;
                    clicked => {
                        root.rounded-corners = !root.rounded-corners;
                        root.rounded-corners-changed();
                    }
                }
                if Platform.has-tray: GroupMenuItem {
                    label: "System Tray";
                    icon: @image-url("icons/window-restore.svg");
                    open: view-popup.group == "tray";
                    toggled => { view-popup.group = view-popup.group == "tray" ? "" : "tray"; }
                }
                if Platform.has-tray && view-popup.group == "tray": CheckMenuItem {
                    label: "Show Tray Icon";
                    icon: @image-url("icons/window-restore.svg");
                    indent: Theme.space-16;
                    checked: root.tray-icon;
                    clicked => {
                        root.tray-icon = !root.tray-icon;
                    }
                }
                // Greyed with no tray to hide in; they keep their ticks
                if Platform.has-tray && view-popup.group == "tray": CheckMenuItem {
                    label: "Close to Tray";
                    icon: @image-url("icons/rectangle-xmark.svg");
                    indent: Theme.space-16;
                    enabled: root.tray-icon && root.tray-available;
                    checked: root.close-to-tray;
                    clicked => {
                        root.close-to-tray = !root.close-to-tray;
                    }
                }
                if Platform.has-tray && view-popup.group == "tray": CheckMenuItem {
                    label: "Minimize to Tray";
                    icon: @image-url("icons/square-minus.svg");
                    indent: Theme.space-16;
                    enabled: root.tray-icon && root.tray-available;
                    checked: root.hide-on-minimize;
                    clicked => {
                        root.hide-on-minimize = !root.hide-on-minimize;
                    }
                }
                if Platform.has-tray && view-popup.group == "tray": CheckMenuItem {
                    label: "Start Hidden in Tray";
                    icon: @image-url("icons/eye-slash.svg");
                    indent: Theme.space-16;
                    enabled: root.tray-icon && root.tray-available;
                    checked: root.start-in-tray;
                    clicked => {
                        root.start-in-tray = !root.start-in-tray;
                    }
                }
                if Platform.has-tray && view-popup.group == "tray" && root.tray-icon && !root.tray-available: MenuNote {
                    indent: Theme.space-16;
                    lines: ["This desktop doesn't show tray icons.", "On GNOME, turn on the AppIndicator extension."];
                }
            }
        }
    }

    help-popup := PopupWindow {
        x: root.menu-start + open-menu.width + stations-menu.width + view-menu.width + tools-menu.width;
        y: 32px;
        width: help-popup-layout.preferred-width;
        close-policy: close-on-click-outside;

        PopupCard {
            help-popup-layout := VerticalLayout {
                padding: Theme.space-4;

                if DesktopShortcuts.enabled: MenuItem {
                    label: "Keyboard Shortcuts";
                    icon: @image-url("icons/keyboard.svg");
                    shortcut: DesktopShortcuts.label(ShortcutAction.help);
                    // Open first: closing the popup takes this item with it
                    clicked => {
                        root.open-keyboard-shortcuts();
                        help-popup.close();
                    }
                }
                MenuItem {
                    label: "About Radiotrope";
                    icon: @image-url("icons/circle-info.svg");
                    clicked => {
                        root.open-about();
                        help-popup.close();
                    }
                }
            }
        }
    }

    tools-popup := PopupWindow {
        x: root.menu-start + open-menu.width + stations-menu.width + view-menu.width;
        y: 32px;
        width: tools-popup-layout.preferred-width;
        close-policy: close-on-click-outside;

        // The open group: "", "recordings" or "connections"; one at a time
        property <string> group: root.snapshot-menu-group;

        PopupCard {
            tools-popup-layout := VerticalLayout {
                padding: Theme.space-4;

                MenuItem {
                    label: "Statistics";
                    icon: @image-url("icons/chart-column.svg");
                    clicked => {
                        root.open-statistics();
                        tools-popup.close();
                    }
                }
                MenuItem {
                    label: "Filters";
                    icon: @image-url("icons/wave-square.svg");
                    clicked => {
                        root.open-filters();
                        tools-popup.close();
                    }
                }
                MenuItem {
                    label: "Equalizer";
                    icon: @image-url("icons/sliders.svg");
                    clicked => {
                        root.open-equalizer();
                        tools-popup.close();
                    }
                }
                MenuSeparator {}
                MenuItem {
                    label: root.is-recording ? "Stop Recording" : "Start Recording";
                    shortcut: DesktopShortcuts.enabled ? DesktopShortcuts.label(ShortcutAction.record) : "";
                    // Greyed out until a station plays
                    enabled: root.can-toggle-recording;
                    icon: @image-url("icons/record.svg");
                    clicked => {
                        root.toggle-recording();
                        tools-popup.close();
                    }
                }
                GroupMenuItem {
                    label: "Recordings";
                    icon: @image-url("icons/folder.svg");
                    open: tools-popup.group == "recordings";
                    toggled => { tools-popup.group = tools-popup.group == "recordings" ? "" : "recordings"; }
                }
                if tools-popup.group == "recordings": MenuItem {
                    label: "Settings";
                    icon: @image-url("icons/gear.svg");
                    indent: Theme.space-16;
                    clicked => {
                        root.open-recording-settings();
                        tools-popup.close();
                    }
                }
                if Platform.has-file-manager && tools-popup.group == "recordings": MenuItem {
                    label: "Open Folder";
                    icon: @image-url("icons/folder-open.svg");
                    indent: Theme.space-16;
                    clicked => {
                        root.open-recordings-folder();
                        tools-popup.close();
                    }
                }
                MenuSeparator {}
                MenuItem {
                    label: "Sleep Timer";
                    icon: @image-url("icons/moon.svg");
                    clicked => {
                        root.open-sleep-timer();
                        tools-popup.close();
                    }
                }
                MenuItem {
                    label: "Scheduler";
                    icon: @image-url("icons/calendar.svg");
                    clicked => {
                        root.open-schedule();
                        tools-popup.close();
                    }
                }
                MenuSeparator {}
                GroupMenuItem {
                    label: "Connections";
                    icon: @image-url("icons/network-wired.svg");
                    open: tools-popup.group == "connections";
                    toggled => { tools-popup.group = tools-popup.group == "connections" ? "" : "connections"; }
                }
                if tools-popup.group == "connections": MenuItem {
                    label: "Agents (MCP)";
                    icon: @image-url("icons/bot.svg");
                    indent: Theme.space-16;
                    clicked => {
                        root.open-agents();
                        tools-popup.close();
                    }
                }
                if tools-popup.group == "connections": MenuItem {
                    label: "Remote Control";
                    icon: @image-url("icons/mobile-screen-button.svg");
                    indent: Theme.space-16;
                    clicked => {
                        root.open-remote-control();
                        tools-popup.close();
                    }
                }
                if Platform.has-wifi: MenuSeparator {}
                if Platform.has-wifi: MenuItem {
                    label: "Wi-Fi Settings";
                    icon: @image-url("icons/wifi.svg");
                    clicked => {
                        root.open-wifi-settings();
                        tools-popup.close();
                    }
                }
            }
        }
    }
}
