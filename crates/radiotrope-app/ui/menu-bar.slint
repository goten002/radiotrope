import { Theme } from "defaults.slint";
import { Icon, AgentsChip, ButtonKeys, FocusRing, PopupCard, MenuSeparator } from "components.slint";
import { VizStyle } from "visualization.slint";
import { Platform } from "@platform/wifi.slint";

component MenuItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    // Its keyboard shortcut, shown on the right ("Ctrl+Q")
    in property <string> shortcut;
    // Greyed out and not clickable when false
    in property <bool> enabled: true;
    callback clicked();

    // Hovered, or reached with Tab: highlighted the same way
    property <bool> lit: touch.has-hover || keys.has-focus;

    height: 28px;
    min-width: 160px;
    border-radius: Theme.radius-sm;
    background: root.lit ? Theme.menu-hover : transparent;
    animate background { duration: Theme.fast; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 15px;
                height: 15px;
                source: root.icon;
                colorize: !root.enabled ? Theme.disabled-text
                    : root.lit ? Theme.text-primary : Theme.text-secondary;
            }
        }

        Text {
            text: root.label;
            color: !root.enabled ? Theme.disabled-text
                : root.lit ? Theme.text-primary : Theme.menu-text;
            font-size: Theme.font-base;
            vertical-alignment: center;
            accessible-role: none;
        }

        if root.shortcut != "": Rectangle {
            horizontal-stretch: 1;
            min-width: 16px;
        }
        if root.shortcut != "": Text {
            text: root.shortcut;
            color: Theme.disabled-text;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// Why the items above it are greyed out, in the menu itself
component MenuNote inherits Rectangle {
    in property <string> text;

    HorizontalLayout {
        // Lined up with the item labels (padding, icon, spacing)
        padding-left: 35px;
        padding-right: 12px;
        padding-top: 2px;
        padding-bottom: 4px;

        Text {
            text: root.text;
            color: Theme.disabled-text;
            font-size: Theme.font-sm;
        }
    }
}

component CheckMenuItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> checked;
    // A faint note on the right, before the tick ("Dark")
    in property <string> hint;
    // Greyed out and not clickable when false
    in property <bool> enabled: true;
    callback clicked();

    // Hovered, or reached with Tab: highlighted the same way
    property <bool> lit: touch.has-hover || keys.has-focus;

    height: 28px;
    min-width: 160px;
    border-radius: Theme.radius-sm;
    background: root.lit ? Theme.menu-hover : transparent;
    animate background { duration: Theme.fast; }

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 15px;
                height: 15px;
                source: root.icon;
                colorize: !root.enabled ? Theme.disabled-text
                    : root.lit ? Theme.text-primary : Theme.text-secondary;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: !root.enabled ? Theme.disabled-text
                : root.lit ? Theme.text-primary : Theme.menu-text;
            font-size: Theme.font-base;
            vertical-alignment: center;
            accessible-role: none;
        }

        if root.hint != "": Text {
            text: root.hint;
            color: Theme.disabled-text;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            accessible-role: none;
        }

        // Tick on the right while the option is on
        Rectangle {
            width: 12px;

            if root.checked: Icon {
                width: 12px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                source: @image-url("icons/tick.svg");
                colorize: root.enabled ? Theme.accent : Theme.disabled-text;
            }
        }
    }
}

// Window button in our own title bar (minimize, maximize, close). Like
// system title bars, it is left out of the Tab order.
component CaptionButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    out property <color> glyph: Theme.menu-text;

    width: 42px;
    height: 32px;
    background: touch.pressed ? Theme.menu-hover
        : touch.has-hover ? Theme.menu-bar-hover : transparent;
    animate background { duration: Theme.fast; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    @children
}

// A menu's name in the bar; opens the menu on click, or on Space, Enter
// or Down once reached with Tab
component MenuTitle inherits Rectangle {
    in property <string> label;
    // Greyed out and not clickable when false
    in property <bool> enabled: true;
    callback clicked();

    width: title.preferred-width + 20px;
    height: 32px;
    background: root.enabled && (touch.has-hover || keys.has-focus) ? Theme.menu-bar-hover : transparent;
    animate background { duration: Theme.fast; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    title := Text {
        text: root.label;
        color: root.enabled ? Theme.menu-text : Theme.disabled-text;
        font-size: Theme.font-base;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return || event.text == Key.DownArrow {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    // Inside the edge: the bar is at the top of the window
    if keys.has-focus: FocusRing {
        offset: -Theme.focus-ring-width;
        radius: Theme.radius-sm;
    }
}

export component MenuBar inherits Rectangle {
    height: 32px;
    // Transparent: drawn on the header background shared with the playback
    // panel (app.slint)

    callback open-network-stream();
    callback open-station-search();
    callback open-country-picker();
    callback open-statistics();
    callback open-equalizer();
    callback open-accent-color();
    in-out property <bool> show-station-stats: true;
    // The header visualizer tile (View > Visualizer)
    in-out property <bool> show-visualizer: true;
    callback open-wifi-settings();
    callback open-about();
    in property <bool> is-recording;
    in property <bool> can-record;
    callback toggle-recording();
    callback open-recording-settings();
    callback open-recordings-folder();
    callback open-agents();
    // The menus are greyed out while a dialog is open; the window buttons
    // and moving the window still work
    in property <bool> menus-enabled: true;
    // Agents (MCP) using the player now, and one line about each: a chip
    // at the end of the bar, only while there are any
    in property <int> agent-count;
    // The chip's hover bubble, drawn by the window (see AgentsChip)
    out property <bool> agents-bubble-open: root.agent-count > 0 && root.agents-hover;
    out property <length> agents-bubble-right;
    out property <length> agents-bubble-top;
    property <bool> agents-hover: false;
    // The chip goes away with the last agent, and its hover with it
    changed agent-count => {
        if root.agent-count == 0 {
            root.agents-hover = false;
        }
    }

    // Our own title bar: the bar moves the window and ends with the window
    // buttons (desktop only, when the system frame is turned off)
    in property <bool> custom-frame;
    in-out property <bool> maximized;
    in-out property <bool> always-on-top;
    callback minimize();
    callback toggle-custom-frame();
    // (x, y, pressed) -> whether the system shows its menu (on press or on
    // the release that follows)
    callback show-system-menu(length, length, bool) -> bool;
    property <length> window-menu-x;
    // Where the first menu starts (the bar's left padding)
    property <length> menu-start: 4px;
    property <length> window-menu-y;
    callback close-window();
    // System tray options (View menu) and Quit (Open menu)
    in-out property <bool> tray-icon;
    in-out property <bool> close-to-tray;
    in-out property <bool> start-in-tray;
    in-out property <bool> hide-on-minimize;
    in property <bool> tray-available: true;
    callback quit-app();


    HorizontalLayout {
        padding-left: 4px;
        padding-right: root.custom-frame ? 0 : 4px;
        alignment: stretch;

        open-menu := MenuTitle {
            label: "Open";
            enabled: root.menus-enabled;
            clicked => { open-popup.show(); }
        }

        stations-menu := MenuTitle {
            label: "Stations";
            enabled: root.menus-enabled;
            clicked => { stations-popup.show(); }
        }

        view-menu := MenuTitle {
            label: "View";
            enabled: root.menus-enabled;
            clicked => { view-popup.show(); }
        }

        tools-menu := MenuTitle {
            label: "Tools";
            enabled: root.menus-enabled;
            clicked => { tools-popup.show(); }
        }

        help-menu := MenuTitle {
            label: "Help";
            enabled: root.menus-enabled;
            clicked => { help-popup.show(); }
        }

        // Empty part of the bar: drag to move, double-click to maximize
        move-area := WindowMoveArea {
            horizontal-stretch: 1;
            enabled: root.custom-frame;

            move-touch := TouchArea {
                enabled: root.custom-frame;
                double-clicked => { root.maximized = !root.maximized; }
                // Right-click: the system window menu, or ours where the
                // system has none (ours opens on press: X11 window managers
                // can close a popup opened on release)
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                        if !root.show-system-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, true) {
                            root.window-menu-x = move-area.x + self.mouse-x + 2px;
                            root.window-menu-y = self.mouse-y + 2px;
                            window-popup.show();
                        }
                    } else if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                        root.show-system-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
                    }
                }
            }
        }

        if root.agent-count > 0: VerticalLayout {
            alignment: center;
            padding-right: 6px;
            AgentsChip {
                count: root.agent-count;
                show-bubble(right, top) => {
                    root.agents-bubble-right = right;
                    root.agents-bubble-top = top;
                    root.agents-hover = true;
                }
                hide-bubble => { root.agents-hover = false; }
            }
        }

        if root.custom-frame: HorizontalLayout {
            padding-left: 6px;

            min := CaptionButton {
                label: "Minimize";
                clicked => { root.minimize(); }

                Rectangle {
                    width: 10px;
                    height: 1px;
                    background: min.glyph;
                }
            }

            max := CaptionButton {
                label: root.maximized ? "Restore" : "Maximize";
                clicked => { root.maximized = !root.maximized; }

                if !root.maximized: Rectangle {
                    width: 10px;
                    height: 10px;
                    border-width: 1px;
                    border-radius: 1px;
                    border-color: max.glyph;
                }
                // Restore: two overlapping squares
                if root.maximized: Rectangle {
                    width: 10px;
                    height: 10px;

                    Rectangle {
                        x: 2px;
                        y: 0;
                        width: 8px;
                        height: 8px;
                        border-width: 1px;
                        border-radius: 1px;
                        border-color: max.glyph;
                    }
                    Rectangle {
                        x: 0;
                        y: 2px;
                        width: 8px;
                        height: 8px;
                        border-width: 1px;
                        border-radius: 1px;
                        border-color: max.glyph;
                        background: Theme.panel;
                    }
                }
            }

            close := CaptionButton {
                label: "Close";
                clicked => { root.close-window(); }

                Path {
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                    stroke: close.glyph;
                    stroke-width: 1.2px;
                }
            }
        }
    }

    open-popup := PopupWindow {
        x: root.menu-start;
        y: 32px;
        width: popup-layout.preferred-width;

        PopupCard {
            popup-layout := VerticalLayout {
                padding: 4px;

                MenuItem {
                    label: "Network Stream";
                    icon: @image-url("icons/link.svg");
                    clicked => {
                        open-popup.close();
                        root.open-network-stream();
                    }
                }
                MenuSeparator {}
                MenuItem {
                    label: "Quit";
                    icon: @image-url("icons/power-off.svg");
                    shortcut: "Ctrl+Q";
                    clicked => {
                        open-popup.close();
                        root.quit-app();
                    }
                }
            }
        }
    }

    stations-popup := PopupWindow {
        x: root.menu-start + open-menu.width;
        y: 32px;
        width: stations-popup-layout.preferred-width;

        PopupCard {
            stations-popup-layout := VerticalLayout {
                padding: 4px;

                MenuItem {
                    label: "Search Stations";
                    icon: @image-url("icons/magnifying-glass.svg");
                    clicked => {
                        stations-popup.close();
                        root.open-station-search();
                    }
                }
                MenuItem {
                    label: "By Country";
                    icon: @image-url("icons/earth-europe.svg");
                    clicked => {
                        stations-popup.close();
                        root.open-country-picker();
                    }
                }
            }
        }
    }

    // Our window menu, for systems without one (some X11 window managers)
    window-popup := PopupWindow {
        x: root.window-menu-x;
        y: root.window-menu-y;
        width: window-popup-layout.preferred-width;

        PopupCard {
            window-popup-layout := VerticalLayout {
                padding: 4px;

                MenuItem {
                    label: "Minimize";
                    icon: @image-url("icons/window-minimize.svg");
                    clicked => {
                        window-popup.close();
                        root.minimize();
                    }
                }
                MenuItem {
                    label: root.maximized ? "Restore" : "Maximize";
                    icon: root.maximized ? @image-url("icons/window-restore.svg") : @image-url("icons/window-maximize.svg");
                    clicked => {
                        window-popup.close();
                        root.maximized = !root.maximized;
                    }
                }
                CheckMenuItem {
                    label: "Always on Top";
                    icon: @image-url("icons/thumbtack.svg");
                    checked: root.always-on-top;
                    clicked => {
                        window-popup.close();
                        root.always-on-top = !root.always-on-top;
                    }
                }
                MenuSeparator {}
                MenuItem {
                    label: "Close";
                    icon: @image-url("icons/xmark.svg");
                    clicked => {
                        window-popup.close();
                        root.close-window();
                    }
                }
            }
        }
    }

    view-popup := PopupWindow {
        x: root.menu-start + open-menu.width + stations-menu.width;
        y: 32px;
        width: view-popup-layout.preferred-width;

        PopupCard {
            view-popup-layout := VerticalLayout {
                padding: 4px;

                // Follows the OS; the hint says what it reports right now
                CheckMenuItem {
                    label: "System Theme";
                    icon: @image-url("icons/desktop.svg");
                    hint: !Platform.has-system-theme ? "Not available"
                        : Theme.system-dark ? "Dark" : "Light";
                    enabled: Platform.has-system-theme;
                    checked: Theme.theme-mode == "system";
                    clicked => {
                        view-popup.close();
                        Theme.theme-mode = "system";
                    }
                }
                CheckMenuItem {
                    label: "Dark Theme";
                    icon: @image-url("icons/moon.svg");
                    checked: Theme.theme-mode == "dark";
                    clicked => {
                        view-popup.close();
                        Theme.theme-mode = "dark";
                    }
                }
                CheckMenuItem {
                    label: "Light Theme";
                    icon: @image-url("icons/sun.svg");
                    checked: Theme.theme-mode == "light";
                    clicked => {
                        view-popup.close();
                        Theme.theme-mode = "light";
                    }
                }
                MenuSeparator {}
                MenuItem {
                    label: "Accent Color";
                    icon: @image-url("icons/palette.svg");
                    clicked => {
                        view-popup.close();
                        root.open-accent-color();
                    }
                }
                MenuSeparator {}
                if Platform.has-window-frame: CheckMenuItem {
                    // Chrome's wording: ticked means the system frame
                    label: "Use System Title Bar";
                    icon: @image-url("icons/window-maximize.svg");
                    checked: !root.custom-frame;
                    clicked => {
                        root.toggle-custom-frame();
                        view-popup.close();
                    }
                }
                if Platform.has-window-frame: MenuSeparator {}
                CheckMenuItem {
                    label: "Show Station Stats";
                    icon: @image-url("icons/clock.svg");
                    checked: root.show-station-stats;
                    clicked => {
                        view-popup.close();
                        root.show-station-stats = !root.show-station-stats;
                    }
                }
                MenuSeparator {}
                CheckMenuItem {
                    label: "Visualizer";
                    icon: @image-url("icons/wave-square.svg");
                    checked: root.show-visualizer;
                    clicked => {
                        view-popup.close();
                        root.show-visualizer = !root.show-visualizer;
                    }
                }
                // Keeps its choice while the visualizer is off
                CheckMenuItem {
                    label: "Station Colors in Visualizer";
                    icon: @image-url("icons/fill-drip.svg");
                    enabled: root.show-visualizer;
                    checked: VizStyle.palette == "logo";
                    clicked => {
                        view-popup.close();
                        VizStyle.palette = VizStyle.palette == "logo" ? "accent" : "logo";
                    }
                }
                if Platform.has-tray: MenuSeparator {}
                if Platform.has-tray: CheckMenuItem {
                    label: "Show Tray Icon";
                    icon: @image-url("icons/window-restore.svg");
                    checked: root.tray-icon;
                    clicked => {
                        root.tray-icon = !root.tray-icon;
                        view-popup.close();
                    }
                }
                // Greyed with no tray to hide in; they keep their ticks
                if Platform.has-tray: CheckMenuItem {
                    label: "Close to Tray";
                    icon: @image-url("icons/rectangle-xmark.svg");
                    enabled: root.tray-icon && root.tray-available;
                    checked: root.close-to-tray;
                    clicked => {
                        root.close-to-tray = !root.close-to-tray;
                        view-popup.close();
                    }
                }
                if Platform.has-tray: CheckMenuItem {
                    label: "Minimize to Tray";
                    icon: @image-url("icons/square-minus.svg");
                    enabled: root.tray-icon && root.tray-available;
                    checked: root.hide-on-minimize;
                    clicked => {
                        root.hide-on-minimize = !root.hide-on-minimize;
                        view-popup.close();
                    }
                }
                if Platform.has-tray: CheckMenuItem {
                    label: "Start Hidden in Tray";
                    icon: @image-url("icons/eye-slash.svg");
                    enabled: root.tray-icon && root.tray-available;
                    checked: root.start-in-tray;
                    clicked => {
                        root.start-in-tray = !root.start-in-tray;
                        view-popup.close();
                    }
                }
                if Platform.has-tray && root.tray-icon && !root.tray-available: MenuNote {
                    text: "This desktop shows no tray icons.\nOn GNOME, turn on the AppIndicator extension.";
                }
            }
        }
    }

    help-popup := PopupWindow {
        x: root.menu-start + open-menu.width + stations-menu.width + view-menu.width + tools-menu.width;
        y: 32px;
        width: help-popup-layout.preferred-width;

        PopupCard {
            help-popup-layout := VerticalLayout {
                padding: 4px;

                MenuItem {
                    label: "About Radiotrope";
                    icon: @image-url("icons/circle-info.svg");
                    clicked => {
                        help-popup.close();
                        root.open-about();
                    }
                }
            }
        }
    }

    tools-popup := PopupWindow {
        x: root.menu-start + open-menu.width + stations-menu.width + view-menu.width;
        y: 32px;
        width: tools-popup-layout.preferred-width;

        PopupCard {
            tools-popup-layout := VerticalLayout {
                padding: 4px;

                MenuItem {
                    label: "Equalizer";
                    icon: @image-url("icons/sliders.svg");
                    clicked => {
                        root.open-equalizer();
                        tools-popup.close();
                    }
                }
                MenuItem {
                    label: "Statistics";
                    icon: @image-url("icons/chart-column.svg");
                    clicked => {
                        root.open-statistics();
                        tools-popup.close();
                    }
                }
                MenuSeparator {}
                MenuItem {
                    label: root.is-recording ? "Stop Recording" : "Start Recording";
                    // Greyed out until a station plays
                    enabled: root.is-recording || root.can-record;
                    icon: @image-url("icons/circle.svg");
                    clicked => {
                        root.toggle-recording();
                        tools-popup.close();
                    }
                }
                MenuItem {
                    label: "Recording Settings";
                    icon: @image-url("icons/gear.svg");
                    clicked => {
                        root.open-recording-settings();
                        tools-popup.close();
                    }
                }
                if Platform.has-file-manager: MenuItem {
                    label: "Open Recordings Folder";
                    icon: @image-url("icons/folder-open.svg");
                    clicked => {
                        root.open-recordings-folder();
                        tools-popup.close();
                    }
                }
                MenuSeparator {}
                MenuItem {
                    label: "Agents (MCP)";
                    icon: @image-url("icons/robot.svg");
                    clicked => {
                        root.open-agents();
                        tools-popup.close();
                    }
                }
                if Platform.has-wifi: MenuSeparator {}
                if Platform.has-wifi: MenuItem {
                    label: "WiFi Settings";
                    icon: @image-url("icons/wifi.svg");
                    clicked => {
                        root.open-wifi-settings();
                        tools-popup.close();
                    }
                }
            }
        }
    }
}
