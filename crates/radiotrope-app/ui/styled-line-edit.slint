import { Theme } from "defaults.slint";
import { IconButton, FocusRing } from "components.slint";

export component StyledLineEdit inherits Rectangle {
    in property <string> placeholder-text;
    // The field's name for screen readers (the same text as its Field
    // label). Without one the placeholder is used.
    in property <string> label;
    // Must be filled in: said after the name
    in property <bool> required: false;
    in-out property <string> text;
    in property <bool> enabled: true;
    // Show an ✕ button on the right that clears the text
    in property <bool> clearable: false;
    // The text field has keyboard focus
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    callback cleared();

    property <length> margin: 10px;
    property <bool> show-clear: root.clearable && root.text != "" && root.enabled;
    // Space on the right for the text: the margin, plus the ✕ button when shown
    property <length> right-margin: root.show-clear ? 32px : root.margin;
    // The focus came by Tab (the key is released in the field it moved to):
    // the full focus ring shows. After a click the field only gets an
    // accent edge.
    property <bool> key-focus: false;

    height: Theme.control-field;
    border-radius: Theme.radius-sm;
    background: root.enabled ? Theme.elevated : Theme.disabled-bg;
    border-width: input.has-focus ? 1.5px : 1px;
    border-color: !root.enabled ? Theme.disabled-border
        : input.has-focus ? Theme.accent-text : Theme.field-border;
    animate border-color { duration: Theme.fast; }
    forward-focus: input;
    clip: true;

    // Placeholder, until something is typed (also while the field has
    // focus). It starts after the caret's width, so the caret never sits
    // on its first letter.
    if input.text == "": Text {
        text: root.placeholder-text;
        color: Theme.text-tertiary;
        font-size: Theme.font-base;
        vertical-alignment: center;
        x: root.margin + input.text-cursor-width;
        width: root.width - self.x - root.right-margin;
        height: root.height;
        // The input says it
        accessible-role: none;
    }

    input := TextInput {
        property <length> computed-x;

        x: min(root.margin, max(root.width - root.right-margin - self.width - self.text-cursor-width,
               self.computed-x + root.margin));
        width: max(root.width - root.margin - root.right-margin, self.preferred-width);
        height: root.height;
        text <=> root.text;
        // Greyed out while the field can't be used
        color: root.enabled ? Theme.text-primary : Theme.disabled-text;
        font-size: Theme.font-base;
        vertical-alignment: center;
        single-line: true;
        enabled: root.enabled;
        selection-background-color: Theme.selection-bg;
        selection-foreground-color: Theme.selection-fg;
        accessible-label: (root.label != "" ? root.label : root.placeholder-text)
            + (root.required ? ", required" : "");
        accessible-placeholder-text: root.placeholder-text;

        cursor-position-changed(cursor-position) => {
            if cursor-position.x + self.computed-x < root.margin {
                self.computed-x = -cursor-position.x + root.margin;
            } else if cursor-position.x + self.computed-x > root.width - root.margin - root.right-margin - self.text-cursor-width {
                self.computed-x = root.width - cursor-position.x - root.margin - root.right-margin - self.text-cursor-width;
            }
        }

        changed has-focus => {
            if self.has-focus {
                root.ensure-visible(ScrollBehavior.instant);
            } else {
                root.key-focus = false;
            }
        }
        key-released(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab {
                root.key-focus = true;
            }
            return reject;
        }
        accepted => { root.accepted(root.text); }
        edited => { root.edited(root.text); }
    }

    // Draw inside the field so scrolling or clipping never hides the ring.
    if input.has-focus && root.key-focus: FocusRing {
        radius: root.border-radius;
        offset: 0px;
    }

    if root.show-clear: IconButton {
        x: root.width - self.width - Theme.space-6;
        y: (root.height - self.height) / 2;
        width: Theme.space-24;
        height: self.width;
        icon-size: Theme.icon-sm;
        icon: @image-url("icons/xmark.svg");
        label: "Clear";
        clicked => {
            root.text = "";
            input.focus();
            root.cleared();
        }
    }

    public function select-all() {
        input.select-all();
    }

    // Focuses the field with the cursor after the text, so a reopened
    // dialog's search can be typed on (offsets past the end clamp to it)
    public function focus-input() {
        input.focus();
        input.set-selection-offsets(2147483647, 2147483647);
    }
}
