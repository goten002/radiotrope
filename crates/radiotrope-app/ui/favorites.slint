import { Theme } from "theme.slint";
import { ScrollBar } from "scroll-bar.slint";
import { IconButton, NowPlayingBars, Icon } from "components.slint";

export struct FavoriteStation {
    id: string,
    name: string,
    url: string,
    logo-url: string,
    country: string,
}

component FavoriteRow inherits Rectangle {
    in property <string> name;
    in property <string> country;
    in property <bool> is-current;
    // Playback state when current: "playing", "loading", "error" or ""
    in property <string> state;
    in property <image> logo-image;
    in property <bool> has-logo;
    in property <bool> is-drag-source;
    in property <bool> dragging;
    in property <int> row-index;
    callback clicked();
    callback edit-clicked();
    callback grip-moved(/* total y offset from press point */ length);
    callback grip-released();
    // The handle was pressed or let go; the list stops scrolling meanwhile
    // so it doesn't steal the drag
    callback handle-held(bool);

    // Set once a press turns into a drag, so releasing doesn't also play
    property <bool> dragged: false;

    height: 56px;
    background: root.is-drag-source ? Theme.elevated
              : is-current ? Theme.accent-soft
              : touch.has-hover || handle.has-hover ? Theme.menu-hover
              : transparent;
    animate background { duration: Theme.fast; }
    border-radius: Theme.radius-md;
    border-width: root.is-drag-source ? 1px : 0;
    border-color: Theme.accent;
    // Lifted look while dragged (no shadow otherwise: it would show
    // through the transparent background)
    drop-shadow-blur: root.is-drag-source ? 16px : 0;
    drop-shadow-offset-y: root.is-drag-source ? 4px : 0;
    drop-shadow-color: root.is-drag-source ? Theme.shadow : transparent;

    // Accent left border for current station
    if is-current: Rectangle {
        x: 0;
        y: 12px;
        width: 3px;
        height: parent.height - 24px;
        background: Theme.accent;
        border-radius: 1.5px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 8px;
        alignment: stretch;

        // Drag hint
        VerticalLayout {
            alignment: center;
            width: 20px;

            Icon {
                source: @image-url("icons/grip-lines.svg");
                width: 20px;
                height: 20px;
                colorize: root.is-drag-source ? Theme.accent
                    : handle.has-hover ? Theme.text-primary
                    : touch.has-hover ? Theme.text-secondary : Theme.text-tertiary;
            }
        }

        // Logo
        VerticalLayout {
            alignment: center;
            width: 40px;

            Rectangle {
                width: 40px;
                height: 40px;
                background: Theme.elevated;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.hairline;
                clip: true;

                if root.has-logo: Image {
                    source: root.logo-image;
                    width: 40px;
                    height: 40px;
                    image-fit: contain;
                }

                if !root.has-logo: Icon {
                    source: @image-url("icons/music-note.svg");
                    width: 18px;
                    height: 18px;
                    colorize: Theme.text-secondary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Station info — takes remaining space
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    horizontal-stretch: 0;
                    text: root.name;
                    color: root.is-current ? Theme.accent-text : Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                }

                // Same state marks as in search: bars only while audio
                // plays, a spinner while connecting, a red mark on errors
                if root.is-current && root.state == "playing": VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    NowPlayingBars {}
                }

                if root.is-current && root.state == "loading": VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    Icon {
                        source: @image-url("icons/spinner.svg");
                        width: 12px;
                        height: 12px;
                        colorize: Theme.accent;
                        rotation: mod(animation-tick() / 900ms, 1) * 360deg;
                    }
                }

                if root.is-current && root.state == "error": VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    Icon {
                        source: @image-url("icons/circle-exclamation.svg");
                        width: 13px;
                        height: 13px;
                        colorize: Theme.danger;
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            if root.country != "": Text {
                text: root.country;
                color: Theme.text-secondary;
                font-size: 11px;
                overflow: elide;
            }
        }

        // Edit (pencil) button
        VerticalLayout {
            alignment: center;

            IconButton {
                icon: @image-url("icons/pencil.svg");
                icon-size: 14px;
                icon-color: Theme.text-tertiary;
                clicked => { root.edit-clicked(); }
            }
        }
    }

    // Drag handle: the grip and the logo. Press and move to reorder; a
    // click without moving still plays
    handle := TouchArea {
        x: 0;
        width: 86px;
        mouse-cursor: root.dragging ? grabbing : grab;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.dragged = false;
                root.handle-held(true);
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.handle-held(false);
                if root.dragged {
                    root.grip-released();
                }
            }
        }
        moved => {
            if self.pressed && (root.dragged || abs(self.mouse-y - self.pressed-y) > 3px) {
                root.dragged = true;
                root.grip-moved(self.mouse-y - self.pressed-y);
            }
        }
        clicked => {
            if !root.dragged {
                root.clicked();
            }
        }
    }
}

// Row height (56px) + spacing (4px)
global RowMetrics {
    out property <length> row-stride: 60px;
    out property <length> list-padding: 8px;
}

export component Favorites inherits Rectangle {
    in-out property <[FavoriteStation]> favorites;
    in-out property <[image]> favorite-logos;
    in property <string> current-station-url;
    in property <bool> is-playing;
    in property <bool> play-loading;
    in property <bool> play-error;
    // Drag the list itself to scroll (touch screens). Off on the desktop,
    // where the wheel and scrollbar scroll and a list that grabs drags
    // would eat quick reorder drags
    in property <bool> touch-scroll: false;

    callback favorite-clicked(FavoriteStation);
    callback favorite-edit-requested(FavoriteStation);
    callback favorites-reordered(/* from */ int, /* to */ int);

    // Drag state
    property <int> drag-from-index: -1;
    property <int> drag-target-index: -1;
    // How far the dragged row has moved from where it was picked up
    property <length> drag-offset: 0;
    // A row's drag handle is held down
    property <bool> handle-held: false;

    background: Theme.surface;

    // Empty state
    if favorites.length == 0: VerticalLayout {
        alignment: center;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            Icon {
                source: @image-url("icons/book-heart.svg");
                width: 48px;
                height: 48px;
                colorize: Theme.text-secondary;
            }
        }

        Text {
            text: "No favorites yet";
            font-size: 14px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }

        Text {
            text: "Stations you favorite will appear here";
            font-size: 11px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
    }

    // Favorites list
    if favorites.length > 0: Rectangle {
        fav-flickable := Flickable {
            interactive: root.touch-scroll && root.drag-from-index < 0 && !root.handle-held;
            content-height: fav-layout.preferred-height;

            fav-layout := VerticalLayout {
                padding: 8px;
                padding-right: 14px;
                spacing: 4px;

                for station[idx] in root.favorites: Rectangle {
                    height: 56px;
                    // The dragged row draws above the others
                    z: root.drag-from-index == idx ? 1 : 0;

                    FavoriteRow {
                        // Dragged row follows the pointer; rows between its
                        // old and new place slide over to open a gap
                        y: root.drag-from-index == idx ? root.drag-offset
                            : root.drag-from-index < 0 ? 0
                            : root.drag-from-index < idx && idx <= root.drag-target-index ? -RowMetrics.row-stride
                            : root.drag-target-index <= idx && idx < root.drag-from-index ? RowMetrics.row-stride
                            : 0;
                        // Only the neighbours glide; on drop everything snaps,
                        // since the list is reordered in the same moment
                        animate y {
                            duration: root.drag-from-index < 0 || root.drag-from-index == idx ? 0ms : Theme.normal;
                            easing: ease-out;
                        }
                        width: parent.width;

                        name: station.name;
                        country: station.country;
                        is-current: station.url == root.current-station-url;
                        state: root.play-error ? "error"
                            : root.play-loading ? "loading"
                            : root.is-playing ? "playing" : "";
                        logo-image: idx < root.favorite-logos.length ? root.favorite-logos[idx] : @image-url("");
                        has-logo: idx < root.favorite-logos.length
                            ? root.favorite-logos[idx].width > 0
                            : false;
                        is-drag-source: root.drag-from-index == idx;
                        dragging: root.drag-from-index >= 0;
                        row-index: idx;
                        clicked => {
                            root.favorite-clicked(station);
                        }
                        edit-clicked => {
                            root.favorite-edit-requested(station);
                        }
                        grip-moved(offset-y) => {
                            if root.drag-from-index < 0 {
                                root.drag-from-index = idx;
                                root.drag-target-index = idx;
                            }
                            // Keep the row inside the list
                            root.drag-offset = clamp(offset-y,
                                -idx * RowMetrics.row-stride,
                                (root.favorites.length - 1 - idx) * RowMetrics.row-stride);
                            root.drag-target-index = clamp(
                                idx + round(root.drag-offset / RowMetrics.row-stride),
                                0, root.favorites.length - 1);
                            // Auto-scroll near the edges (visible pos = content pos + content-y)
                            if RowMetrics.list-padding + idx * RowMetrics.row-stride + root.drag-offset
                               + fav-flickable.content-y < 20px {
                                fav-flickable.content-y = min(0px, fav-flickable.content-y + 12px);
                            }
                            if RowMetrics.list-padding + (idx + 1) * RowMetrics.row-stride + root.drag-offset
                               + fav-flickable.content-y > fav-flickable.height - 20px {
                                fav-flickable.content-y = max(
                                    min(0px, fav-flickable.height - fav-flickable.content-height),
                                    fav-flickable.content-y - 12px);
                            }
                        }
                        handle-held(held) => { root.handle-held = held; }
                        grip-released => {
                            if root.drag-from-index >= 0 && root.drag-target-index >= 0
                               && root.drag-from-index != root.drag-target-index {
                                root.favorites-reordered(root.drag-from-index, root.drag-target-index);
                            }
                            root.drag-from-index = -1;
                            root.drag-target-index = -1;
                            root.drag-offset = 0;
                        }
                    }
                }
            }
        }

        ScrollBar {
            x: parent.width - self.width - 2px;
            y: 4px;
            height: parent.height - 8px;
            viewport-height: fav-flickable.height;
            content-height: fav-flickable.content-height;
            content-y <=> fav-flickable.content-y;
        }
    }
}
