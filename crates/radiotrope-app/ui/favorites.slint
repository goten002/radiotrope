import { Theme } from "theme.slint";
import { ScrollBar } from "scroll-bar.slint";
import { IconButton, NowPlayingBars, Icon } from "components.slint";

export struct FavoriteStation {
    id: string,
    name: string,
    url: string,
    logo-url: string,
    country: string,
    // Stats: total listening time ("3 h 25 m"), when last played
    // ("Yesterday"), both empty when never played
    listen-time: string,
    last-played: string,
    play-count: int,
    // Listening time since the app was opened, empty when none
    session-time: string,
}

// Item of a row's menu
component RowMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    min-width: 170px;
    border-radius: 4px;
    background: touch.has-hover && root.enabled ? (root.danger ? Theme.danger.with-alpha(0.14) : Theme.menu-hover) : transparent;
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.label;
            color: !root.enabled ? Theme.disabled-text
                : root.danger ? Theme.danger
                : touch.has-hover ? Theme.text-primary : Theme.menu-text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

component FavoriteRow inherits Rectangle {
    in property <string> name;
    in property <string> country;
    in property <bool> is-current;
    // Playback state when current: "playing", "loading", "error" or ""
    in property <string> state;
    in property <image> logo-image;
    in property <bool> has-logo;
    in property <bool> is-drag-source;
    in property <bool> dragging;
    in property <int> row-index;
    in property <string> listen-time;
    in property <string> last-played;
    in property <int> play-count;
    in property <string> session-time;
    // Show the stats on the right (View > Show Station Stats)
    in property <bool> show-stats: true;
    // Touch screens: pick a station up only after holding the logo
    // briefly, so a swipe that starts on the logo still scrolls the list,
    // and open the menu by holding the rest of the row
    in property <bool> hold-to-drag: false;
    callback clicked();
    callback edit-clicked();
    callback move-requested(/* to-top */ bool);
    callback remove-requested();
    callback reset-stats-requested();
    // Pointer y in window coordinates, and where in the row it grabbed
    callback grip-moved(/* pointer-y */ length, /* grab-y */ length);
    callback grip-released();
    // The handle was pressed or let go; the list stops scrolling meanwhile
    // so it doesn't steal the drag
    callback handle-held(bool);

    // Set once a press turns into a drag, so releasing doesn't also play
    property <bool> dragged: false;
    // Where the menu opens (row coordinates) and whether Remove was
    // clicked once already
    property <length> menu-x;
    property <length> menu-y;
    property <bool> confirm-remove: false;
    property <bool> confirm-reset: false;
    // The menu opened from a hold, so letting go must not also play
    property <bool> menu-held: false;
    // The pointer has rested on the stats long enough to explain them
    property <bool> stats-ready: false;
    property <length> menu-width: 186px;

    public function open-menu(x: length, y: length) {
        root.confirm-remove = false;
        root.confirm-reset = false;
        root.menu-x = clamp(x, 0, root.width - root.menu-width);
        root.menu-y = y;
        menu.show();
    }

    height: 56px;
    background: root.is-drag-source ? Theme.elevated
              : is-current ? Theme.accent-soft
              : touch.has-hover || handle.has-hover ? Theme.menu-hover
              : transparent;
    animate background { duration: Theme.fast; }
    border-radius: Theme.radius-md;
    border-width: root.is-drag-source ? 1px : 0;
    border-color: Theme.accent;
    // Lifted look while dragged (no shadow otherwise: it would show
    // through the transparent background)
    drop-shadow-blur: root.is-drag-source ? 16px : 0;
    drop-shadow-offset-y: root.is-drag-source ? 4px : 0;
    drop-shadow-color: root.is-drag-source ? Theme.shadow : transparent;

    // Accent left border for current station
    if is-current: Rectangle {
        x: 0;
        // As tall as the logo (40px, centred in the row)
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        background: Theme.accent;
        border-radius: 1.5px;
    }

    // Holding the row opens the menu on touch screens (right-click does
    // on the desktop)
    menu-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            if touch.pressed {
                root.menu-held = true;
                root.open-menu(touch.pressed-x, touch.pressed-y);
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if !root.menu-held {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.open-menu(self.mouse-x, self.mouse-y);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.menu-held = false;
                menu-timer.running = root.hold-to-drag;
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                menu-timer.running = false;
            }
        }
        moved => {
            // Moving is a swipe: leave it to the list
            if abs(self.mouse-y - self.pressed-y) > 6px || abs(self.mouse-x - self.pressed-x) > 6px {
                menu-timer.running = false;
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 8px;
        alignment: stretch;

        // Logo
        VerticalLayout {
            alignment: center;
            width: 40px;

            Rectangle {
                width: 40px;
                height: 40px;
                background: Theme.elevated;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.hairline;
                clip: true;

                if root.has-logo: Image {
                    source: root.logo-image;
                    width: 40px;
                    height: 40px;
                    image-fit: contain;
                }

                if !root.has-logo: Icon {
                    source: @image-url("icons/music-note.svg");
                    width: 18px;
                    height: 18px;
                    colorize: Theme.text-secondary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Station info — takes remaining space
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    horizontal-stretch: 0;
                    text: root.name;
                    color: root.is-current ? Theme.accent-text : Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                }

                // Same state marks as in search: bars only while audio
                // plays, a spinner while connecting, a red mark on errors
                if root.is-current && root.state == "playing": VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    NowPlayingBars {}
                }

                if root.is-current && root.state == "loading": VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    Icon {
                        source: @image-url("icons/spinner.svg");
                        width: 12px;
                        height: 12px;
                        colorize: Theme.accent;
                        rotation: mod(animation-tick() / 900ms, 1) * 360deg;
                    }
                }

                if root.is-current && root.state == "error": VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    Icon {
                        source: @image-url("icons/circle-exclamation.svg");
                        width: 13px;
                        height: 13px;
                        colorize: Theme.danger;
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            if root.country != "": Text {
                text: root.country;
                color: Theme.text-secondary;
                font-size: 11px;
                overflow: elide;
            }
        }

        // Stats: listening time over when it was last played
        if root.show-stats: VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 0;

            if root.listen-time != "": Text {
                text: root.listen-time;
                color: root.is-current ? Theme.accent-text : Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: right;
            }
            Text {
                text: root.last-played != "" ? root.last-played : "Not played yet";
                color: Theme.text-tertiary;
                font-size: 11px;
                horizontal-alignment: right;
            }
        }
    }

    // Hovering the stats explains them in a bubble to their left. Clicks
    // pass through to the row.
    stats-touch := TouchArea {
        visible: root.show-stats;
        x: root.width - self.width;
        width: 104px;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.open-menu(self.x + self.mouse-x, self.mouse-y);
            }
        }
        changed has-hover => {
            if !self.has-hover {
                root.stats-ready = false;
            }
        }
    }

    Timer {
        interval: 400ms;
        running: stats-touch.has-hover && !root.stats-ready;
        triggered => { root.stats-ready = true; }
    }

    stats-bubble := Rectangle {
        property <bool> shown: stats-touch.has-hover && root.stats-ready
            && !stats-touch.pressed && !root.dragging;
        visible: self.opacity > 0;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.fast; }
        x: stats-touch.x - self.width - 4px;
        y: (root.height - self.height) / 2;
        width: bubble-layout.preferred-width;
        height: bubble-layout.preferred-height;
        background: Theme.popup-bg;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.hairline;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: Theme.shadow-soft;

        bubble-layout := VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 2px;

            if root.last-played == "": Text {
                text: "Listening stats appear once you play it";
                color: Theme.text-secondary;
                font-size: 11px;
            }
            if root.last-played != "": Text {
                text: "Total listening time: " + (root.listen-time != "" ? root.listen-time : "<1 m");
                color: Theme.text-primary;
                font-size: 11px;
            }
            if root.session-time != "": Text {
                text: "This session: " + root.session-time;
                color: Theme.text-primary;
                font-size: 11px;
            }
            if root.last-played != "": Text {
                text: "Last played: " + root.last-played
                    + "  ·  " + root.play-count + (root.play-count == 1 ? " play" : " plays");
                color: Theme.text-secondary;
                font-size: 11px;
            }
        }
    }

    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: root.menu-width;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.shadow-soft;
            drop-shadow-offset-y: 2px;

            VerticalLayout {
                padding: 4px;

                RowMenuItem {
                    label: "Edit";
                    clicked => {
                        menu.close();
                        root.edit-clicked();
                    }
                }
                RowMenuItem {
                    label: "Move to Top";
                    clicked => {
                        menu.close();
                        root.move-requested(true);
                    }
                }
                RowMenuItem {
                    label: "Move to Bottom";
                    clicked => {
                        menu.close();
                        root.move-requested(false);
                    }
                }
                // Only while stats are shown, and asks once more first.
                // Act before closing: inside an `if` the handler stops
                // once the menu closes
                if root.show-stats: RowMenuItem {
                    label: root.confirm-reset ? "Click Again to Reset" : "Reset Stats";
                    enabled: root.play-count > 0
                        || root.listen-time != "" || root.session-time != "";
                    clicked => {
                        if root.confirm-reset {
                            root.reset-stats-requested();
                            menu.close();
                        } else {
                            root.confirm-reset = true;
                        }
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Theme.menu-hover;
                    }
                }
                // Asks once more before removing
                RowMenuItem {
                    label: root.confirm-remove ? "Click Again to Remove" : "Remove from Favorites";
                    danger: true;
                    clicked => {
                        if root.confirm-remove {
                            menu.close();
                            root.remove-requested();
                        } else {
                            root.confirm-remove = true;
                        }
                    }
                }
            }
        }
    }

    // After a hold on the logo (touch screens), pick the row up where
    // the finger is, without waiting for it to move
    hold-timer := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            if handle.pressed && !root.dragged {
                root.dragged = true;
                root.handle-held(true);
                root.grip-moved(handle.absolute-position.y + handle.mouse-y, handle.pressed-y);
            }
        }
    }

    // Drag handle: the logo. Press and move to reorder (or hold first on
    // touch screens); a click without moving still plays
    handle := TouchArea {
        x: 0;
        width: 58px;
        mouse-cursor: root.dragging ? grabbing : grab;
        pointer-event(event) => {
            if event.button == PointerEventButton.right {
                if event.kind == PointerEventKind.down {
                    root.open-menu(self.x + self.mouse-x, self.mouse-y);
                }
                return;
            }
            if event.kind == PointerEventKind.down {
                root.dragged = false;
                if root.hold-to-drag {
                    hold-timer.running = true;
                } else {
                    root.handle-held(true);
                }
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                hold-timer.running = false;
                root.handle-held(false);
                if root.dragged {
                    root.grip-released();
                }
            }
        }
        moved => {
            if root.hold-to-drag && !root.dragged {
                // Moving before the hold ends is a swipe: leave it to the list
                if abs(self.mouse-y - self.pressed-y) > 6px || abs(self.mouse-x - self.pressed-x) > 6px {
                    hold-timer.running = false;
                }
                return;
            }
            if self.pressed && (root.dragged || abs(self.mouse-y - self.pressed-y) > 3px) {
                root.dragged = true;
                root.grip-moved(self.absolute-position.y + self.mouse-y, self.pressed-y);
            }
        }
        clicked => {
            if !root.dragged {
                root.clicked();
            }
        }
    }
}

// Row height (56px) + spacing (4px)
global RowMetrics {
    out property <length> row-stride: 60px;
    out property <length> list-padding: 8px;
}

export component Favorites inherits Rectangle {
    in-out property <[FavoriteStation]> favorites;
    in-out property <[image]> favorite-logos;
    in property <string> current-station-url;
    in property <bool> is-playing;
    in property <bool> play-loading;
    in property <bool> play-error;
    // Drag the list itself to scroll (touch screens). Off on the desktop,
    // where the wheel and scrollbar scroll and a list that grabs drags
    // would eat quick reorder drags
    in property <bool> touch-scroll: false;
    in property <bool> show-stats: true;

    callback favorite-clicked(FavoriteStation);
    callback favorite-edit-requested(FavoriteStation);
    callback favorite-move-requested(FavoriteStation, /* to-top */ bool);
    callback favorite-remove-requested(FavoriteStation);
    callback favorite-reset-stats-requested(FavoriteStation);
    callback favorites-reordered(/* from */ int, /* to */ int);

    // Drag state
    property <int> drag-from-index: -1;
    property <int> drag-target-index: -1;
    // How far the dragged row has moved from where it was picked up
    property <length> drag-offset: 0;
    // A row's drag handle is held down
    property <bool> handle-held: false;
    // Pointer y (window coordinates) and where in the row it grabbed
    property <length> drag-pointer-y;
    property <length> drag-grab-y;
    background: Theme.surface;

    // Empty state
    if favorites.length == 0: VerticalLayout {
        alignment: center;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            Icon {
                source: @image-url("icons/book-heart.svg");
                width: 48px;
                height: 48px;
                colorize: Theme.text-secondary;
            }
        }

        Text {
            text: "No favorites yet";
            font-size: 14px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }

        Text {
            text: "Stations you favorite will appear here";
            font-size: 11px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
    }

    // Favorites list
    if favorites.length > 0: list := Rectangle {
        // Auto-scroll speed while the pointer is near or past the list's top or
        // bottom edge: positive scrolls up, faster the further out it is
        property <length> edge-zone: 48px;
        property <length> max-scroll-step: 18px;
        property <length> scroll-step: {
            if root.drag-from-index < 0 { return 0px; }
            let y = root.drag-pointer-y - fav-flickable.absolute-position.y;
            if y < list.edge-zone {
                return list.max-scroll-step * min(1, (list.edge-zone - y) / list.edge-zone);
            }
            if y > fav-flickable.height - list.edge-zone {
                return -list.max-scroll-step * min(1, (y - fav-flickable.height + list.edge-zone) / list.edge-zone);
            }
            return 0px;
        }

        // Place the dragged row under the pointer and pick its drop slot. Also
        // runs after auto-scroll, so the row stays under a pointer that is not
        // moving (e.g. pinned at the screen edge).
        function update-drag() {
            let idx = root.drag-from-index;
            let pointer = root.drag-pointer-y - fav-flickable.absolute-position.y - fav-flickable.content-y;
            let home = RowMetrics.list-padding + idx * RowMetrics.row-stride;
            // Stay inside the list, and in view when the pointer leaves it
            let visible-top = -fav-flickable.content-y - home;
            let visible-bottom = visible-top + fav-flickable.height - RowMetrics.row-stride;
            root.drag-offset = clamp(
                clamp(pointer - root.drag-grab-y - home, visible-top, visible-bottom),
                -idx * RowMetrics.row-stride,
                (root.favorites.length - 1 - idx) * RowMetrics.row-stride);
            root.drag-target-index = clamp(
                idx + round(root.drag-offset / RowMetrics.row-stride),
                0, root.favorites.length - 1);
        }

        // Keeps scrolling while the pointer rests near an edge
        Timer {
            interval: 16ms;
            running: list.scroll-step != 0px;
            triggered => {
                fav-flickable.content-y = clamp(
                    fav-flickable.content-y + list.scroll-step,
                    min(0px, fav-flickable.height - fav-flickable.content-height),
                    0px);
                list.update-drag();
            }
        }

        fav-flickable := Flickable {
            interactive: root.touch-scroll && root.drag-from-index < 0 && !root.handle-held;
            content-height: fav-layout.preferred-height;

            fav-layout := VerticalLayout {
                padding: 8px;
                padding-right: 14px;
                spacing: 4px;

                for station[idx] in root.favorites: Rectangle {
                    height: 56px;
                    // The dragged row draws above the others
                    z: root.drag-from-index == idx ? 1 : 0;

                    FavoriteRow {
                        // Dragged row follows the pointer; rows between its
                        // old and new place slide over to open a gap
                        y: root.drag-from-index == idx ? root.drag-offset
                            : root.drag-from-index < 0 ? 0
                            : root.drag-from-index < idx && idx <= root.drag-target-index ? -RowMetrics.row-stride
                            : root.drag-target-index <= idx && idx < root.drag-from-index ? RowMetrics.row-stride
                            : 0;
                        // Only the neighbours glide; on drop everything snaps,
                        // since the list is reordered in the same moment
                        animate y {
                            duration: root.drag-from-index < 0 || root.drag-from-index == idx ? 0ms : Theme.normal;
                            easing: ease-out;
                        }
                        width: parent.width;

                        name: station.name;
                        country: station.country;
                        is-current: station.url == root.current-station-url;
                        state: root.play-error ? "error"
                            : root.play-loading ? "loading"
                            : root.is-playing ? "playing" : "";
                        logo-image: idx < root.favorite-logos.length ? root.favorite-logos[idx] : @image-url("");
                        has-logo: idx < root.favorite-logos.length
                            ? root.favorite-logos[idx].width > 0
                            : false;
                        is-drag-source: root.drag-from-index == idx;
                        dragging: root.drag-from-index >= 0;
                        row-index: idx;
                        clicked => {
                            root.favorite-clicked(station);
                        }
                        listen-time: station.listen-time;
                        last-played: station.last-played;
                        play-count: station.play-count;
                        session-time: station.session-time;
                        show-stats: root.show-stats;
                        hold-to-drag: root.touch-scroll;
                        edit-clicked => {
                            root.favorite-edit-requested(station);
                        }
                        move-requested(to-top) => {
                            root.favorite-move-requested(station, to-top);
                        }
                        remove-requested => {
                            root.favorite-remove-requested(station);
                        }
                        reset-stats-requested => {
                            root.favorite-reset-stats-requested(station);
                        }
                        grip-moved(pointer-y, grab-y) => {
                            if root.drag-from-index < 0 {
                                root.drag-from-index = idx;
                                root.drag-target-index = idx;
                            }
                            root.drag-pointer-y = pointer-y;
                            root.drag-grab-y = grab-y;
                            list.update-drag();
                        }
                        handle-held(held) => { root.handle-held = held; }
                        grip-released => {
                            if root.drag-from-index >= 0 && root.drag-target-index >= 0
                               && root.drag-from-index != root.drag-target-index {
                                root.favorites-reordered(root.drag-from-index, root.drag-target-index);
                            }
                            root.drag-from-index = -1;
                            root.drag-target-index = -1;
                            root.drag-offset = 0;
                        }
                    }
                }
            }
        }

        ScrollBar {
            x: parent.width - self.width - 2px;
            y: 4px;
            height: parent.height - 8px;
            viewport-height: fav-flickable.height;
            content-height: fav-flickable.content-height;
            content-y <=> fav-flickable.content-y;
        }
    }
}
