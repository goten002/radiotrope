import { Theme } from "theme.slint";
import { ScrollBar } from "scroll-bar.slint";

export struct FavoriteStation {
    id: string,
    name: string,
    url: string,
    logo-url: string,
    country: string,
}

component FavoriteRow inherits Rectangle {
    in property <string> name;
    in property <string> country;
    in property <bool> is-current;
    in property <image> logo-image;
    in property <bool> has-logo;
    in property <bool> is-drag-source;
    in property <int> row-index;
    callback clicked();
    callback edit-clicked();
    callback grip-moved(/* total y offset from press point */ length);
    callback grip-released();

    height: 52px;
    opacity: is-drag-source ? 0.35 : 1.0;
    background: is-current ? Theme.accent.with-alpha(0.15)
              : touch.has-hover ? Theme.menu-hover
              : transparent;
    border-radius: 4px;

    // Accent left border for current station
    if is-current: Rectangle {
        x: 0;
        y: 4px;
        width: 3px;
        height: parent.height - 8px;
        background: Theme.accent;
        border-radius: 1.5px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: stretch;

        // Grip handle — draggable
        VerticalLayout {
            alignment: center;
            width: 24px;

            Rectangle {
                width: 24px;
                height: 36px;

                grip-touch := TouchArea {
                    mouse-cursor: self.pressed ? grabbing : grab;
                    moved => {
                        if self.pressed {
                            root.grip-moved(self.mouse-y - self.pressed-y);
                        }
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.up {
                            root.grip-released();
                        }
                    }
                }

                Image {
                    source: @image-url("icons/grip-vertical.svg");
                    width: 16px;
                    height: 16px;
                    colorize: grip-touch.has-hover || grip-touch.pressed
                              ? Theme.text-primary : Theme.text-secondary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Logo
        VerticalLayout {
            alignment: center;
            width: 36px;

            Rectangle {
                width: 36px;
                height: 36px;
                background: Theme.surface;
                border-radius: 4px;
                clip: true;

                if root.has-logo: Image {
                    source: root.logo-image;
                    width: 36px;
                    height: 36px;
                    image-fit: contain;
                }

                if !root.has-logo: Image {
                    source: @image-url("icons/music-note.svg");
                    width: 18px;
                    height: 18px;
                    colorize: Theme.text-secondary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Station info — takes remaining space
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.name;
                color: Theme.text-primary;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }

            if root.country != "": Text {
                text: root.country;
                color: Theme.text-secondary;
                font-size: 11px;
                overflow: elide;
            }
        }

        // Edit (pencil) button
        VerticalLayout {
            alignment: center;
            width: 28px;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: pencil-touch.has-hover ? Theme.menu-hover : transparent;

                pencil-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.edit-clicked();
                    }
                }

                Image {
                    source: @image-url("icons/pencil.svg");
                    width: 14px;
                    height: 14px;
                    colorize: pencil-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
}

// Row height (52px) + spacing (2px)
global RowMetrics {
    out property <length> row-stride: 54px;
    out property <length> list-padding: 4px;
}

export component Favorites inherits Rectangle {
    in-out property <[FavoriteStation]> favorites;
    in-out property <[image]> favorite-logos;
    in property <string> current-station-url;

    callback favorite-clicked(FavoriteStation);
    callback favorite-edit-requested(FavoriteStation);
    callback favorites-reordered(/* from */ int, /* to */ int);

    // Drag state
    property <int> drag-from-index: -1;
    property <int> drag-target-index: -1;
    // Mouse y in viewport coordinates (for auto-scroll)
    property <length> drag-mouse-in-viewport: 0;
    // Scroll offset exposed for auto-scroll from grip handlers
    property <length> scroll-y: 0;

    background: Theme.surface;

    // Empty state
    if favorites.length == 0: VerticalLayout {
        alignment: center;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/book-heart.svg");
                width: 48px;
                height: 48px;
                colorize: Theme.text-secondary;
            }
        }

        Text {
            text: "No favorites yet";
            font-size: 14px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }

        Text {
            text: "Stations you favorite will appear here";
            font-size: 11px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
    }

    // Favorites list
    if favorites.length > 0: Rectangle {
        fav-flickable := Flickable {
            interactive: root.drag-from-index < 0;
            content-height: fav-layout.preferred-height;
            changed content-y => { root.scroll-y = self.content-y; }

            fav-layout := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                for station[idx] in root.favorites: FavoriteRow {
                    name: station.name;
                    country: station.country;
                    is-current: station.url == root.current-station-url;
                    logo-image: idx < root.favorite-logos.length ? root.favorite-logos[idx] : @image-url("");
                    has-logo: idx < root.favorite-logos.length
                        ? root.favorite-logos[idx].width > 0
                        : false;
                    is-drag-source: root.drag-from-index == idx;
                    row-index: idx;
                    clicked => {
                        root.favorite-clicked(station);
                    }
                    edit-clicked => {
                        root.favorite-edit-requested(station);
                    }
                    grip-moved(offset-y) => {
                        // Start drag on first movement
                        if root.drag-from-index < 0 {
                            root.drag-from-index = idx;
                            root.drag-target-index = idx;
                        }
                        // Mouse position in viewport coordinates
                        root.drag-mouse-in-viewport = RowMetrics.list-padding
                            + idx * RowMetrics.row-stride + 26px + offset-y;
                        // Target index from viewport position
                        root.drag-target-index = Math.clamp(
                            Math.round((root.drag-mouse-in-viewport - RowMetrics.list-padding)
                                / RowMetrics.row-stride),
                            0,
                            root.favorites.length - 1
                        );
                        // Auto-scroll near edges (visible pos = viewport pos + content-y)
                        if root.drag-mouse-in-viewport + fav-flickable.content-y < 40px {
                            fav-flickable.content-y = Math.min(0px,
                                fav-flickable.content-y + 16px);
                        }
                        if root.drag-mouse-in-viewport + fav-flickable.content-y
                           > fav-flickable.height - 40px {
                            fav-flickable.content-y = Math.max(
                                fav-flickable.height - fav-flickable.content-height,
                                fav-flickable.content-y - 16px);
                        }
                    }
                    grip-released => {
                        if root.drag-from-index >= 0 && root.drag-target-index >= 0
                           && root.drag-from-index != root.drag-target-index {
                            root.favorites-reordered(root.drag-from-index, root.drag-target-index);
                        }
                        root.drag-from-index = -1;
                        root.drag-target-index = -1;
                    }
                }
            }

            // Drop indicator line — inside Flickable so it scrolls with content
            if root.drag-from-index >= 0 && root.drag-target-index >= 0
               && root.drag-from-index != root.drag-target-index: Rectangle {
                property <int> insert-visual: root.drag-target-index > root.drag-from-index
                    ? root.drag-target-index + 1 : root.drag-target-index;
                x: 12px;
                y: RowMetrics.list-padding + insert-visual * RowMetrics.row-stride - 1px;
                width: root.width - 24px;
                height: 2px;
                background: Theme.accent;
                border-radius: 1px;
            }
        }

        ScrollBar {
            x: parent.width - self.width - 2px;
            y: 4px;
            height: parent.height - 8px;
            viewport-height: fav-flickable.height;
            content-height: fav-flickable.content-height;
            content-y <=> fav-flickable.content-y;
        }
    }

}
