import { ShortcutAction } from "shortcuts.slint";
import { Theme, Defaults } from "defaults.slint";
import { ScrollBar } from "scroll-bar.slint";
import { Icon, IconButton, ButtonKeys, FocusRing, PopupCard, MenuSeparator, ChoiceRow, StatusPanel } from "components.slint";
import { StyledLineEdit } from "styled-line-edit.slint";
import { AccentButton } from "buttons.slint";
import { DesktopShortcuts } from "shortcuts.slint";
import { Platform } from "@platform/wifi.slint";
import { StationState, StationRowSurface, StationLogo, StationStateMark } from "station-row.slint";
import { KeyListCursor } from "key-list.slint";

// One of a station's streams, for a list of them
export struct StationStream {
    url: string,
    // What is known of it: "AAC · 128 kbps", or empty
    label: string,
    // The server it comes from: "stream.example.org"
    host: string,
    // As the station keeps it (codec "" and bitrate 0: not known)
    codec: string,
    bitrate: int,
    hls: bool,
    status: string,
}

export struct FavoriteStation {
    id: string,
    name: string,
    // The default stream's address
    url: string,
    // Every stream, in order, the default among them
    streams: [StationStream],
    logo-url: string,
    country: string,
    // Stats: total listening time ("3 h 25 min"), when last played
    // ("Yesterday"), both empty when never played
    listen-time: string,
    last-played: string,
    play-count: int,
    // Listening time since the app was opened, empty when none
    session-time: string,
}

// Find in favorites: the rows whose name contains the text, and where
// each of them is in the whole list (Rust; the list itself stays whole and
// in order)
export global FavoritesFind {
    pure callback stations([FavoriteStation], string) -> [FavoriteStation];
    pure callback rows([FavoriteStation], string) -> [int];
}

// Picking another station while recording ends the recording, so the first
// press only arms the row and says so; a second press within this time
// switches. Shared by the favorites and the search results.
export global RecordingGuard {
    out property <string> text: "Recording will stop · Press Again to Switch";
    // For screen readers, after the row's own description
    out property <string> spoken: "recording will stop, press again to switch";
    out property <duration> confirm-time: 5s;
}

// A quiet action under a primary button: accent text, underlined while
// hovered or focused
component TextButton inherits Rectangle {
    in property <string> label;
    // A Tab stop (off while a dialog covers the window)
    in property <bool> focusable: true;
    callback clicked();

    height: Theme.row-menu;
    width: text.preferred-width + 2 * Theme.space-8;
    border-radius: Theme.radius-sm;
    forward-focus: keys;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    text := Text {
        text: root.label;
        color: Theme.accent-text;
        font-size: Theme.font-base;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    if touch.has-hover || keys.has-focus: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height + text.preferred-height) / 2 - 1px;
        width: text.preferred-width;
        height: 1px;
        background: Theme.accent-text;
    }

    keys := ButtonKeys {
        enabled: root.focusable;
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

component RowMenuItem inherits ChoiceRow {
    checkable: false;
}

// Sizes of the favorites list, in one place: dragging a row works out
// where it lands from them
global RowMetrics {
    out property <length> row-height: Theme.row-media;
    out property <length> row-spacing: Theme.space-4;
    out property <length> list-padding: Theme.space-8;
    // From one row's top to the next one's
    out property <length> row-stride: row-height + row-spacing;
}

component FavoriteRow inherits Rectangle {
    in property <string> name;
    in property <string> country;
    in property <bool> is-current;
    in property <bool> highlighted;
    callback pointer-moved(length, length);
    // What the player is doing with it, when current
    in property <StationState> state;
    // The row in one sentence, for screen readers
    in property <string> description;
    in property <image> logo-image;
    in property <bool> has-logo;
    in property <bool> is-drag-source;
    in property <bool> dragging;
    in property <int> row-index;
    in property <int> row-count;
    in property <string> listen-time;
    in property <string> last-played;
    in property <int> play-count;
    in property <string> session-time;
    // Show the stats on the right (View > Show Station Stats)
    in property <bool> show-stats: true;
    // The stats bubble stays open: tapped on a touch screen, which has no
    // hover (the list keeps one open at a time)
    in property <bool> stats-pinned: false;
    // Touch screens: pick a station up only after holding the logo
    // briefly, so a swipe that starts on the logo still scrolls the list,
    // and open the menu by holding the rest of the row
    in property <bool> hold-to-drag: false;
    // The logo is a drag handle (off while Find narrows the list)
    in property <bool> can-drag: true;
    // Pressed once while recording: the next press switches to it
    in property <bool> armed: false;
    // It can go one place up or down (not at the edge, not while finding)
    in property <bool> can-move-up: true;
    in property <bool> can-move-down: true;
    callback clicked();
    callback edit-clicked();
    callback move-requested(/* to-top */ bool);
    // One place up (-1) or down (1)
    callback step-requested(int);
    callback remove-requested();
    callback reset-stats-requested();
    // The stats were tapped on a touch screen: show or hide their bubble
    callback stats-tapped();
    // Pointer y in window coordinates, and where in the row it grabbed
    callback grip-moved(/* pointer-y */ length, /* grab-y */ length);
    callback grip-released();
    // The handle was pressed or let go; the list stops scrolling meanwhile
    // so it doesn't steal the drag
    callback handle-held(bool);

    // Set once a press turns into a drag, so releasing doesn't also play
    property <bool> dragged: false;
    // Where the menu opens (row coordinates) and whether Remove was
    // clicked once already
    property <length> menu-x;
    property <length> menu-y;
    in-out property <bool> confirm-remove: false;
    in-out property <bool> confirm-reset: false;
    // The menu opened from a hold, so letting go must not also play
    property <bool> menu-held: false;
    // The pointer has rested on the stats long enough to explain them
    property <bool> stats-ready: false;
    // The press on the stats came from a touch screen
    property <bool> stats-touch-press: false;
    // The menu's row under the arrow keys (-1: none; 0 Edit, 1 Move Up,
    // 2 Move Down, 3 Move to Top, 4 Move to Bottom, 5 Reset, 6 Remove)
    in-out property <int> menu-active: -1;
    property <bool> can-reset: root.show-stats
        && (root.play-count > 0 || root.listen-time != "" || root.session-time != "");

    pure function menu-usable(item: int) -> bool {
        return item == 1 ? root.can-move-up
            : item == 2 ? root.can-move-down
            : item == 5 ? root.can-reset : true;
    }

    // The next usable row from `from` going `step` (1 or -1), around the ends
    pure function menu-step(from: int, step: int) -> int {
        let start = from >= 0 ? from : step > 0 ? -1 : 7;
        let a = mod(start + step + 7, 7);
        let b = mod(start + 2 * step + 14, 7);
        let c = mod(start + 3 * step + 21, 7);
        let d = mod(start + 4 * step + 28, 7);
        let e = mod(start + 5 * step + 35, 7);
        let f = mod(start + 6 * step + 42, 7);
        return root.menu-usable(a) ? a : root.menu-usable(b) ? b : root.menu-usable(c) ? c
            : root.menu-usable(d) ? d : root.menu-usable(e) ? e : root.menu-usable(f) ? f : from;
    }

    // A menu row was clicked, or Enter pressed on it. Reset and Remove ask
    // once more first and keep the menu open meanwhile.
    function menu-pick(item: int) {
        if !root.menu-usable(item) {
            return;
        }
        if item == 5 {
            if root.confirm-reset {
                root.reset-stats-requested();
                menu.close();
            } else {
                root.confirm-reset = true;
            }
        } else if item == 6 {
            if root.confirm-remove {
                menu.close();
                root.remove-requested();
            } else {
                root.confirm-remove = true;
            }
        } else {
            menu.close();
            if item == 0 {
                root.edit-clicked();
            } else if item == 1 || item == 2 {
                root.step-requested(item == 1 ? -1 : 1);
            } else {
                root.move-requested(item == 3);
            }
        }
    }
    // The menu is as wide as its longest label needs, bold confirm text
    // included, so asking to confirm doesn't push the text to the edge:
    // card padding, item padding, icon and spacing around the label
    property <length> menu-width: max(186px,
        max(remove-label.preferred-width, confirm-label.preferred-width, reset-label.preferred-width)
            + 2 * Theme.space-4 + 3 * Theme.space-8 + Theme.icon-md);

    public function open-menu(x: length, y: length) {
        root.confirm-remove = false;
        root.confirm-reset = false;
        root.menu-active = -1;
        root.menu-x = clamp(x, 0, root.width - root.menu-width);
        root.menu-y = y;
        menu.show();
    }

    // Not a Tab stop: the list has one, which stands for the highlighted row
    accessible-role: list-item;
    accessible-label: root.name;
    accessible-description: root.description;
    accessible-item-index: root.row-index;
    accessible-item-count: root.row-count;
    accessible-item-selectable: true;
    accessible-item-selected: root.is-current;
    accessible-action-default => { root.clicked(); }

    height: RowMetrics.row-height;
    border-radius: Theme.radius-md;
    border-width: root.is-drag-source ? 1px : 0;
    border-color: Theme.accent-graphic;
    background: root.is-drag-source ? Theme.elevated : transparent;
    // Lifted look while dragged
    drop-shadow-blur: root.is-drag-source ? Theme.space-16 : 0;
    drop-shadow-offset-y: root.is-drag-source ? Theme.space-4 : 0;
    drop-shadow-color: root.is-drag-source ? Theme.shadow : transparent;

    row-surface := StationRowSurface {
        current: root.is-current;
        failed: root.is-current && root.state == StationState.failed;
        highlighted: root.highlighted;
        lifted: root.is-drag-source;
    }

    // Holding the row opens the menu on touch screens (right-click does
    // on the desktop)
    menu-timer := Timer {
        interval: Defaults.hold-menu-delay;
        running: false;
        triggered => {
            self.running = false;
            if touch.pressed {
                root.menu-held = true;
                root.open-menu(touch.pressed-x, touch.pressed-y);
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if !root.menu-held {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move && event.touch-finger-id == 0 && !self.pressed {
                root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.open-menu(self.mouse-x, self.mouse-y);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.menu-held = false;
                menu-timer.running = root.hold-to-drag;
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                menu-timer.running = false;
            }
        }
        moved => {
            // Moving is a swipe: leave it to the list
            if abs(self.mouse-y - self.pressed-y) > 6px || abs(self.mouse-x - self.pressed-x) > 6px {
                menu-timer.running = false;
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: Theme.space-8;
        alignment: stretch;

        // Logo
        VerticalLayout {
            alignment: center;
            width: 40px;

            StationLogo {
                logo: root.logo-image;
                has-logo: root.has-logo;
            }
        }

        // Station info — takes remaining space
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.space-2;

            HorizontalLayout {
                spacing: Theme.space-8;

                Text {
                    horizontal-stretch: 0;
                    text: root.name;
                    color: row-surface.name-color;
                    font-size: Theme.font-base;
                    font-weight: Theme.weight-semibold;
                    overflow: elide;
                    // The row says it all in one description
                    accessible-role: none;
                }

                // Same state mark as in search
                if root.is-current && root.state != StationState.none: StationStateMark {
                    state: root.state;
                }

                Rectangle { horizontal-stretch: 1; }
            }

            if root.country != "" || root.armed: Text {
                text: root.armed ? RecordingGuard.text : root.country;
                color: root.armed ? Theme.danger-text : Theme.text-secondary;
                font-size: Theme.font-sm;
                font-weight: root.armed ? Theme.weight-semibold : Theme.weight-regular;
                overflow: elide;
                accessible-role: none;
            }
        }

        // Stats: listening time over when it was last played
        if root.show-stats: VerticalLayout {
            alignment: center;
            spacing: Theme.space-2;
            horizontal-stretch: 0;

            if root.listen-time != "": Text {
                text: root.listen-time;
                color: row-surface.current && !row-surface.failed ? Theme.accent-text : Theme.text-primary;
                font-size: Theme.font-md;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: right;
                accessible-role: none;
            }
            Text {
                text: root.last-played != "" ? root.last-played : "Not played yet";
                color: row-surface.faint-color;
                font-size: Theme.font-sm;
                horizontal-alignment: right;
                accessible-role: none;
            }
        }
    }

    // Hovering the stats explains them in a bubble to their left: only the
    // pointer on the stats, not the rest of the row or the arrow keys
    // (screen readers hear them in the row's description). Clicks pass
    // through to the row.
    stats-touch := TouchArea {
        visible: root.show-stats;
        x: root.width - self.width;
        width: 104px;
        mouse-cursor: pointer;
        clicked => {
            // Touch has no hover: a tap shows or hides the bubble instead
            if root.stats-touch-press {
                root.stats-tapped();
            } else {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move && event.touch-finger-id == 0 && !self.pressed {
                root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if event.kind == PointerEventKind.down {
                root.stats-touch-press = event.touch-finger-id != 0;
            }
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.open-menu(self.x + self.mouse-x, self.mouse-y);
            }
        }
        changed has-hover => {
            if !self.has-hover {
                root.stats-ready = false;
            }
        }
    }

    Timer {
        interval: Defaults.hover-delay;
        running: stats-touch.has-hover && !root.stats-ready;
        triggered => { root.stats-ready = true; }
    }

    // Styled like the Statistics tiles: a caption over the total, and
    // label and value rows beside it
    stats-bubble := PopupCard {
        property <bool> shown: ((stats-touch.has-hover && root.stats-ready)
                || (root.stats-pinned && root.show-stats))
            && !stats-touch.pressed && !root.dragging;
        property <bool> played: root.last-played != "";
        visible: self.opacity > 0;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.fast; }
        x: stats-touch.x - self.width - 6px;
        y: (root.height - self.height) / 2;
        width: bubble-layout.preferred-width;
        height: bubble-layout.preferred-height;

        // Side by side so the bubble stays about as tall as the row
        bubble-layout := HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: Theme.space-12;

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: "LISTENING TIME";
                    color: Theme.text-secondary;
                    font-size: Theme.font-xs;
                    font-weight: Theme.weight-semibold;
                    letter-spacing: 0.5px;
                }
                if stats-bubble.played: Text {
                    text: root.listen-time != "" ? root.listen-time : "<1 min";
                    color: Theme.text-primary;
                    font-size: Theme.font-xl;
                    font-weight: Theme.weight-semibold;
                }
                if !stats-bubble.played: Text {
                    text: "Not played yet";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-md;
                    font-weight: Theme.weight-semibold;
                }
            }

            if stats-bubble.played: Rectangle {
                width: 1px;
                background: Theme.hairline;
            }

            if stats-bubble.played: GridLayout {
                spacing-horizontal: 12px;
                spacing-vertical: 2px;

                if root.session-time != "": Row {
                    Text {
                        text: "This session";
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                    }
                    Text {
                        text: root.session-time;
                        color: Theme.text-primary;
                        font-size: Theme.font-sm;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: right;
                    }
                }
                Row {
                    Text {
                        text: "Last played";
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                    }
                    Text {
                        text: root.last-played;
                        color: Theme.text-primary;
                        font-size: Theme.font-sm;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: right;
                    }
                }
                Row {
                    Text {
                        text: "Plays";
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                    }
                    Text {
                        text: root.play-count;
                        color: Theme.text-primary;
                        font-size: Theme.font-sm;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }

    // Measure the menu's widest labels; never shown
    remove-label := Text {
        visible: false;
        text: "Remove from Favorites";
        font-size: Theme.font-md;
    }
    confirm-label := Text {
        visible: false;
        text: "Press Again to Remove";
        font-size: Theme.font-md;
    }
    reset-label := Text {
        visible: false;
        text: "Reset Listening Stats";
        font-size: Theme.font-md;
    }

    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: root.menu-width;
        close-policy: close-on-click-outside;

        PopupCard {
            // The menu takes the keys while open: the arrows, Home and End
            // move through the rows that can be used, Enter or Space
            // presses one, Esc closes
            FocusScope {
                focus-on-tab-navigation: false;
                focus-on-click: false;
                init => { self.focus(); }

                key-pressed(event) => {
                    if event.text == Key.Escape {
                        menu.close();
                        return accept;
                    }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow {
                        root.menu-active = root.menu-step(root.menu-active, event.text == Key.DownArrow ? 1 : -1);
                        return accept;
                    }
                    if event.text == Key.Home || event.text == Key.End {
                        root.menu-active = root.menu-step(-1, event.text == Key.Home ? 1 : -1);
                        return accept;
                    }
                    if event.text == Key.Return || event.text == Key.Space {
                        if !event.repeat && root.menu-active >= 0 {
                            root.menu-pick(root.menu-active);
                        }
                        return accept;
                    }
                    // Nothing behind the menu takes a key meanwhile
                    return accept;
                }

                VerticalLayout {
                    padding: Theme.space-4;

                    RowMenuItem {
                        label: "Edit";
                        icon: @image-url("icons/edit.svg");
                        highlighted: root.menu-active == 0;
                        tab-stop: false;
                        clicked => { root.menu-pick(0); }
                    }
                    RowMenuItem {
                        label: "Move Up";
                        icon: @image-url("icons/chevron-up.svg");
                        enabled: root.can-move-up;
                        highlighted: root.menu-active == 1;
                        tab-stop: false;
                        clicked => { root.menu-pick(1); }
                    }
                    RowMenuItem {
                        label: "Move Down";
                        icon: @image-url("icons/chevron-down.svg");
                        enabled: root.can-move-down;
                        highlighted: root.menu-active == 2;
                        tab-stop: false;
                        clicked => { root.menu-pick(2); }
                    }
                    RowMenuItem {
                        label: "Move to Top";
                        icon: @image-url("icons/move-top.svg");
                        highlighted: root.menu-active == 3;
                        tab-stop: false;
                        clicked => { root.menu-pick(3); }
                    }
                    RowMenuItem {
                        label: "Move to Bottom";
                        icon: @image-url("icons/move-bottom.svg");
                        highlighted: root.menu-active == 4;
                        tab-stop: false;
                        clicked => { root.menu-pick(4); }
                    }
                    // Only while stats are shown, and asks once more first
                    if root.show-stats: RowMenuItem {
                        label: root.confirm-reset ? "Press Again to Reset" : "Reset Listening Stats";
                        danger-armed: root.confirm-reset;
                        icon: @image-url("icons/reset.svg");
                        enabled: root.can-reset;
                        highlighted: root.menu-active == 5;
                        tab-stop: false;
                        clicked => { root.menu-pick(5); }
                    }
                    MenuSeparator {}
                    // Asks once more before removing
                    RowMenuItem {
                        label: root.confirm-remove ? "Press Again to Remove" : "Remove from Favorites";
                        danger-armed: root.confirm-remove;
                        icon: @image-url("icons/trash.svg");
                        highlighted: root.menu-active == 6;
                        tab-stop: false;
                        clicked => { root.menu-pick(6); }
                    }
                }
            }
        }
    }

    // After a hold on the logo (touch screens), pick the row up where
    // the finger is, without waiting for it to move
    hold-timer := Timer {
        interval: Defaults.hold-drag-delay;
        running: false;
        triggered => {
            self.running = false;
            if handle.pressed && !root.dragged {
                root.dragged = true;
                root.handle-held(true);
                root.grip-moved(handle.absolute-position.y + handle.mouse-y, handle.pressed-y);
            }
        }
    }

    // Drag handle: the logo. Press and move to reorder (or hold first on
    // touch screens); a click without moving still plays
    handle := TouchArea {
        x: 0;
        width: 58px;
        mouse-cursor: !root.can-drag ? pointer : root.dragging ? grabbing : grab;
        pointer-event(event) => {
            if event.kind == PointerEventKind.move && event.touch-finger-id == 0 && !self.pressed {
                root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if event.button == PointerEventButton.right {
                if event.kind == PointerEventKind.down {
                    root.open-menu(self.x + self.mouse-x, self.mouse-y);
                }
                return;
            }
            if event.kind == PointerEventKind.down {
                root.dragged = false;
                if !root.can-drag {
                    // A plain click area meanwhile
                } else if root.hold-to-drag {
                    hold-timer.running = true;
                } else {
                    root.handle-held(true);
                }
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                hold-timer.running = false;
                root.handle-held(false);
                if root.dragged {
                    root.grip-released();
                }
            }
        }
        moved => {
            if root.hold-to-drag && !root.dragged {
                // Moving before the hold ends is a swipe: leave it to the list
                if abs(self.mouse-y - self.pressed-y) > 6px || abs(self.mouse-x - self.pressed-x) > 6px {
                    hold-timer.running = false;
                }
                return;
            }
            if root.can-drag && self.pressed && (root.dragged || abs(self.mouse-y - self.pressed-y) > 3px) {
                root.dragged = true;
                root.grip-moved(self.absolute-position.y + self.mouse-y, self.pressed-y);
            }
        }
        clicked => {
            if !root.dragged {
                root.clicked();
            }
        }
    }
}

export component Favorites inherits Rectangle {
    // The empty list's intrinsic size otherwise collapses the headless layout.
    in-out property <length> snapshot-empty-height;
    min-height: root.snapshot-empty-height;
    // As tall as the whole list at most, also while Find shows fewer rows
    max-height: max(2 * RowMetrics.list-padding + max(0px, root.favorites.length * RowMetrics.row-stride
            - RowMetrics.row-spacing) + find-bar.height,
        root.snapshot-empty-height);

    in-out property <[FavoriteStation]> favorites;
    in-out property <[image]> favorite-logos;
    in property <string> current-station-url;
    in property <bool> is-playing;
    in property <bool> play-loading;
    in property <bool> play-error;
    // Drag the list itself to scroll (touch screens). Off on the desktop,
    // where the wheel and scrollbar scroll and a list that grabs drags
    // would eat quick reorder drags
    in property <bool> touch-scroll: false;
    in property <bool> show-stats: true;
    // Off while a dialog covers the window: nothing here takes the focus
    in property <bool> enabled: true;
    // The favorite whose stats bubble a tap opened (touch screens), or ""
    in-out property <string> pinned-stats-id;

    // A recording is running: picking another station would end it, so
    // the first press only arms the row (see RecordingGuard)
    in property <bool> recording;
    property <string> armed-url;
    changed recording => {
        if !self.recording {
            self.armed-url = "";
        }
    }

    // Find in favorites: a field above the list narrows it to the names
    // containing the text. The rows on screen are `shown`; `favorites`
    // stays the whole list.
    out property <bool> find-open;
    // The window's resize band along the right edge (our title bar, not
    // maximized): the scroll bar keeps clear of it, so both can be grabbed
    in property <length> edge-band;
    // Right of the rows: the scroll bar, and the band
    property <length> scroll-gutter: 14px + root.edge-band;
    in-out property <string> find-text;
    property <bool> finding: root.find-text != "";
    property <[FavoriteStation]> shown: root.finding
        ? FavoritesFind.stations(root.favorites, root.find-text) : root.favorites;
    // Where each shown row is in the whole list: its logo is read there,
    // so one that loads later shows in a found row too
    property <[int]> found-rows: root.finding ? FavoritesFind.rows(root.favorites, root.find-text) : [];

    // A favorite was just removed and can be put back (0: no; Rust counts
    // up for each removal, which restarts the time the offer stays)
    in-out property <int> undo-offer;
    out property <bool> can-undo: root.undo-offer != 0;
    property <duration> undo-time: 6s;
    callback undo-requested();
    changed undo-offer => {
        undo-timer.running = self.undo-offer != 0;
        if self.undo-offer != 0 {
            undo-timer.restart();
        }
    }
    // The focus was in something that went away: the window takes it
    callback release-focus();

    callback favorite-clicked(FavoriteStation);
    callback favorite-edit-requested(FavoriteStation);
    callback favorite-move-requested(FavoriteStation, /* to-top */ bool);
    callback favorite-remove-requested(FavoriteStation);
    callback favorite-reset-stats-requested(FavoriteStation);
    callback favorites-reordered(/* from */ int, /* to */ int);
    // The empty list's two ways to fill it
    callback search-requested();
    callback import-requested();

    pure callback locate-favorite([FavoriteStation], string, string, ShortcutAction, int) -> int;
    property <string> highlight-url;
    property <bool> keyboard-highlight;
    property <int> highlight-index: root.highlight-url == "" ? -1
        : root.locate-favorite(root.shown, root.highlight-url, "", ShortcutAction.unhandled, 0);
    out property <bool> has-highlight: root.highlight-index >= 0;
    in property <string> snapshot-menu;
    property <string> menu-url;
    property <length> last-pointer-x: -1px;
    property <length> last-pointer-y: -1px;
    // What the player is doing with the current station
    property <StationState> play-state: root.play-error ? StationState.failed
        : root.play-loading ? StationState.loading
        : root.is-playing ? StationState.playing : StationState.none;
    // Where the focus starts in the list: the current station, else the top
    property <int> current-index: root.current-station-url == "" ? -1
        : root.locate-favorite(root.shown, root.current-station-url, "", ShortcutAction.unhandled, 0);

    // A row in one sentence for screen readers: its state, the country,
    // and the listening figures when they are shown
    pure function describe(station: FavoriteStation, state: StationState) -> string {
        let status = state == StationState.loading ? "Connecting"
            : state == StationState.failed ? "Playback error"
            : state == StationState.playing ? "Playing" : "";
        let place = status != "" && station.country != "" ? "\{status}, \{station.country}"
            : status != "" ? status : station.country;
        let stats = !root.show-stats ? ""
            : station.last-played == "" ? "not played yet"
            : station.listen-time != "" ? "listened \{station.listen-time}, last played: \{station.last-played}"
            : "last played: \{station.last-played}";
        let row = place != "" && stats != "" ? "\{place}, \{stats}" : place != "" ? place : stats;
        return station.url != root.armed-url || root.armed-url == "" ? row
            : row != "" ? "\{RecordingGuard.spoken}, \{row}" : RecordingGuard.spoken;
    }

    changed highlight-index => {
        if !root.has-highlight {
            root.highlight-url = "";
        } else if root.keyboard-highlight {
            list.reveal(root.highlight-index);
        }
    }

    public function move-highlight(action: ShortcutAction) -> bool {
        let page = max(1, floor(fav-flickable.height / RowMetrics.row-stride));
        let index = root.locate-favorite(root.shown, root.highlight-url,
            root.is-playing ? root.current-station-url : "", action, page);
        if index < 0 {
            return false;
        }
        root.keyboard-highlight = true;
        root.highlight-url = root.shown[index].url;
        list.reveal(index);
        // The list takes the focus, so a screen reader says the row
        if cursor.enabled && !cursor.has-focus {
            cursor.focus();
        }
        return true;
    }

    public function clear-highlight() {
        root.highlight-url = "";
        root.keyboard-highlight = false;
    }

    // Whether to switch to the station at `url` now. While recording, a
    // first press on another station only arms its row; the same press
    // again within RecordingGuard's time switches (and ends the recording).
    public function confirm-switch(url: string) -> bool {
        if !root.recording || url == root.current-station-url || url == root.armed-url {
            root.armed-url = "";
            arm-timer.running = false;
            return true;
        }
        root.armed-url = url;
        arm-timer.running = true;
        arm-timer.restart();
        // Shown, when the press came from a key that steps through the list
        let index = root.locate-favorite(root.shown, url, "", ShortcutAction.unhandled, 0);
        if index >= 0 {
            list.reveal(index);
        }
        return false;
    }

    arm-timer := Timer {
        interval: RecordingGuard.confirm-time;
        running: false;
        triggered => {
            self.running = false;
            root.armed-url = "";
        }
    }

    undo-timer := Timer {
        interval: root.undo-time;
        running: false;
        triggered => {
            self.running = false;
            root.undo-offer = 0;
        }
    }

    function activate(station: FavoriteStation) {
        root.pinned-stats-id = "";
        if root.confirm-switch(station.url) {
            root.favorite-clicked(station);
        }
    }

    public function play-highlight() {
        if root.has-highlight {
            root.activate(root.shown[root.highlight-index]);
        }
    }

    // Move the highlighted favorite one place up (-1) or down (1); not
    // while Find narrows the list. False when there is nothing to move.
    public function move-highlighted(step: int) -> bool {
        if !root.has-highlight || root.finding || root.drag-from-index >= 0 {
            return false;
        }
        let to = root.highlight-index + step;
        if to >= 0 && to < root.favorites.length {
            root.keyboard-highlight = true;
            root.favorites-reordered(root.highlight-index, to);
        }
        return true;
    }

    // Open the Find field (the "/" key), or go back to it
    public function open-find() {
        if root.favorites.length > 0 {
            root.find-open = true;
            find-field.focus-input();
            find-field.select-all();
        }
    }

    // Close the Find field and show the whole list again; the highlighted
    // row stays highlighted and in view
    public function close-find() {
        let focused = find-field.has-focus;
        root.find-text = "";
        root.find-open = false;
        if focused {
            root.release-focus();
        }
        if root.has-highlight {
            list.reveal(root.highlight-index);
        }
    }

    // The field hides when the focus leaves it empty (Tab, Down into the
    // list, a dialog or menu, a click on the window's background) or a row
    // is clicked. With text it stays: hiding it would drop the filter the
    // list shows without a word. A clicked row hides it after the click,
    // so the list moves up under a click that is already done.
    property <bool> find-focused: find-field.has-focus;
    changed find-focused => {
        if !root.find-focused {
            root.leave-empty-find();
        }
    }
    function leave-empty-find() {
        if root.find-open && root.find-text == "" {
            root.close-find();
        }
    }

    // Esc in the list: closes Find first, then clears the highlight
    public function escape() {
        if root.find-open {
            root.close-find();
        } else {
            root.clear-highlight();
        }
    }

    // The favorites changed under an open Find (the last one removed)
    changed favorites => {
        if root.favorites.length == 0 && root.find-open {
            root.close-find();
        }
    }

    public function open-highlight-menu() {
        if root.has-highlight {
            list.reveal(root.highlight-index);
            root.menu-url = root.highlight-url;
        }
    }

    // Drag state
    property <int> drag-from-index: -1;
    property <int> drag-target-index: -1;
    // How far the dragged row has moved from where it was picked up
    property <length> drag-offset: 0;
    // A row's drag handle is held down
    property <bool> handle-held: false;
    // Pointer y (window coordinates) and where in the row it grabbed
    property <length> drag-pointer-y;
    property <length> drag-grab-y;
    background: Theme.surface;

    // Empty state: what to do first, with the two ways to fill the list
    if favorites.length == 0: VerticalLayout {
        padding: Theme.space-16;
        spacing: Theme.space-8;
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Icon {
                width: 32px;
                height: 32px;
                source: @image-url("icons/star-regular.svg");
                colorize: Theme.accent-graphic;
            }
        }

        Text {
            text: "No favorites yet";
            color: Theme.text-primary;
            font-size: Theme.font-lg;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: "Search the directory, or open a stream address from Open > Network Stream.";
            color: Theme.text-secondary;
            font-size: Theme.font-base;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;
            padding-top: Theme.space-8;

            AccentButton {
                label: "Search Stations";
                icon: @image-url("icons/magnifying-glass.svg");
                clicked => { root.search-requested(); }
            }
        }

        if DesktopShortcuts.enabled: Text {
            text: "or press \{DesktopShortcuts.label(ShortcutAction.search)}";
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            horizontal-alignment: center;
        }

        // Needs a file dialog, which the kiosk build lacks
        if Platform.has-file-manager: HorizontalLayout {
            alignment: center;

            TextButton {
                label: "Import Favorites";
                focusable: root.enabled;
                clicked => { root.import-requested(); }
            }
        }
    }

    // Find in favorites: opened by "/", above the list
    find-bar := FocusScope {
        // Esc closes it, Down goes into the list; the field types the rest
        capture-key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            if event.text == Key.Escape {
                root.close-find();
                return accept;
            }
            if event.text == Key.DownArrow && root.shown.length > 0 {
                root.move-highlight(root.has-highlight ? ShortcutAction.unhandled : ShortcutAction.favorite-down);
                return accept;
            }
            return reject;
        }
        focus-on-tab-navigation: false;
        focus-on-click: false;
        visible: root.find-open;
        x: 0;
        y: 0;
        height: root.find-open ? Theme.control-field + Theme.space-8 : 0px;

        find-field := StyledLineEdit {
            x: RowMetrics.list-padding;
            y: Theme.space-8;
            width: parent.width - RowMetrics.list-padding - root.scroll-gutter;
            label: "Find in favorites";
            placeholder-text: "Find in favorites";
            clearable: true;
            enabled: root.enabled && root.find-open;
            text <=> root.find-text;
            // Enter plays the highlighted match, or the first one
            accepted => {
                if root.has-highlight {
                    root.play-highlight();
                } else if root.finding && root.shown.length > 0 {
                    root.activate(root.shown[0]);
                }
            }
        }
    }

    // Nothing matches the text
    if root.finding && root.shown.length == 0 && root.favorites.length > 0: StatusPanel {
        x: 0;
        y: find-bar.height;
        width: root.width;
        height: root.height - self.y;
        icon: @image-url("icons/magnifying-glass.svg");
        title: "No favorites match \"\{root.find-text}\"";
    }

    // Favorites list
    list := Rectangle {
        visible: root.shown.length > 0;
        y: find-bar.height;
        height: root.height - self.y;
        accessible-role: AccessibleRole.list;
        accessible-label: "Favorites";

        function reveal(index: int) {
            let top = RowMetrics.list-padding + index * RowMetrics.row-stride;
            let visible-top = -fav-flickable.content-y;
            let visible-bottom = visible-top + fav-flickable.height;
            let target = top < visible-top ? top
                : top + RowMetrics.row-height > visible-bottom ? top + RowMetrics.row-height - fav-flickable.height
                : visible-top;
            fav-flickable.content-y = -clamp(target, 0px, max(0px, fav-flickable.content-height - fav-flickable.height));
        }

        // Auto-scroll speed while the pointer is near or past the list's top or
        // bottom edge: positive scrolls up, faster the further out it is
        property <length> edge-zone: 48px;
        property <length> max-scroll-step: 18px;
        property <length> scroll-step: {
            if root.drag-from-index < 0 { return 0px; }
            let y = root.drag-pointer-y - fav-flickable.absolute-position.y;
            if y < list.edge-zone {
                return list.max-scroll-step * min(1, (list.edge-zone - y) / list.edge-zone);
            }
            if y > fav-flickable.height - list.edge-zone {
                return -list.max-scroll-step * min(1, (y - fav-flickable.height + list.edge-zone) / list.edge-zone);
            }
            return 0px;
        }

        // Place the dragged row under the pointer and pick its drop slot. Also
        // runs after auto-scroll, so the row stays under a pointer that is not
        // moving (e.g. pinned at the screen edge).
        function update-drag() {
            let idx = root.drag-from-index;
            let pointer = root.drag-pointer-y - fav-flickable.absolute-position.y - fav-flickable.content-y;
            let home = RowMetrics.list-padding + idx * RowMetrics.row-stride;
            // Stay inside the list, and in view when the pointer leaves it
            let visible-top = -fav-flickable.content-y - home;
            let visible-bottom = visible-top + fav-flickable.height - RowMetrics.row-stride;
            root.drag-offset = clamp(
                clamp(pointer - root.drag-grab-y - home, visible-top, visible-bottom),
                -idx * RowMetrics.row-stride,
                (root.shown.length - 1 - idx) * RowMetrics.row-stride);
            root.drag-target-index = clamp(
                idx + round(root.drag-offset / RowMetrics.row-stride),
                0, root.shown.length - 1);
        }

        // Keeps scrolling while the pointer rests near an edge
        Timer {
            interval: Defaults.drag-scroll-step;
            running: list.scroll-step != 0px;
            triggered => {
                fav-flickable.content-y = clamp(
                    fav-flickable.content-y + list.scroll-step,
                    min(0px, fav-flickable.height - fav-flickable.content-height),
                    0px);
                list.update-drag();
            }
        }

        fav-flickable := Flickable {
            interactive: root.touch-scroll && root.drag-from-index < 0 && !root.handle-held;
            content-height: fav-layout.preferred-height;

            fav-layout := VerticalLayout {
                padding: RowMetrics.list-padding;
                padding-right: root.scroll-gutter;
                spacing: RowMetrics.row-spacing;

                for station[idx] in root.shown: Rectangle {
                    height: RowMetrics.row-height;
                    // The dragged row draws above the others
                    z: root.drag-from-index == idx ? 1 : 0;

                    FavoriteRow {
                        property <string> snapshot-menu: idx == 0 ? root.snapshot-menu : "";
                        changed snapshot-menu => {
                            if self.snapshot-menu != "" {
                                self.open-menu(58px, self.height - 8px);
                                self.confirm-reset = self.snapshot-menu == "reset";
                                self.confirm-remove = self.snapshot-menu == "remove";
                            }
                        }
                        property <bool> menu-requested: root.menu-url != "" && root.menu-url == station.url;
                        changed menu-requested => {
                            if self.menu-requested {
                                root.menu-url = "";
                                self.open-menu(58px, self.height - 8px);
                                // Opened with a key: the first row is the keys'
                                self.menu-active = 0;
                            }
                        }
                        pointer-moved(x, y) => {
                            // Slint can redeliver a move at the same window coordinates.
                            if x != root.last-pointer-x || y != root.last-pointer-y {
                                root.last-pointer-x = x;
                                root.last-pointer-y = y;
                                root.keyboard-highlight = false;
                                root.highlight-url = station.url;
                                cursor.leave-tab-focus();
                            }
                        }
                        highlighted: root.highlight-url == station.url && root.highlight-url != "";

                        // Dragged row follows the pointer; rows between its
                        // old and new place slide over to open a gap
                        y: root.drag-from-index == idx ? root.drag-offset
                            : root.drag-from-index < 0 ? 0
                            : root.drag-from-index < idx && idx <= root.drag-target-index ? -RowMetrics.row-stride
                            : root.drag-target-index <= idx && idx < root.drag-from-index ? RowMetrics.row-stride
                            : 0;
                        // Only the neighbours glide; on drop everything snaps,
                        // since the list is reordered in the same moment
                        animate y {
                            duration: root.drag-from-index < 0 || root.drag-from-index == idx ? 0ms : Theme.normal;
                            easing: ease-out;
                        }
                        width: parent.width;

                        name: station.name;
                        country: station.country;
                        is-current: station.url == root.current-station-url;
                        state: root.play-state;
                        description: root.describe(station, self.is-current ? root.play-state : StationState.none);
                        property <int> source-row: !root.finding ? idx
                            : idx < root.found-rows.length ? root.found-rows[idx] : -1;
                        logo-image: self.source-row >= 0 && self.source-row < root.favorite-logos.length
                            ? root.favorite-logos[self.source-row] : @image-url("");
                        has-logo: self.source-row >= 0 && self.source-row < root.favorite-logos.length
                            ? root.favorite-logos[self.source-row].width > 0
                            : false;
                        is-drag-source: root.drag-from-index == idx;
                        dragging: root.drag-from-index >= 0;
                        row-index: idx;
                        row-count: root.shown.length;
                        armed: root.armed-url == station.url && root.armed-url != "";
                        can-move-up: !root.finding && idx > 0;
                        can-move-down: !root.finding && idx < root.shown.length - 1;
                        step-requested(step) => { root.favorites-reordered(idx, idx + step); }
                        clicked => {
                            root.activate(station);
                            root.leave-empty-find();
                        }
                        listen-time: station.listen-time;
                        last-played: station.last-played;
                        play-count: station.play-count;
                        session-time: station.session-time;
                        show-stats: root.show-stats;
                        stats-pinned: root.pinned-stats-id == station.id;
                        stats-tapped => {
                            root.pinned-stats-id = root.pinned-stats-id == station.id ? "" : station.id;
                        }
                        hold-to-drag: root.touch-scroll;
                        // No reordering by drag while Find narrows the list
                        can-drag: !root.finding;
                        edit-clicked => {
                            root.favorite-edit-requested(station);
                        }
                        move-requested(to-top) => {
                            root.favorite-move-requested(station, to-top);
                        }
                        remove-requested => {
                            root.favorite-remove-requested(station);
                        }
                        reset-stats-requested => {
                            root.favorite-reset-stats-requested(station);
                        }
                        grip-moved(pointer-y, grab-y) => {
                            if root.drag-from-index < 0 {
                                root.drag-from-index = idx;
                                root.drag-target-index = idx;
                            }
                            root.drag-pointer-y = pointer-y;
                            root.drag-grab-y = grab-y;
                            list.update-drag();
                        }
                        handle-held(held) => { root.handle-held = held; }
                        grip-released => {
                            if root.drag-from-index >= 0 && root.drag-target-index >= 0
                               && root.drag-from-index != root.drag-target-index {
                                root.favorites-reordered(root.drag-from-index, root.drag-target-index);
                            }
                            root.drag-from-index = -1;
                            root.drag-target-index = -1;
                            root.drag-offset = 0;
                        }
                    }
                }
            }

            // The list's one Tab stop, over the highlighted row. Tab comes
            // in on the highlighted row, else the current station, else
            // the first; the arrows move the highlight, which looks the
            // same as under the pointer, and the ring shows only after Tab.
            // Space stays the play shortcut unless the focus came by Tab.
            cursor := KeyListCursor {
                x: RowMetrics.list-padding;
                y: RowMetrics.list-padding + max(0, root.highlight-index) * RowMetrics.row-stride;
                width: fav-layout.width - RowMetrics.list-padding - root.scroll-gutter;
                height: RowMetrics.row-height;
                enabled: root.enabled && root.shown.length > 0 && root.drag-from-index < 0;
                count: root.shown.length;
                active: root.highlight-index;
                start: max(0, root.current-index);
                page: max(1, floor(fav-flickable.height / RowMetrics.row-stride));
                item-label: root.shown[root.highlight-index].name;
                item-description: root.describe(root.shown[root.highlight-index],
                    root.shown[root.highlight-index].url == root.current-station-url
                        ? root.play-state : StationState.none);
                item-selected: root.highlight-url == root.current-station-url;
                space-activates: self.tab-focus;
                ring-on-tab-only: true;
                ring-radius: Theme.radius-md;
                ring-offset: Theme.focus-ring-offset;
                move-to(index) => {
                    root.keyboard-highlight = true;
                    root.highlight-url = root.shown[index].url;
                    list.reveal(index);
                }
                activated => { root.play-highlight(); }
                // Up on the first row goes back to the Find field
                left-at-top => {
                    if root.find-open {
                        find-field.focus-input();
                    }
                }
                key(event) => {
                    if root.has-highlight
                        && (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                        root.open-highlight-menu();
                        return accept;
                    }
                    return reject;
                }
            }
        }

        // Drawn just inside the band, with a wider zone to grab it by
        ScrollBar {
            width: 16px;
            x: parent.width - root.edge-band - self.width - 2px;
            y: 4px;
            height: parent.height - 8px;
            viewport-height: fav-flickable.height;
            content-height: fav-flickable.content-height;
            content-y <=> fav-flickable.content-y;
        }
    }

    // A favorite was just removed: offer to put it back where it was, for
    // a few seconds, over the bottom of the list
    if root.can-undo: PopupCard {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - Theme.space-12;
        width: min(undo-row.preferred-width, root.width - 2 * Theme.space-12);
        height: Theme.control-button + 2 * Theme.space-4;
        accessible-role: none;

        undo-row := HorizontalLayout {
            padding-left: Theme.space-12;
            padding-right: Theme.space-4;
            spacing: Theme.space-4;

            Text {
                text: "Removed from Favorites";
                color: Theme.text-primary;
                font-size: Theme.font-md;
                vertical-alignment: center;
                overflow: elide;
            }

            VerticalLayout {
                alignment: center;
                TextButton {
                    label: "Undo";
                    focusable: root.enabled;
                    clicked => { root.undo-requested(); }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("icons/xmark.svg");
                    icon-size: Theme.icon-sm;
                    label: "Dismiss";
                    enabled: root.enabled;
                    clicked => { root.undo-offer = 0; }
                }
            }
        }
    }
}
