// On-screen keyboard for the Pi's touchscreen: the full width of the
// screen, 44 px keys, letters with Shift, a symbols layer with every
// character a Wi-Fi password can hold. The text it types lives in the
// owner (`text`); Backspace goes through `backspace` because Slint can't
// cut a string.
import { Theme } from "defaults.slint";

component KeyButton inherits Rectangle {
    in property <string> key;
    // What the key puts in; the key itself when empty
    in property <string> inserts: "";
    in property <bool> accent: false;
    in property <bool> enabled: true;
    in property <length> text-size: 19px;
    in property <color> text-color: Theme.text-primary;
    callback pressed();

    height: 44px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.accent ? transparent : Theme.hairline;
    background: !root.enabled ? Theme.disabled-bg
        : root.accent ? (ta.pressed ? Theme.accent-hover : Theme.accent)
        : ta.pressed ? Theme.menu-hover : Theme.card;
    animate background { duration: Theme.fast; }

    accessible-role: button;
    accessible-label: root.key;
    accessible-enabled: root.enabled;

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.pressed(); }
    }

    Text {
        text: root.key;
        color: !root.enabled ? Theme.disabled-text
            : root.accent ? Theme.on-accent : root.text-color;
        font-size: root.text-size;
        font-weight: root.accent ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

export component VirtualKeyboard inherits Rectangle {
    in-out property <string> text: "";
    // Done is greyed while the text is shorter than this
    in property <int> min-length: 0;
    in property <string> done-label: "Done";
    callback submitted(string);
    callback backspace();

    property <bool> shift: false;
    property <bool> symbols: false;
    property <[string]> row1: root.symbols ? ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]
        : root.shift ? ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"]
        : ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"];
    property <[string]> row2: root.symbols
        ? (root.shift ? ["~", "`", "'", "\"", ";", ":", "[", "]", "{", "}"]
                      : ["!", "@", "#", "$", "%", "^", "&", "*", "(", ")"])
        : root.shift ? ["A", "S", "D", "F", "G", "H", "J", "K", "L"]
        : ["a", "s", "d", "f", "g", "h", "j", "k", "l"];
    property <[string]> row3: root.symbols
        ? (root.shift ? ["<", ">", "|", "\\", "€", "£", "°"] : ["-", "_", "=", "+", ".", ",", "?", "/"])
        : root.shift ? ["Z", "X", "C", "V", "B", "N", "M"]
        : ["z", "x", "c", "v", "b", "n", "m"];

    function type(key: string) {
        root.text += key;
        // Shift is for one letter, as on a phone
        if !root.symbols {
            root.shift = false;
        }
    }

    height: layout.preferred-height;
    background: Theme.panel;

    layout := VerticalLayout {
        padding: 6px;
        spacing: 5px;

        HorizontalLayout {
            spacing: 5px;
            for key in root.row1: KeyButton {
                key: key;
                pressed => { root.type(self.key); }
            }
        }

        HorizontalLayout {
            spacing: 5px;
            // The home row sits in by half a key, as on a real keyboard
            if !root.symbols: Rectangle { width: 36px; }
            for key in root.row2: KeyButton {
                key: key;
                pressed => { root.type(self.key); }
            }
            if !root.symbols: Rectangle { width: 36px; }
        }

        HorizontalLayout {
            spacing: 5px;
            KeyButton {
                key: root.shift ? "⇧" : "⇧";
                text-size: 20px;
                text-color: root.shift ? Theme.accent-text : Theme.text-secondary;
                horizontal-stretch: 0;
                width: 80px;
                background: root.shift ? Theme.accent-soft : Theme.card;
                pressed => { root.shift = !root.shift; }
            }
            for key in root.row3: KeyButton {
                key: key;
                pressed => { root.type(self.key); }
            }
            KeyButton {
                key: "⌫";
                text-size: 20px;
                text-color: Theme.text-secondary;
                horizontal-stretch: 0;
                width: 80px;
                pressed => { root.backspace(); }
            }
        }

        HorizontalLayout {
            spacing: 5px;
            KeyButton {
                key: root.symbols ? "ABC" : "?123";
                text-size: 14px;
                text-color: Theme.text-secondary;
                horizontal-stretch: 0;
                width: 96px;
                pressed => {
                    root.symbols = !root.symbols;
                    root.shift = false;
                }
            }
            KeyButton {
                key: "space";
                text-size: 13px;
                text-color: Theme.text-secondary;
                pressed => { root.type(" "); }
            }
            KeyButton {
                key: root.done-label;
                accent: true;
                text-size: 15px;
                horizontal-stretch: 0;
                width: 140px;
                enabled: root.text.character-count >= root.min-length;
                pressed => { root.submitted(root.text); }
            }
        }
    }
}
