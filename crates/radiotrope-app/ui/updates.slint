// Updates: what Help's rows and the About dialog show about a newer
// version. Filled in from Rust (src/update_ui.rs); builds with updates
// off (a package manager brings them) show none of it.
export global Updates {
    // This build looks for updates: the rows and the About line exist
    in property <bool> enabled;
    // Help > Check for Updates Automatically (once a day)
    in-out property <bool> auto-check;
    callback auto-check-changed(bool);
    // The newer version that is out, e.g. "0.2.0"; "" for none
    in property <string> available;
    // One line about the check or the update; "" for nothing to say
    in property <string> message;
    // The message is a problem (can't check, can't verify)
    in property <bool> failed;
    // The release notes of the newer version ("What's New"); "" for none
    in property <string> notes-url;
    // The button under the message: "" for none, else "download" or "restart"
    in property <string> action;
    in property <string> action-label;
    in property <bool> action-enabled: true;
    // Help > Check for Updates: look now, and show the answer in About
    callback check-now();
    // The button was pressed
    callback run-action();
}
