import { DialogShell, SectionHeader } from "../components.slint";
import { Defaults, Theme } from "../defaults.slint";
import { KeyCaps } from "../keycap.slint";
import { DesktopShortcuts, ShortcutRow } from "../shortcuts.slint";

// Description on the left, the keys right-aligned
component ShortcutLine inherits Rectangle {
    in property <ShortcutRow> shortcut;

    height: Theme.row-menu;
    accessible-role: text;
    accessible-label: root.shortcut.spoken;

    HorizontalLayout {
        spacing: Theme.space-12;

        Text {
            text: root.shortcut.description;
            color: Theme.text-primary;
            font-size: Theme.font-base;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }

        VerticalLayout {
            alignment: center;

            KeyCaps {
                alternatives: root.shortcut.alternatives;
                separator: root.shortcut.separator;
            }
        }
    }
}

export component KeyboardShortcutsDialog inherits Rectangle {
    in-out property <bool> show-dialog;

    if root.show-dialog: DialogShell {
        title: "Keyboard Shortcuts";
        card-width: Defaults.keyboard-shortcuts-width;
        card-height: Defaults.keyboard-shortcuts-height;
        close-requested => { root.show-dialog = false; }

        for group in DesktopShortcuts.groups: VerticalLayout {
            spacing: Theme.space-4;

            SectionHeader { title: group.title.to-uppercase(); }

            Rectangle {
                background: Theme.elevated;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.hairline;

                VerticalLayout {
                    padding-left: Theme.space-12;
                    padding-right: Theme.space-8;
                    padding-top: Theme.space-4;
                    padding-bottom: Theme.space-4;

                    for row in group.rows: ShortcutLine { shortcut: row; }
                }
            }
        }
    }
}
