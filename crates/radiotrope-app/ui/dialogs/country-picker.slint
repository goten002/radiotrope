import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, ButtonKeys, FocusRing } from "../components.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { SecondaryButton } from "../buttons.slint";
import { ScrollBar } from "../scroll-bar.slint";

export struct CountryEntry {
    name: string,
    // ISO 3166-1 alpha-2 code, empty if unknown
    code: string,
    station-count: int,
    flag: image,
}

component CountryRow inherits Rectangle {
    in property <string> name;
    in property <int> station-count;
    in property <image> flag;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.menu-hover : transparent;
    animate background { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: list-item;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    // Enter or Space opens the country
    keys := ButtonKeys {
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: stretch;

        // Flag slot keeps names aligned even when a country has no flag
        Rectangle {
            width: 20px;

            if root.flag.width > 0: Image {
                source: root.flag;
                width: 20px;
                height: 15px;
                image-fit: contain;
            }
        }

        Text {
            text: root.name;
            color: Theme.text-primary;
            font-size: Theme.font-base;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: root.station-count > 0 ? "\{root.station-count}" : "";
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 50px;
        }
    }
}

export component CountryPickerDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <bool> loading: false;
    in-out property <string> error: "";
    in-out property <[CountryEntry]> countries: [];
    in-out property <string> filter-text: "";

    callback country-selected(CountryEntry);
    callback load-countries();
    // Show only countries whose name contains the text
    callback filter-countries(string);

    if show-dialog: DialogShell {
        title: "Select Country";
        subtitle: "\{root.countries.length} countries";
        card-width: Defaults.country-picker-width;
        card-height: Defaults.country-picker-height;
        auto-focus: false;
        close-requested => { root.show-dialog = false; }

        StyledLineEdit {
            placeholder-text: "Filter countries...";
            clearable: true;
            init => { self.focus-input(); }
            text <=> root.filter-text;
            edited(text) => { root.filter-countries(text); }
            cleared => { root.filter-countries(""); }
            accepted(text) => {
                if root.countries.length == 1 {
                    root.show-dialog = false;
                    root.country-selected(root.countries[0]);
                }
            }
        }

        // Content area
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            border-radius: Theme.radius-sm;
            background: Theme.surface;

            // Loading state
            if root.loading: Text {
                text: "Loading countries...";
                color: Theme.text-secondary;
                font-size: Theme.font-base;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Error state, with a way to ask again
            if root.error != "" && !root.loading: VerticalLayout {
                alignment: center;
                spacing: 6px;

                Text {
                    text: root.error;
                    color: Theme.danger;
                    font-size: Theme.font-base;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    padding-top: 6px;

                    SecondaryButton {
                        label: "Try again";
                        clicked => {
                            root.loading = true;
                            root.load-countries();
                        }
                    }
                }
            }

            // Country list
            if root.countries.length > 0 && !root.loading: Rectangle {
                country-flick := Flickable {
                    content-height: country-layout.preferred-height;

                    country-layout := VerticalLayout {
                        padding: 4px;

                        for entry[idx] in root.countries: CountryRow {
                            name: entry.name;
                            station-count: entry.station-count;
                            flag: entry.flag;
                            clicked => {
                                root.show-dialog = false;
                                root.country-selected(entry);
                            }
                        }
                    }
                }

                ScrollBar {
                    x: parent.width - self.width - 2px;
                    y: 4px;
                    height: parent.height - 8px;
                    viewport-height: country-flick.height;
                    content-height: country-flick.content-height;
                    content-y <=> country-flick.content-y;
                }
            }

            // No match for the filter
            if root.countries.length == 0 && !root.loading && root.error == ""
                && root.filter-text != "": Text {
                text: "No countries match \"\{root.filter-text}\"";
                color: Theme.text-secondary;
                font-size: Theme.font-base;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
