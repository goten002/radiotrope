import { Theme, Defaults } from "../defaults.slint";
import { SecondaryButton } from "../buttons.slint";
import { DialogShell, InfoRow, LinkRow, SectionHeader, ButtonKeys, FocusRing } from "../components.slint";

// Build and environment details, filled in from Rust at startup
export global AboutInfo {
    in property <string> version;
    // Short commit hash, empty outside a git checkout
    in property <string> commit;
    in property <string> commit-date;
    // e.g. "Linux x86_64"
    in property <string> platform;
    in property <string> config-dir;
    in property <string> cache-dir;
    // Where the log goes when stderr isn't read; empty where there is none
    in property <string> log-file;
    in property <string> repository;
    in property <string> license;
    in property <string> authors;
}

export component AboutDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;

    callback open-url(string);

    if show-dialog: DialogShell {
        // Wide and short, so it fits the Pi's 800 x 480 screen
        card-width: Defaults.about-width;
        close-requested => { root.show-dialog = false; }

        HorizontalLayout {
            spacing: Theme.space-24;

            // Logo, name, version, links
            VerticalLayout {
                width: 200px;
                spacing: Theme.space-6;
                alignment: start;

                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../../../assets/icons/icon-128.png");
                        width: 72px;
                        height: 72px;
                    }
                }

                Text {
                    text: "Radiotrope";
                    color: Theme.text-primary;
                    font-size: Theme.font-hero;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Internet radio player";
                    color: Theme.text-secondary;
                    font-size: Theme.font-md;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    padding-top: Theme.space-4;
                    padding-bottom: Theme.space-8;

                    Rectangle {
                        width: version-text.preferred-width + 20px;
                        height: 22px;
                        border-radius: Theme.radius-md;
                        background: Theme.accent-tint;

                        // Selectable, so it can be copied into a bug report
                        version-text := TextInput {
                            text: "Version \{AboutInfo.version}";
                            color: Theme.accent-text;
                            font-size: Theme.font-sm;
                            font-weight: Theme.weight-semibold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            read-only: true;
                            single-line: true;
                            selection-background-color: Theme.selection-bg;
                            selection-foreground-color: Theme.selection-fg;
                            // A Tab stop: read as text that can't be changed
                            accessible-label: "Version";
                            accessible-read-only: true;
                        }

                        if version-text.has-focus: FocusRing {
                            offset: 1px;
                            radius: parent.border-radius;
                        }
                    }
                }

                // Links, not tasks: both quiet buttons
                SecondaryButton {
                    width: 200px;
                    label: "Source Code";
                    clicked => { root.open-url(AboutInfo.repository); }
                }

                SecondaryButton {
                    width: 200px;
                    label: "Report an Issue";
                    clicked => { root.open-url(AboutInfo.repository + "/issues"); }
                }

                // License (a link to its text) and copyright
                HorizontalLayout {
                    alignment: center;
                    padding-top: Theme.space-8;
                    Rectangle {
                        width: license-link.preferred-width;

                        accessible-role: button;
                        accessible-label: AboutInfo.license;
                        accessible-description: "https://www.gnu.org/licenses/gpl-3.0.html";
                        accessible-action-default => { root.open-url("https://www.gnu.org/licenses/gpl-3.0.html"); }

                        // The readable accent in every state; hover and focus underline it
                        license-link := Text {
                            text: AboutInfo.license;
                            color: Theme.accent-text;
                            font-size: Theme.font-xs;
                            accessible-role: none;
                        }
                        // Underline (Text can't underline)
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: license-link.color;
                            visible: license-touch.has-hover || license-keys.has-focus;
                        }
                        license-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-url("https://www.gnu.org/licenses/gpl-3.0.html"); }
                        }
                        // Enter or Space opens the link
                        license-keys := ButtonKeys {
                            activated => { root.open-url("https://www.gnu.org/licenses/gpl-3.0.html"); }
                        }
                        if license-keys.has-focus: FocusRing {
                            offset: 1px;
                            radius: Theme.radius-sm;
                        }
                    }
                    Text {
                        text: " · © 2026 \{AboutInfo.authors}";
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                    }
                }
            }

            // Details
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0;
                alignment: start;

                SectionHeader { title: "BUILD"; }
                if AboutInfo.commit != "": InfoRow {
                    label: "Commit";
                    value: AboutInfo.commit-date != ""
                        ? "\{AboutInfo.commit} (\{AboutInfo.commit-date})"
                        : AboutInfo.commit;
                    selectable: true;
                }
                InfoRow { label: "Platform"; value: AboutInfo.platform; selectable: true; }
                InfoRow { label: "Settings"; value: AboutInfo.config-dir; selectable: true; }
                InfoRow { label: "Cache"; value: AboutInfo.cache-dir; selectable: true; }
                if AboutInfo.log-file != "": InfoRow { label: "Log"; value: AboutInfo.log-file; selectable: true; }

                SectionHeader { title: "CREDITS"; }
                LinkRow {
                    label: "Stations";
                    links: [{ name: "radiotrope.app", url: "https://radiotrope.app" }];
                    note: "(station directory)";
                    open-url(url) => { root.open-url(url); }
                }
                LinkRow {
                    label: "UI toolkit";
                    links: [{ name: "Slint", url: "https://slint.dev" }];
                    open-url(url) => { root.open-url(url); }
                }
                LinkRow {
                    label: "Audio";
                    links: [
                        { name: "Symphonia", url: "https://github.com/pdeljanov/Symphonia" },
                        { name: "rodio", url: "https://github.com/RustAudio/rodio" },
                        { name: "fdk-aac", url: "https://github.com/mstorsjo/fdk-aac" },
                        { name: "libopus", url: "https://opus-codec.org" },
                        { name: "LAME", url: "https://lame.sourceforge.io" },
                    ];
                    open-url(url) => { root.open-url(url); }
                }
                LinkRow {
                    label: "Flags";
                    links: [{ name: "flag-icons", url: "https://github.com/lipis/flag-icons" }];
                    note: "(MIT)";
                    open-url(url) => { root.open-url(url); }
                }
                LinkRow {
                    label: "Icons";
                    links: [{ name: "Font Awesome Free", url: "https://fontawesome.com" }];
                    note: "(CC BY 4.0)";
                    open-url(url) => { root.open-url(url); }
                }
                LinkRow {
                    label: "Font";
                    links: [{ name: "Inter", url: "https://rsms.me/inter/" }];
                    note: "(SIL Open Font License)";
                    open-url(url) => { root.open-url(url); }
                }
                // Everything above and the rest, with each one's license
                LinkRow {
                    label: "Licenses";
                    links: [{ name: "Third-party licenses", url: AboutInfo.repository + "/blob/main/THIRD-PARTY-LICENSES" }];
                    open-url(url) => { root.open-url(url); }
                }

                // GPL v3 section 5(d) asks an interactive program to show a
                // copyright, no-warranty and license notice; the license and
                // copyright sit under the buttons on the left
                Rectangle { height: Theme.space-8; }

                Text {
                    text: "This program comes with absolutely no warranty.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-xs;
                    wrap: word-wrap;
                }
            }
        }
    }
}
