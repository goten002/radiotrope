import { Theme } from "../theme.slint";
import { AccentButton, SecondaryButton } from "../buttons.slint";
import { DialogShell, InfoRow, LinkRow, SectionHeader } from "../components.slint";

// Build and environment details, filled in from Rust at startup
export global AboutInfo {
    in property <string> version;
    // Short commit hash, empty outside a git checkout
    in property <string> commit;
    in property <string> commit-date;
    // e.g. "Linux x86_64"
    in property <string> platform;
    in property <string> config-dir;
    in property <string> cache-dir;
    in property <string> repository;
    in property <string> license;
    in property <string> authors;
}

export component AboutDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;

    callback open-url(string);

    if show-dialog: DialogShell {
        // Wide and short, so it fits the Pi's 800 x 480 screen
        card-width: 680px;
        close-requested => { root.show-dialog = false; }

        HorizontalLayout {
            spacing: 24px;

            // Logo, name, version, links
            VerticalLayout {
                width: 200px;
                spacing: 6px;
                alignment: start;

                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../../../assets/icons/icon-128.png");
                        width: 72px;
                        height: 72px;
                    }
                }

                Text {
                    text: "Radiotrope";
                    color: Theme.text-primary;
                    font-size: 22px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Internet radio player";
                    color: Theme.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    padding-top: 4px;
                    padding-bottom: 10px;

                    Rectangle {
                        width: version-text.preferred-width + 20px;
                        height: 22px;
                        border-radius: Theme.radius-md;
                        background: Theme.accent-soft;

                        // Selectable, so it can be copied into a bug report
                        version-text := TextInput {
                            text: "Version \{AboutInfo.version}";
                            color: Theme.accent-text;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            read-only: true;
                            single-line: true;
                            selection-background-color: Theme.selection-bg;
                            selection-foreground-color: Theme.selection-fg;
                        }
                    }
                }

                AccentButton {
                    width: 200px;
                    label: "Source code";
                    clicked => { root.open-url(AboutInfo.repository); }
                }

                SecondaryButton {
                    width: 200px;
                    label: "Report an issue";
                    clicked => { root.open-url(AboutInfo.repository + "/issues"); }
                }
            }

            // Details
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0;
                alignment: start;

                SectionHeader { title: "BUILD"; }
                if AboutInfo.commit != "": InfoRow {
                    label: "Commit";
                    value: AboutInfo.commit-date != ""
                        ? "\{AboutInfo.commit} (\{AboutInfo.commit-date})"
                        : AboutInfo.commit;
                    selectable: true;
                }
                InfoRow { label: "Platform"; value: AboutInfo.platform; selectable: true; }
                InfoRow { label: "Settings"; value: AboutInfo.config-dir; selectable: true; }
                InfoRow { label: "Cache"; value: AboutInfo.cache-dir; selectable: true; }

                SectionHeader { title: "CREDITS"; }
                LinkRow {
                    label: "Stations";
                    links: [{ name: "radio-browser.info", url: "https://www.radio-browser.info" }];
                    note: "community directory";
                    open-url(url) => { root.open-url(url); }
                }
                LinkRow {
                    label: "UI toolkit";
                    links: [{ name: "Slint", url: "https://slint.dev" }];
                    open-url(url) => { root.open-url(url); }
                }
                LinkRow {
                    label: "Audio";
                    links: [
                        { name: "Symphonia", url: "https://github.com/pdeljanov/Symphonia" },
                        { name: "rodio", url: "https://github.com/RustAudio/rodio" },
                        { name: "fdk-aac", url: "https://github.com/mstorsjo/fdk-aac" },
                        { name: "libopus", url: "https://opus-codec.org" },
                        { name: "LAME", url: "https://lame.sourceforge.io" },
                    ];
                    open-url(url) => { root.open-url(url); }
                }
                LinkRow {
                    label: "Flags";
                    links: [{ name: "flag-icons", url: "https://github.com/lipis/flag-icons" }];
                    note: "(MIT)";
                    open-url(url) => { root.open-url(url); }
                }
                LinkRow {
                    label: "Font";
                    links: [{ name: "Inter", url: "https://rsms.me/inter/" }];
                    note: "(SIL Open Font License)";
                    open-url(url) => { root.open-url(url); }
                }

                Rectangle { height: 10px; }

                Text {
                    text: "\{AboutInfo.license} License · © \{AboutInfo.authors}";
                    color: Theme.text-secondary;
                    font-size: 10px;
                }
            }
        }
    }
}
