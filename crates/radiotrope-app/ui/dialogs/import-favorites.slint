import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, StatusPanel, ChipVariant } from "../components.slint";

// One choice: its name, what it does, and what it would change here
component ImportChoice inherits VerticalLayout {
    in property <string> label;
    in property <string> text;
    in property <string> summary;
    spacing: Theme.space-2;

    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.font-lg;
        font-weight: Theme.weight-semibold;
    }
    Text {
        text: root.text;
        color: Theme.text-secondary;
        font-size: Theme.font-base;
        overflow: elide;
    }
    Text {
        text: root.summary;
        color: Theme.text-primary;
        font-size: Theme.font-base;
        overflow: elide;
    }
}

// Import Favorites: after a file is picked, choose Add Missing or Replace,
// each with what it would change; then what was done, or what went wrong.
// Export Favorites uses it for its outcome too.
export component ImportFavoritesDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <string> title: "Import Favorites";
    // "Favorites.json: 42 stations"
    in-out property <string> subtitle;
    // What each choice would change, e.g. "Adds 12, keeps 30."
    in-out property <string> add-summary;
    in-out property <string> replace-summary;
    // Set once done (or failed): shown instead of the choices, with a
    // second line under it (a file's path, what to do next)
    in-out property <string> message;
    in-out property <string> message-detail;
    in-out property <bool> message-error;
    callback add-missing();
    callback replace();

    // Replace was pressed once: the next press replaces. Replacing drops
    // favorites, so it always takes a second, deliberate press.
    property <bool> confirm-replace: false;
    changed show-dialog => { root.confirm-replace = false; }
    changed message => { root.confirm-replace = false; }

    if show-dialog: DialogShell {
        title: root.title;
        subtitle: root.message == "" ? root.subtitle : "";
        card-width: Defaults.import-favorites-width;
        cancel-label: root.message == "" ? "Cancel" : "";
        destructive-label: root.message == "" ? "Replace" : "";
        destructive-armed: root.confirm-replace;
        destructive-armed-label: "Press Again to Replace";
        primary-label: root.message == "" ? "Add Missing" : "";
        close-footer: root.message != "";
        destructive-requested => {
            if root.confirm-replace {
                root.confirm-replace = false;
                root.replace();
            } else {
                root.confirm-replace = true;
            }
        }
        primary-requested => { root.add-missing(); }
        close-requested => { root.show-dialog = false; }

        if root.message == "": VerticalLayout {
            spacing: Theme.dialog-gap;

            ImportChoice {
                label: "Add Missing";
                text: "Adds the stations you don't have, at the end.";
                summary: root.add-summary;
            }
            ImportChoice {
                label: "Replace";
                text: "Your favorites become the file's list, in its order.";
                summary: root.replace-summary;
            }
        }

        if root.message != "": StatusPanel {
            icon: root.message-error ? @image-url("../icons/circle-exclamation.svg")
                : @image-url("../icons/tick.svg");
            variant: root.message-error ? ChipVariant.danger : ChipVariant.success;
            title: root.message;
            message: root.message-detail;
        }
    }
}
