import { Theme } from "../theme.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { AccentButton, SecondaryButton } from "../buttons.slint";
import { Chip, DialogShell, SectionHeader } from "../components.slint";

component ColorSwatch inherits Rectangle {
    in property <color> swatch-color;
    in property <bool> is-selected;
    callback clicked();

    width: 38px;
    height: 38px;
    border-radius: 19px;
    // Ring around the selected color
    border-width: 2px;
    border-color: root.is-selected ? root.swatch-color : transparent;
    animate border-color { duration: Theme.fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    Rectangle {
        property <length> size: touch.has-hover || root.is-selected ? 28px : 26px;
        animate size { duration: Theme.fast; }
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        background: root.swatch-color;
    }

    if root.is-selected: Image {
        width: 12px;
        height: 12px;
        source: @image-url("../icons/tick.svg");
        colorize: #ffffff;
    }
}

export component AccentColorDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <color> selected-color <=> Theme.accent-base;

    callback color-changed(color);
    callback custom-hex-requested(string);

    property <string> hex-input;
    // Rust callback validates actual hex digits; Slint gates on length only
    property <bool> hex-valid: hex-input.character-count == 7;
    property <[color]> swatches: [
        #f7931e, #ed5b00, #e62d42, #d56199, #9141ac,
        #3584e4, #2190a4, #3a944a, #c88800, #6f8396,
    ];

    if show-dialog: DialogShell {
        title: "Accent Color";
        subtitle: "Used for highlights, buttons and the visualizer";
        card-width: 400px;
        close-requested => { root.show-dialog = false; }

        // Swatches, two rows of five
        VerticalLayout {
            spacing: 6px;

            for row in [0, 1]: HorizontalLayout {
                alignment: center;
                spacing: 10px;

                for i in [0, 1, 2, 3, 4]: ColorSwatch {
                    swatch-color: root.swatches[row * 5 + i];
                    is-selected: Theme.accent-base == root.swatches[row * 5 + i];
                    clicked => {
                        Theme.accent-base = root.swatches[row * 5 + i];
                        root.color-changed(root.swatches[row * 5 + i]);
                    }
                }
            }
        }

        // Custom color
        VerticalLayout {
            spacing: 6px;

            SectionHeader { title: "CUSTOM"; }

            HorizontalLayout {
                spacing: 8px;

                hex-edit := StyledLineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "#f7931e";
                    text <=> root.hex-input;
                    clearable: true;
                    accepted(val) => {
                        if root.hex-valid { root.custom-hex-requested(root.hex-input); }
                    }
                }

                AccentButton {
                    label: "Apply";
                    enabled: root.hex-valid;
                    clicked => { root.custom-hex-requested(root.hex-input); }
                }
            }
        }

        // Live preview of the current accent
        VerticalLayout {
            spacing: 8px;

            SectionHeader { title: "PREVIEW"; }

            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                AccentButton { label: "Play"; }
                Chip {
                    text: "Playing";
                    tone: Theme.accent-text;
                    dot: true;
                    pulse: true;
                    y: (parent.height - self.height) / 2;
                }
                Rectangle {
                    width: 110px;
                    height: 34px;

                    Rectangle {
                        x: 0;
                        width: parent.width;
                        y: (parent.height - self.height) / 2;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.elevated;

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * 0.65;
                            height: parent.height;
                            border-radius: 3px;
                            background: Theme.accent;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: end;

            SecondaryButton {
                label: "Reset to default";
                clicked => {
                    Theme.accent-base = #f7931e;
                    root.color-changed(#f7931e);
                }
            }
        }
    }
}
