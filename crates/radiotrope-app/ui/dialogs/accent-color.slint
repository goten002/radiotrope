import { Theme, Defaults } from "../defaults.slint";
import { SecondaryButton } from "../buttons.slint";
import { DialogShell, SectionHeader, Icon, Toggle, ButtonKeys, FocusRing } from "../components.slint";

component ColorSwatch inherits Rectangle {
    in property <color> swatch-color;
    // The colour's name, for screen readers
    in property <string> name;
    in property <bool> is-selected;
    callback clicked();

    width: 38px;
    height: 38px;
    border-radius: 19px;
    // Ring around the selected color
    border-width: 2px;
    border-color: root.is-selected ? root.swatch-color : transparent;
    animate border-color { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: radio-button;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.is-selected;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    keys := ButtonKeys {
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }

    Rectangle {
        property <length> size: touch.has-hover || root.is-selected ? 28px : 26px;
        animate size { duration: Theme.fast; }
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        background: root.swatch-color;
    }

    if root.is-selected: Icon {
        width: 12px;
        height: 12px;
        source: @image-url("../icons/tick.svg");
        colorize: Theme.text-on(root.swatch-color);
    }
}

// Custom colour: a saturation/brightness square over a hue bar. The accent
// follows the pointer live; it is saved when the finger or button lets go.
// Handles are touch sized (Pi screen). Drawn without clipping, since the
// software renderer can't clip to rounded corners.
component ColorPicker inherits VerticalLayout {
    // The accent in use
    in property <color> current;
    // Height of the colour square: shorter on small screens (Pi)
    in property <length> square-height: Defaults.accent-picker-height;
    // A new colour picked; `final` is false while dragging, true on release
    callback picked(color, bool);

    property <float> hue: 0;
    property <float> sat: 1;
    property <float> val: 1;
    // Dragging or using keys: the colour comes from here, not `current`
    property <bool> editing: false;
    property <color> chosen: hsv(root.hue, root.sat, root.val);

    function sync() {
        if !root.editing {
            // Grey has no hue: keep the hue bar where it is
            if current.to-hsv().saturation > 0.001 && current.to-hsv().value > 0.001 {
                root.hue = current.to-hsv().hue;
            }
            // Black has no saturation: keep it too
            if current.to-hsv().value > 0.001 {
                root.sat = current.to-hsv().saturation;
            }
            root.val = current.to-hsv().value;
        }
    }

    function set(h: float, s: float, v: float, final: bool) {
        root.hue = Math.clamp(h, 0, 359.9);
        root.sat = Math.clamp(s, 0, 1);
        root.val = Math.clamp(v, 0, 1);
        root.picked(root.chosen, final);
    }

    init => { root.sync(); }
    changed current => { root.sync(); }

    spacing: 10px;

    // Saturation left to right, brightness bottom to top
    sv := Rectangle {
        height: root.square-height;
        property <length> knob: 26px;
        accessible-role: slider;
        accessible-label: "Saturation and brightness";
        accessible-value: Math.round(root.sat * 100) + "% saturation, " + Math.round(root.val * 100) + "% brightness";

        Rectangle {
            border-radius: Theme.radius-md;
            background: hsv(root.hue, 1, 1);
        }
        Rectangle {
            border-radius: Theme.radius-md;
            background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%);
        }
        Rectangle {
            border-radius: Theme.radius-md;
            background: @linear-gradient(0deg, #000000 0%, #00000000 100%);
            border-width: 1px;
            border-color: Theme.hairline;
        }

        sv-touch := TouchArea {
            mouse-cursor: crosshair;
            function pick(final: bool) {
                root.set(root.hue, self.mouse-x / self.width, 1 - self.mouse-y / self.height, final);
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.editing = true;
                    sv-keys.focus();
                    self.pick(false);
                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    if root.editing { self.pick(true); }
                    root.editing = false;
                }
            }
            moved => {
                if self.pressed { self.pick(false); }
            }
        }

        // Its touch area takes the focus, so a first press both focuses and picks
        sv-keys := FocusScope {
            focus-on-click: false;
            key-pressed(e) => {
                if e.text == Key.LeftArrow { root.set(root.hue, root.sat - 0.05, root.val, true); return accept; }
                if e.text == Key.RightArrow { root.set(root.hue, root.sat + 0.05, root.val, true); return accept; }
                if e.text == Key.DownArrow { root.set(root.hue, root.sat, root.val - 0.05, true); return accept; }
                if e.text == Key.UpArrow { root.set(root.hue, root.sat, root.val + 0.05, true); return accept; }
                return reject;
            }
        }

        if sv-keys.has-focus: FocusRing {
            radius: Theme.radius-md;
        }

        // Ring showing the picked spot
        Rectangle {
            x: root.sat * parent.width - self.width / 2;
            y: (1 - root.val) * parent.height - self.height / 2;
            width: sv.knob;
            height: sv.knob;
            border-radius: self.width / 2;
            background: root.chosen;
            border-width: 3px;
            border-color: #ffffff;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000080;
        }
    }

    // Hue, red round to red
    hue-bar := Rectangle {
        height: 32px;
        property <length> knob: 28px;
        accessible-role: slider;
        accessible-label: "Hue";
        accessible-value: Math.round(root.hue) + " degrees";

        Rectangle {
            height: 16px;
            border-radius: 8px;
            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);
            border-width: 1px;
            border-color: Theme.hairline;
        }

        hue-touch := TouchArea {
            mouse-cursor: pointer;
            function pick(final: bool) {
                root.set((self.mouse-x - hue-bar.knob / 2) / (self.width - hue-bar.knob) * 360, root.sat, root.val, final);
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.editing = true;
                    hue-keys.focus();
                    self.pick(false);
                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    if root.editing { self.pick(true); }
                    root.editing = false;
                }
            }
            moved => {
                if self.pressed { self.pick(false); }
            }
        }

        // Its touch area takes the focus, so a first press both focuses and picks
        hue-keys := FocusScope {
            focus-on-click: false;
            key-pressed(e) => {
                if e.text == Key.LeftArrow || e.text == Key.DownArrow { root.set(root.hue - (e.modifiers.shift ? 1 : 10), root.sat, root.val, true); return accept; }
                if e.text == Key.RightArrow || e.text == Key.UpArrow { root.set(root.hue + (e.modifiers.shift ? 1 : 10), root.sat, root.val, true); return accept; }
                return reject;
            }
        }

        if hue-keys.has-focus: FocusRing {
            height: 16px;
            radius: 8px;
        }

        Rectangle {
            x: root.hue / 360 * (parent.width - self.width);
            width: hue-bar.knob;
            height: hue-bar.knob;
            border-radius: self.width / 2;
            background: hsv(root.hue, 1, 1);
            border-width: 3px;
            border-color: #ffffff;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000080;
        }
    }
}

export component AccentColorDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;

    callback color-changed(color);
    property <[color]> swatches: Theme.accent-swatches;

    if show-dialog: DialogShell {
        title: "Accent Color";
        subtitle: "Used for highlights, buttons and the visualizer";
        card-width: Defaults.accent-color-width;
        close-requested => { root.show-dialog = false; }

        // Swatches, two rows of five
        VerticalLayout {
            spacing: 6px;

            for row in [0, 1]: HorizontalLayout {
                alignment: center;
                spacing: 10px;

                for i in [0, 1, 2, 3, 4]: ColorSwatch {
                    swatch-color: root.swatches[row * 5 + i];
                    name: Theme.accent-swatch-names[row * 5 + i];
                    is-selected: Theme.accent-base == root.swatches[row * 5 + i];
                    clicked => {
                        Theme.accent-base = root.swatches[row * 5 + i];
                        root.color-changed(root.swatches[row * 5 + i]);
                    }
                }
            }
        }

        // Custom color
        VerticalLayout {
            spacing: 6px;

            SectionHeader { title: "CUSTOM"; }

            ColorPicker {
                current: Theme.accent-base;
                // Keep the whole dialog on a 480 px tall screen
                square-height: Math.clamp(root.height - 400px, 64px, Defaults.accent-picker-height);
                picked(c, final) => {
                    Theme.accent-base = c;
                    if final { root.color-changed(c); }
                }
            }
        }

        // Accent glow on the panels and dialogs
        VerticalLayout {
            spacing: 6px;

            SectionHeader { title: "STYLE"; }

            Toggle {
                label: "Gradient on panels and dialogs";
                checked <=> Theme.panel-gradient;
            }
        }

        HorizontalLayout {
            alignment: end;

            SecondaryButton {
                label: "Restore Default";
                clicked => {
                    Theme.accent-base = Theme.accent-default;
                    Theme.panel-gradient = true;
                    root.color-changed(Theme.accent-default);
                }
            }
        }
    }
}
