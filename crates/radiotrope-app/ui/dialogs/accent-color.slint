import { Theme } from "../theme.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { AccentButton, SecondaryButton } from "../buttons.slint";

component ColorSwatch inherits Rectangle {
    in property <color> swatch-color;
    in property <bool> is-selected;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: swatch-color;
    border-width: is-selected ? 2px : 0px;
    border-color: white;

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    // Inner dot for selected state
    if is-selected: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: white;
    }
}

export component AccentColorDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <color> selected-color <=> Theme.accent-base;

    callback color-changed(color);
    callback custom-hex-requested(string);

    property <string> hex-input;
    // Rust callback validates actual hex digits; Slint gates on length only
    property <bool> hex-valid: hex-input.character-count == 7;

    if show-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.scrim;

        TouchArea {
            clicked => { root.show-dialog = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 380px;
            height: card-layout.preferred-height + 24px;
            background: Theme.card;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;

            // Block clicks from closing dialog
            TouchArea {}

            card-layout := VerticalLayout {
                padding: 16px;
                spacing: 16px;

                // Title bar
                HorizontalLayout {
                    height: 28px;

                    Text {
                        text: "Accent Color";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: close-touch.has-hover ? Theme.menu-hover : transparent;
                        animate background { duration: Theme.fast; }

                        close-touch := TouchArea {
                            clicked => { root.show-dialog = false; }
                        }

                        Image {
                            width: 12px;
                            height: 12px;
                            source: @image-url("../icons/xmark.svg");
                            colorize: close-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                        }
                    }
                }

                // Color swatches row
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    ColorSwatch {
                        swatch-color: #3584e4;
                        is-selected: Theme.accent-base == #3584e4;
                        clicked => { Theme.accent-base = #3584e4; root.color-changed(#3584e4); }
                    }
                    ColorSwatch {
                        swatch-color: #2190a4;
                        is-selected: Theme.accent-base == #2190a4;
                        clicked => { Theme.accent-base = #2190a4; root.color-changed(#2190a4); }
                    }
                    ColorSwatch {
                        swatch-color: #3a944a;
                        is-selected: Theme.accent-base == #3a944a;
                        clicked => { Theme.accent-base = #3a944a; root.color-changed(#3a944a); }
                    }
                    ColorSwatch {
                        swatch-color: #c88800;
                        is-selected: Theme.accent-base == #c88800;
                        clicked => { Theme.accent-base = #c88800; root.color-changed(#c88800); }
                    }
                    ColorSwatch {
                        swatch-color: #ed5b00;
                        is-selected: Theme.accent-base == #ed5b00;
                        clicked => { Theme.accent-base = #ed5b00; root.color-changed(#ed5b00); }
                    }
                    ColorSwatch {
                        swatch-color: #e62d42;
                        is-selected: Theme.accent-base == #e62d42;
                        clicked => { Theme.accent-base = #e62d42; root.color-changed(#e62d42); }
                    }
                    ColorSwatch {
                        swatch-color: #d56199;
                        is-selected: Theme.accent-base == #d56199;
                        clicked => { Theme.accent-base = #d56199; root.color-changed(#d56199); }
                    }
                    ColorSwatch {
                        swatch-color: #9141ac;
                        is-selected: Theme.accent-base == #9141ac;
                        clicked => { Theme.accent-base = #9141ac; root.color-changed(#9141ac); }
                    }
                    ColorSwatch {
                        swatch-color: #6f8396;
                        is-selected: Theme.accent-base == #6f8396;
                        clicked => { Theme.accent-base = #6f8396; root.color-changed(#6f8396); }
                    }
                }

                // Custom hex input row
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "Hex:";
                        color: Theme.text-secondary;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    hex-edit := StyledLineEdit {
                        width: 120px;
                        placeholder-text: "#f7931e";
                        text <=> root.hex-input;
                        accepted(val) => {
                            if root.hex-valid { root.custom-hex-requested(root.hex-input); }
                        }
                    }

                    AccentButton {
                        label: "Apply";
                        enabled: root.hex-valid;
                        clicked => { root.custom-hex-requested(root.hex-input); }
                    }
                }

                // Reset button
                HorizontalLayout {
                    alignment: center;

                    SecondaryButton {
                        label: "Reset Default";
                        clicked => {
                            Theme.accent-base = #f7931e;
                            root.color-changed(#f7931e);
                        }
                    }
                }
            }
        }
    }
}
