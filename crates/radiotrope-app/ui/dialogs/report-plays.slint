import { Theme, Defaults } from "../defaults.slint";
import { SecondaryButton } from "../buttons.slint";
import { DialogShell } from "../components.slint";
import { AboutInfo } from "about.slint";

// Asked when the user switches Stations > Report Plays on: why, what is
// kept, and how to take it back, in plain words; the README's Privacy
// section, behind Learn More, has the technical details. Opt-in consent:
// the switch stays off unless Allow is pressed; Esc, the close button and
// a click outside are Don't Allow. Both answers look the same, so neither
// is pushed. Switching it off never asks.
export component ReportPlaysDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;

    callback allow();
    callback open-url(string);

    // The Privacy section of the README
    out property <string> learn-more-url: AboutInfo.repository + "#privacy";

    if show-dialog: DialogShell {
        title: "Report Plays?";
        card-width: Defaults.dialog-width;
        close-requested => { root.show-dialog = false; }

        Text {
            text: "Help others find good stations. When you play a station from Search Stations, Radiotrope counts the play so popular stations show up first.";
            color: Theme.text-primary;
            font-size: Theme.font-md;
            wrap: word-wrap;
        }

        Text {
            text: "We only count plays: we don't store your IP address or anything else that could identify you, and there's no account.";
            color: Theme.text-primary;
            font-size: Theme.font-md;
            wrap: word-wrap;
        }

        Text {
            text: "You can turn this off anytime in Stations > Report Plays.";
            color: Theme.text-primary;
            font-size: Theme.font-md;
            wrap: word-wrap;
        }

        // Learn More at the left, where a dialog's extra action goes; the
        // two answers at the right, the same size and style
        HorizontalLayout {
            spacing: Theme.space-8;

            SecondaryButton {
                label: "Learn More";
                clicked => { root.open-url(root.learn-more-url); }
            }

            Rectangle { horizontal-stretch: 1; }

            property <length> answer-width: max(dont.natural-width, yes.natural-width);

            dont := SecondaryButton {
                label: "Don't Allow";
                width: parent.answer-width;
                clicked => { root.show-dialog = false; }
            }

            yes := SecondaryButton {
                label: "Allow";
                width: parent.answer-width;
                clicked => {
                    root.show-dialog = false;
                    root.allow();
                }
            }
        }
    }
}
