import { Theme } from "../theme.slint";
import { DialogShell, InfoRow, SectionHeader } from "../components.slint";

// Headline number with a caption
component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> tone: Theme.text-primary;

    // Equal share of the row whatever the text, so tiles don't jump as
    // values change
    horizontal-stretch: 1;
    min-width: 0;
    preferred-width: 0;
    height: 62px;
    border-radius: Theme.radius-md;
    background: Theme.elevated;
    border-width: 1px;
    border-color: Theme.hairline;

    VerticalLayout {
        padding: 10px;
        padding-left: 12px;
        spacing: 2px;
        alignment: center;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        Text {
            text: root.value;
            color: root.tone;
            font-size: 17px;
            font-weight: 600;
            overflow: elide;
        }
    }
}

// Titled group of rows
component StatGroup inherits Rectangle {
    in property <string> title;

    min-width: 0;
    preferred-width: 0;

    border-radius: Theme.radius-md;
    background: Theme.elevated;
    border-width: 1px;
    border-color: Theme.hairline;

    VerticalLayout {
        padding: 12px;
        padding-top: 4px;
        spacing: 0;
        alignment: start;

        SectionHeader { title: root.title; }
        @children
    }
}

export component StatisticsDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;

    in property <string> stat-health: "--";
    in property <string> stat-playtime: "--";
    in property <string> stat-codec: "--";
    in property <string> stat-bitrate: "--";
    in property <string> stat-sample-rate: "--";
    in property <string> stat-channels: "--";
    in property <string> stat-received: "--";
    in property <string> stat-segments: "--";
    in property <string> stat-throughput: "--";
    in property <string> stat-buffer-level: "--";
    in property <string> stat-buffer-capacity: "--";
    in property <string> stat-frames-played: "--";
    in property <string> stat-decode-errors: "--";
    in property <string> stat-underruns: "--";

    if show-dialog: DialogShell {
        title: "Statistics";
        subtitle: "Live stream, buffer and decoder details";
        card-width: 540px;
        close-requested => { root.show-dialog = false; }

        HorizontalLayout {
            spacing: 10px;

            StatTile {
                label: "STREAM";
                value: root.stat-health;
                tone: root.stat-health == "Stable" ? Theme.success
                    : root.stat-health == "--" || root.stat-health == "Stopped"
                        ? Theme.text-primary : Theme.accent-text;
            }
            StatTile { label: "PLAYTIME"; value: root.stat-playtime; }
            StatTile { label: "THROUGHPUT"; value: root.stat-throughput; }
            StatTile { label: "BUFFER"; value: root.stat-buffer-level; }
        }

        // Two equal columns lined up with the tiles above; rows share a height
        GridLayout {
            spacing: 10px;

            Row {
                StatGroup {
                    title: "CODEC";
                    InfoRow { label: "Codec"; value: root.stat-codec; }
                    InfoRow { label: "Bitrate"; value: root.stat-bitrate; }
                    InfoRow { label: "Sample rate"; value: root.stat-sample-rate; }
                    InfoRow { label: "Channels"; value: root.stat-channels; }
                }

                StatGroup {
                    title: "DECODE";
                    InfoRow { label: "Frames"; value: root.stat-frames-played; }
                    InfoRow { label: "Errors"; value: root.stat-decode-errors; }
                    InfoRow { label: "Underruns"; value: root.stat-underruns; }
                }
            }

            Row {
                StatGroup {
                    title: "NETWORK";
                    InfoRow { label: "Received"; value: root.stat-received; }
                    InfoRow { label: "Segments"; value: root.stat-segments; }
                }

                StatGroup {
                    title: "BUFFER";
                    InfoRow { label: "Level"; value: root.stat-buffer-level; }
                    InfoRow { label: "Capacity"; value: root.stat-buffer-capacity; }
                }
            }
        }
    }
}
