import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, InfoRow, SectionHeader } from "../components.slint";

// Headline number with a caption
component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> tone: Theme.text-primary;
    // Status colours as their readable text tone
    property <color> foreground: root.tone == Theme.success ? Theme.success-text
        : root.tone == Theme.danger ? Theme.danger-text
        : root.tone == Theme.warning ? Theme.warning-text : root.tone;

    // Equal share of the row whatever the text, so tiles don't jump as
    // values change
    horizontal-stretch: 1;
    min-width: 0;
    preferred-width: 0;
    height: 62px;
    border-radius: Theme.radius-md;
    background: Theme.elevated;
    border-width: 1px;
    border-color: Theme.hairline;

    VerticalLayout {
        padding: Theme.space-8;
        padding-left: Theme.space-12;
        spacing: Theme.space-2;
        alignment: center;

        // The same caps heading as the groups below
        Text {
            text: root.label;
            color: Theme.accent-text;
            font-size: Theme.font-xs;
            font-weight: Theme.weight-semibold;
            letter-spacing: 1px;
        }

        Text {
            text: root.value;
            color: root.foreground;
            font-size: Theme.font-title;
            font-weight: Theme.weight-semibold;
            overflow: elide;
        }
    }
}

// Titled group of rows
component StatGroup inherits Rectangle {
    in property <string> title;

    min-width: 0;
    preferred-width: 0;

    border-radius: Theme.radius-md;
    background: Theme.elevated;
    border-width: 1px;
    border-color: Theme.hairline;

    VerticalLayout {
        padding: Theme.space-12;
        padding-top: Theme.space-4;
        spacing: 0;
        alignment: start;

        SectionHeader { title: root.title; }
        @children
    }
}

// How the stream is doing, for the tone of the STREAM tile
export enum StreamHealth {
    // Nothing plays
    stopped,
    connecting,
    playing,
    // The station stopped sending for a moment
    stalled,
    failed,
}

// The figures of the Statistics dialog, set from Rust (stats_ui.rs). The
// header's play time reads `playtime` too.
export global StatsData {
    in property <StreamHealth> health: StreamHealth.stopped;
    // The health in words: "Playing", "Failed · no audio"
    in property <string> health-text: "—";
    in property <string> playtime: "—";
    in property <string> codec: "—";
    in property <string> bitrate: "—";
    in property <string> sample-rate: "—";
    in property <string> channels: "—";
    in property <string> received: "—";
    in property <string> segments: "—";
    in property <string> throughput: "—";
    in property <string> buffer-level: "—";
    in property <string> buffer-capacity: "—";
    in property <string> frames-played: "—";
    in property <string> decode-errors: "—";
    in property <string> underruns: "—";
    in property <string> leveler: "—";
    in property <string> hum: "—";
}

export component StatisticsDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;

    if show-dialog: DialogShell {
        title: "Statistics";
        subtitle: "Live stream, sound and decoder details";
        card-width: Defaults.statistics-width;
        close-requested => { root.show-dialog = false; }

        HorizontalLayout {
            spacing: Theme.space-12;

            StatTile {
                label: "STREAM";
                value: StatsData.health-text;
                tone: StatsData.health == StreamHealth.playing ? Theme.success
                    : StatsData.health == StreamHealth.stopped ? Theme.text-primary
                    : StatsData.health == StreamHealth.failed ? Theme.danger
                    : Theme.accent-text;
            }
            StatTile { label: "PLAYING FOR"; value: StatsData.playtime; }
            StatTile { label: "DATA RATE"; value: StatsData.throughput; }
            StatTile { label: "BUFFER"; value: StatsData.buffer-level; }
        }

        // Two equal columns lined up with the tiles above; rows share a height
        GridLayout {
            spacing: Theme.space-12;

            Row {
                StatGroup {
                    title: "AUDIO";
                    InfoRow { label: "Codec"; value: StatsData.codec; }
                    InfoRow { label: "Bitrate"; value: StatsData.bitrate; }
                    InfoRow { label: "Sample rate"; value: StatsData.sample-rate; }
                    InfoRow { label: "Channels"; value: StatsData.channels; }
                }

                // What the filters do to the station playing
                StatGroup {
                    title: "SOUND";
                    InfoRow { label: "Volume leveler"; value: StatsData.leveler; }
                    InfoRow { label: "Hum filter"; value: StatsData.hum; }
                }
            }

            Row {
                StatGroup {
                    title: "NETWORK";
                    InfoRow { label: "Received"; value: StatsData.received; }
                    InfoRow { label: "Segments"; value: StatsData.segments; }
                    // The live level is on the BUFFER tile
                    InfoRow { label: "Buffer size"; value: StatsData.buffer-capacity; }
                }

                StatGroup {
                    title: "DECODE";
                    InfoRow { label: "Frames"; value: StatsData.frames-played; }
                    InfoRow { label: "Errors"; value: StatsData.decode-errors; }
                    InfoRow { label: "Underruns"; value: StatsData.underruns; }
                }
            }
        }
    }
}
