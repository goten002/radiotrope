import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, InfoRow, SectionHeader } from "../components.slint";

// Headline number with a caption
component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> tone: Theme.text-primary;
    // Status colours as their readable text tone
    property <color> foreground: root.tone == Theme.success ? Theme.success-text
        : root.tone == Theme.danger ? Theme.danger-text
        : root.tone == Theme.warning ? Theme.warning-text : root.tone;

    // Equal share of the row whatever the text, so tiles don't jump as
    // values change
    horizontal-stretch: 1;
    min-width: 0;
    preferred-width: 0;
    height: 62px;
    border-radius: Theme.radius-md;
    background: Theme.elevated;
    border-width: 1px;
    border-color: Theme.hairline;

    VerticalLayout {
        padding: Theme.space-8;
        padding-left: Theme.space-12;
        spacing: Theme.space-2;
        alignment: center;

        // The same caps heading as the groups below
        Text {
            text: root.label;
            color: Theme.accent-text;
            font-size: Theme.font-xs;
            font-weight: Theme.weight-semibold;
            letter-spacing: 1px;
        }

        Text {
            text: root.value;
            color: root.foreground;
            font-size: Theme.font-title;
            font-weight: Theme.weight-semibold;
            overflow: elide;
        }
    }
}

// Titled group of rows
component StatGroup inherits Rectangle {
    in property <string> title;

    min-width: 0;
    preferred-width: 0;

    border-radius: Theme.radius-md;
    background: Theme.elevated;
    border-width: 1px;
    border-color: Theme.hairline;

    VerticalLayout {
        padding: Theme.space-12;
        padding-top: Theme.space-4;
        spacing: 0;
        alignment: start;

        SectionHeader { title: root.title; }
        @children
    }
}

export component StatisticsDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;

    in property <string> stat-health: "—";
    in property <string> stat-playtime: "—";
    in property <string> stat-codec: "—";
    in property <string> stat-bitrate: "—";
    in property <string> stat-sample-rate: "—";
    in property <string> stat-channels: "—";
    in property <string> stat-received: "—";
    in property <string> stat-segments: "—";
    in property <string> stat-throughput: "—";
    in property <string> stat-buffer-level: "—";
    in property <string> stat-buffer-capacity: "—";
    in property <string> stat-frames-played: "—";
    in property <string> stat-decode-errors: "—";
    in property <string> stat-underruns: "—";
    in property <string> stat-leveler: "—";
    in property <string> stat-hum: "—";
    in property <string> stat-hiss: "—";

    if show-dialog: DialogShell {
        title: "Statistics";
        subtitle: "Live stream, sound and decoder details";
        card-width: Defaults.statistics-width;
        close-requested => { root.show-dialog = false; }

        HorizontalLayout {
            spacing: Theme.space-12;

            StatTile {
                label: "STREAM";
                value: root.stat-health;
                // The words come from format_health in main.rs; anything
                // else is a failure ("Failed · no audio")
                tone: root.stat-health == "Playing" ? Theme.success
                    : root.stat-health == "—" || root.stat-health == "Stopped"
                        ? Theme.text-primary
                    : root.stat-health == "Connecting…" || root.stat-health == "Stalled"
                        ? Theme.accent-text : Theme.danger;
            }
            StatTile { label: "PLAYTIME"; value: root.stat-playtime; }
            StatTile { label: "THROUGHPUT"; value: root.stat-throughput; }
            StatTile { label: "BUFFER"; value: root.stat-buffer-level; }
        }

        // Two equal columns lined up with the tiles above; rows share a height
        GridLayout {
            spacing: Theme.space-12;

            Row {
                StatGroup {
                    title: "AUDIO";
                    InfoRow { label: "Codec"; value: root.stat-codec; }
                    InfoRow { label: "Bitrate"; value: root.stat-bitrate; }
                    InfoRow { label: "Sample rate"; value: root.stat-sample-rate; }
                    InfoRow { label: "Channels"; value: root.stat-channels; }
                }

                // What the filters do to the station playing
                StatGroup {
                    title: "SOUND";
                    InfoRow { label: "Volume leveler"; value: root.stat-leveler; }
                    InfoRow { label: "Hum filter"; value: root.stat-hum; }
                    InfoRow { label: "Hiss reducer"; value: root.stat-hiss; }
                }
            }

            Row {
                StatGroup {
                    title: "NETWORK";
                    InfoRow { label: "Received"; value: root.stat-received; }
                    InfoRow { label: "Segments"; value: root.stat-segments; }
                    // The live level is on the BUFFER tile
                    InfoRow { label: "Buffer size"; value: root.stat-buffer-capacity; }
                }

                StatGroup {
                    title: "DECODE";
                    InfoRow { label: "Frames"; value: root.stat-frames-played; }
                    InfoRow { label: "Errors"; value: root.stat-decode-errors; }
                    InfoRow { label: "Underruns"; value: root.stat-underruns; }
                }
            }
        }
    }
}
