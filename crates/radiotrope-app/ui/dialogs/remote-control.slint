import { Theme, Defaults } from "../defaults.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { SecondaryButton } from "../buttons.slint";
import { DialogShell, Toggle, InfoTip, IconButton, Icon, Chip, ChipVariant, SectionHeader } from "../components.slint";
import { CopyLine, RowLabel } from "agents.slint";
import { ScrollBar } from "../scroll-bar.slint";

// A paired phone, and when it was last used ("Used 5 min ago")
export struct RemoteDevice {
    id: string,
    name: string,
    seen: string,
}

component DeviceRow inherits Rectangle {
    in property <RemoteDevice> device;
    // The trash was clicked once: the next click removes
    in property <bool> confirm-remove;
    callback remove();

    height: Theme.row-dense;
    border-radius: Theme.radius-md;
    background: Theme.elevated;

    HorizontalLayout {
        padding-left: Theme.space-12;
        padding-right: Theme.space-6;
        spacing: Theme.space-12;

        VerticalLayout {
            alignment: center;
            Icon {
                width: Theme.icon-compact;
                height: Theme.icon-compact;
                source: @image-url("../icons/mobile-screen-button.svg");
                colorize: Theme.text-secondary;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;

            Text {
                text: root.device.name;
                color: Theme.text-primary;
                font-size: Theme.font-base;
                font-weight: Theme.weight-semibold;
                overflow: elide;
            }
            Text {
                text: root.confirm-remove ? "Press Again to Remove" : root.device.seen;
                color: root.confirm-remove ? Theme.danger-text : Theme.text-secondary;
                font-size: Theme.font-sm;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("../icons/trash-can.svg");
                label: root.confirm-remove ? "Press Again to Remove" : "Remove " + root.device.name;
                icon-size: Theme.icon-compact;
                danger-armed: root.confirm-remove;
                clicked => { root.remove(); }
            }
        }
    }
}

// Radiotrope Remote: phones on this network that may control the player
export component RemoteControlDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in property <string> snapshot-overlay;
    in-out property <bool> enabled-on: false;
    // What the server says, while on
    in property <string> status;
    in property <bool> status-error;
    // A short form of an error status for the row ("Can't start"), with
    // the full status in the bubble. Empty: worked out here.
    in property <string> status-short;
    // Where phones reach the player, e.g. "192.168.1.20:8766"
    in property <string> address;
    in property <string> address-note;
    // The saved name, and the computer's name shown when there is none
    in property <string> name;
    in property <string> name-placeholder;
    in property <[RemoteDevice]> devices;
    in-out property <bool> share-recordings: false;
    // The height the paired phones can take in this window
    property <length> list-room: max(Theme.row-dense,
        root.height - Defaults.remote-devices-chrome);

    // Being edited; reset from the saved name when the dialog opens
    in-out property <string> edit-name;
    in-out property <string> confirm-remove;

    callback opened();
    callback toggled(bool);
    callback apply-name(string);
    callback remove-device(string);
    callback pair-qr();
    callback share-toggled(bool);

    public function open() {
        root.opened();
        root.edit-name = root.name;
        root.confirm-remove = "";
        root.show-dialog = true;
    }

    // The name saves on Enter, when it loses focus, or here
    function close() {
        if root.edit-name != root.name {
            root.apply-name(root.edit-name);
        }
        root.show-dialog = false;
    }

    if show-dialog: shell := DialogShell {
        title: "Remote Control";
        subtitle: "Control the player from the Radiotrope Remote app on your phone";
        card-width: Defaults.remote-control-width;
        close-requested => { root.close(); }

        // While on, what the server says at the right, as in Agents: a
        // short chip, and on a problem the full reason in the bubble
        HorizontalLayout {
            spacing: Theme.space-12;

            Toggle {
                label: "Allow phones on this network";
                checked <=> root.enabled-on;
                toggled(on) => {
                    root.confirm-remove = "";
                    root.toggled(on);
                }
            }
            if root.enabled-on && root.status != "": HorizontalLayout {
                horizontal-stretch: 1;
                alignment: end;
                spacing: Theme.space-6;

                VerticalLayout {
                    alignment: center;
                    Chip {
                        // Without an address the server didn't start; with
                        // one, only the announcement failed
                        text: !root.status-error ? "Ready"
                            : root.status-short != "" ? root.status-short
                            : root.address == "" ? "Can't start" : "Can't announce";
                        variant: root.status-error ? ChipVariant.danger : ChipVariant.success;
                        dot: !root.status-error;
                        keep: true;
                    }
                }
                // Near the top of the card: open below, inside the body
                if root.status-error: VerticalLayout {
                    alignment: center;
                    InfoTip {
                        popup-bounds: shell.popup-bounds;
                        open-below: true;
                        text: root.status;
                        open: root.snapshot-overlay == "status-info";
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-8;
            RowLabel { text: "Name"; }
            StyledLineEdit {
                height: Theme.control-button;
                horizontal-stretch: 1;
                text <=> root.edit-name;
                placeholder-text: root.name-placeholder;
                accepted(text) => { root.apply-name(text); }
                changed has-focus => {
                    if !self.has-focus && root.edit-name != root.name {
                        root.apply-name(root.edit-name);
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-8;
            RowLabel { text: "Address"; }
            CopyLine {
                text: root.enabled-on ? root.address : "";
                placeholder: root.enabled-on ? "No network found" : "Shown when Remote Control is on";
                enabled: root.enabled-on;
            }
            VerticalLayout {
                alignment: center;
                InfoTip {
                    popup-bounds: shell.popup-bounds;
                    text: root.address-note;
                    open: root.snapshot-overlay == "address-info";
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-8;
            Toggle {
                label: "Share recordings with paired phones";
                checked <=> root.share-recordings;
                enabled: root.enabled-on;
                toggled(on) => { root.share-toggled(on); }
            }
            VerticalLayout {
                alignment: center;
                InfoTip {
                    popup-bounds: shell.popup-bounds;
                    open: root.snapshot-overlay == "recordings-info";
                    text: "Paired phones can see, download and delete your recordings. Other files in the folder stay private.";
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        HorizontalLayout {
            spacing: Theme.space-8;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                SectionHeader { title: "PAIRED PHONES"; }
            }
            SecondaryButton {
                label: "Pair a Phone";
                icon: @image-url("../icons/qrcode.svg");
                enabled: root.enabled-on;
                clicked => {
                    root.confirm-remove = "";
                    root.pair-qr();
                }
            }
        }

        if root.devices.length == 0: Text {
            text: "No phones yet. Press Pair a Phone, then scan the code with Radiotrope Remote.";
            color: Theme.text-secondary;
            font-size: Theme.font-md;
            wrap: word-wrap;
        }

        // As tall as the phones while the window has room, scrolling past that
        if root.devices.length > 0: Rectangle {
            height: min(root.list-room, list.preferred-height);

            flick := Flickable {
                content-height: list.preferred-height;
                width: parent.width - (scroll.visible ? Theme.space-12 : 0px);
                x: 0;

                list := VerticalLayout {
                    spacing: Theme.space-6;

                    for device in root.devices: DeviceRow {
                        device: device;
                        confirm-remove: root.confirm-remove == device.id;
                        remove => {
                            if root.confirm-remove == device.id {
                                root.confirm-remove = "";
                                root.remove-device(device.id);
                            } else {
                                root.confirm-remove = device.id;
                            }
                        }
                    }
                }
            }

            scroll := ScrollBar {
                x: parent.width - self.width;
                height: parent.height;
                viewport-height: flick.height;
                content-height: flick.content-height;
                content-y <=> flick.content-y;
            }
        }
    }
}

// The code a phone asks for while it pairs; shown over everything
export component PairingCodeDialog inherits Rectangle {
    in property <bool> show-dialog: false;
    in property <string> device-name;
    in property <string> code;
    // Seconds before the code runs out
    in property <int> seconds-left;
    callback cancel();

    if show-dialog: DialogShell {
        title: "Pair a Phone";
        subtitle: root.device-name + " wants to control Radiotrope";
        card-width: Defaults.pairing-code-width;
        // Cancel in the footer, at the right as in the other dialogs
        cancel-label: "Cancel";
        close-requested => { root.cancel(); }

        Text {
            text: root.code;
            color: Theme.accent-text;
            font-size: Theme.font-code;
            font-weight: 700;
            letter-spacing: 10px;
            horizontal-alignment: center;
            accessible-label: "Code " + root.code;
        }

        Text {
            // e.g. "Type this code on the phone · 1:58"
            text: "Type this code on the phone · " + floor(root.seconds-left / 60) + ":"
                + (mod(root.seconds-left, 60) < 10 ? "0" : "") + mod(root.seconds-left, 60);
            color: Theme.text-secondary;
            font-size: Theme.font-md;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// A QR code a phone scans to pair: works once, for a short while
export component PairingQrDialog inherits Rectangle {
    in property <bool> show-dialog: false;
    in property <image> qr;
    // Seconds before the code runs out
    in property <int> seconds-left;
    callback cancel();

    if show-dialog: DialogShell {
        title: "Pair a Phone";
        subtitle: "Scan this code with Radiotrope Remote";
        card-width: Defaults.pairing-code-width;
        // Cancel in the footer, at the right as in the other dialogs
        cancel-label: "Cancel";
        close-requested => { root.cancel(); }

        HorizontalLayout {
            alignment: center;
            // Black on light in every theme, as scanners expect: the light
            // theme's card itself, or a white tile in the dark theme
            Rectangle {
                width: Defaults.pairing-qr-size;
                height: Defaults.pairing-qr-size;
                border-radius: Theme.radius-md;
                background: Theme.dark-mode ? white : transparent;

                Image {
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    source: root.qr;
                    image-rendering: pixelated;
                    image-fit: contain;
                    accessible-role: image;
                    accessible-label: "Pairing QR code";
                }
            }
        }

        Text {
            // e.g. "Works once · 1:58"
            text: "Works once · " + floor(root.seconds-left / 60) + ":"
                + (mod(root.seconds-left, 60) < 10 ? "0" : "") + mod(root.seconds-left, 60);
            color: Theme.text-secondary;
            font-size: Theme.font-md;
            horizontal-alignment: center;
        }
    }
}
