import { Theme } from "../theme.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { AccentButton, SecondaryButton } from "../buttons.slint";
import { DialogShell, Field } from "../components.slint";

export component NetworkStreamDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <string> url: "";
    // Optional station details, shown in the player and kept when the
    // stream is added to favorites with the star
    in-out property <string> name: "";
    in-out property <string> logo-url: "";
    in-out property <string> country: "";
    // url, name, logo url, country
    callback accepted(string, string, string, string);
    callback cancelled();

    function reset() {
        root.url = "";
        root.name = "";
        root.logo-url = "";
        root.country = "";
    }

    function cancel() {
        root.reset();
        root.show-dialog = false;
        root.cancelled();
    }

    function play() {
        if root.url != "" {
            root.show-dialog = false;
            root.accepted(root.url, root.name, root.logo-url, root.country);
            root.reset();
        }
    }

    if show-dialog: DialogShell {
        title: "Open Network Stream";
        subtitle: "Play any internet radio or HLS stream by its address";
        card-width: 460px;
        auto-focus: false;
        close-requested => { root.cancel(); }

        Field {
            label: "Stream URL";
            StyledLineEdit {
                placeholder-text: "https://stream.example.com/radio";
                text <=> root.url;
                clearable: true;
                accepted(text) => { root.play(); }
                init => { self.focus-input(); }
            }
        }

        HorizontalLayout {
            spacing: 12px;

            Field {
                horizontal-stretch: 1;
                label: "Name";
                StyledLineEdit {
                    placeholder-text: "Optional";
                    text <=> root.name;
                    accepted(text) => { root.play(); }
                }
            }

            Field {
                horizontal-stretch: 1;
                label: "Country";
                StyledLineEdit {
                    placeholder-text: "Optional";
                    text <=> root.country;
                    accepted(text) => { root.play(); }
                }
            }
        }

        Field {
            label: "Logo URL";
            StyledLineEdit {
                placeholder-text: "Optional, https://example.com/logo.png";
                text <=> root.logo-url;
                clearable: true;
                accepted(text) => { root.play(); }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            SecondaryButton {
                label: "Cancel";
                clicked => { root.cancel(); }
            }

            AccentButton {
                label: "Play";
                enabled: root.url != "";
                clicked => { root.play(); }
            }
        }
    }
}
