import { Theme } from "../theme.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { AccentButton, SecondaryButton } from "../buttons.slint";
import { DialogShell, Field } from "../components.slint";

export component NetworkStreamDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <string> url: "";
    callback accepted(string);
    callback cancelled();

    function cancel() {
        root.url = "";
        root.show-dialog = false;
        root.cancelled();
    }

    function play() {
        if root.url != "" {
            root.show-dialog = false;
            root.accepted(root.url);
            root.url = "";
        }
    }

    if show-dialog: DialogShell {
        title: "Open Network Stream";
        subtitle: "Play any internet radio or HLS stream by its address";
        card-width: 460px;
        auto-focus: false;
        close-requested => { root.cancel(); }

        Field {
            label: "Stream URL";
            url-input := StyledLineEdit {
                placeholder-text: "https://stream.example.com/radio";
                text <=> root.url;
                clearable: true;
                accepted(url) => { root.play(); }
                init => { self.focus-input(); }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            SecondaryButton {
                label: "Cancel";
                clicked => { root.cancel(); }
            }

            AccentButton {
                label: "Play";
                enabled: root.url != "";
                clicked => { root.play(); }
            }
        }
    }
}
