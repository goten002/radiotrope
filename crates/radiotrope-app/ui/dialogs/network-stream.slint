import { Theme, Defaults } from "../defaults.slint";
import { RecordingGuard } from "../favorites.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { DialogShell, Field } from "../components.slint";

export component NetworkStreamDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <string> url: "";
    // Optional station details, shown in the player and kept when the
    // stream is added to favorites with the star. Without a name, the
    // stream's own name is shown.
    in-out property <string> name: "";
    in-out property <string> logo-url: "";
    in-out property <string> country: "";
    // The station playing, to clear the form once the stream sent plays
    in property <string> playing-url;
    in property <bool> is-playing;
    // A recording is running: playing another stream would end it, so the
    // first Play only says so (see RecordingGuard), as in the favorites
    // and the search results
    in property <bool> recording;
    // The address Play was pressed for once, while a second press plays it
    out property <string> armed-url;
    changed recording => {
        if !self.recording {
            self.disarm();
        }
    }
    changed url => {
        // Another address is another question
        if self.armed-url != "" && root.address(self.url) != self.armed-url {
            self.disarm();
        }
    }
    changed show-dialog => {
        if !self.show-dialog {
            self.disarm();
        }
    }
    // url, name, logo url, country
    callback accepted(string, string, string, string);

    // Only the address is needed
    property <bool> can-play: root.url != "";
    // The address last sent, until it plays: the fields stay meanwhile, so
    // a typo can be fixed without typing everything again
    property <string> sent;
    property <bool> sent-plays: root.sent != "" && root.is-playing && root.playing-url == root.sent;
    changed sent-plays => {
        if root.sent-plays && !root.show-dialog {
            root.reset();
        }
    }

    function reset() {
        root.sent = "";
        root.url = "";
        root.name = "";
        root.logo-url = "";
        root.country = "";
    }

    // Cancel, Esc, the close button and a click beside the dialog all
    // discard what was typed, like Cancel in every other form
    function cancel() {
        root.reset();
        root.show-dialog = false;
    }

    // The address without spaces, with "http://" when it has no scheme
    pure function address(text: string) -> string {
        let bare = text.replace-all(" ", "");
        bare.replace-all("://", "") != bare ? bare : "http://" + bare
    }

    function disarm() {
        root.armed-url = "";
        arm-timer.running = false;
    }

    // Whether Play goes ahead: while recording another station, only the
    // second press within RecordingGuard's time does (and ends the
    // recording). The station recorded plays on without asking.
    public function confirm-switch(url: string) -> bool {
        if !root.recording || url == root.playing-url || url == root.armed-url {
            root.disarm();
            return true;
        }
        root.armed-url = url;
        arm-timer.running = true;
        arm-timer.restart();
        return false;
    }

    arm-timer := Timer {
        interval: RecordingGuard.confirm-time;
        running: false;
        triggered => { root.disarm(); }
    }

    function play() {
        if root.can-play {
            // Asked about before the field is rewritten: the text stays
            // as typed while it may still be changed
            if !root.confirm-switch(root.address(root.url)) {
                return;
            }
            root.url = root.address(root.url);
            root.sent = root.url;
            root.show-dialog = false;
            root.accepted(root.url, root.name, root.logo-url, root.country);
        }
    }

    if show-dialog: DialogShell {
        title: "Open Network Stream";
        subtitle: "Play any radio stream by its web address";
        card-width: Defaults.network-stream-width;
        auto-focus: false;
        cancel-label: "Cancel";
        primary-label: "Play";
        primary-enabled: root.can-play;
        primary-requested => { root.play(); }
        close-requested => { root.cancel(); }

        // The address first: it is all a stream needs
        Field {
            label: "Stream URL";
            required: true;
            StyledLineEdit {
                label: "Stream URL";
                required: true;
                placeholder-text: "https://stream.example.com/radio";
                text <=> root.url;
                accepted(text) => { root.play(); }
                // Reopened after a stream that didn't play: the address is
                // selected, ready to fix or replace
                init => {
                    self.focus-input();
                    if root.url != "" {
                        self.select-all();
                    }
                }
            }
        }

        Field {
            label: "Name";
            optional: true;
            StyledLineEdit {
                label: "Name";
                placeholder-text: "Uses the stream's name";
                text <=> root.name;
                clearable: true;
                accepted(text) => { root.play(); }
            }
        }

        Field {
            label: "Logo URL";
            optional: true;
            StyledLineEdit {
                label: "Logo URL";
                placeholder-text: "https://example.com/logo.png";
                text <=> root.logo-url;
                clearable: true;
                accepted(text) => { root.play(); }
            }
        }

        Field {
            label: "Country";
            optional: true;
            StyledLineEdit {
                label: "Country";
                placeholder-text: "United Kingdom";
                text <=> root.country;
                clearable: true;
                accepted(text) => { root.play(); }
            }
        }

        // Play pressed once while recording: what a second press does
        if root.armed-url != "": Text {
            text: RecordingGuard.text;
            color: Theme.danger-text;
            font-size: Theme.font-md;
            font-weight: Theme.weight-semibold;
            wrap: word-wrap;
            accessible-live-region: assertive;
        }
    }
}
