import { Theme, Defaults } from "../defaults.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { AccentButton, SecondaryButton } from "../buttons.slint";
import { DialogShell, Field } from "../components.slint";

export component NetworkStreamDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <string> url: "";
    // Station details, shown in the player and kept when the stream is
    // added to favorites with the star (logo and country are optional)
    in-out property <string> name: "";
    in-out property <string> logo-url: "";
    in-out property <string> country: "";
    // url, name, logo url, country
    callback accepted(string, string, string, string);
    callback cancelled();

    property <bool> can-play: root.name != "" && root.url != "";

    function reset() {
        root.url = "";
        root.name = "";
        root.logo-url = "";
        root.country = "";
    }

    // Cancel clears the fields
    function cancel() {
        root.reset();
        root.show-dialog = false;
        root.cancelled();
    }

    function play() {
        if root.can-play {
            root.show-dialog = false;
            root.accepted(root.url, root.name, root.logo-url, root.country);
            root.reset();
        }
    }

    if show-dialog: DialogShell {
        title: "Open Network Stream";
        subtitle: "Play any internet radio or HLS stream by its address";
        card-width: Defaults.network-stream-width;
        auto-focus: false;
        // Esc, the close button or a click beside the dialog keep what was
        // typed, for when it is opened again
        close-requested => { root.show-dialog = false; }

        // Same fields, in the same order, as Edit Favorite
        Field {
            label: "Name";
            required: true;
            StyledLineEdit {
                placeholder-text: "Station name";
                text <=> root.name;
                accepted(text) => { root.play(); }
                init => { self.focus-input(); }
            }
        }

        Field {
            label: "Stream URL";
            required: true;
            StyledLineEdit {
                placeholder-text: "https://stream.example.com/radio";
                text <=> root.url;
                clearable: true;
                accepted(text) => { root.play(); }
            }
        }

        Field {
            label: "Logo URL";
            StyledLineEdit {
                placeholder-text: "https://example.com/logo.png";
                text <=> root.logo-url;
                clearable: true;
                accepted(text) => { root.play(); }
            }
        }

        Field {
            label: "Country";
            StyledLineEdit {
                placeholder-text: "United Kingdom, London";
                text <=> root.country;
                clearable: true;
                accepted(text) => { root.play(); }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            SecondaryButton {
                label: "Cancel";
                clicked => { root.cancel(); }
            }

            AccentButton {
                label: "Play";
                enabled: root.can-play;
                clicked => { root.play(); }
            }
        }
    }
}
