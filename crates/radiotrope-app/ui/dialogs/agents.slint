import { Theme, Defaults } from "../defaults.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { SecondaryButton } from "../buttons.slint";
import { DialogShell, Toggle, InfoTip, Dropdown } from "../components.slint";
import { Platform } from "@platform/wifi.slint";

// A value to read and copy: the token, or a command that adds Radiotrope
export component CopyLine inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;

    property <bool> copied: false;

    height: 34px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.hairline;
    background: Theme.elevated;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 8px;

        // Read-only but selectable, so part of a line can be copied too;
        // a long line scrolls with the cursor, as in StyledLineEdit
        view := Rectangle {
            min-width: 0px;
            horizontal-stretch: 1;
            clip: true;

            if root.text == "": Text {
                width: 100%;
                text: root.placeholder;
                color: Theme.disabled-text;
                font-size: Theme.font-md;
                overflow: elide;
                vertical-alignment: center;
            }
            // Always there, so the focus stays when the line empties;
            // an empty line can't take the focus
            TextInput {
                property <length> scroll;

                x: min(0px, max(view.width - self.width - self.text-cursor-width, self.scroll));
                width: max(view.width, self.preferred-width);
                height: view.height;
                cursor-position-changed(cursor) => {
                    if cursor.x + self.scroll < 0px {
                        self.scroll = -cursor.x;
                    } else if cursor.x + self.scroll > view.width - self.text-cursor-width {
                        self.scroll = view.width - cursor.x - self.text-cursor-width;
                    }
                }
                text: root.text;
                read-only: true;
                single-line: true;
                enabled: root.enabled && root.text != "";
                color: root.enabled ? Theme.text-primary : Theme.disabled-text;
                selection-background-color: Theme.selection-bg;
                selection-foreground-color: Theme.selection-fg;
                font-size: Theme.font-md;
                vertical-alignment: center;
            }
        }

        // A small borderless Copy, part of the box
        if Platform.has-clipboard: VerticalLayout {
            alignment: center;
            copy := Rectangle {
                property <bool> can-copy: root.enabled && root.text != "";
                width: copy-label.preferred-width + 16px;
                height: 24px;
                border-radius: Theme.radius-sm;
                background: self.can-copy && copy-touch.has-hover ? Theme.menu-hover : transparent;
                animate background { duration: Theme.fast; }

                copy-touch := TouchArea {
                    enabled: copy.can-copy;
                    mouse-cursor: copy.can-copy ? pointer : default;
                    clicked => {
                        clipboard.select-all();
                        clipboard.copy();
                        clipboard.clear-selection();
                        root.copied = true;
                        copied-timer.running = false;
                        copied-timer.running = true;
                    }
                }
                copy-label := Text {
                    text: root.copied ? "Copied" : "Copy";
                    color: !copy.can-copy ? Theme.disabled-text
                        : copy-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                    font-size: Theme.font-sm;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    copied-timer := Timer {
        interval: Defaults.copied-time;
        running: false;
        triggered => {
            self.running = false;
            root.copied = false;
        }
    }

    // Hidden: holds the text for the clipboard
    clipboard := TextInput {
        visible: false;
        text: root.text;
        read-only: true;
        single-line: true;
    }
}

// Caption at the start of a row
export component RowLabel inherits Text {
    width: 84px;
    color: Theme.text-secondary;
    font-size: Theme.font-md;
    vertical-alignment: center;
}

// Which AI agents may use the player: on this computer, and over the network
export component AgentsDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    // False in a --mcp --standalone player: agents reach the main one
    in property <bool> available: true;
    in-out property <bool> network-on: false;
    // Where the server listens: the choices ("This computer only", each
    // interface, "All networks"), the picked one, and the saved port
    in property <[string]> listen-options;
    in-out property <int> listen;
    in property <string> port;
    // The picked address is this computer's own (loopback)
    in property <bool> listen-local: true;
    // Token, and what the server says
    in property <string> token;
    in property <string> status;
    in property <bool> status-error;
    in property <string> command;
    // Lines that add Radiotrope to the picked agent, on this computer and
    // over the network, with a note each where the line needs one
    in property <string> local-command;
    in property <string> local-note;
    in property <string> network-note;
    // In place of the network line when there is none yet, or none at all
    in property <string> network-placeholder: "Ready once there is a token";
    in property <[string]> apps;
    in-out property <int> app;
    callback app-changed(int);
    // How network agents sign in: None, or Token (the second choice)
    in property <[string]> auths;
    in-out property <int> auth;
    callback auth-changed(int);

    // Fields being edited; reset from the saved values when the dialog opens
    in-out property <string> edit-port;

    callback network-toggled(bool);
    callback listen-changed(int);
    callback apply-port(string);
    // Look for network interfaces again (they come and go)
    callback refresh-listen();
    callback regenerate-token();

    property <bool> network-fields: root.available && root.network-on;
    property <bool> token-on: root.auth == 1;
    // Listening on a network with no token: anyone there gets in
    property <bool> open-to-network: root.network-fields && !root.token-on && !root.listen-local;

    public function open() {
        root.refresh-listen();
        root.edit-port = root.port;
        root.show-dialog = true;
    }

    // The port saves on Enter, when it loses focus, or here
    function close() {
        if root.edit-port != root.port {
            root.apply-port(root.edit-port);
        }
        root.show-dialog = false;
    }

    if show-dialog: DialogShell {
        title: "Agents (MCP)";
        subtitle: "AI agents can play stations, search and manage favorites";
        card-width: Defaults.agents-width;
        close-requested => { root.close(); }

        // With None the token and its button go away, and the focus with
        // them if one had it: the dialog takes it back so Esc still works
        property <bool> token-on: root.token-on;
        changed token-on => {
            if !self.token-on {
                self.take-focus();
            }
        }

        if !root.available: Text {
            text: "This player serves one agent alone (--standalone). Agents connect to the main player.";
            color: Theme.text-secondary;
            font-size: Theme.font-md;
            wrap: word-wrap;
        }

        // Agents on this computer need no setting: whoever runs them can
        // use the player anyway
        HorizontalLayout {
            spacing: 8px;
            RowLabel { text: "Agent"; }
            Dropdown {
                items: root.apps;
                selected <=> root.app;
                changed(index) => { root.app-changed(index); }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            RowLabel { text: "Command"; }
            CopyLine {
                text: root.local-command;
                enabled: root.available;
            }
            if root.local-note != "": VerticalLayout {
                alignment: center;
                InfoTip { text: root.local-note; }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        // While on, what the server says at the right: where it
        // listens, in the accent colour, or why it can't
        HorizontalLayout {
            spacing: 12px;

            Toggle {
                label: "Allow agents over the network";
                enabled: root.available;
                checked <=> root.network-on;
                toggled(on) => { root.network-toggled(on); }
            }
            if root.network-on && root.available && root.status != "": HorizontalLayout {
                horizontal-stretch: 1;
                alignment: end;
                spacing: 6px;

                if !root.status-error: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: Theme.accent;
                    }
                }
                Text {
                    text: root.status;
                    color: root.status-error ? Theme.danger : Theme.accent-text;
                    font-size: Theme.font-md;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            RowLabel { text: "Listen on"; }
            Dropdown {
                items: root.listen-options;
                selected <=> root.listen;
                enabled: root.network-fields;
                changed(index) => { root.listen-changed(index); }
            }
            port-label := Text {
                text: "Port";
                color: Theme.text-secondary;
                font-size: Theme.font-md;
                vertical-alignment: center;
            }
            port-edit := StyledLineEdit {
                width: 72px;
                height: 34px;
                enabled: root.network-fields;
                text <=> root.edit-port;
                placeholder-text: "8765";
                accepted(text) => { root.apply-port(text); }
                changed has-focus => {
                    if !self.has-focus && root.edit-port != root.port {
                        root.apply-port(root.edit-port);
                    }
                }
            }
        }

        // The token sits beside its choice; with None there is none
        HorizontalLayout {
            spacing: 8px;
            RowLabel { text: "Authentication"; }
            Dropdown {
                width: 96px;
                horizontal-stretch: 0;
                items: root.auths;
                selected <=> root.auth;
                enabled: root.network-fields;
                changed(index) => { root.auth-changed(index); }
            }
            if root.token-on: CopyLine {
                text: root.token;
                placeholder: "Made when network agents first need one";
                enabled: root.network-fields;
            }
            // Under Port, so the token ends where Listen on does
            if root.token-on: SecondaryButton {
                width: port-label.width + 8px + port-edit.width;
                label: "New token";
                enabled: root.network-fields && root.token != "";
                clicked => { root.regenerate-token(); }
            }
            // Listening on a network with no token: said in red
            if !root.token-on: Text {
                horizontal-stretch: 1;
                text: root.listen-local ? "Only agents on this computer can connect"
                    : root.open-to-network ? "Anyone on this network can control the player"
                    : "Anyone who can reach the address can use the player";
                color: !root.network-fields ? Theme.disabled-text
                    : root.open-to-network ? Theme.danger : Theme.text-secondary;
                font-size: Theme.font-md;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            RowLabel { text: "Command"; }
            CopyLine {
                text: root.token-on && root.token == "" ? "" : root.command;
                placeholder: root.network-placeholder;
                enabled: root.network-fields;
            }
            if root.network-note != "": VerticalLayout {
                alignment: center;
                InfoTip { text: root.network-note; }
            }
        }
    }
}
