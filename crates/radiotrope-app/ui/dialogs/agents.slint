import { Theme, Defaults } from "../defaults.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { SecondaryButton } from "../buttons.slint";
import { DialogShell, Toggle, InfoTip, Icon } from "../components.slint";
import { Platform } from "@platform/wifi.slint";

// A value to read and copy: the token, or the command for Claude Code
component CopyLine inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;

    property <bool> copied: false;

    height: 34px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.hairline;
    background: Theme.elevated;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 8px;

        Text {
            text: root.text != "" ? root.text : root.placeholder;
            color: !root.enabled || root.text == "" ? Theme.disabled-text : Theme.text-primary;
            font-size: Theme.font-md;
            overflow: elide;
            min-width: 0px;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        if Platform.has-clipboard: VerticalLayout {
            alignment: center;
            SecondaryButton {
                height: 26px;
                label: root.copied ? "Copied" : "Copy";
                enabled: root.enabled && root.text != "";
                clicked => {
                    clipboard.select-all();
                    clipboard.copy();
                    clipboard.clear-selection();
                    root.copied = true;
                    copied-timer.running = false;
                    copied-timer.running = true;
                }
            }
        }
    }

    copied-timer := Timer {
        interval: Defaults.copied-time;
        running: false;
        triggered => {
            self.running = false;
            root.copied = false;
        }
    }

    // Hidden: holds the text for the clipboard
    clipboard := TextInput {
        visible: false;
        text: root.text;
        read-only: true;
        single-line: true;
    }
}

// Caption at the start of a row
component RowLabel inherits Text {
    width: 84px;
    color: Theme.text-secondary;
    font-size: Theme.font-md;
    vertical-alignment: center;
}

// One agent in the picker's list, with the menus' tick when picked
component AgentItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.menu-hover : transparent;
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: touch.has-hover ? Theme.text-primary : Theme.menu-text;
            font-size: Theme.font-md;
            vertical-alignment: center;
        }
        Rectangle {
            width: 12px;
            if root.selected: Icon {
                width: 12px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                source: @image-url("../icons/tick.svg");
                colorize: Theme.accent;
            }
        }
    }
}

// Which agent the setup lines are for: a dropdown like the EQ presets
component AgentPicker inherits Rectangle {
    in property <[string]> apps;
    in-out property <int> selected;
    in property <bool> enabled: true;
    callback changed(int);

    height: 32px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.hairline;
    background: root.enabled && touch.has-hover ? Theme.menu-hover : Theme.elevated;
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { popup.show(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        Text {
            text: root.apps[root.selected];
            color: root.enabled ? Theme.text-primary : Theme.disabled-text;
            font-size: Theme.font-md;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                width: 10px;
                height: 10px;
                source: @image-url("../icons/angles-down.svg");
                colorize: Theme.text-secondary;
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;

        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.shadow-soft;

            VerticalLayout {
                padding: 4px;
                for label[index] in root.apps: AgentItem {
                    label: label;
                    selected: index == root.selected;
                    // Picks before closing: the list's rows (and their
                    // index) go away with the popup
                    clicked => {
                        if root.selected != index {
                            root.selected = index;
                            root.changed(index);
                        }
                        popup.close();
                    }
                }
            }
        }
    }
}

// Line of help under a toggle, lined up with its label (36px switch + 8px gap)
component ToggleNote inherits HorizontalLayout {
    in property <string> text;
    padding-left: 44px;

    Text {
        text: root.text;
        color: Theme.text-secondary;
        font-size: Theme.font-md;
        wrap: word-wrap;
    }
}

// Which AI agents may use the player: on this computer, and over the network
export component AgentsDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    // False in a --mcp --standalone player: agents reach the main one
    in property <bool> available: true;
    in-out property <bool> network-on: false;
    // Saved address, token, and what the server says
    in property <string> address;
    in property <string> token;
    in property <string> status;
    in property <bool> status-error;
    in property <string> command;
    // Lines that add Radiotrope to the picked agent, on this computer and
    // over the network, with a note each where the line needs one
    in property <string> local-command;
    in property <string> local-note;
    in property <string> network-note;
    in property <[string]> apps;
    in-out property <int> app;
    callback app-changed(int);

    // Fields being edited; reset from the saved values when the dialog opens
    in-out property <string> edit-address;

    callback network-toggled(bool);
    callback apply-address(string);
    callback regenerate-token();

    property <bool> network-fields: root.available && root.network-on;

    public function open() {
        root.edit-address = root.address;
        root.show-dialog = true;
    }

    // The address saves on Enter, when it loses focus, or here
    function close() {
        if root.edit-address != root.address {
            root.apply-address(root.edit-address);
        }
        root.show-dialog = false;
    }

    if show-dialog: DialogShell {
        title: "Agents (MCP)";
        subtitle: "AI agents can play stations, search and manage favorites";
        card-width: Defaults.agents-width;
        auto-focus: false;
        close-requested => { root.close(); }

        if !root.available: Text {
            text: "This player serves one agent alone (--standalone). Agents connect to the main player.";
            color: Theme.text-secondary;
            font-size: Theme.font-md;
            wrap: word-wrap;
        }

        // Agents on this computer need no setting: whoever runs them can
        // use the player anyway
        HorizontalLayout {
            spacing: 8px;
            RowLabel { text: "Agent"; }
            AgentPicker {
                apps: root.apps;
                selected <=> root.app;
                changed(index) => { root.app-changed(index); }
            }
        }

        VerticalLayout {
            spacing: 8px;

            Text {
                text: "Agents on this computer connect with radiotrope --mcp.";
                color: Theme.text-secondary;
                font-size: Theme.font-md;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                RowLabel { text: "Command"; }
                CopyLine {
                    text: root.local-command;
                    enabled: root.available;
                }
                if root.local-note != "": VerticalLayout {
                    alignment: center;
                    InfoTip { text: root.local-note; }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        VerticalLayout {
            spacing: 8px;

            VerticalLayout {
                spacing: 2px;

                Toggle {
                    label: "Allow agents over the network";
                    enabled: root.available;
                    checked <=> root.network-on;
                    toggled(on) => { root.network-toggled(on); }
                }
                ToggleNote {
                    text: "Agents on other computers connect with the token.";
                }
            }

            HorizontalLayout {
                spacing: 8px;
                RowLabel { text: "Address"; }
                StyledLineEdit {
                    enabled: root.network-fields;
                    text <=> root.edit-address;
                    placeholder-text: "127.0.0.1:8765";
                    accepted(text) => { root.apply-address(text); }
                    changed has-focus => {
                        if !self.has-focus && root.edit-address != root.address {
                            root.apply-address(root.edit-address);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    InfoTip {
                        text: "127.0.0.1 is this computer only. Use this computer's network address, or 0.0.0.0 for all.";
                    }
                }
            }
            if root.network-on && root.available: Text {
                text: root.status;
                color: root.status-error ? Theme.danger : Theme.text-secondary;
                font-size: Theme.font-md;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                RowLabel { text: "Token"; }
                CopyLine {
                    text: root.token;
                    placeholder: "Made when you allow network agents";
                    enabled: root.network-fields;
                }
                SecondaryButton {
                    label: "Regenerate";
                    enabled: root.network-fields && root.token != "";
                    clicked => { root.regenerate-token(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                RowLabel { text: "Command"; }
                CopyLine {
                    text: root.token != "" ? root.command : "";
                    placeholder: "Ready once there is a token";
                    enabled: root.network-fields;
                }
                if root.network-note != "": VerticalLayout {
                    alignment: center;
                    InfoTip { text: root.network-note; }
                }
            }
        }
    }
}
