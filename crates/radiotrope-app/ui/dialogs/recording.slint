import { Theme } from "../theme.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { AccentButton, SecondaryButton } from "../buttons.slint";
import { DialogShell, Field, Toggle } from "../components.slint";
import { Platform } from "@platform/wifi.slint";

// One option of a Picker
component PickerOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <length> option-width: 56px;
    callback clicked();

    min-width: root.option-width;
    height: 30px;
    border-radius: Theme.radius-sm;
    background: root.selected && root.enabled ? Theme.accent
        : root.selected ? Theme.disabled-bg
        : touch.has-hover ? Theme.menu-hover
        : transparent;
    animate background { duration: Theme.fast; }

    Text {
        text: root.label;
        color: !root.enabled ? Theme.disabled-text
            : root.selected ? Theme.button-text : Theme.text-primary;
        font-size: 13px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

struct PickerChoice {
    id: string,
    label: string,
}

// A row of options, one selected
component Picker inherits HorizontalLayout {
    in property <[PickerChoice]> choices;
    in-out property <string> selected;
    in property <bool> enabled: true;
    in property <length> option-width: 56px;
    callback changed(string);

    alignment: start;

    Rectangle {
        background: Theme.elevated;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.hairline;
        width: row.preferred-width;
        height: row.preferred-height;

        row := HorizontalLayout {
            padding: 3px;
            spacing: 3px;

            for choice in root.choices: PickerOption {
                label: choice.label;
                selected: root.selected == choice.id;
                enabled: root.enabled;
                option-width: root.option-width;
                clicked => {
                    if root.selected != choice.id {
                        root.selected = choice.id;
                        root.changed(choice.id);
                    }
                }
            }
        }
    }
}

// Recording format, folder, and whether recordings include the equalizer
export component RecordingSettingsDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    // The folder in use
    in property <string> folder;
    // The default folder, to offer Restore Default whenever the path differs
    in property <string> default-folder;
    // Problem with the last folder tried, shown under the field
    in property <string> error;
    in-out property <bool> with-eq;
    // The equalizer is on; recording with it only applies then
    in property <bool> eq-on;
    // "mp3", "opus" or "wav"
    in-out property <string> format: "mp3";
    // MP3/Opus bitrate in kbps; 0 is Auto (the station's bitrate)
    in-out property <int> bitrate: 0;

    // The path being edited; reset to `folder` each time the dialog opens
    in-out property <string> edit-path;

    callback browse();
    callback apply-folder(string);
    callback restore-default();
    callback open-folder();
    callback with-eq-toggled(bool);
    callback format-changed(string);
    callback bitrate-changed(int);

    property <bool> edited: root.edit-path != root.folder;

    public function open() {
        root.edit-path = root.folder;
        root.show-dialog = true;
    }

    function close() {
        root.show-dialog = false;
    }

    if show-dialog: DialogShell {
        title: "Recording Settings";
        subtitle: "How and where recordings are saved";
        card-width: 480px;
        auto-focus: false;
        close-requested => { root.close(); }

        // Format and bitrate share a row to keep the dialog short
        HorizontalLayout {
            spacing: 20px;
            alignment: start;

            Field {
                label: "Format";
                Picker {
                    choices: [
                        { id: "mp3", label: "MP3" },
                        { id: "opus", label: "Opus" },
                        { id: "wav", label: "WAV" },
                    ];
                    selected: root.format;
                    changed(id) => {
                        root.format = id;
                        root.format-changed(id);
                    }
                }
            }

            Field {
                label: "Bitrate";
                Picker {
                    choices: [
                        { id: "0", label: "Auto" },
                        { id: "96", label: "96" },
                        { id: "128", label: "128" },
                        { id: "192", label: "192" },
                        { id: "256", label: "256" },
                    ];
                    // WAV is uncompressed, so it has no bitrate to pick
                    enabled: root.format != "wav";
                    option-width: 42px;
                    selected: root.bitrate;
                    changed(id) => {
                        root.bitrate = id.to-float();
                        root.bitrate-changed(root.bitrate);
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        Field {
            label: root.edit-path == root.default-folder ? "Folder (default)" : "Folder";
            StyledLineEdit {
                text <=> root.edit-path;
                placeholder-text: "Folder for recordings";
                accepted(path) => { root.apply-folder(path); }
            }
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.danger;
            font-size: 12px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            if Platform.has-file-manager: SecondaryButton {
                label: "Browse...";
                clicked => { root.browse(); }
            }
            if root.edit-path != root.default-folder || root.folder != root.default-folder: SecondaryButton {
                label: "Restore Default";
                clicked => {
                    root.edit-path = root.default-folder;
                    root.restore-default();
                }
            }
            if Platform.has-file-manager: SecondaryButton {
                label: "Open Folder";
                clicked => { root.open-folder(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        VerticalLayout {
            spacing: 2px;

            Toggle {
                label: "Apply equalizer to recording";
                enabled: root.eq-on;
                checked <=> root.with-eq;
                toggled(on) => { root.with-eq-toggled(on); }
            }
            // Lines up with the label (36px switch + 8px gap)
            HorizontalLayout {
                padding-left: 44px;

                Text {
                    text: root.eq-on
                        ? "Record audio with your current equalizer settings."
                        : "Turn on the equalizer to use this.";
                    color: Theme.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            if root.edited: SecondaryButton {
                label: "Cancel";
                clicked => { root.close(); }
            }
            // Closing is the X in the header; Save waits for a change
            AccentButton {
                label: "Save";
                enabled: root.edited;
                clicked => { root.apply-folder(root.edit-path); }
            }
        }
    }
}
