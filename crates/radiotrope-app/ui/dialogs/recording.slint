import { Theme, Defaults } from "../defaults.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { SecondaryButton } from "../buttons.slint";
import { DialogShell, Field, Toggle, Dropdown, Picker } from "../components.slint";
import { Platform } from "@platform/wifi.slint";

// Recording format, folder, and whether recordings include the equalizer
export component RecordingSettingsDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    // The folder in use
    in property <string> folder;
    // The default folder, to offer Restore Default whenever the path differs
    in property <string> default-folder;
    // Problem with the last folder tried, shown under the field
    in property <string> error;
    in-out property <bool> with-eq;
    // The equalizer is on; recording with it only applies then
    in property <bool> eq-on;
    // "mp3", "opus" or "wav"
    in-out property <string> format: "mp3";
    // MP3/Opus bitrate in kbps; 0 is Auto (the station's bitrate)
    in-out property <int> bitrate: 0;

    // The path being edited; reset to `folder` each time the dialog opens.
    // Browse, Restore Default and a typed path all save straight away
    in-out property <string> edit-path;

    callback browse();
    callback apply-folder(string);
    callback restore-default();
    callback open-folder();
    callback with-eq-toggled(bool);
    callback format-changed(string);
    callback bitrate-changed(int);

    property <bool> edited: root.edit-path != root.folder;
    // The Bitrate list's values, Auto first, and where the saved one sits
    property <[int]> bitrates: [0, 96, 128, 192, 256, 320];
    property <int> bitrate-index: root.bitrate == 96 ? 1
        : root.bitrate == 128 ? 2
        : root.bitrate == 192 ? 3
        : root.bitrate == 256 ? 4
        : root.bitrate == 320 ? 5
        : 0;

    public function open() {
        root.edit-path = root.folder;
        root.show-dialog = true;
    }

    // Every setting saves as it changes; a typed folder saves on Enter,
    // when the field loses focus, or here when the dialog closes
    function close() {
        if root.edited {
            root.apply-folder(root.edit-path);
        }
        root.show-dialog = false;
    }

    if show-dialog: DialogShell {
        title: "Recording Settings";
        subtitle: "Changes are saved as you make them";
        card-width: Defaults.recording-width;
        close-requested => { root.close(); }

        // Format and bitrate share a row to keep the dialog short
        HorizontalLayout {
            spacing: 20px;
            alignment: start;

            Field {
                label: "Format";
                Picker {
                    choices: [
                        { id: "mp3", label: "MP3" },
                        { id: "opus", label: "Opus" },
                        { id: "wav", label: "WAV" },
                    ];
                    selected: root.format;
                    changed(id) => {
                        root.format = id;
                        root.format-changed(id);
                    }
                }
            }

            Field {
                label: "Bitrate";
                Dropdown {
                    width: 120px;
                    // As tall as the Format picker beside it
                    height: 36px;
                    horizontal-stretch: 0;
                    items: ["Auto", "96 kbps", "128 kbps", "192 kbps", "256 kbps", "320 kbps"];
                    selected: root.bitrate-index;
                    // WAV is uncompressed, so it has no bitrate to pick
                    enabled: root.format != "wav";
                    changed(index) => {
                        root.bitrate = root.bitrates[index];
                        root.bitrate-changed(root.bitrate);
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        Field {
            label: root.edit-path == root.default-folder ? "Folder (default)" : "Folder";
            StyledLineEdit {
                text <=> root.edit-path;
                placeholder-text: "Folder for recordings";
                accepted(path) => { root.apply-folder(path); }
                changed has-focus => {
                    if !self.has-focus && root.edited {
                        root.apply-folder(root.edit-path);
                    }
                }
            }
        }

        if root.error != "": Text {
            text: root.error;
            color: Theme.danger;
            font-size: Theme.font-md;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            if Platform.has-file-manager: SecondaryButton {
                label: "Browse...";
                clicked => { root.browse(); }
            }
            SecondaryButton {
                label: "Restore Default";
                enabled: root.edit-path != root.default-folder || root.folder != root.default-folder;
                clicked => {
                    root.edit-path = root.default-folder;
                    root.restore-default();
                }
            }
            if Platform.has-file-manager: SecondaryButton {
                label: "Open Folder";
                clicked => { root.open-folder(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        VerticalLayout {
            spacing: 2px;

            Toggle {
                label: "Apply equalizer to recording";
                enabled: root.eq-on;
                checked <=> root.with-eq;
                toggled(on) => { root.with-eq-toggled(on); }
            }
            // Lines up with the label (36px switch + 8px gap)
            HorizontalLayout {
                padding-left: 44px;

                Text {
                    text: root.eq-on
                        ? "Record audio with your current equalizer settings."
                        : "Turn on the equalizer to use this.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-md;
                    wrap: word-wrap;
                }
            }
        }
    }
}
