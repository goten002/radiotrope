import { Theme } from "../theme.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { AccentButton, SecondaryButton } from "../buttons.slint";
import { ScrollBar } from "../scroll-bar.slint";

export struct BrowseStation {
    name: string,
    url: string,
    logo-url: string,
    country: string,
    codec: string,
    bitrate: int,
    // Provider's station ID, used to recognize favorites with a different URL
    provider-id: string,
}

component StationRow inherits Rectangle {
    in property <string> name;
    in property <string> country;
    in property <string> codec;
    in property <int> bitrate;
    in property <image> logo-image;
    in property <bool> has-logo;
    callback clicked();

    height: 52px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.menu-hover : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: stretch;

        // Station logo
        VerticalLayout {
            alignment: center;
            width: 32px;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 4px;
                clip: true;

                if root.has-logo: Image {
                    source: root.logo-image;
                    width: 32px;
                    height: 32px;
                    image-fit: contain;
                }

                if !root.has-logo: Image {
                    source: @image-url("../icons/music-note.svg");
                    width: 16px;
                    height: 16px;
                    colorize: Theme.text-secondary;
                }
            }
        }

        // Station name + country
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.name;
                color: Theme.text-primary;
                font-size: 13px;
                overflow: elide;
            }

            Text {
                text: root.country;
                color: Theme.text-secondary;
                font-size: 11px;
                overflow: elide;
            }
        }

        // Codec badge
        VerticalLayout {
            alignment: center;
            width: 40px;

            Text {
                text: root.codec;
                color: Theme.text-secondary;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }

        // Bitrate
        VerticalLayout {
            alignment: center;
            width: 60px;

            Text {
                text: root.bitrate > 0 ? "\{root.bitrate} kbps" : "";
                color: Theme.text-secondary;
                font-size: 11px;
                horizontal-alignment: right;
            }
        }

    }
}

export component StationBrowserDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <string> search-mode: "search";
    in-out property <bool> search-loading: false;
    in-out property <bool> search-loading-more: false;
    in-out property <string> search-error: "";
    in-out property <[BrowseStation]> search-results: [];
    in-out property <[image]> browse-logos: [];
    in-out property <bool> has-more: false;
    in-out property <string> country-name: "";
    // ISO 3166-1 code of the country, empty if unknown
    in-out property <string> country-code: "";
    in-out property <image> country-flag;
    property <string> search-query: "";
    // Query of the results on screen; empty means the default list
    property <string> shown-query: "";

    // Search by name; an empty query loads the top stations
    callback search-stations(string);
    // Search by name within a country (name, code, query); an empty query
    // lists the country's stations
    callback search-in-country(string, string, string);
    callback load-more();
    callback station-selected(BrowseStation);

    // Forget the typed query, for when the dialog opens in a new mode
    public function reset-query() {
        root.search-query = "";
        root.shown-query = "";
    }

    function run-search() {
        root.shown-query = root.search-query;
        root.search-loading = true;
        if root.search-mode == "country" {
            root.search-in-country(root.country-name, root.country-code, root.search-query);
        } else {
            root.search-stations(root.search-query);
        }
    }

    if show-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000aa;

        TouchArea {
            clicked => {
                root.show-dialog = false;
            }
        }

        // Dialog card — scales with window, with min/max constraints
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(max(parent.width - 80px, 420px), 700px);
            height: min(max(parent.height - 80px, 360px), 640px);
            background: Theme.panel;
            border-radius: 8px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000080;

            TouchArea {}

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                // Header row: title left, "radio-browser.info" right
                HorizontalLayout {
                    height: 28px;
                    spacing: 8px;

                    if root.search-mode == "country" && root.country-flag.width > 0: Image {
                        source: root.country-flag;
                        width: 24px;
                        height: 18px;
                        image-fit: contain;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: root.search-mode == "country"
                            ? "Stations in \{root.country-name}"
                            : "Search Radio Stations";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: "radio-browser.info";
                        color: Theme.text-secondary;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }

                // Search input
                HorizontalLayout {
                    spacing: 8px;
                    height: 36px;

                    search-input := StyledLineEdit {
                        horizontal-stretch: 1;
                        clearable: true;
                        placeholder-text: root.search-mode == "country"
                            ? "Search stations in \{root.country-name}..."
                            : "Search by station name...";
                        text <=> root.search-query;
                        accepted(query) => {
                            if root.search-query != "" || root.shown-query != "" {
                                root.run-search();
                            }
                        }
                        // Emptying the box (backspace or ✕) brings back the default list
                        edited(query) => {
                            if query == "" && root.shown-query != "" {
                                root.run-search();
                            }
                        }
                        cleared => {
                            if root.shown-query != "" {
                                root.run-search();
                            }
                        }
                    }

                    AccentButton {
                        label: "Search";
                        enabled: root.search-query != "";
                        clicked => {
                            if root.search-query != "" {
                                root.run-search();
                            }
                        }
                    }
                }

                // Results area
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    border-radius: 4px;
                    background: Theme.surface;

                    // Loading state
                    if root.search-loading && root.search-results.length == 0: Text {
                        text: "Loading...";
                        color: Theme.text-secondary;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Error state
                    if root.search-error != "" && !root.search-loading: Text {
                        text: root.search-error;
                        color: #e05555;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Empty state
                    if root.search-results.length == 0
                        && !root.search-loading && root.search-error == "": Text {
                        text: root.search-mode == "country"
                            ? "No stations found in \{root.country-name}"
                            : "No stations found";
                        color: Theme.text-secondary;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Results list
                    if root.search-results.length > 0: Rectangle {
                        results-flick := Flickable {
                            content-height: results-layout.preferred-height;

                            results-layout := VerticalLayout {
                                padding: 4px;

                                for station[idx] in root.search-results: StationRow {
                                    name: station.name;
                                    country: station.country;
                                    codec: station.codec;
                                    bitrate: station.bitrate;
                                    logo-image: idx < root.browse-logos.length ? root.browse-logos[idx] : @image-url("");
                                    has-logo: idx < root.browse-logos.length
                                        ? root.browse-logos[idx].width > 0
                                        : false;
                                    clicked => { root.station-selected(station); }
                                }

                                // Load More button
                                if root.has-more: Rectangle {
                                    height: 44px;
                                    border-radius: 4px;
                                    background: load-more-touch.has-hover && !root.search-loading-more
                                        ? Theme.menu-hover : transparent;

                                    load-more-touch := TouchArea {
                                        enabled: !root.search-loading-more;
                                        clicked => {
                                            root.search-loading-more = true;
                                            root.load-more();
                                        }
                                        mouse-cursor: root.search-loading-more ? default : pointer;
                                    }

                                    Text {
                                        text: root.search-loading-more ? "Loading..." : "Load More Stations";
                                        color: root.search-loading-more ? Theme.text-secondary : Theme.accent;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        ScrollBar {
                            x: parent.width - self.width - 2px;
                            y: 4px;
                            height: parent.height - 8px;
                            viewport-height: results-flick.height;
                            content-height: results-flick.content-height;
                            content-y <=> results-flick.content-y;
                        }
                    }
                }

                // Footer
                HorizontalLayout {
                    height: 32px;
                    alignment: stretch;

                    Text {
                        text: root.search-results.length > 0
                            ? "\{root.search-results.length} stations"
                            : "";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    SecondaryButton {
                        label: "Close";
                        clicked => { root.show-dialog = false; }
                    }
                }
            }
        }
    }
}
