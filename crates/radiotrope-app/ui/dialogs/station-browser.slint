import { DesktopShortcuts, ShortcutAction } from "../shortcuts.slint";
import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, Icon, IconButton, ButtonKeys, FocusRing, Motion, PopupCard, StatusPanel, ChipVariant, ChoiceRow } from "../components.slint";
import { StationState, StationRowSurface, StationLogo, StationStateMark } from "../station-row.slint";
import { KeyListCursor } from "../key-list.slint";
import { FilterDropdown, FilterEntry } from "../filter-dropdown.slint";
import { RecordingGuard, StationStream } from "../favorites.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { AccentButton, SecondaryButton } from "../buttons.slint";
import { ScrollBar } from "../scroll-bar.slint";

export struct BrowseStation {
    name: string,
    url: string,
    logo-url: string,
    country: string,
    // The genres' names, joined ("Jazz, Blues")
    genres: string,
    codec: string,
    bitrate: int,
    // Every stream of the station, in the directory's order. `url`, `codec`
    // and `bitrate` are those of the one the row plays: the first, or the
    // one picked from the row's stream menu.
    streams: [StationStream],
    // Provider's station ID, used to recognize favorites with a different URL
    provider-id: string,
    // Already in favorites (set from Rust, kept up to date)
    is-favorite: bool,
}

// One search result, built from the same parts as a favorites row. Not a
// Tab stop: the list has one, which stands for the active row.
component StationRow inherits Rectangle {
    in property <string> name;
    // Where it is and what it plays: "United Kingdom · Jazz, Blues"
    in property <string> detail;
    in property <string> codec;
    in property <int> bitrate;
    in property <image> logo-image;
    in property <bool> has-logo;
    // What the player is doing with this station
    in property <StationState> state;
    // Status line shown instead of the detail while loading or failed
    in property <string> status;
    in property <bool> is-favorite;
    // The keyboard's row, while the list has the focus
    in property <bool> key-active;
    // Picked once while recording: the next pick switches to it
    in property <bool> armed;
    // The row in one sentence, for screen readers
    in property <string> description;
    in property <int> row-index;
    in property <int> row-count;
    // The station has several streams and one can be picked: the codec
    // and bitrate are a button that opens the list of them
    in property <bool> has-streams;
    // That list is open for this row
    in property <bool> streams-open;
    callback clicked();
    callback favorite-clicked();
    callback streams-clicked();

    height: Theme.row-media;

    accessible-role: list-item;
    accessible-label: root.name;
    accessible-description: root.description;
    accessible-item-index: root.row-index;
    accessible-item-count: root.row-count;
    accessible-item-selectable: true;
    accessible-item-selected: root.state != StationState.none;
    accessible-action-default => { root.clicked(); }

    // As in Favorites: the active row (playing, connecting or failed) has a
    // tint and a rail; a failure shows in the mark and the status line
    surface := StationRowSurface {
        current: root.state != StationState.none;
        failed: root.state == StationState.failed;
        highlighted: touch.has-hover || root.key-active;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: Theme.space-12;
        padding-right: Theme.space-12;
        spacing: Theme.space-8;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            width: 40px;

            StationLogo {
                logo: root.logo-image;
                has-logo: root.has-logo;
            }
        }

        // Station name + country and genres
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.space-2;

            HorizontalLayout {
                spacing: Theme.space-8;

                Text {
                    horizontal-stretch: 0;
                    text: root.name;
                    color: surface.name-color;
                    font-size: Theme.font-base;
                    font-weight: Theme.weight-semibold;
                    overflow: elide;
                    // The row says it all in one description
                    accessible-role: none;
                }

                if root.state != StationState.none: StationStateMark {
                    state: root.state;
                }

                Rectangle { horizontal-stretch: 1; }
            }

            Text {
                text: root.armed ? RecordingGuard.text
                    : (root.state == StationState.loading || root.state == StationState.failed) && root.status != ""
                    ? root.status : root.detail;
                color: root.armed || root.state == StationState.failed ? Theme.danger-text : Theme.text-secondary;
                font-size: Theme.font-sm;
                font-weight: root.armed ? Theme.weight-semibold : Theme.weight-regular;
                overflow: elide;
                accessible-role: none;
            }
        }

        // Codec and bitrate of the stream the row plays. With several
        // streams they are a button that lists them, to play another.
        Rectangle {
            width: 152px;

            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 30px;
                border-radius: Theme.radius-sm;
                background: !root.has-streams ? transparent
                    : streams-touch.pressed ? Theme.pressed-bg
                    : streams-touch.has-hover || root.streams-open ? Theme.hover-bg : transparent;
                animate background { duration: Theme.fast; }

                // The button, for screen readers (a role can't depend on
                // a property)
                if root.has-streams: Rectangle {
                    accessible-role: button;
                    accessible-label: "Streams";
                    accessible-action-default => { root.streams-clicked(); }
                }

                // Without several streams the click is the row's
                streams-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if root.has-streams {
                            root.streams-clicked();
                        } else {
                            root.clicked();
                        }
                    }
                }
            }

            HorizontalLayout {
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                spacing: Theme.space-8;

                // Codec badge, sized to its text
                VerticalLayout {
                    alignment: center;
                    width: 64px;

                    if root.codec != "": HorizontalLayout {
                        alignment: end;

                        Rectangle {
                            width: min(64px, codec-text.preferred-width + 12px);
                            height: 18px;
                            border-radius: Theme.radius-sm;
                            background: Theme.elevated;
                            border-width: 1px;
                            border-color: Theme.hairline;

                            codec-text := Text {
                                x: 6px;
                                width: parent.width - 12px;
                                text: root.codec;
                                color: Theme.text-secondary;
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-semibold;
                                horizontal-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                        }
                    }
                }

                // Bitrate
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: root.bitrate > 0 ? "\{root.bitrate} kbps" : "";
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                        horizontal-alignment: right;
                        accessible-role: none;
                    }
                }

                // More streams to pick from
                VerticalLayout {
                    alignment: center;
                    width: Theme.icon-sm;

                    if root.has-streams: Icon {
                        width: Theme.icon-sm;
                        height: Theme.icon-sm;
                        source: @image-url("../icons/chevron-down.svg");
                        colorize: streams-touch.has-hover || root.streams-open
                            ? Theme.text-primary : Theme.text-secondary;
                    }
                }
            }
        }

        // Add to or remove from favorites without playing; last, like
        // row actions elsewhere, so the details line up to its left. For
        // the pointer: on the keyboard the list's favorite key does it.
        VerticalLayout {
            alignment: center;
            width: 30px;

            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: star-touch.pressed ? Theme.pressed-bg
                    : star-touch.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: Theme.fast; }

                accessible-role: button;
                accessible-label: root.is-favorite ? "Remove from Favorites" : "Add to Favorites";
                accessible-action-default => { root.favorite-clicked(); }

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: Theme.icon-md;
                    height: Theme.icon-md;
                    source: root.is-favorite ? @image-url("../icons/star.svg")
                        : @image-url("../icons/star-regular.svg");
                    colorize: root.is-favorite ? Theme.accent-graphic
                        : star-touch.has-hover ? Theme.text-primary : surface.faint-color;
                }

                star-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.favorite-clicked(); }
                }
            }
        }
    }
}

// Shows or hides the filters under the search box: a square button beside
// it, held down while they show, with a dot once a filter is set. Resting
// the pointer on it (or reaching it with Tab) names it in a bubble.
component FilterToggle inherits Rectangle {
    // The filters show
    in property <bool> shown;
    // A filter is set
    in property <bool> filtered;
    // The filters set, for the bubble and screen readers: "United Kingdom, Jazz"
    in property <string> summary;
    out property <bool> has-focus: keys.has-focus;
    callback clicked();

    property <bool> bubble-ready;

    width: Theme.control-field;
    height: Theme.control-field;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.shown ? Theme.accent-graphic : Theme.field-border;
    background: touch.pressed ? Theme.pressed-bg
        : touch.has-hover ? Theme.hover-bg
        : root.shown ? Theme.accent-tint : Theme.elevated;
    animate background, border-color { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: button;
    accessible-label: "Filters";
    accessible-description: root.filtered ? root.summary : "";
    accessible-checkable: true;
    accessible-checked: root.shown;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.bubble-ready = false;
            root.clicked();
        }
        changed has-hover => {
            if !self.has-hover {
                root.bubble-ready = false;
            }
        }
    }

    Timer {
        interval: Defaults.hover-delay;
        running: touch.has-hover && !root.bubble-ready;
        triggered => { root.bubble-ready = true; }
    }

    keys := ButtonKeys {
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.icon-md;
        height: Theme.icon-md;
        source: @image-url("../icons/filter.svg");
        colorize: root.shown || root.filtered ? Theme.accent-graphic
            : touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        animate colorize { duration: Theme.fast; }
    }

    // A filter is set: a dot on the corner, ringed so it reads on the edge
    if root.filtered: Rectangle {
        x: parent.width - self.width + 3px;
        y: -3px;
        width: 10px;
        height: 10px;
        border-radius: self.height / 2;
        background: Theme.accent-graphic;
        border-width: 1.5px;
        border-color: Theme.card;
    }

    PopupCard {
        property <bool> wanted: (touch.has-hover && root.bubble-ready) || keys.has-focus;
        visible: self.opacity > 0;
        opacity: self.wanted ? 1 : 0;
        // Beside the button, over the end of the search field: the rows
        // under this one are drawn after it, and would cover a bubble below
        x: -self.width - Theme.space-6;
        y: (root.height - self.height) / 2;
        width: bubble-text.preferred-width + 2 * Theme.space-8;
        height: Theme.row-menu;
        // The button says it
        accessible-role: none;

        bubble-text := Text {
            text: root.filtered ? "Filters: \{root.summary}" : "Filters";
            color: Theme.text-primary;
            font-size: Theme.font-md;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// The quiet action of the Undo offer, as under the favorites list: accent
// text, underlined while hovered or focused
component TextButton inherits Rectangle {
    in property <string> label;
    out property <bool> has-focus: keys.has-focus;
    callback clicked();

    height: Theme.row-menu;
    width: text.preferred-width + 2 * Theme.space-8;
    border-radius: Theme.radius-sm;
    forward-focus: keys;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    text := Text {
        text: root.label;
        color: Theme.accent-text;
        font-size: Theme.font-base;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    if touch.has-hover || keys.has-focus: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height + text.preferred-height) / 2 - 1px;
        width: text.preferred-width;
        height: 1px;
        background: Theme.accent-text;
    }

    keys := ButtonKeys {
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

export component StationBrowserDialog inherits Rectangle {
    // Opens a filter's list (the snapshot tool)
    in property <string> snapshot-overlay;
    in-out property <bool> show-dialog: false;
    in-out property <bool> search-loading: false;
    in-out property <bool> search-loading-more: false;
    in-out property <string> search-error: "";
    // Seconds until a failed request is tried again on its own
    in-out property <int> retry-in: 0;
    // The first page's Try Again has the focus
    property <bool> retry-focused;
    in-out property <[BrowseStation]> search-results: [];
    in-out property <[image]> browse-logos: [];
    in-out property <bool> has-more: false;
    // The filters in force, each a name to show and the code the directory
    // is asked for (empty: any)
    in-out property <string> country-name: "";
    // ISO 3166-1 code
    in-out property <string> country-code: "";
    in-out property <image> country-flag;
    in-out property <string> genre-name: "";
    // The directory's slug
    in-out property <string> genre-code: "";
    property <bool> filtered: root.country-code != "" || root.genre-code != "";
    // The filters set, by name: "United Kingdom, Jazz"
    property <string> filter-summary: root.join(root.country-name, root.genre-name);
    // The filters show under the search box (the button beside it)
    in-out property <bool> filters-shown: false;
    // The filter list opened last ("country" or "genre"): its rows that
    // match the typed text, and whether they are loading or failed. One
    // list is open at a time, so both filters use these.
    in-out property <string> filter-kind: "";
    in-out property <[FilterEntry]> filter-entries: [];
    in-out property <string> filter-text: "";
    in-out property <bool> filter-loading: false;
    in-out property <string> filter-error: "";
    // A favorite was just removed: its Undo is offered here too
    in property <bool> can-undo;
    callback undo-requested();
    callback undo-dismissed();
    // The Undo offer has the focus
    property <bool> undo-focused;
    // Current playback, so the row of the station being played shows its
    // state even while the dialog hides the player
    in property <string> playing-url;
    in property <bool> is-playing;
    in property <bool> play-loading;
    in property <bool> play-error;
    in property <string> play-status;
    // A recording is running: picking another station would end it, so
    // the first pick only arms the row (see RecordingGuard)
    in property <bool> recording;
    property <string> armed: "";
    changed recording => {
        if !self.recording {
            self.armed = "";
        }
        // Another stream would end the recording like another station
        self.streams-row = -1;
    }
    // The row whose list of streams is open (-1: none), and the list's
    // row under the arrow keys
    property <int> streams-row: -1;
    property <int> streams-active: -1;

    function open-streams(row: int) {
        if root.recording || row < 0 || root.search-results[row].streams.length < 2 {
            return;
        }
        root.active-row = row;
        root.streams-active = -1;
        root.streams-row = row;
    }

    function close-streams() {
        root.streams-row = -1;
        // The keys go back to the list
        root.focus-list-request += 1;
    }

    // Play the row with another of its streams
    function pick-stream(stream: int) {
        let row = root.streams-row;
        root.close-streams();
        root.stream-picked(row, stream);
        root.pick(root.search-results[row]);
    }
    // Row picked last (provider ID or URL); the played URL may differ
    // after resolving a playlist or matching a favorite
    property <string> picked: "";
    // The keyboard's row in the results (-1: none yet), whether the list
    // has the focus, and requests to give it or the search field the focus
    property <int> active-row: -1;
    property <bool> list-focused;
    property <int> focus-list-request;
    property <int> focus-search-request;
    changed show-dialog => {
        if !self.show-dialog {
            root.streams-row = -1;
            root.picked = "";
            root.armed = "";
            root.undo-focused = false;
            root.closed();
        }
    }
    in-out property <string> search-query: "";
    // Query of the results on screen; empty means the default list
    in-out property <string> shown-query: "";
    // How far the list is scrolled (kept while the dialog is closed)
    in-out property <length> list-scroll: 0;
    // The rows on screen: first row and how many, for loading their logos
    out property <int> visible-first;
    out property <int> visible-count;
    callback visible-rows-changed();
    // The dialog closed: its logos can be let go
    callback closed();

    function show-rows(first: int, count: int) {
        root.visible-first = first;
        root.visible-count = count;
        root.visible-rows-changed();
    }

    // Search by name within the filters (query, country code, genre slug);
    // with nothing given, the most played stations
    callback search-stations(string, string, string);
    // A filter's list opens: fill it with the countries or genres
    // ("country", "genre")
    callback load-filter-entries(string);
    // Show only the entries of the open list that match the text
    callback filter-filter-entries(string);
    callback load-more();
    // Try the failed request again (the first page, or the next one)
    callback retry();
    callback station-selected(BrowseStation);
    callback favorite-toggled(BrowseStation);
    // Another stream was picked for the result at this row (row, index in
    // its streams): the row plays that one from now on. It is played next.
    callback stream-picked(int, int);

    // Ask for the next page, unless it is on its way or has failed (then
    // the countdown or Try Again fetches it)
    function fetch-more() {
        if root.has-more && !root.search-loading-more && root.search-error == "" {
            root.search-loading-more = true;
            root.load-more();
        }
    }

    pure function key-of(station: BrowseStation) -> string {
        return station.provider-id != "" ? station.provider-id : station.url;
    }

    // The station the player has now (the row picked here, or before any
    // pick the one whose URL is loaded)
    pure function is-current(station: BrowseStation) -> bool {
        return root.picked != "" ? root.picked == root.key-of(station) : station.url == root.playing-url;
    }

    function pick(station: BrowseStation) {
        // While recording, a first pick of another station only arms its
        // row; the same pick again in time switches (and ends the recording)
        if root.recording && !root.is-current(station) && root.armed != root.key-of(station) {
            root.armed = root.key-of(station);
            arm-timer.running = true;
            arm-timer.restart();
            return;
        }
        root.armed = "";
        arm-timer.running = false;
        root.picked = root.key-of(station);
        root.station-selected(station);
    }

    arm-timer := Timer {
        interval: RecordingGuard.confirm-time;
        running: false;
        triggered => {
            self.running = false;
            root.armed = "";
        }
    }

    // The row clicked here; before any click, the row whose URL is playing
    pure function state-of(station: BrowseStation) -> StationState {
        return !root.is-current(station) ? StationState.none
            : root.play-error ? StationState.failed
            : root.play-loading ? StationState.loading
            : root.is-playing ? StationState.playing : StationState.none;
    }

    pure function join(a: string, b: string) -> string {
        return a == "" ? b : b == "" ? a : "\{a}, \{b}";
    }

    // Two parts of a status line
    pure function dot(a: string, b: string) -> string {
        return a == "" ? b : b == "" ? a : "\{a} · \{b}";
    }

    function open-filter(kind: string) {
        root.filter-kind = kind;
        root.filter-text = "";
        root.load-filter-entries(kind);
    }

    function reset-filters() {
        root.country-name = "";
        root.country-code = "";
        root.genre-name = "";
        root.genre-code = "";
        root.run-search();
    }

    // The snapshot tool's states of the dialog
    public function stage(detail: string) {
        root.search-query = detail == "empty" ? "no such station" : "jazz";
        if detail == "filtered" || detail == "filtered-shown" || detail == "next-loading"
            || detail == "next-error" {
            root.country-code = "GB";
            root.country-name = "United Kingdom";
            root.genre-code = "jazz";
            root.genre-name = "Jazz";
        }
        root.filters-shown = detail == "filters" || detail == "filtered-shown"
            || detail == "filter-country" || detail == "filter-genre" || detail == "filter-keys"
            || detail == "filter-loading" || detail == "filter-error" || detail == "filter-no-match";
        root.show-dialog = true;
        if detail == "streams" {
            root.open-streams(0);
        }
    }

    // A result in one sentence for screen readers: its status or country,
    // the genres, the codec, the bitrate, and whether it is a favorite
    pure function describe(station: BrowseStation, state: StationState) -> string {
        return root.join(root.join(root.join(root.join(root.join(root.join(
            root.armed != "" && root.armed == root.key-of(station) ? RecordingGuard.spoken : "",
            (state == StationState.loading || state == StationState.failed) && root.play-status != ""
                ? root.play-status
                : state == StationState.playing ? root.join("Playing", station.country) : station.country),
            station.genres),
            station.codec),
            station.bitrate > 0 ? "\{station.bitrate} kbps" : ""),
            station.streams.length > 1 ? "\{station.streams.length} streams" : ""),
            station.is-favorite ? "in favorites" : "");
    }

    function take-undo() {
        root.undo-requested();
    }

    // Search again with the query on screen, for a filter just changed
    public function run-search() {
        // The list goes away while it loads: if it had the focus, the
        // search field takes it, so Esc still closes the dialog
        if root.list-focused {
            root.focus-search-request += 1;
        }
        root.active-row = -1;
        root.shown-query = root.search-query;
        root.list-scroll = 0;
        root.search-loading = true;
        root.search-stations(root.search-query, root.country-code, root.genre-code);
    }

    if show-dialog: shell := DialogShell {
        title: "Search Stations";
        subtitle: "From the Radiotrope station directory";
        card-width: Defaults.station-browser-width;
        card-height: Defaults.station-browser-height;
        auto-focus: false;
        close-requested => { root.show-dialog = false; }
        capture-key(event) => {
            if DesktopShortcuts.enabled && DesktopShortcuts.match-key(event) == ShortcutAction.search {
                search-input.focus-input();
                return accept;
            }
            // While the Undo of a favorite just removed is offered, its
            // shortcut takes it (the offer is on screen, so it is what the
            // key means, also in the search box)
            if root.can-undo && DesktopShortcuts.enabled
                && DesktopShortcuts.match-key(event) == ShortcutAction.undo-remove {
                root.take-undo();
                return accept;
            }
            // Down from the search field goes into the results
            if event.text == Key.DownArrow && search-input.has-focus && root.search-results.length > 0
                && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                root.focus-list-request += 1;
                return accept;
            }
            return reject;
        }

        // Search input: the field, the filters' button and Search share
        // one height
        HorizontalLayout {
            spacing: Theme.space-8;
            height: Theme.control-field;

            search-input := StyledLineEdit {
                horizontal-stretch: 1;
                clearable: true;
                init => { self.focus-input(); }
                property <int> focus-request: root.focus-search-request;
                changed focus-request => { self.focus-input(); }
                // The Undo offer went away (taken, dismissed or timed out)
                // while it had the focus: keep it in the dialog
                property <bool> undo-offered: root.can-undo;
                changed undo-offered => {
                    if !self.undo-offered && root.undo-focused {
                        root.undo-focused = false;
                        self.focus-input();
                    }
                }
                label: "Search by station name";
                placeholder-text: "Search by station name";
                text <=> root.search-query;
                accepted(query) => {
                    if root.search-query != "" || root.shown-query != "" {
                        root.run-search();
                    }
                }
                // Emptying the box (backspace or ✕) brings back the default list
                edited(query) => {
                    if query == "" && root.shown-query != "" {
                        root.run-search();
                    }
                }
                cleared => {
                    if root.shown-query != "" {
                        root.run-search();
                    }
                }
            }

            filter-toggle := FilterToggle {
                shown: root.filters-shown;
                filtered: root.filtered;
                summary: root.filter-summary;
                clicked => {
                    // The filters go away: if one of them had the focus,
                    // the search field takes it, so Esc still closes the
                    // dialog
                    if root.filters-shown && !self.has-focus && !search-input.has-focus {
                        search-input.focus-input();
                    }
                    root.filters-shown = !root.filters-shown;
                }
            }

            AccentButton {
                label: "Search";
                height: Theme.control-field;
                enabled: root.search-query != "";
                clicked => {
                    if root.search-query != "" {
                        root.run-search();
                    }
                }
            }
        }

        // Filters: country and genre, as tall as the search field; each
        // opens a list to choose from, narrowed by typing
        if root.filters-shown: HorizontalLayout {
            spacing: Theme.space-8;
            height: Theme.control-field;

            FilterDropdown {
                name: "Country";
                any-label: "Any country";
                plural: "countries";
                list-label: "Countries";
                value: root.country-name;
                selected-code: root.country-code;
                flag: root.country-flag;
                show-flags: true;
                entries: root.filter-entries;
                loading: root.filter-loading;
                error: root.filter-error;
                filter-text <=> root.filter-text;
                popup-bounds: shell.popup-bounds;
                show-popup: root.snapshot-overlay == "filter-country" || root.snapshot-overlay == "filter-keys"
                    || root.snapshot-overlay == "filter-loading" || root.snapshot-overlay == "filter-error"
                    || root.snapshot-overlay == "filter-no-match";
                opening => { root.open-filter("country"); }
                filter-entries(text) => { root.filter-filter-entries(text); }
                retry => { root.load-filter-entries("country"); }
                picked(entry) => {
                    root.country-name = entry.name;
                    root.country-code = entry.code;
                    root.country-flag = entry.flag;
                    root.run-search();
                }
                cleared => {
                    root.country-name = "";
                    root.country-code = "";
                    root.run-search();
                }
            }

            FilterDropdown {
                name: "Genre";
                any-label: "Any genre";
                plural: "genres";
                list-label: "Genres";
                value: root.genre-name;
                selected-code: root.genre-code;
                entries: root.filter-entries;
                loading: root.filter-loading;
                error: root.filter-error;
                filter-text <=> root.filter-text;
                popup-bounds: shell.popup-bounds;
                show-popup: root.snapshot-overlay == "filter-genre";
                opening => { root.open-filter("genre"); }
                filter-entries(text) => { root.filter-filter-entries(text); }
                retry => { root.load-filter-entries("genre"); }
                picked(entry) => {
                    root.genre-name = entry.name;
                    root.genre-code = entry.code;
                    root.run-search();
                }
                cleared => {
                    root.genre-name = "";
                    root.genre-code = "";
                    root.run-search();
                }
            }

            // Greyed out while no filter is set
            SecondaryButton {
                label: "Reset Filters";
                icon: @image-url("../icons/reset.svg");
                height: Theme.control-field;
                enabled: root.filtered;
                clicked => { root.reset-filters(); }
            }
        }

        // Results area: the list, or one status panel for loading, a
        // failed first page and no results
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            border-radius: Theme.radius-sm;
            background: Theme.surface;

            if root.search-loading && root.search-results.length == 0: StatusPanel {
                width: parent.width;
                height: parent.height;
                busy: true;
                title: "Loading stations…";
            }

            // Counts down to the next try while a request has failed.
            // It lives with the dialog, so nothing is retried while closed.
            Timer {
                interval: 1s;
                running: root.search-error != "" && root.retry-in > 0;
                triggered => {
                    root.retry-in -= 1;
                    if root.retry-in == 0 {
                        root.retry();
                        // Try Again goes away while it loads: if it had
                        // the focus, keep it in the dialog so Esc still works
                        if root.retry-focused {
                            root.retry-focused = false;
                            search-input.focus-input();
                        }
                    }
                }
            }

            // Error state: the first page failed. The panel's own button
            // can't report its focus, so Try Again sits under it, in the
            // same SecondaryButton style.
            if root.search-error != "" && !root.search-loading
                && root.search-results.length == 0: VerticalLayout {
                width: parent.width;
                height: parent.height;
                alignment: center;
                padding-bottom: Theme.space-16;

                StatusPanel {
                    padding-bottom: 0;
                    variant: ChipVariant.danger;
                    title: root.search-error;
                    message: root.retry-in > 0 ? "Trying again in \{root.retry-in} s" : "";
                }

                HorizontalLayout {
                    alignment: center;
                    padding-top: Theme.space-8;

                    SecondaryButton {
                        label: "Try Again";
                        changed has-focus => { root.retry-focused = self.has-focus; }
                        clicked => {
                            root.retry-in = 0;
                            root.retry();
                            // The button goes away while it loads: keep the
                            // focus in the dialog so Esc still closes it
                            if self.has-focus {
                                search-input.focus-input();
                            }
                        }
                    }
                }
            }

            // Empty state
            if root.search-results.length == 0
                && !root.search-loading && root.search-error == "": StatusPanel {
                width: parent.width;
                height: parent.height;
                icon: @image-url("../icons/magnifying-glass.svg");
                title: "No stations found";
                message: root.filtered ? "Try removing a filter."
                    : root.shown-query != "" ? "Check the spelling or try another name." : "";
                // The filters may be hidden: the way out is here too
                action-label: root.filtered ? "Reset Filters" : "";
                action => {
                    // The button goes away while it loads: keep the focus
                    // in the dialog so Esc still closes it
                    search-input.focus-input();
                    root.reset-filters();
                }
            }

            // Results list: one Tab stop. The arrows, Page Up / Page Down
            // and Home / End move the active row, Enter or Space plays it
            // and the favorite key stars it; Up on the first row goes back
            // to the search field.
            if root.search-results.length > 0: Rectangle {
                accessible-role: AccessibleRole.list;
                accessible-label: "Stations";

                property <int> focus-request: root.focus-list-request;
                changed focus-request => { cursor.focus(); }

                results-flick := Flickable {
                    content-height: rows.height;
                    content-y <=> root.list-scroll;

                    // Infinite scroll: fetch the next page when the view
                    // comes within about five rows of the end
                    changed content-y => {
                        if self.height - self.content-y > self.content-height - 300px {
                            root.fetch-more();
                        }
                    }

                    // Scroll just far enough to show the row
                    function reveal(index: int) {
                        let top = index * rows.row-height;
                        let shown = -self.content-y;
                        let target = top < shown ? top
                            : top + rows.row-height + 2 * Theme.space-4 > shown + self.height
                                ? top + rows.row-height + 2 * Theme.space-4 - self.height
                            : shown;
                        self.content-y = -clamp(target, 0px, max(0px, self.content-height - self.height));
                    }

                    // Only the rows on screen (and a couple either side)
                    // exist, however long the list; Rust loads the logos
                    // of the rows shown
                    rows := Rectangle {
                        property <length> row-height: Theme.row-media;
                        property <int> first: max(0, floor(-root.list-scroll / self.row-height) - 2);
                        property <int> pool: ceil(results-flick.height / self.row-height) + 4;
                        property <int> count: max(0, min(root.search-results.length - self.first, self.pool));
                        height: root.search-results.length * self.row-height + 2 * Theme.space-4
                            + (root.has-more ? 40px : 0px);
                        init => { root.show-rows(self.first, self.count); }
                        changed first => { root.show-rows(self.first, self.count); }
                        changed count => { root.show-rows(self.first, self.count); }

                        for k in rows.count: StationRow {
                            // Each row keeps its station while it stays on
                            // screen, so hover and highlight don't hop
                            // between rows as the list scrolls
                            property <int> idx: rows.first + mod(k - mod(rows.first, rows.count) + rows.count, rows.count);
                            property <BrowseStation> station: root.search-results[self.idx];
                            x: Theme.space-4;
                            y: Theme.space-4 + self.idx * rows.row-height;
                            width: rows.width - 2 * Theme.space-4;
                            name: station.name;
                            detail: root.dot(station.country, station.genres);
                            codec: station.codec;
                            bitrate: station.bitrate;
                            logo-image: self.idx < root.browse-logos.length ? root.browse-logos[self.idx] : @image-url("");
                            has-logo: self.idx < root.browse-logos.length
                                ? root.browse-logos[self.idx].width > 0
                                : false;
                            state: root.state-of(station);
                            status: root.play-status;
                            is-favorite: station.is-favorite;
                            armed: root.armed != "" && root.armed == root.key-of(station);
                            key-active: cursor.has-focus && root.active-row == self.idx;
                            description: root.describe(station, self.state);
                            row-index: self.idx;
                            row-count: root.search-results.length;
                            has-streams: station.streams.length > 1 && !root.recording;
                            streams-open: root.streams-row == self.idx;
                            favorite-clicked => { root.favorite-toggled(station); }
                            streams-clicked => { root.open-streams(self.idx); }
                            clicked => {
                                root.active-row = self.idx;
                                root.pick(station);
                            }
                        }

                        // Footer while the next page loads
                        if root.has-more && root.search-loading-more: HorizontalLayout {
                            x: 0;
                            y: Theme.space-4 + root.search-results.length * rows.row-height;
                            width: rows.width;
                            height: 40px;
                            alignment: center;
                            spacing: Theme.space-8;

                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: @image-url("../icons/spinner.svg");
                                    width: Theme.icon-sm;
                                    height: Theme.icon-sm;
                                    colorize: Theme.accent-graphic;
                                    rotation: mod(Motion.tick / Theme.spin-period, 1) * 360deg;
                                }
                            }
                            Text {
                                text: "Loading more stations…";
                                color: Theme.text-secondary;
                                font-size: Theme.font-md;
                                vertical-alignment: center;
                            }
                        }

                        // The list's one Tab stop, over the active row
                        cursor := KeyListCursor {
                            property <BrowseStation> station: root.search-results[root.active-row];
                            x: Theme.space-4;
                            y: Theme.space-4 + max(0, root.active-row) * rows.row-height;
                            width: rows.width - 2 * Theme.space-4;
                            height: rows.row-height;
                            count: root.search-results.length;
                            active: root.active-row;
                            // Come in on the first row in view
                            start: ceil(-root.list-scroll / rows.row-height);
                            page: max(1, floor(results-flick.height / rows.row-height) - 1);
                            item-label: self.station.name;
                            item-description: root.describe(self.station, root.state-of(self.station));
                            item-selected: root.state-of(self.station) != StationState.none;
                            ring-radius: Theme.radius-md;
                            changed has-focus => { root.list-focused = self.has-focus; }
                            move-to(index) => {
                                root.active-row = index;
                                results-flick.reveal(index);
                                // The last rows fetch the next page, also
                                // when the list is too short to scroll
                                if index >= root.search-results.length - 5 {
                                    root.fetch-more();
                                }
                            }
                            activated => { root.pick(self.station); }
                            left-at-top => { search-input.focus-input(); }
                            key(event) => {
                                // The window's favorite key stars the active row
                                if self.active >= 0 && !event.modifiers.control && !event.modifiers.alt
                                    && !event.modifiers.meta && (event.text == "f" || event.text == "F"
                                        || (DesktopShortcuts.enabled
                                            && DesktopShortcuts.match-key(event) == ShortcutAction.toggle-favorite)) {
                                    if !event.repeat {
                                        root.favorite-toggled(self.station);
                                    }
                                    return accept;
                                }
                                // The Menu key lists the active row's streams
                                if self.active >= 0 && self.station.streams.length > 1 && !root.recording
                                    && (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                                    root.open-streams(self.active);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }

                ScrollBar {
                    x: parent.width - self.width - Theme.space-2;
                    y: Theme.space-4;
                    height: parent.height - 2 * Theme.space-4;
                    viewport-height: results-flick.height;
                    content-height: results-flick.content-height;
                    content-y <=> results-flick.content-y;
                }
            }

            // The streams of a result, to play another than the one its
            // row shows. Over the list, under the row's codec and bitrate
            // (above them when there is no room below). It takes the keys
            // while open: the arrows, Home and End move, Enter or Space
            // plays, Esc or a click elsewhere closes.
            if root.streams-row >= 0 && root.streams-row < root.search-results.length: Rectangle {
                TouchArea {
                    clicked => { root.close-streams(); }
                    scroll-event(event) => { return accept; }
                }

                PopupCard {
                    property <BrowseStation> station: root.search-results[root.streams-row];
                    property <int> count: self.station.streams.length;
                    // The row's top and bottom edge in the list's view
                    property <length> row-top: Theme.space-4 + root.streams-row * Theme.row-media + root.list-scroll;
                    property <length> below: self.row-top + Theme.row-media - Theme.space-8;
                    x: max(Theme.space-4, parent.width - self.width - 58px);
                    y: clamp(self.below + self.height <= parent.height - Theme.space-4
                            ? self.below : self.row-top + Theme.space-8 - self.height,
                        Theme.space-4, max(Theme.space-4, parent.height - self.height - Theme.space-4));
                    width: min(300px, parent.width - 2 * Theme.space-4);
                    height: min(self.count * Theme.row-menu + 2 * Theme.space-4, parent.height - 2 * Theme.space-4);
                    clip: true;
                    accessible-role: none;

                    FocusScope {
                        focus-on-tab-navigation: false;
                        focus-on-click: false;
                        init => { self.focus(); }

                        key-pressed(event) => {
                            if event.text == Key.Escape {
                                root.close-streams();
                                return accept;
                            }
                            if event.text == Key.DownArrow {
                                root.streams-active = min(count - 1, root.streams-active + 1);
                                return accept;
                            }
                            if event.text == Key.UpArrow {
                                root.streams-active = max(0, root.streams-active - 1);
                                return accept;
                            }
                            if event.text == Key.Home || event.text == Key.End {
                                root.streams-active = event.text == Key.Home ? 0 : count - 1;
                                return accept;
                            }
                            if event.text == Key.Return || event.text == Key.Space {
                                if !event.repeat && root.streams-active >= 0 {
                                    root.pick-stream(root.streams-active);
                                }
                                return accept;
                            }
                            // Nothing behind the menu takes a key meanwhile
                            return accept;
                        }

                        VerticalLayout {
                            padding: Theme.space-4;
                            alignment: start;

                            for stream[index] in station.streams: ChoiceRow {
                                // "AAC · 128 kbps", and the server it comes from
                                label: stream.label != "" ? stream.label : stream.host;
                                trailing-text: stream.label != "" ? stream.host : "";
                                selected: stream.url == station.url;
                                highlighted: root.streams-active == index;
                                tab-stop: false;
                                clicked => { root.pick-stream(index); }
                            }
                        }
                    }
                }
            }

            // A favorite was just removed (un-starred here, or in the main
            // window a moment ago): the same offer as under the favorites
            // list, over the bottom of the results, for as long as there
            if root.can-undo: PopupCard {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - Theme.space-12;
                width: min(undo-row.preferred-width, parent.width - 2 * Theme.space-12);
                height: Theme.control-button + 2 * Theme.space-4;
                accessible-role: none;

                undo-row := HorizontalLayout {
                    padding-left: Theme.space-12;
                    padding-right: Theme.space-4;
                    spacing: Theme.space-4;

                    Text {
                        text: "Removed from Favorites";
                        color: Theme.text-primary;
                        font-size: Theme.font-md;
                        vertical-alignment: center;
                        overflow: elide;
                        // Said when it appears
                        accessible-live-region: polite;
                    }

                    VerticalLayout {
                        alignment: center;
                        undo-button := TextButton {
                            label: "Undo";
                            changed has-focus => {
                                root.undo-focused = self.has-focus || undo-dismiss.has-focus;
                            }
                            clicked => { root.take-undo(); }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        undo-dismiss := IconButton {
                            icon: @image-url("../icons/xmark.svg");
                            icon-size: Theme.icon-sm;
                            label: "Dismiss";
                            changed has-focus => {
                                root.undo-focused = self.has-focus || undo-button.has-focus;
                            }
                            clicked => { root.undo-dismissed(); }
                        }
                    }
                }
            }
        }

        // Footer: how many stations, and a failed next page with its retry.
        // The row stays (blank) in the other states, so the results area
        // keeps its height when a search returns.
        HorizontalLayout {
            height: Theme.control-button;
            alignment: stretch;
            spacing: Theme.space-8;

            // How many, and the filters they are within (which may be hidden)
            Text {
                text: root.dot(root.search-results.length == 0 ? ""
                        : root.search-results.length == 1 ? "1 station"
                        : "\{root.search-results.length} stations",
                    root.filtered ? "Filters: \{root.filter-summary}" : "");
                overflow: elide;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            // The next page failed: the list stays, with the reason here
            if root.search-error != "" && root.search-results.length > 0: HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                spacing: Theme.space-6;

                VerticalLayout {
                    alignment: center;

                    Icon {
                        width: Theme.icon-sm;
                        height: Theme.icon-sm;
                        source: @image-url("../icons/circle-alert.svg");
                        colorize: Theme.danger-text;
                    }
                }

                Text {
                    text: root.search-error;
                    color: Theme.danger-text;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.retry-in > 0: Text {
                    text: "· trying again in \{root.retry-in} s";
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    padding-left: Theme.space-4;

                    SecondaryButton {
                        label: "Try Again";
                        height: Theme.row-menu;
                        clicked => {
                            root.retry-in = 0;
                            root.retry();
                            // It goes away while the page loads: keep the
                            // focus in the dialog so Esc still closes it
                            if self.has-focus {
                                search-input.focus-input();
                            }
                        }
                    }
                }
            }
        }
    }
}
