import { DesktopShortcuts, ShortcutAction } from "../shortcuts.slint";
import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, NowPlayingBars, Icon, ButtonKeys, FocusRing, Motion, StatusPanel, ChipVariant } from "../components.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { AccentButton, SecondaryButton } from "../buttons.slint";
import { ScrollBar } from "../scroll-bar.slint";

export struct BrowseStation {
    name: string,
    url: string,
    logo-url: string,
    country: string,
    codec: string,
    bitrate: int,
    // Provider's station ID, used to recognize favorites with a different URL
    provider-id: string,
    // Already in favorites (set from Rust, kept up to date)
    is-favorite: bool,
}

component StationRow inherits Rectangle {
    in property <string> name;
    in property <string> country;
    in property <string> codec;
    in property <int> bitrate;
    in property <image> logo-image;
    in property <bool> has-logo;
    // Playback state of this station: "", "loading", "playing" or "error"
    in property <string> state;
    // Status line shown instead of the country while loading or failed
    in property <string> status;
    in property <bool> is-favorite;
    callback clicked();
    callback favorite-clicked();

    height: Theme.row-media;
    border-radius: Theme.radius-md;
    // As in Favorites: the active row (playing, connecting or failed) has a
    // tint and an accent rail; a failure shows in the icon and status line
    background: touch.has-hover ? Theme.hover-bg
        : root.state != "" ? Theme.accent-soft : transparent;
    animate background { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: list-item;
    accessible-label: root.name;
    accessible-description: root.state != "" && root.status != "" ? root.status : root.country;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    // Enter or Space plays the station
    keys := ButtonKeys {
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }

    // Accent rail on the active row, as tall as the logo
    if root.state != "": Rectangle {
        x: 0;
        y: (parent.height - 40px) / 2;
        width: 3px;
        height: 40px;
        background: Theme.accent;
        border-radius: self.width / 2;
    }

    HorizontalLayout {
        padding-left: Theme.space-12;
        padding-right: Theme.space-12;
        spacing: Theme.space-8;
        alignment: stretch;

        // Station logo
        VerticalLayout {
            alignment: center;
            width: 40px;

            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-sm;
                background: Theme.elevated;
                border-width: 1px;
                border-color: Theme.hairline;
                clip: true;

                if root.has-logo: Image {
                    source: root.logo-image;
                    width: 40px;
                    height: 40px;
                    image-fit: contain;
                }

                if !root.has-logo: Icon {
                    source: @image-url("../icons/radio.svg");
                    width: Theme.icon-md;
                    height: Theme.icon-md;
                    colorize: Theme.accent;
                }
            }
        }

        // Station name + country
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.space-2;

            HorizontalLayout {
                spacing: Theme.space-8;

                Text {
                    horizontal-stretch: 0;
                    text: root.name;
                    color: root.state == "playing" || root.state == "loading"
                        ? Theme.accent-text : Theme.text-primary;
                    font-size: Theme.font-base;
                    font-weight: Theme.weight-semibold;
                    overflow: elide;
                }

                // Playback state: bouncing bars, a spinner or an error mark
                if root.state == "playing": VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    NowPlayingBars {}
                }

                if root.state == "loading": VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    Icon {
                        source: @image-url("../icons/spinner.svg");
                        width: Theme.icon-sm;
                        height: Theme.icon-sm;
                        colorize: Theme.accent-text;
                        rotation: mod(Motion.tick / Theme.spin-period, 1) * 360deg;
                    }
                }

                if root.state == "error": VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    Icon {
                        source: @image-url("../icons/circle-exclamation.svg");
                        width: Theme.icon-sm;
                        height: Theme.icon-sm;
                        colorize: Theme.danger-text;
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            Text {
                text: (root.state == "loading" || root.state == "error") && root.status != ""
                    ? root.status : root.country;
                color: root.state == "error" ? Theme.danger-text : Theme.text-secondary;
                font-size: Theme.font-sm;
                overflow: elide;
            }
        }

        // Codec badge, sized to its text
        VerticalLayout {
            alignment: center;
            width: 64px;

            if root.codec != "": HorizontalLayout {
                alignment: end;

                Rectangle {
                    width: min(64px, codec-text.preferred-width + 12px);
                    height: 18px;
                    border-radius: Theme.radius-sm;
                    background: Theme.elevated;
                    border-width: 1px;
                    border-color: Theme.hairline;

                    codec-text := Text {
                        x: 6px;
                        width: parent.width - 12px;
                        text: root.codec;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // Bitrate
        VerticalLayout {
            alignment: center;
            width: 60px;

            Text {
                text: root.bitrate > 0 ? "\{root.bitrate} kbps" : "";
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                horizontal-alignment: right;
            }
        }

        // Add to or remove from favorites without playing; last, like
        // row actions elsewhere, so the details line up to its left
        VerticalLayout {
            alignment: center;
            width: 30px;

            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: star-touch.pressed ? Theme.pressed-bg
                    : star-touch.has-hover ? Theme.hover-bg : transparent;
                animate background { duration: Theme.fast; }

                accessible-role: button;
                accessible-label: root.is-favorite ? "Remove from Favorites" : "Add to Favorites";
                accessible-action-default => { root.favorite-clicked(); }

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: Theme.icon-md;
                    height: Theme.icon-md;
                    source: root.is-favorite ? @image-url("../icons/star.svg")
                        : @image-url("../icons/star-regular.svg");
                    colorize: root.is-favorite ? Theme.accent
                        : star-touch.has-hover ? Theme.text-primary : Theme.text-tertiary;
                }

                star-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.favorite-clicked(); }
                }

                star-keys := ButtonKeys {
                    activated => { root.favorite-clicked(); }
                }

                if star-keys.has-focus: FocusRing {
                    radius: parent.border-radius;
                }
            }
        }
    }
}

// A filter under the search box: "Any country" or the one chosen, with a
// ✕ to clear it. Clicking it opens the list to choose from. It has the
// search field's height and shape, and both filters share the row equally,
// so a long value elides rather than moving the other one.
component FilterChip inherits Rectangle {
    // "Any country" and the like when nothing is chosen
    in property <string> any-label;
    // The chosen value, empty for Any
    in property <string> value;
    in property <image> flag;
    callback clicked();
    callback cleared();

    property <bool> active: root.value != "";

    height: Theme.control-field;
    min-width: 0;
    preferred-width: 0;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    background: touch.pressed ? Theme.pressed-bg
        : touch.has-hover ? Theme.hover-bg : Theme.elevated;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.field-border;
    animate background, border-color { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: button;
    accessible-label: root.active ? root.value : root.any-label;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: root.active ? Theme.space-6 : 10px;
        spacing: Theme.space-6;

        if root.active && root.flag.width > 0: VerticalLayout {
            alignment: center;

            Image {
                source: root.flag;
                width: 18px;
                height: 13px;
                image-fit: contain;
            }
        }

        Text {
            text: root.active ? root.value : root.any-label;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: Theme.font-base;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if !root.active: VerticalLayout {
            alignment: center;

            Icon {
                width: Theme.icon-sm;
                height: Theme.icon-sm;
                source: @image-url("../icons/chevron-down.svg");
                colorize: Theme.text-secondary;
            }
        }

        // Clear the filter
        if root.active: Rectangle {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: self.height / 2;
            background: clear-touch.pressed ? Theme.pressed-bg
                : clear-touch.has-hover ? Theme.hover-bg : transparent;
            accessible-role: button;
            accessible-label: "Clear \{root.value}";
            accessible-action-default => { root.cleared(); }

            clear-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.cleared(); }
            }

            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Theme.icon-sm;
                height: Theme.icon-sm;
                source: @image-url("../icons/xmark.svg");
                colorize: clear-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            }
        }
    }
}

export component StationBrowserDialog inherits Rectangle {
    in property <bool> search-shortcut-enabled;
    in-out property <bool> show-dialog: false;
    in-out property <bool> search-loading: false;
    in-out property <bool> search-loading-more: false;
    in-out property <string> search-error: "";
    // Seconds until a failed request is tried again on its own
    in-out property <int> retry-in: 0;
    // The first page's Try Again has the focus
    property <bool> retry-focused;
    in-out property <[BrowseStation]> search-results: [];
    in-out property <[image]> browse-logos: [];
    in-out property <bool> has-more: false;
    // The filters in force, each a name to show and the code the directory
    // is asked for (empty: any)
    in-out property <string> country-name: "";
    // ISO 3166-1 code
    in-out property <string> country-code: "";
    in-out property <image> country-flag;
    in-out property <string> genre-name: "";
    // The directory's slug
    in-out property <string> genre-code: "";
    property <bool> filtered: root.country-code != "" || root.genre-code != "";
    // Current playback, so the row of the station being played shows its
    // state even while the dialog hides the player
    in property <string> playing-url;
    in property <bool> is-playing;
    in property <bool> play-loading;
    in property <bool> play-error;
    in property <string> play-status;
    // Row picked last (provider ID or URL); the played URL may differ
    // after resolving a playlist or matching a favorite
    property <string> picked: "";
    changed show-dialog => {
        if !self.show-dialog {
            root.picked = "";
            root.closed();
        }
    }
    in-out property <string> search-query: "";
    // Query of the results on screen; empty means the default list
    in-out property <string> shown-query: "";
    // How far the list is scrolled (kept while the dialog is closed)
    in-out property <length> list-scroll: 0;
    // The rows on screen: first row and how many, for loading their logos
    out property <int> visible-first;
    out property <int> visible-count;
    callback visible-rows-changed();
    // The dialog closed: its logos can be let go
    callback closed();

    function show-rows(first: int, count: int) {
        root.visible-first = first;
        root.visible-count = count;
        root.visible-rows-changed();
    }

    // Search by name within the filters (query, country code, genre slug);
    // with nothing given, the most played stations
    callback search-stations(string, string, string);
    // Open the list of countries or genres ("country", "genre") to choose a
    // filter from
    callback pick-filter(string);
    callback load-more();
    // Try the failed request again (the first page, or the next one)
    callback retry();
    callback station-selected(BrowseStation);
    callback favorite-toggled(BrowseStation);

    // Search again with the query on screen, for a filter just changed
    public function run-search() {
        root.shown-query = root.search-query;
        root.list-scroll = 0;
        root.search-loading = true;
        root.search-stations(root.search-query, root.country-code, root.genre-code);
    }

    if show-dialog: DialogShell {
        title: "Search Stations";
        subtitle: "From the Radiotrope station directory";
        card-width: Defaults.station-browser-width;
        card-height: Defaults.station-browser-height;
        auto-focus: false;
        close-requested => { root.show-dialog = false; }
        capture-key(event) => {
            if DesktopShortcuts.enabled && root.search-shortcut-enabled
                && DesktopShortcuts.match-key(event) == ShortcutAction.search {
                search-input.focus-input();
                return accept;
            }
            return reject;
        }

        // Search input: field and button share one height
        HorizontalLayout {
            spacing: Theme.space-8;
            height: Theme.control-field;

            search-input := StyledLineEdit {
                horizontal-stretch: 1;
                clearable: true;
                init => { self.focus-input(); }
                placeholder-text: "Search by station name";
                text <=> root.search-query;
                accepted(query) => {
                    if root.search-query != "" || root.shown-query != "" {
                        root.run-search();
                    }
                }
                // Emptying the box (backspace or ✕) brings back the default list
                edited(query) => {
                    if query == "" && root.shown-query != "" {
                        root.run-search();
                    }
                }
                cleared => {
                    if root.shown-query != "" {
                        root.run-search();
                    }
                }
            }

            AccentButton {
                label: "Search";
                height: Theme.control-field;
                enabled: root.search-query != "";
                clicked => {
                    if root.search-query != "" {
                        root.run-search();
                    }
                }
            }
        }

        // Filters: country and genre, as tall as the search field
        HorizontalLayout {
            spacing: Theme.space-8;
            height: Theme.control-field;

            FilterChip {
                any-label: "Any country";
                value: root.country-name;
                flag: root.country-flag;
                clicked => { root.pick-filter("country"); }
                cleared => {
                    root.country-name = "";
                    root.country-code = "";
                    root.run-search();
                }
            }

            FilterChip {
                any-label: "Any genre";
                value: root.genre-name;
                clicked => { root.pick-filter("genre"); }
                cleared => {
                    root.genre-name = "";
                    root.genre-code = "";
                    root.run-search();
                }
            }

            // Greyed out while no filter is set
            SecondaryButton {
                label: "Reset Filters";
                icon: @image-url("../icons/rotate-left.svg");
                height: Theme.control-field;
                enabled: root.filtered;
                clicked => {
                    root.country-name = "";
                    root.country-code = "";
                    root.genre-name = "";
                    root.genre-code = "";
                    root.run-search();
                }
            }
        }

        // Results area: the list, or one status panel for loading, a
        // failed first page and no results
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            border-radius: Theme.radius-sm;
            background: Theme.surface;

            if root.search-loading && root.search-results.length == 0: StatusPanel {
                width: parent.width;
                height: parent.height;
                busy: true;
                title: "Loading stations…";
            }

            // Counts down to the next try while a request has failed.
            // It lives with the dialog, so nothing is retried while closed.
            Timer {
                interval: 1s;
                running: root.search-error != "" && root.retry-in > 0;
                triggered => {
                    root.retry-in -= 1;
                    if root.retry-in == 0 {
                        root.retry();
                        // Try Again goes away while it loads: if it had
                        // the focus, keep it in the dialog so Esc still works
                        if root.retry-focused {
                            root.retry-focused = false;
                            search-input.focus-input();
                        }
                    }
                }
            }

            // Error state: the first page failed. The panel's own button
            // can't report its focus, so Try Again sits under it, in the
            // same SecondaryButton style.
            if root.search-error != "" && !root.search-loading
                && root.search-results.length == 0: VerticalLayout {
                width: parent.width;
                height: parent.height;
                alignment: center;
                padding-bottom: Theme.space-16;

                StatusPanel {
                    padding-bottom: 0;
                    icon: @image-url("../icons/circle-exclamation.svg");
                    variant: ChipVariant.danger;
                    title: root.search-error;
                    message: root.retry-in > 0 ? "Trying again in \{root.retry-in} s" : "";
                }

                HorizontalLayout {
                    alignment: center;
                    padding-top: Theme.space-8;

                    SecondaryButton {
                        label: "Try Again";
                        changed has-focus => { root.retry-focused = self.has-focus; }
                        clicked => {
                            root.retry-in = 0;
                            root.retry();
                            // The button goes away while it loads: keep the
                            // focus in the dialog so Esc still closes it
                            if self.has-focus {
                                search-input.focus-input();
                            }
                        }
                    }
                }
            }

            // Empty state
            if root.search-results.length == 0
                && !root.search-loading && root.search-error == "": StatusPanel {
                width: parent.width;
                height: parent.height;
                icon: @image-url("../icons/magnifying-glass.svg");
                title: "No stations found";
                message: root.filtered ? "Try removing a filter."
                    : root.shown-query != "" ? "Check the spelling or try another name." : "";
            }

            // Results list
            if root.search-results.length > 0: Rectangle {
                results-flick := Flickable {
                    content-height: rows.height;
                    content-y <=> root.list-scroll;

                    // Infinite scroll: fetch the next page when the view
                    // comes within about five rows of the end
                    changed content-y => {
                        // After a failure, the countdown or Try Again fetches it
                        if root.has-more && !root.search-loading-more
                           && root.search-error == ""
                           && self.height - self.content-y > self.content-height - 300px {
                            root.search-loading-more = true;
                            root.load-more();
                        }
                    }

                    // Only the rows on screen (and a couple either side)
                    // exist, however long the list; Rust loads the logos
                    // of the rows shown
                    rows := Rectangle {
                        property <length> row-height: Theme.row-media;
                        property <int> first: max(0, floor(-root.list-scroll / self.row-height) - 2);
                        property <int> pool: ceil(results-flick.height / self.row-height) + 4;
                        property <int> count: max(0, min(root.search-results.length - self.first, self.pool));
                        height: root.search-results.length * self.row-height + 2 * Theme.space-4
                            + (root.has-more ? 40px : 0px);
                        init => { root.show-rows(self.first, self.count); }
                        changed first => { root.show-rows(self.first, self.count); }
                        changed count => { root.show-rows(self.first, self.count); }

                        for k in rows.count: StationRow {
                            // Each row keeps its station while it stays on
                            // screen, so hover and highlight don't hop
                            // between rows as the list scrolls
                            property <int> idx: rows.first + mod(k - mod(rows.first, rows.count) + rows.count, rows.count);
                            property <BrowseStation> station: root.search-results[self.idx];
                            x: Theme.space-4;
                            y: Theme.space-4 + self.idx * rows.row-height;
                            width: rows.width - 2 * Theme.space-4;
                            name: station.name;
                            country: station.country;
                            codec: station.codec;
                            bitrate: station.bitrate;
                            logo-image: self.idx < root.browse-logos.length ? root.browse-logos[self.idx] : @image-url("");
                            has-logo: self.idx < root.browse-logos.length
                                ? root.browse-logos[self.idx].width > 0
                                : false;
                            // The row clicked here; before any click, the row
                            // whose URL is playing
                            property <bool> active: root.picked != ""
                                ? root.picked == (station.provider-id != "" ? station.provider-id : station.url)
                                : station.url == root.playing-url;
                            state: !self.active ? ""
                                : root.play-error ? "error"
                                : root.play-loading ? "loading"
                                : root.is-playing ? "playing" : "";
                            status: root.play-status;
                            is-favorite: station.is-favorite;
                            favorite-clicked => { root.favorite-toggled(station); }
                            clicked => {
                                root.picked = station.provider-id != "" ? station.provider-id : station.url;
                                root.station-selected(station);
                            }
                        }

                        // Footer while the next page loads
                        if root.has-more && root.search-loading-more: HorizontalLayout {
                            x: 0;
                            y: Theme.space-4 + root.search-results.length * rows.row-height;
                            width: rows.width;
                            height: 40px;
                            alignment: center;
                            spacing: Theme.space-8;

                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: @image-url("../icons/spinner.svg");
                                    width: Theme.icon-sm;
                                    height: Theme.icon-sm;
                                    colorize: Theme.accent-text;
                                    rotation: mod(Motion.tick / Theme.spin-period, 1) * 360deg;
                                }
                            }
                            Text {
                                text: "Loading more stations…";
                                color: Theme.text-secondary;
                                font-size: Theme.font-md;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                ScrollBar {
                    x: parent.width - self.width - Theme.space-2;
                    y: Theme.space-4;
                    height: parent.height - 2 * Theme.space-4;
                    viewport-height: results-flick.height;
                    content-height: results-flick.content-height;
                    content-y <=> results-flick.content-y;
                }
            }
        }

        // Footer: how many stations, and a failed next page with its retry.
        // Only with results; otherwise the status panel takes the room.
        if root.search-results.length > 0: HorizontalLayout {
            height: Theme.control-button;
            alignment: stretch;
            spacing: Theme.space-8;

            Text {
                text: "\{root.search-results.length} stations";
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            // The next page failed: the list stays, with the reason here
            if root.search-error != "": HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                spacing: Theme.space-6;

                VerticalLayout {
                    alignment: center;

                    Icon {
                        width: Theme.icon-sm;
                        height: Theme.icon-sm;
                        source: @image-url("../icons/circle-exclamation.svg");
                        colorize: Theme.danger-text;
                    }
                }

                Text {
                    text: root.search-error;
                    color: Theme.danger-text;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.retry-in > 0: Text {
                    text: "· trying again in \{root.retry-in} s";
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    padding-left: Theme.space-4;

                    SecondaryButton {
                        label: "Try Again";
                        height: Theme.row-menu;
                        clicked => {
                            root.retry-in = 0;
                            root.retry();
                            // It goes away while the page loads: keep the
                            // focus in the dialog so Esc still closes it
                            if self.has-focus {
                                search-input.focus-input();
                            }
                        }
                    }
                }
            }
        }
    }
}
