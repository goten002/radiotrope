import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, NowPlayingBars, Icon, ButtonKeys, FocusRing, Motion } from "../components.slint";
import { LogoFog, LogoFogLayer, Fog } from "../logo-fog.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { AccentButton, SecondaryButton } from "../buttons.slint";
import { ScrollBar } from "../scroll-bar.slint";

export struct BrowseStation {
    name: string,
    url: string,
    logo-url: string,
    country: string,
    codec: string,
    bitrate: int,
    // Provider's station ID, used to recognize favorites with a different URL
    provider-id: string,
    // Already in favorites (set from Rust, kept up to date)
    is-favorite: bool,
}

component StationRow inherits Rectangle {
    in property <string> name;
    in property <string> country;
    in property <string> codec;
    in property <int> bitrate;
    in property <image> logo-image;
    in property <bool> has-logo;
    in property <LogoFog> logo-fog;
    // Playback state of this station: "", "loading", "playing" or "error"
    in property <string> state;
    // Status line shown instead of the country while loading or failed
    in property <string> status;
    in property <bool> is-favorite;
    callback clicked();
    callback favorite-clicked();

    height: 56px;
    border-radius: Theme.radius-md;
    background: root.state == "error" ? Theme.danger.with-alpha(0.12)
        : root.state != "" ? Theme.accent-soft
        : touch.has-hover ? Theme.menu-hover : transparent;
    animate background { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: list-item;
    accessible-label: root.name;
    accessible-description: root.state != "" && root.status != "" ? root.status : root.country;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    // Enter or Space plays the station
    keys := ButtonKeys {
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: stretch;

        // Station logo
        VerticalLayout {
            alignment: center;
            width: 40px;

            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-sm;
                background: Theme.elevated;
                border-width: 1px;
                border-color: Theme.hairline;
                clip: true;

                if root.has-logo && Fog.shown(root.logo-fog): LogoFogLayer {
                    fog: root.logo-fog;
                }

                if root.has-logo: Image {
                    source: root.logo-image;
                    width: 40px;
                    height: 40px;
                    image-fit: contain;
                }

                if !root.has-logo: Icon {
                    source: @image-url("../icons/radio.svg");
                    width: 16px;
                    height: 16px;
                    colorize: Theme.accent;
                }
            }
        }

        // Station name + country
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    horizontal-stretch: 0;
                    text: root.name;
                    color: root.state == "error" ? Theme.danger
                        : root.state != "" ? Theme.accent-text : Theme.text-primary;
                    font-size: Theme.font-base;
                    font-weight: 600;
                    overflow: elide;
                }

                // Playback state: bouncing bars, a spinner or an error mark
                if root.state == "playing": VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    NowPlayingBars {}
                }

                if root.state == "loading": VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    Icon {
                        source: @image-url("../icons/spinner.svg");
                        width: 12px;
                        height: 12px;
                        colorize: Theme.accent;
                        rotation: mod(Motion.tick / 900ms, 1) * 360deg;
                    }
                }

                if root.state == "error": VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    Icon {
                        source: @image-url("../icons/circle-exclamation.svg");
                        width: 13px;
                        height: 13px;
                        colorize: Theme.danger;
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            Text {
                text: (root.state == "loading" || root.state == "error") && root.status != ""
                    ? root.status : root.country;
                color: root.state == "error" ? Theme.danger : Theme.text-secondary;
                font-size: Theme.font-sm;
                overflow: elide;
            }
        }

        // Codec badge, sized to its text
        VerticalLayout {
            alignment: center;
            width: 64px;

            if root.codec != "": HorizontalLayout {
                alignment: end;

                Rectangle {
                    width: min(64px, codec-text.preferred-width + 12px);
                    height: 18px;
                    border-radius: Theme.radius-sm;
                    background: Theme.elevated;
                    border-width: 1px;
                    border-color: Theme.hairline;

                    codec-text := Text {
                        x: 6px;
                        width: parent.width - 12px;
                        text: root.codec;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        font-weight: 600;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // Bitrate
        VerticalLayout {
            alignment: center;
            width: 60px;

            Text {
                text: root.bitrate > 0 ? "\{root.bitrate} kbps" : "";
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                horizontal-alignment: right;
            }
        }

        // Add to or remove from favorites without playing; last, like
        // row actions elsewhere, so the details line up to its left
        VerticalLayout {
            alignment: center;
            width: 30px;

            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: star-touch.has-hover ? Theme.menu-hover : transparent;
                animate background { duration: Theme.fast; }

                accessible-role: button;
                accessible-label: root.is-favorite ? "Remove from favorites" : "Add to favorites";
                accessible-action-default => { root.favorite-clicked(); }

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    source: root.is-favorite ? @image-url("../icons/star.svg")
                        : @image-url("../icons/star-regular.svg");
                    colorize: root.is-favorite ? Theme.accent
                        : star-touch.has-hover ? Theme.text-primary : Theme.text-tertiary;
                }

                star-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.favorite-clicked(); }
                }

                star-keys := ButtonKeys {
                    activated => { root.favorite-clicked(); }
                }

                if star-keys.has-focus: FocusRing {
                    radius: parent.border-radius;
                }
            }
        }
    }
}

export component StationBrowserDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <string> search-mode: "search";
    in-out property <bool> search-loading: false;
    in-out property <bool> search-loading-more: false;
    in-out property <string> search-error: "";
    // Seconds until a failed request is tried again on its own
    in-out property <int> retry-in: 0;
    in-out property <[BrowseStation]> search-results: [];
    in-out property <[image]> browse-logos: [];
    // Colour fog of each logo, same order as browse-logos
    in-out property <[LogoFog]> browse-logo-fogs: [];
    in-out property <bool> has-more: false;
    in-out property <string> country-name: "";
    // ISO 3166-1 code of the country, empty if unknown
    in-out property <string> country-code: "";
    in-out property <image> country-flag;
    // Current playback, so the row of the station being played shows its
    // state even while the dialog hides the player
    in property <string> playing-url;
    in property <bool> is-playing;
    in property <bool> play-loading;
    in property <bool> play-error;
    in property <string> play-status;
    // Row picked last (provider ID or URL); the played URL may differ
    // after resolving a playlist or matching a favorite
    property <string> picked: "";
    changed show-dialog => {
        if !self.show-dialog {
            root.picked = "";
            root.closed();
        }
    }
    in-out property <string> search-query: "";
    // Query of the results on screen; empty means the default list
    in-out property <string> shown-query: "";
    // How far the list is scrolled (kept while the dialog is closed)
    in-out property <length> list-scroll: 0;
    // The rows on screen: first row and how many, for loading their logos
    out property <int> visible-first;
    out property <int> visible-count;
    callback visible-rows-changed();
    // The dialog closed: its logos can be let go
    callback closed();

    function show-rows(first: int, count: int) {
        root.visible-first = first;
        root.visible-count = count;
        root.visible-rows-changed();
    }

    // Search by name; an empty query loads the top stations
    callback search-stations(string);
    // Search by name within a country (name, code, query); an empty query
    // lists the country's stations
    callback search-in-country(string, string, string);
    // Back to the country list (country mode only)
    callback change-country();
    callback load-more();
    // Try the failed request again (the first page, or the next one)
    callback retry();
    callback station-selected(BrowseStation);
    callback favorite-toggled(BrowseStation);

    // Forget the typed query, for when the dialog opens in a new mode
    public function reset-query() {
        root.search-query = "";
        root.shown-query = "";
        root.list-scroll = 0;
    }

    function run-search() {
        root.shown-query = root.search-query;
        root.list-scroll = 0;
        root.search-loading = true;
        if root.search-mode == "country" {
            root.search-in-country(root.country-name, root.country-code, root.search-query);
        } else {
            root.search-stations(root.search-query);
        }
    }

    if show-dialog: DialogShell {
        title: root.search-mode == "country"
            ? "Stations in \{root.country-name}"
            : "Search Radio Stations";
        subtitle: "From the radio-browser.info community directory";
        icon: root.search-mode == "country" ? root.country-flag : @image-url("");
        card-width: Defaults.station-browser-width;
        card-height: Defaults.station-browser-height;
        auto-focus: false;
        show-back: root.search-mode == "country";
        back-requested => { root.change-country(); }
        close-requested => { root.show-dialog = false; }

        // Search input
        HorizontalLayout {
            spacing: 8px;
            height: 36px;

            search-input := StyledLineEdit {
                horizontal-stretch: 1;
                clearable: true;
                init => { self.focus-input(); }
                placeholder-text: root.search-mode == "country"
                    ? "Search stations in \{root.country-name}..."
                    : "Search by station name...";
                text <=> root.search-query;
                accepted(query) => {
                    if root.search-query != "" || root.shown-query != "" {
                        root.run-search();
                    }
                }
                // Emptying the box (backspace or ✕) brings back the default list
                edited(query) => {
                    if query == "" && root.shown-query != "" {
                        root.run-search();
                    }
                }
                cleared => {
                    if root.shown-query != "" {
                        root.run-search();
                    }
                }
            }

            AccentButton {
                label: "Search";
                enabled: root.search-query != "";
                clicked => {
                    if root.search-query != "" {
                        root.run-search();
                    }
                }
            }
        }

        // Results area
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            border-radius: 4px;
            background: Theme.surface;

            // Loading state
            if root.search-loading && root.search-results.length == 0: Text {
                text: "Loading...";
                color: Theme.text-secondary;
                font-size: Theme.font-base;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Counts down to the next try while a request has failed.
            // It lives with the dialog, so nothing is retried while closed.
            Timer {
                interval: 1s;
                running: root.search-error != "" && root.retry-in > 0;
                triggered => {
                    root.retry-in -= 1;
                    if root.retry-in == 0 {
                        root.retry();
                    }
                }
            }

            // Error state: the first page failed
            if root.search-error != "" && !root.search-loading
                && root.search-results.length == 0: VerticalLayout {
                alignment: center;
                spacing: 6px;

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;

                    Icon {
                        width: 14px;
                        height: 14px;
                        source: @image-url("../icons/circle-exclamation.svg");
                        colorize: Theme.danger;
                    }

                    Text {
                        text: root.search-error;
                        color: Theme.danger;
                        font-size: Theme.font-base;
                        font-weight: 500;
                    }
                }

                Text {
                    text: root.retry-in > 0 ? "Trying again in \{root.retry-in}s" : "";
                    color: Theme.text-secondary;
                    font-size: Theme.font-md;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    padding-top: 6px;

                    SecondaryButton {
                        label: "Try again";
                        clicked => {
                            root.retry-in = 0;
                            root.retry();
                        }
                    }
                }
            }

            // Empty state
            if root.search-results.length == 0
                && !root.search-loading && root.search-error == "": Text {
                text: root.search-mode == "country"
                    ? "No stations found in \{root.country-name}"
                    : "No stations found";
                color: Theme.text-secondary;
                font-size: Theme.font-base;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Results list
            if root.search-results.length > 0: Rectangle {
                results-flick := Flickable {
                    content-height: rows.height;
                    content-y <=> root.list-scroll;

                    // Infinite scroll: fetch the next page when the view
                    // comes within about five rows of the end
                    changed content-y => {
                        // After a failure, the countdown or Try again fetches it
                        if root.has-more && !root.search-loading-more
                           && root.search-error == ""
                           && self.height - self.content-y > self.content-height - 300px {
                            root.search-loading-more = true;
                            root.load-more();
                        }
                    }

                    // Only the rows on screen (and a couple either side)
                    // exist, however long the list; Rust loads the logos
                    // of the rows shown
                    rows := Rectangle {
                        property <length> row-height: 56px;
                        property <int> first: max(0, floor(-root.list-scroll / self.row-height) - 2);
                        property <int> pool: ceil(results-flick.height / self.row-height) + 4;
                        property <int> count: max(0, min(root.search-results.length - self.first, self.pool));
                        height: root.search-results.length * self.row-height + 8px
                            + (root.has-more ? 40px : 0px);
                        init => { root.show-rows(self.first, self.count); }
                        changed first => { root.show-rows(self.first, self.count); }
                        changed count => { root.show-rows(self.first, self.count); }

                        for k in rows.count: StationRow {
                            // Each row keeps its station while it stays on
                            // screen, so hover and highlight don't hop
                            // between rows as the list scrolls
                            property <int> idx: rows.first + mod(k - mod(rows.first, rows.count) + rows.count, rows.count);
                            property <BrowseStation> station: root.search-results[self.idx];
                            x: 4px;
                            y: 4px + self.idx * rows.row-height;
                            width: rows.width - 8px;
                            name: station.name;
                            country: station.country;
                            codec: station.codec;
                            bitrate: station.bitrate;
                            logo-image: self.idx < root.browse-logos.length ? root.browse-logos[self.idx] : @image-url("");
                            has-logo: self.idx < root.browse-logos.length
                                ? root.browse-logos[self.idx].width > 0
                                : false;
                            logo-fog: root.browse-logo-fogs[self.idx];
                            // The row clicked here; before any click, the row
                            // whose URL is playing
                            property <bool> active: root.picked != ""
                                ? root.picked == (station.provider-id != "" ? station.provider-id : station.url)
                                : station.url == root.playing-url;
                            state: !self.active ? ""
                                : root.play-error ? "error"
                                : root.play-loading ? "loading"
                                : root.is-playing ? "playing" : "";
                            status: root.play-status;
                            is-favorite: station.is-favorite;
                            favorite-clicked => { root.favorite-toggled(station); }
                            clicked => {
                                root.picked = station.provider-id != "" ? station.provider-id : station.url;
                                root.station-selected(station);
                            }
                        }

                        // Footer while the next page loads
                        if root.has-more: Text {
                            x: 0;
                            y: 4px + root.search-results.length * rows.row-height;
                            width: rows.width;
                            height: 40px;
                            text: root.search-loading-more ? "Loading more stations..." : "";
                            color: Theme.text-secondary;
                            font-size: Theme.font-md;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                ScrollBar {
                    x: parent.width - self.width - 2px;
                    y: 4px;
                    height: parent.height - 8px;
                    viewport-height: results-flick.height;
                    content-height: results-flick.content-height;
                    content-y <=> results-flick.content-y;
                }
            }
        }

        // Footer
        HorizontalLayout {
            height: 32px;
            alignment: stretch;

            Text {
                text: root.search-results.length > 0
                    ? "\{root.search-results.length} stations"
                    : "";
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            // The next page failed: the list stays, with the reason here
            if root.search-error != "" && root.search-results.length > 0: HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                spacing: 6px;

                VerticalLayout {
                    alignment: center;

                    Icon {
                        width: 12px;
                        height: 12px;
                        source: @image-url("../icons/circle-exclamation.svg");
                        colorize: Theme.danger;
                    }
                }

                Text {
                    text: root.search-error;
                    color: Theme.danger;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }

                Text {
                    text: root.retry-in > 0 ? "· trying again in \{root.retry-in}s" : "";
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }

                retry-link := Text {
                    text: "Try again";
                    color: retry-touch.has-hover ? Theme.accent : Theme.accent-text;
                    font-size: Theme.font-sm;
                    font-weight: 600;
                    vertical-alignment: center;

                    retry-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.retry-in = 0;
                            root.retry();
                        }
                    }
                }
            }
        }
    }
}
