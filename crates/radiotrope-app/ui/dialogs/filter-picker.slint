import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, ButtonKeys, FocusRing } from "../components.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { SecondaryButton } from "../buttons.slint";
import { ScrollBar } from "../scroll-bar.slint";

// A country or genre the station search can be narrowed to
export struct FilterEntry {
    name: string,
    // What the directory is asked for: a country's ISO 3166-1 code or a
    // genre's slug. Empty for "Any".
    code: string,
    station-count: int,
    // Countries only
    flag: image,
}

component FilterRow inherits Rectangle {
    in property <string> name;
    in property <int> station-count;
    in property <image> flag;
    in property <bool> show-flag;
    // The entry in force
    in property <bool> selected;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.menu-hover : transparent;
    animate background { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: list-item;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    // Enter or Space picks it
    keys := ButtonKeys {
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: stretch;

        // Flag slot keeps country names aligned even when one has no flag
        if root.show-flag: Rectangle {
            width: 20px;

            if root.flag.width > 0: Image {
                source: root.flag;
                width: 20px;
                height: 15px;
                image-fit: contain;
            }
        }

        Text {
            text: root.name;
            color: root.selected ? Theme.accent-text : Theme.text-primary;
            font-weight: root.selected ? 600 : 400;
            font-size: Theme.font-base;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: root.station-count > 0 ? "\{root.station-count}" : "";
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 50px;
        }
    }
}

// Pick the country or genre the station search is narrowed to
export component FilterPickerDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    // "country" or "genre"
    in-out property <string> kind: "country";
    // Code of the entry in force, empty for Any
    in-out property <string> selected-code: "";
    in-out property <bool> loading: false;
    in-out property <string> error: "";
    in-out property <[FilterEntry]> entries: [];
    in-out property <string> filter-text: "";

    // An entry was picked (empty code: Any)
    callback entry-selected(FilterEntry);
    // Closed without picking
    callback dismissed();
    callback load-entries(string);
    // Show only entries whose name contains the text
    callback filter-entries(string);

    property <string> noun: root.kind == "genre" ? "genre" : "country";
    property <string> plural: root.kind == "genre" ? "genres" : "countries";

    function pick(entry: FilterEntry) {
        root.show-dialog = false;
        root.entry-selected(entry);
    }

    if show-dialog: DialogShell {
        title: root.kind == "genre" ? "Genre" : "Country";
        subtitle: root.loading ? "" : "\{root.entries.length} \{root.plural}";
        card-width: Defaults.filter-picker-width;
        card-height: Defaults.filter-picker-height;
        auto-focus: false;
        show-back: true;
        back-requested => {
            root.show-dialog = false;
            root.dismissed();
        }
        close-requested => {
            root.show-dialog = false;
            root.dismissed();
        }

        filter-input := StyledLineEdit {
            placeholder-text: "Filter \{root.plural}...";
            clearable: true;
            init => { self.focus-input(); }
            text <=> root.filter-text;
            edited(text) => { root.filter-entries(text); }
            cleared => { root.filter-entries(""); }
            accepted(text) => {
                if root.entries.length == 1 {
                    root.pick(root.entries[0]);
                }
            }
        }

        // Content area
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            border-radius: Theme.radius-sm;
            background: Theme.surface;

            // Loading state
            if root.loading: Text {
                text: "Loading \{root.plural}...";
                color: Theme.text-secondary;
                font-size: Theme.font-base;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Error state, with a way to ask again
            if root.error != "" && !root.loading: VerticalLayout {
                alignment: center;
                spacing: 6px;

                Text {
                    text: root.error;
                    color: Theme.danger;
                    font-size: Theme.font-base;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    padding-top: 6px;

                    SecondaryButton {
                        label: "Try again";
                        clicked => {
                            root.loading = true;
                            root.load-entries(root.kind);
                            // The button goes away while it loads: keep the
                            // focus in the dialog so Esc still closes it
                            if self.has-focus {
                                filter-input.focus-input();
                            }
                        }
                    }
                }
            }

            // The list, with Any first while nothing is typed
            if root.entries.length > 0 && !root.loading: Rectangle {
                entry-flick := Flickable {
                    content-height: entry-layout.preferred-height;

                    entry-layout := VerticalLayout {
                        padding: 4px;

                        if root.filter-text == "": FilterRow {
                            name: "Any \{root.noun}";
                            show-flag: root.kind == "country";
                            selected: root.selected-code == "";
                            clicked => {
                                root.pick({ name: "", code: "", station-count: 0 });
                            }
                        }

                        for entry in root.entries: FilterRow {
                            name: entry.name;
                            station-count: entry.station-count;
                            flag: entry.flag;
                            show-flag: root.kind == "country";
                            selected: entry.code == root.selected-code;
                            clicked => { root.pick(entry); }
                        }
                    }
                }

                ScrollBar {
                    x: parent.width - self.width - 2px;
                    y: 4px;
                    height: parent.height - 8px;
                    viewport-height: entry-flick.height;
                    content-height: entry-flick.content-height;
                    content-y <=> entry-flick.content-y;
                }
            }

            // No match for the filter
            if root.entries.length == 0 && !root.loading && root.error == ""
                && root.filter-text != "": Text {
                text: "No \{root.plural} match \"\{root.filter-text}\"";
                color: Theme.text-secondary;
                font-size: Theme.font-base;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
