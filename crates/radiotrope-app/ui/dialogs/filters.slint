import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, Toggle, Picker, InfoTip, PopupBounds } from "../components.slint";

// One filter: its name with an ⓘ that says what it does, and its switch on
// the right. A filter with a control of its own (the leveler's levels) has
// that in place of the switch.
component FilterRow inherits HorizontalLayout {
    in property <string> name;
    in property <string> info;
    in property <PopupBounds> popup-bounds;
    // The first row's bubble opens below, so the dialog doesn't cut it off
    in property <bool> info-below: false;
    in property <bool> show-info;
    // False when the row's own control takes the switch's place
    in property <bool> has-switch: true;
    in-out property <bool> checked;
    callback toggled(bool);

    spacing: Theme.space-16;
    padding-top: Theme.space-12;
    padding-bottom: Theme.space-12;

    // Over the controls beside and under it, so its bubble isn't hidden
    HorizontalLayout {
        z: 1;
        horizontal-stretch: 1;
        spacing: Theme.space-6;
        alignment: start;

        Text {
            text: root.name;
            color: Theme.text-primary;
            font-size: Theme.font-base;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            InfoTip {
                text: root.info;
                open: root.show-info;
                popup-bounds: root.popup-bounds;
                open-right: true;
                open-below: root.info-below;
            }
        }
    }

    VerticalLayout {
        alignment: center;
        @children
        if root.has-switch: Toggle {
            label: root.name;
            show-label: false;
            checked <=> root.checked;
            toggled(on) => { root.toggled(on); }
        }
    }
}

component Line inherits Rectangle {
    height: 1px;
    background: Theme.hairline;
}

// The filters, each with its own switch; the Volume Leveler has its levels
// and Off, the Hiss Reducer its strengths and Off. What the leveler does to
// the station playing shows after its channels in the header.
export component FiltersDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <bool> show-leveler-info;
    in-out property <bool> leveler-on: true;
    // "quiet", "normal" or "loud"
    in-out property <string> level-target: "normal";
    // "off", "light" or "strong"
    in-out property <string> hiss-reducer: "off";
    in-out property <bool> hum-filter: true;
    in-out property <bool> rumble-filter: true;
    in-out property <bool> smooth-switching: true;

    callback leveler-toggled(bool);
    callback level-target-changed(string);
    callback hiss-reducer-changed(string);
    callback hum-filter-toggled(bool);
    callback rumble-filter-toggled(bool);
    callback smooth-switching-toggled(bool);

    // The leveler's pill: "off", or its level
    property <string> level-pick: "normal";
    function show-level() {
        root.level-pick = root.leveler-on ? root.level-target : "off";
    }
    init => { root.show-level(); }
    changed leveler-on => { root.show-level(); }
    changed level-target => { root.show-level(); }

    if show-dialog: shell := DialogShell {
        title: "Filters";
        subtitle: "Cleans up the sound as it plays";
        card-width: Defaults.dialog-width;
        close-requested => { root.show-dialog = false; }

        VerticalLayout {
            FilterRow {
                popup-bounds: shell.popup-bounds;
                // Its bubble opens over the rows below
                z: 2;
                name: "Volume Leveler";
                info: "Plays every station at a similar loudness, so you don't need the volume knob when you switch. Pick how loud they play.";
                info-below: true;
                show-info: root.show-leveler-info;
                has-switch: false;

                Picker {
                    choices: [
                        { id: "off", label: "Off" },
                        { id: "quiet", label: "Quiet" },
                        { id: "normal", label: "Normal" },
                        { id: "loud", label: "Loud" },
                    ];
                    selected <=> root.level-pick;
                    changed(id) => {
                        if id == "off" {
                            root.leveler-on = false;
                            root.leveler-toggled(false);
                        } else {
                            root.level-target = id;
                            root.level-target-changed(id);
                            if !root.leveler-on {
                                root.leveler-on = true;
                                root.leveler-toggled(true);
                            }
                        }
                    }
                }
            }
            Line { }
            FilterRow {
                popup-bounds: shell.popup-bounds;
                // Its bubble also opens below, under the leveler's
                z: 1;
                name: "Hiss Reducer";
                info: "Turns down background hiss and static. Strong removes more but can make music sound watery.";
                info-below: true;
                has-switch: false;

                Picker {
                    choices: [
                        { id: "off", label: "Off" },
                        { id: "light", label: "Light" },
                        { id: "strong", label: "Strong" },
                    ];
                    selected <=> root.hiss-reducer;
                    changed(id) => { root.hiss-reducer-changed(id); }
                }
            }
            Line { }
            FilterRow {
                popup-bounds: shell.popup-bounds;
                name: "Hum Filter";
                info: "Removes the low electrical buzz some stations carry, only when it hears one.";
                checked <=> root.hum-filter;
                toggled(on) => { root.hum-filter-toggled(on); }
            }
            Line { }
            FilterRow {
                popup-bounds: shell.popup-bounds;
                name: "Rumble Filter";
                info: "Cuts deep rumble you can't hear, so your speakers play cleaner.";
                checked <=> root.rumble-filter;
                toggled(on) => { root.rumble-filter-toggled(on); }
            }
            Line { }
            FilterRow {
                popup-bounds: shell.popup-bounds;
                name: "Smooth Switching";
                info: "Fades out when you change or stop a station, instead of cutting off.";
                checked <=> root.smooth-switching;
                toggled(on) => { root.smooth-switching-toggled(on); }
            }
        }
    }
}
