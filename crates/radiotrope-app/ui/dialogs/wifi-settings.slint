// Wi-Fi on the Raspberry Pi: a full-screen page with the networks in
// range, a sheet with the details and actions of a tapped network, and the
// on-screen keyboard rising from the bottom for a password. The page only
// shows and asks; the iwd thread (src/wifi) answers through the app's
// wifi-* properties.
import { Theme } from "../defaults.slint";
import { Icon, IconButton, Toggle } from "../components.slint";
import { AccentButton, SecondaryButton, DangerButton } from "../buttons.slint";
import { ScrollBar } from "../scroll-bar.slint";
import { VirtualKeyboard } from "../virtual-keyboard.slint";

export struct WifiNetworkEntry {
    ssid: string,
    // 0-4
    signal-bars: int,
    // "Good (-61 dBm)"
    signal-text: string,
    security: string,
    open: bool,
    connected: bool,
    // Saved in iwd (auto-connects)
    known: bool,
    object-path: string,
}

// Four bars, the lit ones for the strength
component SignalBars inherits Rectangle {
    in property <int> bars;
    in property <bool> dim: false;

    width: 22px;
    height: 18px;

    HorizontalLayout {
        spacing: 2px;
        alignment: start;

        for i in 4: Rectangle {
            y: parent.height - self.height;
            width: 4px;
            height: 6px + i * 4px;
            border-radius: 1px;
            background: i < root.bars ? Theme.text-primary : Theme.text-tertiary;
            opacity: root.dim ? 0.45 : i < root.bars ? 1 : 0.35;
        }
    }
}

export component WifiSettingsDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in property <bool> is-scanning: false;
    in property <string> current-ssid: "";
    // A line for a few seconds: "Connected to Home", "Wrong password..."
    in property <string> connection-status: "";
    in property <bool> status-is-error: false;
    // The radio is on
    in property <bool> powered: false;
    // Our address, "" while there is none
    in property <string> ip: "";
    // "no-adapter", "off", "disconnected", "connecting" or "connected"
    in property <string> state: "no-adapter";
    in property <[WifiNetworkEntry]> networks: [];
    // Something is playing: a disconnect stops it, so it asks twice
    in property <bool> playing: false;
    // Finger scrolling of the list (the Pi)
    in property <bool> touch-scroll: false;

    callback scan-requested();
    callback connect-requested(string, string); // object-path, password
    callback disconnect-requested();
    callback forget-requested(string); // object-path
    callback power-requested(bool);
    callback close-requested();
    callback wifi-backspace-requested(string) -> string;
    // The password as dots, for the field
    pure callback mask-requested(string) -> string;

    // The row tapped last (its sheet is open), -1 for none
    property <int> selected: -1;
    property <bool> show-password: false;
    property <bool> password-visible: false;
    // What was typed: kept for a retry after a wrong password, dropped on
    // Cancel, on success and when the page closes
    property <string> password-draft: "";
    changed connection-status => {
        if root.connection-status != "" && !root.status-is-error {
            root.password-draft = "";
        }
    }
    // Disconnect asks twice while something plays
    property <bool> disconnect-armed: false;
    property <bool> has-selection: root.selected >= 0 && root.selected < root.networks.length;
    property <WifiNetworkEntry> picked: root.has-selection ? root.networks[root.selected] : {};
    property <string> headline: root.state == "connected" && root.current-ssid != ""
        ? root.current-ssid + (root.ip != "" ? "  ·  " + root.ip : "")
        : root.state == "connecting" ? "Connecting to " + root.current-ssid
        : root.state == "off" ? "Wi-Fi is off"
        : root.state == "no-adapter" ? "No Wi-Fi adapter"
        : "Not connected";

    function close() {
        root.show-password = false;
        root.password-draft = "";
        root.selected = -1;
        root.disconnect-armed = false;
        root.show-dialog = false;
        root.close-requested();
    }

    function close-sheet() {
        root.selected = -1;
        root.disconnect-armed = false;
    }

    // What tapping Connect does for the picked network
    function connect-picked() {
        if root.picked.open || root.picked.known {
            root.connect-requested(root.picked.object-path, "");
            root.close-sheet();
        } else {
            root.show-password = true;
        }
    }

    if root.show-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.surface;

        // Esc closes the sheet first, then the page. The scope holds the
        // whole page, so Esc reaches it from a button that took the focus
        FocusScope {
            focus-on-click: false;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    if root.show-password {
                        root.show-password = false;
                        root.password-draft = "";
                    } else if root.selected >= 0 {
                        root.close-sheet();
                    } else {
                        root.close();
                    }
                    return accept;
                }
                return reject;
            }

        VerticalLayout {
            // ── Header ──
            Rectangle {
                height: 52px;
                background: Theme.panel;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.hairline;
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        Icon {
                            width: 20px;
                            height: 20px;
                            source: @image-url("../icons/wifi.svg");
                            colorize: root.powered ? Theme.accent-text : Theme.text-tertiary;
                        }
                    }

                    Text {
                        text: "Wi-Fi";
                        color: Theme.text-primary;
                        font-size: Theme.font-title;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    // The connection, as a chip (a plain box takes the
                    // layout's width; the chip sizes to its text inside it)
                    Rectangle {
                        horizontal-stretch: 1;

                        Rectangle {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            width: min(chip.preferred-width + 20px, parent.width);
                            height: 28px;
                            border-radius: Theme.radius-md;
                            background: root.state == "connected" ? Theme.accent-soft : Theme.elevated;
                            clip: true;

                            chip := HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: start;

                                if root.state == "connected" || root.state == "connecting": VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.state == "connected" ? Theme.success : Theme.accent;
                                    }
                                }

                                Text {
                                    text: root.headline;
                                    color: root.state == "connected" ? Theme.accent-text : Theme.text-secondary;
                                    font-size: Theme.font-md;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("../icons/rotate-right.svg");
                            label: "Scan";
                            icon-size: 15px;
                            width: 34px;
                            height: 34px;
                            enabled: root.powered && !root.is-scanning;
                            clicked => { root.scan-requested(); }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Toggle {
                            label: "Wi-Fi";
                            checked: root.powered;
                            enabled: root.state != "no-adapter";
                            toggled(on) => { root.power-requested(on); }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("../icons/xmark.svg");
                            label: "Close";
                            icon-size: 12px;
                            width: 34px;
                            height: 34px;
                            clicked => { root.close(); }
                        }
                    }
                }
            }

            // ── Status line ──
            if root.connection-status != "": Rectangle {
                height: 34px;
                background: root.status-is-error ? Theme.danger.with-alpha(0.14) : Theme.accent-soft;

                Text {
                    x: 14px;
                    width: parent.width - 28px;
                    height: parent.height;
                    text: root.connection-status;
                    color: root.status-is-error ? Theme.danger : Theme.accent-text;
                    font-size: Theme.font-base;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // ── The list ──
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                // Nothing to list: say why
                if root.networks.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    padding: 24px;

                    Text {
                        text: root.state == "no-adapter" ? "No Wi-Fi adapter found"
                            : root.state == "off" ? "Wi-Fi is off"
                            : root.is-scanning ? "Looking for networks..."
                            : "No networks found";
                        color: Theme.text-primary;
                        font-size: Theme.font-lg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.state == "no-adapter" ? "iwd is not running, or the adapter is missing"
                            : root.state == "off" ? "Turn Wi-Fi on to see networks"
                            : root.is-scanning ? ""
                            : "Tap the refresh button to look again";
                        color: Theme.text-secondary;
                        font-size: Theme.font-base;
                        horizontal-alignment: center;
                    }
                }

                flick := Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: rows.preferred-height;
                    interactive: root.touch-scroll && root.selected < 0;

                    rows := VerticalLayout {
                        width: flick.width;
                        alignment: start;

                        for network[i] in root.networks: Rectangle {
                            height: 64px;
                            background: row-ta.pressed ? Theme.menu-hover
                                : network.connected ? Theme.accent-soft.with-alpha(0.08)
                                : transparent;
                            animate background { duration: Theme.fast; }
                            opacity: root.powered ? 1 : 0.45;

                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.hairline;
                            }

                            row-ta := TouchArea {
                                enabled: root.powered && root.selected < 0;
                                clicked => {
                                    root.selected = i;
                                    root.disconnect-armed = false;
                                }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    SignalBars {
                                        bars: network.signal-bars;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: network.ssid;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-xl;
                                        font-weight: 500;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: network.connected ? "Connected" + (root.ip != "" ? "  ·  " + root.ip : "")
                                            : network.known ? "Saved  ·  " + network.security
                                            : network.open ? "Open network"
                                            : network.security;
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-sm;
                                        overflow: elide;
                                    }
                                }

                                if !network.open: VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        width: 14px;
                                        height: 14px;
                                        source: @image-url("../icons/lock.svg");
                                        colorize: Theme.text-secondary;
                                    }
                                }

                                if network.connected: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: badge.preferred-width + 14px;
                                        height: 22px;
                                        border-radius: Theme.radius-sm;
                                        background: Theme.accent-soft;
                                        badge := Text {
                                            text: "Connected";
                                            color: Theme.accent-text;
                                            font-size: Theme.font-xs;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        width: 14px;
                                        height: 14px;
                                        source: @image-url("../icons/chevron-right.svg");
                                        colorize: Theme.text-tertiary;
                                    }
                                }
                            }
                        }
                    }
                }

                ScrollBar {
                    x: parent.width - self.width - 3px;
                    y: 6px;
                    height: parent.height - 12px;
                    viewport-height: flick.height;
                    content-height: flick.content-height;
                    content-y <=> flick.content-y;
                }
            }
        }

        // ── The sheet for a tapped network ──
        if root.has-selection && !root.show-password: Rectangle {
            background: Theme.scrim;
            TouchArea {
                clicked => { root.close-sheet(); }
            }
        }

        if root.has-selection && !root.show-password: Rectangle {
            y: parent.height - self.height;
            height: sheet.preferred-height;
            background: Theme.card;
            border-radius: Theme.radius-lg;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: -4px;
            drop-shadow-color: Theme.shadow;

            // Square the bottom corners (the sheet sits on the edge)
            Rectangle {
                y: parent.height - Theme.radius-lg;
                height: Theme.radius-lg;
                background: Theme.card;
            }

            Rectangle {
                height: 1px;
                background: Theme.hairline;
            }

            TouchArea {}

            sheet := VerticalLayout {
                padding: 16px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        SignalBars {
                            bars: root.picked.signal-bars;
                        }
                    }

                    Text {
                        text: root.picked.ssid;
                        color: Theme.text-primary;
                        font-size: Theme.font-station;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    if root.picked.connected: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: sheet-badge.preferred-width + 14px;
                            height: 22px;
                            border-radius: Theme.radius-sm;
                            background: Theme.accent-soft;
                            sheet-badge := Text {
                                text: "Connected";
                                color: Theme.accent-text;
                                font-size: Theme.font-xs;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Details in two columns
                HorizontalLayout {
                    spacing: 24px;

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Signal";
                            color: Theme.text-secondary;
                            font-size: Theme.font-base;
                            width: 70px;
                        }
                        Text {
                            text: root.picked.signal-text;
                            color: Theme.text-primary;
                            font-size: Theme.font-base;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Security";
                            color: Theme.text-secondary;
                            font-size: Theme.font-base;
                            width: 70px;
                        }
                        Text {
                            text: root.picked.security;
                            color: Theme.text-primary;
                            font-size: Theme.font-base;
                        }
                    }
                    if root.picked.connected && root.ip != "": HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Address";
                            color: Theme.text-secondary;
                            font-size: Theme.font-base;
                            width: 70px;
                        }
                        Text {
                            text: root.ip;
                            color: Theme.text-primary;
                            font-size: Theme.font-base;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                if root.picked.known && !root.picked.connected: Text {
                    text: "Saved: the player joins this network by itself when it is in range.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-sm;
                    wrap: word-wrap;
                }

                // Three buttons of the same width across the sheet
                actions := HorizontalLayout {
                    spacing: 10px;
                    padding-top: 4px;
                    property <length> button-width: (self.width - 2 * self.spacing) / 3;

                    SecondaryButton {
                        label: "Cancel";
                        height: 44px;
                        width: actions.button-width;
                        clicked => { root.close-sheet(); }
                    }

                    // Greyed when there is nothing saved to forget
                    SecondaryButton {
                        label: "Forget";
                        height: 44px;
                        width: actions.button-width;
                        enabled: root.picked.known;
                        clicked => {
                            root.forget-requested(root.picked.object-path);
                            root.close-sheet();
                        }
                    }

                    if root.picked.connected: DangerButton {
                        label: root.disconnect-armed ? "Press Again to Disconnect" : "Disconnect";
                        height: 44px;
                        width: actions.button-width;
                        clicked => {
                            if root.playing && !root.disconnect-armed {
                                root.disconnect-armed = true;
                            } else {
                                root.disconnect-requested();
                                root.close-sheet();
                            }
                        }
                    }

                    if !root.picked.connected: AccentButton {
                        label: root.picked.open || root.picked.known ? "Connect" : "Connect...";
                        height: 44px;
                        width: actions.button-width;
                        enabled: root.state != "connecting";
                        clicked => { root.connect-picked(); }
                    }
                }

                if root.playing && root.picked.connected: Text {
                    text: "Playback stops when the player leaves the network.";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-sm;
                    horizontal-alignment: center;
                }
            }
        }

        // ── Password: the field and the keyboard ──
        if root.show-password: Rectangle {
            background: Theme.scrim;
            TouchArea {
                clicked => { root.show-password = false; }
            }
        }

        if root.show-password: Rectangle {
            y: parent.height - self.height;
            height: password-layout.preferred-height;
            background: Theme.panel;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: -4px;
            drop-shadow-color: Theme.shadow;

            Rectangle {
                height: 1px;
                background: Theme.hairline;
            }

            TouchArea {}

            password-layout := VerticalLayout {
                spacing: 0;

                // The network on its own line, cut short when it is long,
                // so the field below always has the full width
                VerticalLayout {
                    padding-top: 10px;
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: "Password for " + root.picked.ssid;
                        color: Theme.text-secondary;
                        font-size: Theme.font-base;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    padding: 6px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;

                    Rectangle {
                        height: 44px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.accent;
                        background: Theme.elevated;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 44px;
                            spacing: 2px;

                            Text {
                                text: keyboard.text == "" ? "Enter password"
                                    : root.password-visible ? keyboard.text
                                    : root.mask-requested(keyboard.text);
                                color: keyboard.text == "" ? Theme.text-tertiary : Theme.text-primary;
                                font-size: 18px;
                                letter-spacing: keyboard.text != "" && !root.password-visible ? 2px : 0;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 2px;
                                    height: 22px;
                                    background: Theme.accent;
                                }
                            }
                        }

                        IconButton {
                            x: parent.width - self.width - 6px;
                            y: (parent.height - self.height) / 2;
                            width: 34px;
                            height: 34px;
                            icon: root.password-visible ? @image-url("../icons/eye-slash.svg") : @image-url("../icons/eye.svg");
                            label: root.password-visible ? "Hide password" : "Show password";
                            icon-size: 16px;
                            clicked => { root.password-visible = !root.password-visible; }
                        }
                    }

                    SecondaryButton {
                        label: "Cancel";
                        height: 44px;
                        clicked => {
                            root.show-password = false;
                            root.password-draft = "";
                        }
                    }

                    AccentButton {
                        label: "Connect";
                        height: 44px;
                        enabled: keyboard.text.character-count >= 8;
                        clicked => { keyboard.submitted(keyboard.text); }
                    }
                }

                keyboard := VirtualKeyboard {
                    text <=> root.password-draft;
                    min-length: 8;
                    done-label: "Connect";
                    submitted(password) => {
                        root.show-password = false;
                        root.connect-requested(root.picked.object-path, password);
                        root.close-sheet();
                    }
                    backspace() => {
                        self.text = root.wifi-backspace-requested(self.text);
                    }
                }
            }
        }
        }
    }
}
