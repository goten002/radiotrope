import { Theme, Defaults } from "../defaults.slint";
import { SecondaryButton, DangerButton, AccentButton } from "../buttons.slint";
import { DialogShell, Toggle, ButtonKeys, FocusRing } from "../components.slint";

// A round − or + next to the length
component StepButton inherits Rectangle {
    in property <string> label;
    in property <string> name;
    in property <bool> enabled: true;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: 18px;
    border-width: 1px;
    border-color: Theme.hairline;
    background: !root.enabled ? Theme.disabled-bg
        : touch.pressed ? Theme.menu-hover.darker(0.05)
        : touch.has-hover ? Theme.menu-hover
        : Theme.elevated;
    animate background { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: button;
    accessible-label: root.name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    Text {
        text: root.label;
        color: root.enabled ? Theme.text-primary : Theme.disabled-text;
        font-size: 18px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

// A length to pick; it sets the length, Start begins it
component LengthChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 26px;
    width: chip-text.preferred-width + 22px;
    border-radius: 13px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.hairline;
    background: root.selected ? Theme.accent-soft
        : touch.has-hover ? Theme.menu-hover
        : transparent;
    animate background, border-color { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }

    chip-text := Text {
        text: root.label;
        color: root.selected || touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        font-size: Theme.font-md;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

// Stops playback after a while. One length, changed with − and +, the
// wheel or the arrow keys (5 minute steps) or set by a chip, and one Start.
// It opens on the length used last time. While running it shows the time
// left, Restart and Stop Timer.
export component SleepTimerDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    // A timer runs
    in property <bool> active;
    // Time left, "23:12" or "1:02:03"
    in property <string> left;
    // When it stops, "23:30"
    in property <string> until;
    // Seconds left and the length it started with, for the bar
    in property <int> left-secs;
    in property <int> length-minutes;
    // The length started last time, in minutes (the dialog opens on it)
    in property <int> last: 30;
    in-out property <bool> fade: true;

    callback start(int);
    callback turn-off();
    callback fade-toggled(bool);

    // The length to start, in minutes
    property <int> length: 30;
    property <[int]> lengths: [15, 30, 45, 60, 120, 180, 240, 360];

    public function open() {
        root.length = root.clamped(root.last);
        root.show-dialog = true;
    }

    pure function clamped(minutes: int) -> int {
        clamp(minutes, Defaults.sleep-step-minutes, Defaults.sleep-max-minutes)
    }

    // Five minutes more or less, onto the 5 minute steps
    function bump(steps: int) {
        let step = Defaults.sleep-step-minutes;
        let base = steps > 0 ? floor(root.length / step) * step : ceil(root.length / step) * step;
        root.length = root.clamped(base + steps * step);
    }

    // "1 h 30 min", "45 min", "2 h"
    pure function length-label(total: int) -> string {
        let h = floor(total / 60);
        let m = mod(total, 60);
        if h == 0 {
            return m + " min";
        }
        if m == 0 {
            return h + " h";
        }
        h + " h " + m + " min"
    }

    if show-dialog: DialogShell {
        title: "Sleep Timer";
        card-width: Defaults.sleep-timer-width;
        close-requested => { root.show-dialog = false; }

        // ── Off: pick a length ──
        if !root.active: HorizontalLayout {
            alignment: center;
            spacing: 14px;

            VerticalLayout {
                alignment: center;
                StepButton {
                    label: "−";
                    name: "5 minutes less";
                    enabled: root.length > Defaults.sleep-step-minutes;
                    clicked => { root.bump(-1); }
                }
            }

            readout := FocusScope {
                width: Defaults.sleep-readout-width;
                height: 44px;
                accessible-role: spinbox;
                accessible-label: "Length";
                accessible-value: root.length-label(root.length);
                accessible-action-increment => { root.bump(1); }
                accessible-action-decrement => { root.bump(-1); }

                key-pressed(event) => {
                    if event.text == Key.UpArrow || event.text == Key.RightArrow {
                        root.bump(1);
                        return accept;
                    }
                    if event.text == Key.DownArrow || event.text == Key.LeftArrow {
                        root.bump(-1);
                        return accept;
                    }
                    if event.text == Key.Return {
                        root.start(root.length);
                        return accept;
                    }
                    reject
                }

                TouchArea {
                    clicked => { readout.focus(); }
                    scroll-event(event) => {
                        if event.delta-y > 0 {
                            root.bump(1);
                            return accept;
                        }
                        if event.delta-y < 0 {
                            root.bump(-1);
                            return accept;
                        }
                        reject
                    }
                }

                Text {
                    text: root.length-label(root.length);
                    color: Theme.text-primary;
                    font-size: 30px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                if readout.has-focus: FocusRing {
                    radius: Theme.radius-md;
                }
            }

            VerticalLayout {
                alignment: center;
                StepButton {
                    label: "+";
                    name: "5 minutes more";
                    enabled: root.length < Defaults.sleep-max-minutes;
                    clicked => { root.bump(1); }
                }
            }
        }

        if !root.active: HorizontalLayout {
            alignment: center;
            spacing: 6px;

            for minutes in root.lengths: LengthChip {
                label: root.length-label(minutes);
                selected: root.length == minutes;
                clicked => { root.length = minutes; }
            }
        }

        // Full width: the one way to begin
        if !root.active: Rectangle {
            height: 34px;

            AccentButton {
                width: parent.width;
                label: "Start " + root.length-label(root.length);
                icon: @image-url("../icons/play.svg");
                clicked => { root.start(root.length); }
            }
        }

        // ── Running: the time left ──
        if root.active: VerticalLayout {
            spacing: 4px;

            Text {
                text: root.left;
                color: Theme.text-primary;
                font-size: 34px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: "Stops at " + root.until;
                color: Theme.text-secondary;
                font-size: Theme.font-md;
                horizontal-alignment: center;
            }
        }

        if root.active: Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.elevated;

            Rectangle {
                x: 0;
                width: parent.width * clamp(root.left-secs / max(1, root.length-minutes * 60), 0, 1);
                border-radius: 2px;
                background: Theme.accent;
            }
        }

        if root.active: HorizontalLayout {
            spacing: 8px;

            SecondaryButton {
                label: "Restart " + root.length-label(root.length-minutes);
                icon: @image-url("../icons/rotate-right.svg");
                clicked => { root.start(root.length-minutes); }
            }
            Rectangle { horizontal-stretch: 1; }
            DangerButton {
                label: "Stop Timer";
                icon: @image-url("../icons/stop.svg");
                clicked => { root.turn-off(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        Toggle {
            label: "Fade out";
            checked <=> root.fade;
            toggled(on) => { root.fade-toggled(on); }
        }
    }
}
