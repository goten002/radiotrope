import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, Toggle, ButtonKeys, FocusRing } from "../components.slint";

// A round − or + next to the length
component StepButton inherits Rectangle {
    in property <image> icon;
    in property <string> name;
    in property <bool> enabled: true;
    callback clicked();

    width: Theme.control-field;
    height: Theme.control-field;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: Theme.field-border;
    background: !root.enabled ? Theme.disabled-bg
        : touch.pressed ? Theme.pressed-bg
        : touch.has-hover ? Theme.hover-bg
        : Theme.elevated;
    animate background { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: button;
    accessible-label: root.name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    // An icon, not a "−" or "+" glyph: the font sets those off centre
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.icon-compact;
        height: Theme.icon-compact;
        source: root.icon;
        colorize: root.enabled ? Theme.text-primary : Theme.disabled-text;
        accessible-role: none;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

// A length to pick; it sets the length, Start begins it
component LengthChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 32px;
    width: chip-text.preferred-width + 30px;
    border-radius: Theme.radius-md;
    // Selected looks like a Picker's choice: accent fill, on-accent text
    border-width: root.selected ? 0px : 1px;
    border-color: Theme.field-border;
    background: root.selected
        ? (touch.pressed ? Theme.accent-fill-pressed : touch.has-hover ? Theme.accent-fill-hover : Theme.accent-fill)
        : touch.pressed ? Theme.pressed-bg
        : touch.has-hover ? Theme.hover-bg
        : transparent;
    animate background { duration: Theme.fast; }
    forward-focus: keys;

    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }

    chip-text := Text {
        text: root.label;
        color: !root.selected ? Theme.text-primary
            : touch.pressed ? Theme.on-accent-pressed
            : touch.has-hover ? Theme.on-accent-hover : Theme.on-accent;
        font-size: Theme.font-lg;
        font-weight: root.selected ? Theme.weight-semibold : Theme.weight-regular;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        activated => { root.clicked(); }
    }

    if keys.has-focus: FocusRing {
        radius: root.border-radius;
    }
}

// Stops playback after a while. One length, changed with − and +, the
// wheel or the arrow keys (15 minute steps, 5 below 15 minutes) or set by a
// chip, and one Start.
// It opens on the length used last time. While running it shows the time
// left, Restart and Stop Timer.
export component SleepTimerDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    // A timer runs
    in property <bool> active;
    // Time left, "23:12" or "1:02:03"
    in property <string> left;
    // When it stops, "23:30"
    in property <string> until;
    // Seconds left and the length it started with, for the bar
    in property <int> left-secs;
    in property <int> length-minutes;
    // The length started last time, in minutes (the dialog opens on it)
    in property <int> last: 30;
    in-out property <bool> fade: true;
    // A station plays (or is starting): without one there is nothing for
    // the timer to stop, so Start waits for one
    in property <bool> playing: true;

    callback start(int);
    callback turn-off();
    callback fade-toggled(bool);

    // The length to start, in minutes
    property <int> length: 30;
    property <[int]> lengths: [15, 30, 45, 60, 120];

    public function open() {
        root.length = root.clamped(root.last);
        root.show-dialog = true;
    }

    pure function clamped(minutes: int) -> int {
        clamp(minutes, Defaults.sleep-step-minutes, Defaults.sleep-max-minutes)
    }

    // The step − (-1) or + (1) takes: 5 minutes below 15, else 15
    pure function step(steps: int) -> int {
        let big = Defaults.sleep-big-step-minutes;
        (steps > 0 && root.length < big) || (steps < 0 && root.length <= big)
            ? Defaults.sleep-step-minutes : big
    }

    // One step more or less, onto that step's grid (12 goes to 10 or 15,
    // 20 to 15 or 30)
    function bump(steps: int) {
        let step = root.step(steps);
        let base = steps > 0 ? floor(root.length / step) * step : ceil(root.length / step) * step;
        root.length = root.clamped(base + steps * step);
    }

    // "1 h 30 min", "45 min", "2 h"
    pure function length-label(total: int) -> string {
        let h = floor(total / 60);
        let m = mod(total, 60);
        if h == 0 {
            return m + " min";
        }
        if m == 0 {
            return h + " h";
        }
        h + " h " + m + " min"
    }

    // Start and Stop Timer go away when pressed, so the dialog takes the
    // focus back and Esc still closes it
    function begin(minutes: int) {
        if root.playing {
            root.start(minutes);
        }
    }

    if show-dialog: shell := DialogShell {
        title: "Sleep Timer";
        subtitle: "Stops playback after a set time";
        card-width: Defaults.sleep-timer-width;
        close-requested => { root.show-dialog = false; }

        // Footer: Start when off; Stop Timer at the left and Restart at
        // the right while it runs
        primary-label: root.active ? "" : "Start " + root.length-label(root.length);
        primary-enabled: root.playing;
        primary-requested => {
            root.begin(root.length);
            self.take-focus();
        }
        destructive-label: root.active ? "Stop Timer" : "";
        destructive-requested => {
            root.turn-off();
            self.take-focus();
        }
        cancel-label: root.active ? "Restart " + root.length-label(root.length-minutes) : "";
        cancel-requested => { root.start(root.length-minutes); }

        // ── Off: pick a length ──
        if !root.active: HorizontalLayout {
            alignment: center;
            spacing: Theme.space-12;

            VerticalLayout {
                alignment: center;
                StepButton {
                    icon: @image-url("../icons/minus.svg");
                    name: root.step(-1) + " minutes less";
                    enabled: root.length > Defaults.sleep-step-minutes;
                    clicked => { root.bump(-1); }
                }
            }

            readout := FocusScope {
                width: Defaults.sleep-readout-width;
                height: Theme.control-touch;
                accessible-role: spinbox;
                accessible-label: "Length";
                accessible-value: root.length-label(root.length);
                accessible-action-increment => { root.bump(1); }
                accessible-action-decrement => { root.bump(-1); }

                key-pressed(event) => {
                    if event.text == Key.UpArrow || event.text == Key.RightArrow {
                        root.bump(1);
                        return accept;
                    }
                    if event.text == Key.DownArrow || event.text == Key.LeftArrow {
                        root.bump(-1);
                        return accept;
                    }
                    if event.text == Key.Return && root.playing {
                        root.begin(root.length);
                        shell.take-focus();
                        return accept;
                    }
                    reject
                }

                TouchArea {
                    clicked => { readout.focus(); }
                    scroll-event(event) => {
                        if event.delta-y > 0 {
                            root.bump(1);
                            return accept;
                        }
                        if event.delta-y < 0 {
                            root.bump(-1);
                            return accept;
                        }
                        reject
                    }
                }

                Text {
                    text: root.length-label(root.length);
                    color: Theme.text-primary;
                    font-size: Theme.font-timer;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                if readout.has-focus: FocusRing {
                    radius: Theme.radius-md;
                }
            }

            VerticalLayout {
                alignment: center;
                StepButton {
                    icon: @image-url("../icons/plus.svg");
                    name: root.step(1) + " minutes more";
                    enabled: root.length < Defaults.sleep-max-minutes;
                    clicked => { root.bump(1); }
                }
            }
        }

        if !root.active: HorizontalLayout {
            alignment: center;
            spacing: Theme.space-8;

            for minutes in root.lengths: LengthChip {
                label: root.length-label(minutes);
                selected: root.length == minutes;
                clicked => { root.length = minutes; }
            }
        }

        if !root.active && !root.playing: Text {
            text: "Start a station first.";
            color: Theme.text-secondary;
            font-size: Theme.font-md;
            horizontal-alignment: center;
        }

        // ── Running: the time left ──
        if root.active: VerticalLayout {
            spacing: Theme.space-4;

            Text {
                text: root.left;
                color: Theme.text-primary;
                font-size: Theme.font-timer;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
            }
            Text {
                text: "Stops at " + root.until;
                color: Theme.text-secondary;
                font-size: Theme.font-md;
                horizontal-alignment: center;
            }
        }

        if root.active: Rectangle {
            height: 4px;
            border-radius: self.height / 2;
            background: Theme.elevated;

            Rectangle {
                x: 0;
                width: parent.width * clamp(root.left-secs / max(1, root.length-minutes * 60), 0, 1);
                border-radius: parent.border-radius;
                background: Theme.accent-graphic;
            }
        }

        Toggle {
            label: "Fade out";
            checked <=> root.fade;
            toggled(on) => { root.fade-toggled(on); }
        }
    }
}
