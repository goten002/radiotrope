import { Theme, Defaults } from "../defaults.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { SecondaryButton, DangerButton } from "../buttons.slint";
import { DialogShell, Toggle, PickerOption } from "../components.slint";

// A whole number field: type it, or step it with Up and Down or the wheel
component NumberField inherits FocusScope {
    in-out property <string> text;
    in property <string> placeholder;
    in property <int> step: 1;
    in property <int> maximum: 99;
    callback accepted();
    callback edited();

    width: 64px;
    height: 36px;

    function bump(by: int) {
        let now = root.text.is-float() ? round(root.text.to-float()) : 0;
        root.text = max(0, min(root.maximum, now + by));
        root.edited();
    }

    capture-key-pressed(event) => {
        if event.text == Key.UpArrow {
            root.bump(root.step);
            return accept;
        }
        if event.text == Key.DownArrow {
            root.bump(-root.step);
            return accept;
        }
        reject
    }

    TouchArea {
        scroll-event(event) => {
            if event.delta-y > 0 {
                root.bump(root.step);
                return accept;
            }
            if event.delta-y < 0 {
                root.bump(-root.step);
                return accept;
            }
            reject
        }

        StyledLineEdit {
            width: parent.width;
            placeholder-text: root.placeholder;
            text <=> root.text;
            accepted => { root.accepted(); }
            edited => { root.edited(); }
        }
    }
}

// Stops playback after a while. While off it offers lengths that start
// at once, or Custom for hours and minutes of your own; while running
// it shows the time left, Restart and Stop Timer.
export component SleepTimerDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    // A timer runs
    in property <bool> active;
    // Time left, "23:12" or "1:02:03"
    in property <string> left;
    // When it stops, "23:30"
    in property <string> until;
    // Seconds left and the length it started with, for the bar
    in property <int> left-secs;
    in property <int> length-minutes;
    in-out property <bool> fade: true;

    callback start(int);
    callback turn-off();
    callback fade-toggled(bool);

    property <string> hours;
    property <string> minutes;
    property <string> error;
    // Custom picked: show the hours and minutes fields
    property <bool> custom;
    property <[int]> lengths: [15, 30, 45, 60, 90, 120];
    property <[string]> labels: ["15 min", "30 min", "45 min", "1 h", "1 h 30 min", "2 h"];

    public function open() {
        root.hours = "";
        root.minutes = "";
        root.error = "";
        root.custom = false;
        root.show-dialog = true;
    }

    // "1 h 30 min", "45 min", "2 h"
    pure function length-label(total: int) -> string {
        let h = floor(total / 60);
        let m = mod(total, 60);
        if h == 0 {
            return m + " min";
        }
        if m == 0 {
            return h + " h";
        }
        h + " h " + m + " min"
    }

    function start-custom() {
        let h = root.hours == "" ? 0 : root.hours.is-float() ? round(root.hours.to-float()) : -1;
        let m = root.minutes == "" ? 0 : root.minutes.is-float() ? round(root.minutes.to-float()) : -1;
        if h < 0 || m < 0 {
            root.error = "Type whole hours and minutes";
        } else if h * 60 + m < 1 || h * 60 + m > 1440 {
            root.error = "Pick from 1 minute to 24 hours";
        } else {
            root.error = "";
            root.start(h * 60 + m);
        }
    }

    if show-dialog: DialogShell {
        title: "Sleep Timer";
        card-width: Defaults.sleep-timer-width;
        close-requested => { root.show-dialog = false; }

        // ── Off: pick a length ──
        if !root.active: VerticalLayout {
            spacing: 6px;

            Text {
                text: "Start now for";
                color: Theme.text-secondary;
                font-size: Theme.font-md;
            }
            Rectangle {
                background: Theme.elevated;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.hairline;
                height: lengths-row.preferred-height;

                lengths-row := HorizontalLayout {
                    padding: 3px;
                    spacing: 3px;

                    for length[i] in root.lengths: PickerOption {
                        label: root.labels[i];
                        option-width: 44px;
                        horizontal-stretch: 1;
                        clicked => {
                            root.error = "";
                            root.start(length);
                        }
                    }
                    PickerOption {
                        label: "Custom";
                        option-width: 44px;
                        horizontal-stretch: 1;
                        selected: root.custom;
                        clicked => {
                            root.error = "";
                            root.custom = !root.custom;
                            // Ready to start: 30 min, changed by typing or stepping
                            if root.custom && root.hours == "" && root.minutes == "" {
                                root.hours = "0";
                                root.minutes = "30";
                            }
                        }
                    }
                }
            }
        }

        if !root.active && root.custom: VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 8px;

                NumberField {
                    text <=> root.hours;
                    placeholder: "0";
                    maximum: 24;
                    accepted => { root.start-custom(); }
                    edited => { root.error = ""; }
                }
                Text {
                    text: "h";
                    color: Theme.text-secondary;
                    font-size: Theme.font-base;
                    vertical-alignment: center;
                }
                NumberField {
                    text <=> root.minutes;
                    placeholder: "30";
                    step: 5;
                    maximum: 59;
                    accepted => { root.start-custom(); }
                    edited => { root.error = ""; }
                }
                Text {
                    text: "min";
                    color: Theme.text-secondary;
                    font-size: Theme.font-base;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    alignment: center;
                    DangerButton {
                        label: "Start";
                        icon: @image-url("../icons/play.svg");
                        tone: Theme.success;
                        enabled: root.hours != "" || root.minutes != "";
                        clicked => { root.start-custom(); }
                    }
                }
            }

            if root.error != "": Text {
                text: root.error;
                color: Theme.danger;
                font-size: Theme.font-md;
                wrap: word-wrap;
            }
        }

        // ── Running: the time left ──
        if root.active: VerticalLayout {
            spacing: 4px;

            Text {
                text: root.left;
                color: Theme.text-primary;
                font-size: 34px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: "Stops at " + root.until;
                color: Theme.text-secondary;
                font-size: Theme.font-md;
                horizontal-alignment: center;
            }
        }

        if root.active: Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.elevated;

            Rectangle {
                x: 0;
                width: parent.width * clamp(root.left-secs / max(1, root.length-minutes * 60), 0, 1);
                border-radius: 2px;
                background: Theme.accent;
            }
        }

        if root.active: HorizontalLayout {
            spacing: 8px;

            SecondaryButton {
                label: "Restart " + root.length-label(root.length-minutes);
                icon: @image-url("../icons/rotate-right.svg");
                clicked => { root.start(root.length-minutes); }
            }
            Rectangle { horizontal-stretch: 1; }
            DangerButton {
                label: "Stop Timer";
                icon: @image-url("../icons/stop.svg");
                clicked => { root.turn-off(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        Toggle {
            label: "Fade out";
            checked <=> root.fade;
            toggled(on) => { root.fade-toggled(on); }
        }
    }
}
