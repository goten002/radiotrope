import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, Field, Toggle, Picker, FocusRing } from "../components.slint";

// Left/right balance: filled from the centre to the knob, with a tick at
// the centre it snaps to. Drag or click to move it, double-click to centre
// it, arrow keys move it 5% (Shift 1%).
component BalanceSlider inherits Rectangle {
    // -100 (left only) to 100 (right only)
    in-out property <float> value;
    callback value-changed(float);

    property <float> shown: (Math.clamp(root.value, -100, 100) + 100) / 200;
    property <bool> active: touch.has-hover || touch.pressed;
    property <length> knob: root.active ? Defaults.volume-knob-active : Defaults.volume-knob;
    animate knob { duration: Theme.fast; }
    property <bool> key-focus;

    height: 28px;
    accessible-role: slider;
    accessible-label: "Balance";
    accessible-value: root.value < -0.5 ? "Left " + Math.round(-root.value) + "%"
        : root.value > 0.5 ? "Right " + Math.round(root.value) + "%" : "Centre";
    accessible-value-minimum: -100;
    accessible-value-maximum: 100;
    accessible-value-step: 5;
    accessible-action-increment => { root.set(Math.round(root.value) + 5); }
    accessible-action-decrement => { root.set(Math.round(root.value) - 5); }
    accessible-action-set-value(v) => { root.set(v.to-float()); }

    function set(v: float) {
        let c = Math.clamp(v, -100, 100);
        // Close to the centre is the centre
        root.value = Math.abs(c) < 3 ? 0 : c;
        root.value-changed(root.value);
    }

    bar := Rectangle {
        track := Rectangle {
            height: Defaults.volume-track;
            y: (bar.height - self.height) / 2;
            border-radius: self.height / 2;
            background: Theme.text-primary.with-alpha(0.12);

            // From the centre to the knob
            Rectangle {
                property <length> centre: bar.width / 2;
                property <length> at: (bar.width - root.knob) * root.shown + root.knob / 2;
                x: Math.min(self.centre, self.at);
                width: Math.abs(self.at - self.centre);
                background: Theme.accent;
            }
        }

        // The centre tick
        Rectangle {
            x: bar.width / 2 - 1px;
            y: (bar.height - 14px) / 2;
            width: 2px;
            height: 14px;
            border-radius: 1px;
            background: Theme.text-tertiary;
        }

        Rectangle {
            x: (bar.width - root.knob) * root.shown;
            y: (bar.height - root.knob) / 2;
            width: root.knob;
            height: root.knob;
            border-radius: root.knob / 2;
            background: Theme.panel;
            border-width: 2px;
            border-color: Theme.accent;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000040;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        property <float> at: Math.clamp((self.mouse-x - root.knob / 2) / (bar.width - root.knob) * 200 - 100, -100, 100);

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.key-focus = false;
                keys.focus();
            }
        }
        moved => {
            if (self.pressed) {
                root.set(self.at);
            }
        }
        clicked => { root.set(self.at); }
        double-clicked => { root.set(0); }
    }

    keys := FocusScope {
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                root.key-focus = true;
            }
        }
        key-pressed(e) => {
            root.key-focus = true;
            if (e.text == Key.RightArrow || e.text == Key.UpArrow) {
                root.set(Math.round(root.value) + (e.modifiers.shift ? 1 : 5));
                return accept;
            }
            if (e.text == Key.LeftArrow || e.text == Key.DownArrow) {
                root.set(Math.round(root.value) - (e.modifiers.shift ? 1 : 5));
                return accept;
            }
            if (e.text == Key.Home) {
                root.set(-100);
                return accept;
            }
            if (e.text == Key.End) {
                root.set(100);
                return accept;
            }
            return reject;
        }
    }

    if keys.has-focus && root.key-focus: FocusRing {
        width: bar.width;
        height: bar.height;
        radius: bar.height / 2;
    }
}

// Station volume matching and the speaker channels. The limiter, the
// rumble filter and the fades between stations have no switches: they are
// always on.
export component SoundDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <bool> level-on: true;
    // "quiet", "normal" or "loud"
    in-out property <string> level-target: "normal";
    // "none" (nothing playing), "learning", "settled"
    in property <string> level-state: "none";
    // What matching does to this station now, in dB
    in property <float> station-gain: 0;
    // "stereo", "mono" or "swap"
    in-out property <string> channels: "stereo";
    // -100 (left only) to 100 (right only)
    in-out property <float> balance: 0;

    callback level-on-toggled(bool);
    callback level-target-changed(string);
    callback channels-changed(string);
    callback balance-changed(float);

    pure function gain-text(db: float) -> string {
        let r = Math.round(Math.abs(db) * 2) / 2;
        db < -0.25 ? "turned down " + r + " dB"
            : db > 0.25 ? "turned up " + r + " dB"
            : "already at the level"
    }

    pure function balance-text(v: float) -> string {
        let r = Math.round(Math.abs(v));
        v < -0.5 ? "Left " + r + "%" : v > 0.5 ? "Right " + r + "%" : "Centre"
    }

    if show-dialog: DialogShell {
        title: "Sound";
        subtitle: "Changes are saved as you make them";
        card-width: 480px;
        close-requested => { root.show-dialog = false; }

        VerticalLayout {
            spacing: 2px;

            Toggle {
                label: "Match station volume";
                checked <=> root.level-on;
                toggled(on) => { root.level-on-toggled(on); }
            }
            HorizontalLayout {
                padding-left: 44px;

                Text {
                    text: "Turns loud stations down and quiet ones up, so the volume stays put when you switch.";
                    color: Theme.text-secondary;
                    font-size: Theme.font-md;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            padding-left: 44px;
            spacing: 16px;

            Field {
                label: "Level";
                Picker {
                    choices: [
                        { id: "quiet", label: "Quiet" },
                        { id: "normal", label: "Normal" },
                        { id: "loud", label: "Loud" },
                    ];
                    option-width: 72px;
                    selected <=> root.level-target;
                    enabled: root.level-on;
                    changed(id) => { root.level-target-changed(id); }
                }
            }
        }

        // What it does to the station playing now
        HorizontalLayout {
            padding-left: 44px;
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.level-on && root.level-state == "settled" ? Theme.accent : Theme.text-tertiary;
                }
            }
            Text {
                text: !root.level-on ? "Off: stations play at their own volume."
                    : root.level-state == "none" ? "Starts with the next station."
                    : root.level-state == "learning" ? "Learning this station's level..."
                    : "This station: " + root.gain-text(root.station-gain);
                color: root.level-on ? Theme.text-primary : Theme.text-tertiary;
                font-size: Theme.font-md;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        Field {
            label: "Channels";
            Picker {
                choices: [
                    { id: "stereo", label: "Stereo" },
                    { id: "mono", label: "Mono" },
                    { id: "swap", label: "Swap L/R" },
                ];
                option-width: 80px;
                selected <=> root.channels;
                changed(id) => { root.channels-changed(id); }
            }
        }

        Field {
            label: "Balance";
            HorizontalLayout {
                spacing: 10px;

                Text {
                    text: "L";
                    color: Theme.text-secondary;
                    font-size: Theme.font-md;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                BalanceSlider {
                    horizontal-stretch: 1;
                    value <=> root.balance;
                    value-changed(v) => { root.balance-changed(v); }
                }
                Text {
                    text: "R";
                    color: Theme.text-secondary;
                    font-size: Theme.font-md;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    width: 70px;
                    text: root.balance-text(root.balance);
                    color: Theme.text-primary;
                    font-size: Theme.font-md;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}
