import { Theme, Defaults } from "../defaults.slint";
import { FavoriteStation } from "../favorites.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { AccentButton, SecondaryButton, DangerButton } from "../buttons.slint";
import { DialogShell, Field } from "../components.slint";

export component EditFavoriteDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <string> edit-id;
    in-out property <string> edit-name;
    in-out property <string> edit-url;
    in-out property <string> edit-logo-url;
    in-out property <string> edit-country;
    // Why the last Save didn't go through (nothing was changed); cleared
    // when the URL is edited
    property <string> error;
    // Remove was clicked once: the next click removes
    property <bool> confirm-remove: false;
    property <bool> can-save: root.edit-name != "" && root.edit-url != "";

    // Saves the changes; returns why it couldn't (e.g. another favorite
    // has the URL), or "" when saved
    callback accepted(FavoriteStation) -> string;
    callback deleted(FavoriteStation);

    public function open(station: FavoriteStation) {
        self.edit-id = station.id;
        self.edit-name = station.name;
        self.edit-url = station.url;
        self.edit-logo-url = station.logo-url;
        self.edit-country = station.country;
        self.error = "";
        self.confirm-remove = false;
        self.show-dialog = true;
    }

    // Save, or Enter in any field; the dialog stays open when it fails
    function save() {
        if !root.can-save {
            return;
        }
        root.error = root.accepted(root.station());
        if root.error == "" {
            root.show-dialog = false;
        }
    }

    function station() -> FavoriteStation {
        return {
            id: root.edit-id,
            name: root.edit-name,
            url: root.edit-url,
            logo-url: root.edit-logo-url,
            country: root.edit-country,
        };
    }

    if show-dialog: DialogShell {
        title: "Edit Favorite";
        subtitle: root.edit-name;
        card-width: Defaults.edit-favorite-width;
        close-requested => { root.show-dialog = false; }

        Field {
            label: "Name";
            required: true;
            StyledLineEdit {
                placeholder-text: "Station name";
                text <=> root.edit-name;
                accepted => { root.save(); }
            }
        }

        Field {
            label: "Stream URL";
            required: true;
            StyledLineEdit {
                placeholder-text: "https://stream.example.com/radio";
                text <=> root.edit-url;
                accepted => { root.save(); }
                edited => { root.error = ""; }
            }

            if root.error != "": Text {
                text: root.error;
                color: Theme.danger;
                font-size: Theme.font-md;
                wrap: word-wrap;
            }
        }

        Field {
            label: "Logo URL";
            StyledLineEdit {
                placeholder-text: "https://example.com/logo.png";
                text <=> root.edit-logo-url;
                clearable: true;
                accepted => { root.save(); }
            }
        }

        Field {
            label: "Country";
            StyledLineEdit {
                placeholder-text: "United Kingdom, London";
                text <=> root.edit-country;
                clearable: true;
                accepted => { root.save(); }
            }
        }

        HorizontalLayout {
            padding-top: 4px;
            spacing: 8px;

            // Asks once more before removing, like the row's menu
            DangerButton {
                label: root.confirm-remove ? "Click Again to Remove" : "Remove";
                icon: @image-url("../icons/trash-can.svg");
                clicked => {
                    if root.confirm-remove {
                        root.deleted(root.station());
                        root.show-dialog = false;
                    } else {
                        root.confirm-remove = true;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            SecondaryButton {
                label: "Cancel";
                clicked => { root.show-dialog = false; }
            }

            AccentButton {
                label: "Save";
                enabled: root.can-save;
                clicked => { root.save(); }
            }
        }
    }
}
