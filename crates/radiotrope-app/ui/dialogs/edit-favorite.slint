import { Theme, Defaults } from "../defaults.slint";
import { FavoriteStation, StationStream } from "../favorites.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { DialogShell, Field, IconButton, ButtonKeys, FocusRing } from "../components.slint";
import { SecondaryButton } from "../buttons.slint";

// Changes to the dialog's list of streams, worked out in Rust (a list
// can't be changed in place here)
export global StreamEdit {
    // Why the address typed can't be added; empty when it can
    pure callback problem([StationStream], string) -> string;
    // The list with the address typed at the end
    pure callback added([StationStream], string) -> [StationStream];
    // The list without the row at the index
    pure callback removed([StationStream], int) -> [StationStream];
    // The list with the row at the index moved by -1 (up) or 1 (down)
    pure callback moved([StationStream], int, int) -> [StationStream];
    // Why the row at the index can't take the address typed; empty when
    // it can
    pure callback change-problem([StationStream], int, string) -> string;
    // The list with the row at the index given the address typed
    pure callback changed([StationStream], int, string) -> [StationStream];
}

// One stream of the station: a radio button that makes it the default (the
// one played), what is known of it and its address, and its place in the
// list (the others are tried in order when the default doesn't connect).
// Edit Address turns the row's text into a field with the address, edited
// in place: Enter or Done keeps the change, Esc leaves it.
component StreamRow inherits Rectangle {
    in property <StationStream> stream;
    in property <bool> is-default;
    // The station's only stream: nothing to move, and it can't be removed
    in property <bool> alone;
    in property <bool> first;
    in property <bool> last;
    // The address is being edited, as `draft`
    in property <bool> editing;
    in-out property <string> draft;
    // The address typed can be kept
    in property <bool> can-keep;
    callback picked();
    callback move(int);
    callback remove();
    callback edit();
    callback keep();
    callback leave();

    property <string> text: root.stream.label == "" ? root.stream.url
        : root.stream.label + " · " + root.stream.url;

    height: root.editing ? Theme.control-field : Theme.row-menu;
    border-radius: Theme.radius-sm;
    background: root.editing ? transparent
        : touch.pressed ? Theme.pressed-bg
        : touch.has-hover ? Theme.hover-bg
        : root.is-default ? Theme.accent-tint : transparent;
    animate background { duration: Theme.fast; }

    touch := TouchArea {
        enabled: !root.editing;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-8;
        padding-right: Theme.space-2;
        spacing: Theme.space-8;

        // The radio button, and the row's Tab stop
        VerticalLayout {
            alignment: center;

            radio := Rectangle {
                width: Theme.icon-md;
                height: Theme.icon-md;
                border-radius: self.width / 2;
                border-width: root.is-default ? 2px : 1px;
                border-color: root.is-default ? Theme.accent-graphic : Theme.field-border;
                forward-focus: keys;

                accessible-role: radio-button;
                accessible-label: root.is-default ? "Default stream, \{root.text}" : "Make default, \{root.text}";
                accessible-checkable: true;
                accessible-checked: root.is-default;
                accessible-action-default => { root.picked(); }

                if root.is-default: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 8px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.accent-graphic;
                }

                keys := ButtonKeys {
                    activated => { root.picked(); }
                }

                if keys.has-focus: FocusRing {
                    radius: parent.border-radius;
                }
            }
        }

        if !root.editing: Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text-primary;
            font-size: Theme.font-md;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        // The address, edited where it was shown; Esc leaves it as it was
        // (and the dialog open)
        if root.editing: FocusScope {
            horizontal-stretch: 1;
            focus-on-tab-navigation: false;
            focus-on-click: false;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.leave();
                    return accept;
                }
                return reject;
            }

            StyledLineEdit {
                width: parent.width;
                height: parent.height;
                init => { self.focus-input(); }
                label: "Stream URL";
                placeholder-text: "Stream URL";
                text <=> root.draft;
                clearable: true;
                accepted => { root.keep(); }
            }
        }

        if root.editing: VerticalLayout {
            alignment: center;
            IconButton {
                width: 26px;
                height: 26px;
                icon: @image-url("../icons/tick.svg");
                icon-size: Theme.icon-sm;
                label: "Done";
                enabled: root.can-keep;
                clicked => { root.keep(); }
            }
        }

        if !root.editing: VerticalLayout {
            alignment: center;
            IconButton {
                width: 26px;
                height: 26px;
                icon: @image-url("../icons/pencil.svg");
                icon-size: Theme.icon-sm;
                label: "Edit Address";
                clicked => { root.edit(); }
            }
        }

        if !root.alone && !root.editing: HorizontalLayout {
            spacing: 0px;

            VerticalLayout {
                alignment: center;
                IconButton {
                    width: 26px;
                    height: 26px;
                    icon: @image-url("../icons/chevron-up.svg");
                    icon-size: Theme.icon-sm;
                    label: "Move Up";
                    enabled: !root.first;
                    clicked => { root.move(-1); }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    width: 26px;
                    height: 26px;
                    icon: @image-url("../icons/chevron-down.svg");
                    icon-size: Theme.icon-sm;
                    label: "Move Down";
                    enabled: !root.last;
                    clicked => { root.move(1); }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    width: 26px;
                    height: 26px;
                    icon: @image-url("../icons/xmark.svg");
                    icon-size: Theme.icon-sm;
                    label: "Remove Stream";
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

export component EditFavoriteDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <string> edit-id;
    in-out property <string> edit-name;
    // The default stream's address: the one played
    in-out property <string> edit-url;
    // Every stream, in the order they are tried after the default
    in-out property <[StationStream]> edit-streams;
    // The address typed to add, and why it can't be
    in-out property <string> new-stream;
    property <string> new-stream-problem: StreamEdit.problem(root.edit-streams, root.new-stream);
    // The row whose address is edited in place (-1: none), the address as
    // typed, and why the row can't take it
    in-out property <int> editing: -1;
    in-out property <string> stream-draft;
    property <string> draft-problem: root.editing < 0 ? ""
        : StreamEdit.change-problem(root.edit-streams, root.editing, root.stream-draft);
    property <bool> can-keep: root.stream-draft != "" && root.draft-problem == "";
    // What is said under the streams: why the address typed (in a row,
    // then in the field for a new one) can't be used, or why Save failed
    property <string> stream-problem: root.draft-problem != "" ? root.draft-problem
        : root.new-stream-problem != "" ? root.new-stream-problem : root.error;
    in-out property <string> edit-logo-url;
    in-out property <string> edit-country;
    // Why the last Save didn't go through (nothing was changed); cleared
    // when the streams are changed
    property <string> error;
    // Remove was clicked once: the next click removes
    in-out property <bool> confirm-remove: false;
    property <bool> can-save: root.edit-name != "" && root.edit-url != "";
    property <bool> can-add: root.new-stream != "" && root.new-stream-problem == "";
    // A row's button was used and went away with the list it was in (the
    // rows are made anew): the field for a new address takes the focus,
    // so the keys stay in the dialog
    property <int> focus-add-request;

    // Saves the changes; returns why it couldn't (e.g. another favorite
    // has the URL), or "" when saved
    callback accepted(FavoriteStation) -> string;
    callback deleted(FavoriteStation);

    public function open(station: FavoriteStation) {
        self.edit-id = station.id;
        self.edit-name = station.name;
        self.edit-url = station.url;
        self.edit-streams = station.streams;
        self.new-stream = "";
        self.editing = -1;
        self.stream-draft = "";
        self.edit-logo-url = station.logo-url;
        self.edit-country = station.country;
        self.error = "";
        self.confirm-remove = false;
        self.show-dialog = true;
    }

    // Save, or Enter in any field; the dialog stays open when it fails
    function save() {
        if !root.can-save {
            return;
        }
        // An address edited in place is kept, unless it can't be
        if root.editing >= 0 {
            if root.draft-problem != "" {
                return;
            }
            root.keep-address(false);
        }
        root.error = root.accepted(root.station());
        if root.error == "" {
            root.show-dialog = false;
        }
    }

    // Add the address typed to the list; Enter in its field does this
    // instead of saving, and saves once the field is empty
    function add-stream() {
        if !root.can-add {
            return;
        }
        root.edit-streams = StreamEdit.added(root.edit-streams, root.new-stream);
        root.new-stream = "";
        root.error = "";
    }

    // Edit the address of the row at `index` in place
    public function edit-address(index: int) {
        root.editing = index;
        root.stream-draft = root.edit-streams[index].url;
        root.error = "";
    }

    // The row being edited takes the address typed; `refocus` moves the
    // focus to the field for a new address, as the row's field goes away
    function keep-address(refocus: bool) {
        let index = root.editing;
        let was-default = root.edit-streams[index].url == root.edit-url;
        root.edit-streams = StreamEdit.changed(root.edit-streams, index, root.stream-draft);
        // The default's address changed: it is still the default
        if was-default {
            root.edit-url = root.edit-streams[index].url;
        }
        root.editing = -1;
        root.error = "";
        if refocus {
            root.focus-add-request += 1;
        }
    }

    function leave-address() {
        root.editing = -1;
        root.focus-add-request += 1;
    }

    function remove-stream(index: int) {
        root.editing = -1;
        let was-default = root.edit-streams[index].url == root.edit-url;
        root.edit-streams = StreamEdit.removed(root.edit-streams, index);
        // The default is gone: the first is the default now
        if was-default {
            root.edit-url = root.edit-streams[0].url;
        }
        root.error = "";
        root.focus-add-request += 1;
    }

    function move-stream(index: int, by: int) {
        root.editing = -1;
        root.edit-streams = StreamEdit.moved(root.edit-streams, index, by);
        root.error = "";
        root.focus-add-request += 1;
    }

    function station() -> FavoriteStation {
        return {
            id: root.edit-id,
            name: root.edit-name,
            url: root.edit-url,
            streams: root.edit-streams,
            logo-url: root.edit-logo-url,
            country: root.edit-country,
        };
    }

    if show-dialog: DialogShell {
        title: "Edit Favorite";
        subtitle: root.edit-name;
        card-width: Defaults.edit-favorite-width;
        auto-focus: false;
        cancel-label: "Cancel";
        primary-label: "Save";
        primary-enabled: root.can-save;
        primary-requested => { root.save(); }
        destructive-label: "Remove";
        destructive-armed: root.confirm-remove;
        destructive-armed-label: "Press Again to Remove";
        destructive-requested => {
            if root.confirm-remove {
                root.deleted(root.station());
                root.show-dialog = false;
            } else {
                root.confirm-remove = true;
            }
        }
        close-requested => { root.show-dialog = false; }

        Field {
            label: "Name";
            required: true;
            // The form starts on its first field; Enter in any field saves
            StyledLineEdit {
                init => { self.focus-input(); }
                label: "Name";
                required: true;
                placeholder-text: "Station name";
                text <=> root.edit-name;
                accepted => { root.save(); }
            }
        }

        Field {
            label: root.edit-streams.length == 1 ? "Stream" : "Streams";
            required: true;

            // The streams, the default marked: it plays, and the others
            // are tried in order when it doesn't connect
            Rectangle {
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.field-border;
                background: Theme.elevated;
                accessible-role: radio-group;
                accessible-label: "Default stream";

                VerticalLayout {
                    padding: Theme.space-4;
                    spacing: Theme.space-2;

                    for stream[index] in root.edit-streams: StreamRow {
                        stream: stream;
                        is-default: stream.url == root.edit-url;
                        alone: root.edit-streams.length == 1;
                        first: index == 0;
                        last: index == root.edit-streams.length - 1;
                        editing: index == root.editing;
                        draft <=> root.stream-draft;
                        can-keep: root.can-keep;
                        edit => { root.edit-address(index); }
                        keep => {
                            if root.can-keep {
                                root.keep-address(true);
                            }
                        }
                        leave => { root.leave-address(); }
                        picked => {
                            root.edit-url = stream.url;
                            root.error = "";
                        }
                        move(by) => { root.move-stream(index, by); }
                        remove => { root.remove-stream(index); }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-8;

                StyledLineEdit {
                    horizontal-stretch: 1;
                    property <int> focus-request: root.focus-add-request;
                    changed focus-request => { self.focus-input(); }
                    label: "Stream URL to add";
                    placeholder-text: "Add a stream URL";
                    text <=> root.new-stream;
                    clearable: true;
                    accepted => {
                        if root.new-stream == "" {
                            root.save();
                        } else {
                            root.add-stream();
                        }
                    }
                }

                SecondaryButton {
                    label: "Add";
                    enabled: root.can-add;
                    clicked => { root.add-stream(); }
                }
            }

            if root.stream-problem != "": Text {
                text: root.stream-problem;
                color: Theme.danger-text;
                font-size: Theme.font-md;
                wrap: word-wrap;
                // Save didn't go through: said at once
                accessible-live-region: assertive;
            }

            if root.edit-streams.length > 1 && root.stream-problem == "": Text {
                text: "The default plays. The others are tried in order if it doesn't connect.";
                color: Theme.text-tertiary;
                font-size: Theme.font-sm;
                wrap: word-wrap;
            }
        }

        Field {
            label: "Logo URL";
            optional: true;
            StyledLineEdit {
                label: "Logo URL";
                placeholder-text: "https://example.com/logo.png";
                text <=> root.edit-logo-url;
                clearable: true;
                accepted => { root.save(); }
            }
        }

        Field {
            label: "Country";
            optional: true;
            StyledLineEdit {
                label: "Country";
                placeholder-text: "United Kingdom";
                text <=> root.edit-country;
                clearable: true;
                accepted => { root.save(); }
            }
        }
    }
}
