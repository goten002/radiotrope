import { Theme } from "../theme.slint";
import { FavoriteStation } from "../favorites.slint";
import { StyledLineEdit } from "../styled-line-edit.slint";
import { AccentButton, SecondaryButton } from "../buttons.slint";

export component EditFavoriteDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <string> edit-id;
    in-out property <string> edit-name;
    in-out property <string> edit-url;
    in-out property <string> edit-logo-url;
    in-out property <string> edit-country;

    callback accepted(FavoriteStation);
    callback deleted(FavoriteStation);

    public function open(station: FavoriteStation) {
        self.edit-id = station.id;
        self.edit-name = station.name;
        self.edit-url = station.url;
        self.edit-logo-url = station.logo-url;
        self.edit-country = station.country;
        self.show-dialog = true;
    }

    if show-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.scrim;

        TouchArea {
            clicked => {
                root.show-dialog = false;
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 450px;
            height: edit-layout.preferred-height + 40px;
            background: Theme.card;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.hairline;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;

            TouchArea {}

            edit-layout := VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: "Edit Favorite";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 600;
                }

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Name";
                        color: Theme.text-secondary;
                        font-size: 12px;
                    }
                    StyledLineEdit {
                        placeholder-text: "Station name";
                        text <=> root.edit-name;
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "URL";
                        color: Theme.text-secondary;
                        font-size: 12px;
                    }
                    StyledLineEdit {
                        placeholder-text: "https://stream.example.com/radio";
                        text <=> root.edit-url;
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Logo URL";
                        color: Theme.text-secondary;
                        font-size: 12px;
                    }
                    StyledLineEdit {
                        placeholder-text: "https://example.com/logo.png";
                        text <=> root.edit-logo-url;
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Country";
                        color: Theme.text-secondary;
                        font-size: 12px;
                    }
                    StyledLineEdit {
                        placeholder-text: "United Kingdom, London";
                        text <=> root.edit-country;
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    spacing: 8px;

                    // Delete button
                    Rectangle {
                        height: 32px;
                        width: delete-layout.preferred-width + 24px;
                        border-radius: 4px;
                        background: delete-touch.pressed ? Theme.danger-hover.darker(0.1)
                                    : delete-touch.has-hover ? Theme.danger-hover
                                    : Theme.danger;
                        animate background { duration: Theme.fast; }

                        delete-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.deleted({
                                    id: root.edit-id,
                                    name: root.edit-name,
                                    url: root.edit-url,
                                    logo-url: root.edit-logo-url,
                                    country: root.edit-country,
                                });
                                root.show-dialog = false;
                            }
                        }

                        delete-layout := HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            padding-left: 4px;
                            padding-right: 4px;

                            Image {
                                source: @image-url("../icons/xmark.svg");
                                width: 12px;
                                height: 12px;
                                colorize: white;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "Delete";
                                color: white;
                                font-size: 13px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;

                        SecondaryButton {
                            label: "Cancel";
                            clicked => {
                                root.show-dialog = false;
                            }
                        }

                        AccentButton {
                            label: "Save";
                            enabled: root.edit-name != "" && root.edit-url != "";
                            clicked => {
                                root.accepted({
                                    id: root.edit-id,
                                    name: root.edit-name,
                                    url: root.edit-url,
                                    logo-url: root.edit-logo-url,
                                    country: root.edit-country,
                                });
                                root.show-dialog = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
