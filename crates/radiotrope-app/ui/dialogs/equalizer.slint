import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, Toggle, FocusRing, PopupCard, ChoiceRow, SectionHeader } from "../components.slint";

component EqFader inherits Rectangle {
    in property <string> label;
    // What a screen reader calls it: "Preamp", "40 Hz", "1 kHz"
    in property <string> spoken;
    in-out property <float> value: 0;
    // The EQ is off: grey instead of the accent, and it doesn't move. It
    // keeps showing its value.
    in property <bool> enabled: true;
    callback value-changed(float);

    property <color> tint: root.enabled ? Theme.accent : Theme.text-tertiary;

    horizontal-stretch: 1;
    height: 220px;

    // Like the volume slider: the knob grows under the pointer and a
    // bubble shows the value while hovering, dragging or scrolling
    property <bool> active: root.enabled && (track-touch.has-hover || track-touch.pressed);
    property <length> knob: root.active ? 18px : 14px;
    animate knob { duration: Theme.fast; }
    // Keeps the bubble up briefly after a scroll or key press
    property <bool> nudged;
    // The focus came from the keyboard (Tab, or keys used after a click),
    // so the knob shows the focus ring
    property <bool> key-focus;

    forward-focus: keys;
    accessible-role: slider;
    accessible-enabled: root.enabled;
    accessible-label: root.spoken;
    accessible-value: root.signed-db(Math.round(root.value * 10));
    accessible-value-minimum: -12;
    accessible-value-maximum: 12;
    accessible-value-step: 0.5;
    accessible-action-increment => { root.set(root.value + 0.5); }
    accessible-action-decrement => { root.set(root.value - 0.5); }
    accessible-action-set-value(v) => { root.set(v.to-float()); }

    // "+3.5 dB", "−3.5 dB" (a real minus), "0 dB"
    pure function signed-db(tenths: float) -> string {
        (tenths > 0 ? "+" : tenths < 0 ? "\u{2212}" : "") + abs(tenths) / 10 + " dB"
    }

    function set(v: float) {
        if !root.enabled {
            return;
        }
        root.value = clamp(v, -12.0, 12.0);
        root.value-changed(root.value);
        root.nudged = true;
        nudge-timer.running = false;
        nudge-timer.running = true;
    }

    nudge-timer := Timer {
        interval: Defaults.value-hint-time;
        running: false;
        triggered => {
            root.nudged = false;
            self.running = false;
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        // Track area
        Rectangle {
            height: 180px;

            // Track groove (outer shadow for depth)
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 0;
                width: 6px;
                height: parent.height;
                background: Theme.elevated;
                border-radius: 3px;
            }

            // Track groove (inner)
            Rectangle {
                x: (parent.width - self.width) / 2 + 0.5px;
                y: 0.5px;
                width: 5px;
                height: parent.height - 1px;
                // A firmer track in the light theme, where the well is faint
                background: Theme.dark-mode ? Theme.viz-track : Theme.text-tertiary.with-alpha(0.3);
                border-radius: 2.5px;
            }

            // 0dB reference line
            Rectangle {
                x: 2px;
                y: parent.height / 2 - 0.5px;
                width: parent.width - 4px;
                height: 1px;
                background: Theme.text-secondary;
                opacity: 0.3;
            }

            // Filled portion from center to thumb
            Rectangle {
                property <float> norm-value: (root.value + 12.0) / 24.0;
                property <length> center-y: parent.height / 2;
                property <length> thumb-y: parent.height * (1.0 - norm-value);

                x: (parent.width - self.width) / 2;
                y: thumb-y < center-y ? thumb-y : center-y;
                width: 5px;
                height: thumb-y < center-y ? center-y - thumb-y : thumb-y - center-y;
                background: root.tint;
                animate background { duration: Theme.normal; }
                border-radius: 2.5px;
            }

            // Thumb — solid filled circle
            thumb := Rectangle {
                property <float> norm-value: (root.value + 12.0) / 24.0;

                x: (parent.width - self.width) / 2;
                y: parent.height * (1.0 - norm-value) - self.height / 2;
                width: root.knob;
                height: root.knob;
                border-radius: root.knob / 2;
                background: root.tint;
                animate background { duration: Theme.normal; }

                // Inner highlight dot
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.knob * 3 / 7;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.surface;
                }

                if keys.has-focus && root.key-focus: FocusRing {
                    radius: parent.border-radius;
                }
            }

            // Drag area
            track-touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? pointer : default;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.key-focus = false;
                        keys.focus();
                    }
                }
                moved => {
                    if self.pressed {
                        root.value = clamp(12.0 - (self.mouse-y / 1px) / (parent.height / 1px) * 24.0, -12.0, 12.0);
                        root.value-changed(root.value);
                    }
                }
                double-clicked => {
                    root.value = 0;
                    root.value-changed(root.value);
                }
                clicked => {
                    root.value = clamp(12.0 - (self.mouse-y / 1px) / (parent.height / 1px) * 24.0, -12.0, 12.0);
                    root.value-changed(root.value);
                }
                scroll-event(evt) => {
                    root.value = clamp(root.value + (evt.delta-y / 1px) / 60.0, -12.0, 12.0);
                    root.value-changed(root.value);
                    root.nudged = true;
                    nudge-timer.running = false;
                    nudge-timer.running = true;
                    accept
                }
            }

            // Value bubble above the knob (below it near the top)
            bubble := PopupCard {
                property <bool> visible-now: root.active || root.nudged;
                property <float> tenths: Math.round(root.value * 10);
                opacity: visible-now ? 1 : 0;
                animate opacity { duration: Theme.fast; }
                width: 50px;
                height: 20px;
                x: (parent.width - self.width) / 2;
                y: thumb.y > self.height + 6px
                    ? thumb.y - self.height - 4px
                    : thumb.y + thumb.height + 4px;

                Text {
                    text: root.signed-db(bubble.tenths);
                    font-size: Theme.font-sm;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Frequency label
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }

    // Up/Down (0.5 dB, 0.1 with Shift), Page Up/Down (3 dB) and Home/End
    // once the fader has focus
    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                root.key-focus = true;
            }
        }
        key-pressed(e) => {
            root.key-focus = true;
            if e.text == Key.UpArrow || e.text == Key.RightArrow {
                root.set(root.value + (e.modifiers.shift ? 0.1 : 0.5));
                return accept;
            }
            if e.text == Key.DownArrow || e.text == Key.LeftArrow {
                root.set(root.value - (e.modifiers.shift ? 0.1 : 0.5));
                return accept;
            }
            if e.text == Key.PageUp {
                root.set(root.value + 3);
                return accept;
            }
            if e.text == Key.PageDown {
                root.set(root.value - 3);
                return accept;
            }
            if e.text == Key.Home {
                root.set(-12);
                return accept;
            }
            if e.text == Key.End {
                root.set(12);
                return accept;
            }
            return reject;
        }
    }
}

// A column of the preset menu: its heading and its presets
export struct EqPresetGroup {
    title: string,
    names: [string],
}

export component EqualizerDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in property <bool> show-preset-menu;
    // The presets, from the engine's list (set from Rust): the ones shown
    // on their own at the top (Flat), then a column per group
    in property <[string]> top-presets;
    in property <[EqPresetGroup]> preset-groups;
    property <length> preset-column-width: 140px;
    in-out property <bool> eq-enabled: false;
    in-out property <string> preset-name: "Flat";
    in-out property <float> preamp-gain: 0;
    in-out property <float> band0: 0;
    in-out property <float> band1: 0;
    in-out property <float> band2: 0;
    in-out property <float> band3: 0;
    in-out property <float> band4: 0;
    in-out property <float> band5: 0;
    in-out property <float> band6: 0;
    in-out property <float> band7: 0;
    in-out property <float> band8: 0;
    in-out property <float> band9: 0;

    // The preset the arrow keys are on in the open menu: a column (-1 for
    // the presets at the top) and a row in it
    property <int> active-group: -1;
    property <int> active-index: 0;
    // The menu was opened or moved with the keyboard: show where Enter lands
    property <bool> preset-keyboard: false;

    pure function group-length(g: int) -> int {
        g < 0 ? root.top-presets.length : root.preset-groups[g].names.length
    }

    pure function active-name() -> string {
        root.active-group < 0 ? root.top-presets[root.active-index]
            : root.preset-groups[root.active-group].names[root.active-index]
    }

    function move-active(key: string) {
        let last-group = root.preset-groups.length - 1;
        if key == Key.Home {
            root.active-group = -1;
            root.active-index = 0;
        } else if key == Key.End {
            root.active-group = last-group;
            root.active-index = root.group-length(last-group) - 1;
        } else if key == Key.DownArrow {
            if root.active-index < root.group-length(root.active-group) - 1 {
                root.active-index += 1;
            } else if root.active-group < 0 && last-group >= 0 {
                root.active-group = 0;
                root.active-index = 0;
            }
        } else if key == Key.UpArrow {
            if root.active-index > 0 {
                root.active-index -= 1;
            } else if root.active-group >= 0 {
                root.active-group = -1;
                root.active-index = root.top-presets.length - 1;
            }
        } else if root.active-group >= 0 {
            // Left and Right: the same row of the next column, or its last
            root.active-group = clamp(root.active-group + (key == Key.RightArrow ? 1 : -1), 0, last-group);
            root.active-index = min(root.active-index, root.group-length(root.active-group) - 1);
        } else if key == Key.RightArrow && last-group >= 0 {
            root.active-group = 0;
            root.active-index = 0;
        }
    }

    callback enabled-toggled(bool);
    callback preset-selected(string);
    callback preamp-changed(float);
    callback band-changed(int, float);

    if show-dialog: DialogShell {
        title: "Equalizer";
        subtitle: "10-band EQ, applied live to the stream";
        card-width: Defaults.equalizer-width;
        close-requested => { root.show-dialog = false; }

        // Controls row: enable toggle + preset dropdown
        HorizontalLayout {
            spacing: Theme.space-12;
            alignment: start;

            Toggle {
                label: "Use equalizer";
                checked <=> root.eq-enabled;
                toggled(on) => { root.enabled-toggled(on); }
            }

            // Preset dropdown, built like the shared Dropdown but with the
            // presets in columns. Space, Enter or the arrows open it; in
            // the menu the arrows move (Left and Right between columns),
            // Enter picks and Esc closes. Greyed out while the EQ is off,
            // like the faders.
            preset-field := Rectangle {
                property <bool> show-preset-menu: root.show-preset-menu;
                changed show-preset-menu => {
                    if self.show-preset-menu { self.open-presets(false); }
                }

                function open-presets(keyboard: bool) {
                    if root.eq-enabled {
                        // The rows move this onto the current preset as they appear
                        root.active-group = -1;
                        root.active-index = 0;
                        root.preset-keyboard = keyboard;
                        preset-keys.focus();
                        preset-popup.show();
                    }
                }

                function pick-preset(name: string) {
                    root.preset-selected(name);
                    preset-popup.close();
                }
                width: 160px;
                height: Theme.control-button;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.field-border;
                background: !root.eq-enabled ? Theme.disabled-bg
                    : preset-dd-touch.pressed ? Theme.pressed-bg
                    : preset-dd-touch.has-hover ? Theme.hover-bg : Theme.elevated;
                animate background { duration: Theme.fast; }

                accessible-role: combobox;
                accessible-label: "Preset";
                accessible-enabled: root.eq-enabled;
                accessible-value: root.preset-name == "" ? "Custom" : root.preset-name;
                accessible-action-default => { preset-field.open-presets(true); }

                preset-dd-touch := TouchArea {
                    enabled: root.eq-enabled;
                    mouse-cursor: root.eq-enabled ? pointer : default;
                    clicked => { preset-field.open-presets(false); }
                }

                preset-keys := FocusScope {
                    enabled: root.eq-enabled;
                    focus-on-click: false;
                    key-pressed(event) => {
                        if event.text == Key.Space || event.text == Key.Return
                            || event.text == Key.DownArrow || event.text == Key.UpArrow {
                            preset-field.open-presets(true);
                            return accept;
                        }
                        return reject;
                    }
                }

                if preset-keys.has-focus: FocusRing {
                    offset: 0px;
                    radius: parent.border-radius;
                }

                HorizontalLayout {
                    padding-left: Theme.space-12;
                    padding-right: Theme.space-12;
                    spacing: Theme.space-6;

                    Text {
                        text: root.preset-name == "" ? "Custom" : root.preset-name;
                        color: root.eq-enabled ? Theme.text-primary : Theme.disabled-text;
                        font-size: Theme.font-md;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                        accessible-role: none;
                    }

                    // Chevron
                    Rectangle {
                        width: Theme.icon-compact;

                        Text {
                            text: "\u{2304}";
                            color: root.eq-enabled ? Theme.text-secondary : Theme.disabled-text;
                            font-size: Theme.font-lg;
                            y: (parent.height - self.preferred-height) / 2 - Theme.space-2;
                            accessible-role: none;
                        }
                    }
                }

                // Flat on top, then the groups side by side, so the list
                // stays short enough for an 800x480 screen
                preset-popup := PopupWindow {
                    x: 0;
                    y: parent.height + Theme.space-2;
                    // The columns, the gaps between them and the padding
                    width: root.preset-groups.length * (root.preset-column-width + Theme.space-4) + Theme.space-4;
                    close-policy: close-on-click-outside;

                    PopupCard {
                        menu-keys := FocusScope {
                            focus-on-tab-navigation: false;
                            focus-on-click: false;
                            init => { self.focus(); }

                            key-pressed(event) => {
                                if event.text == Key.Escape {
                                    preset-popup.close();
                                    return accept;
                                }
                                if event.text == Key.Return || event.text == Key.Space {
                                    if !event.repeat {
                                        preset-field.pick-preset(root.active-name());
                                    }
                                    return accept;
                                }
                                if event.text == Key.UpArrow || event.text == Key.DownArrow
                                    || event.text == Key.LeftArrow || event.text == Key.RightArrow
                                    || event.text == Key.Home || event.text == Key.End {
                                    root.preset-keyboard = true;
                                    root.move-active(event.text);
                                    return accept;
                                }
                                return reject;
                            }

                            VerticalLayout {
                                padding: Theme.space-4;
                                spacing: Theme.space-4;

                                // Each item picks before closing: the menu's rows
                                // (and their name) go away with the popup
                                for name[i] in root.top-presets: ChoiceRow {
                                    label: name;
                                    selected: root.preset-name == name;
                                    highlighted: root.preset-keyboard && root.active-group == -1 && root.active-index == i;
                                    tab-stop: false;
                                    init => {
                                        if self.selected {
                                            root.active-group = -1;
                                            root.active-index = i;
                                        }
                                    }
                                    clicked => { preset-field.pick-preset(name); }
                                }

                                Rectangle {
                                    height: 1px;
                                    background: Theme.hairline;
                                }

                                HorizontalLayout {
                                    spacing: Theme.space-4;

                                    for group[g] in root.preset-groups: VerticalLayout {
                                        width: root.preset-column-width;
                                        // In line with the preset names under it
                                        HorizontalLayout {
                                            padding-left: Theme.space-8;
                                            SectionHeader { title: group.title.to-uppercase(); }
                                        }
                                        for name[i] in group.names: ChoiceRow {
                                            label: name;
                                            selected: root.preset-name == name;
                                            highlighted: root.preset-keyboard && root.active-group == g && root.active-index == i;
                                            tab-stop: false;
                                            init => {
                                                if self.selected {
                                                    root.active-group = g;
                                                    root.active-index = i;
                                                }
                                            }
                                            clicked => { preset-field.pick-preset(name); }
                                        }
                                        Rectangle { vertical-stretch: 1; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // dB scale + faders
        HorizontalLayout {
            spacing: 0px;

            // dB labels, laid out like a fader so they line up with the
            // track ends and its middle
            VerticalLayout {
                width: 40px;
                height: 220px;
                alignment: center;
                spacing: Theme.space-4;

                Rectangle {
                    height: 180px;

                    for mark[k] in ["+12 dB", "0 dB", "\u{2212}12 dB"]: Text {
                        x: 0;
                        width: parent.width - Theme.space-4;
                        y: parent.height * k / 2 - self.height / 2;
                        text: mark;
                        color: Theme.text-secondary;
                        font-size: Theme.font-2xs;
                        horizontal-alignment: right;
                        accessible-role: none;
                    }
                }
                // As tall as the frequency labels under the faders
                Text {
                    text: " ";
                    font-size: Theme.font-xs;
                    accessible-role: none;
                }
            }

            // Preamp fader
            EqFader {
                label: "Pre";
                spoken: "Preamp";
                enabled: root.eq-enabled;
                value <=> root.preamp-gain;
                value-changed(v) => { root.preamp-changed(v); }
            }

            // Separator line
            VerticalLayout {
                width: 1px;
                padding-top: Theme.space-8;
                padding-bottom: Theme.space-24;
                Rectangle {
                    width: 1px;
                    background: Theme.hairline;
                }
            }

            // 10 band faders — each stretches equally
            EqFader { label: "40"; spoken: "40 Hz"; enabled: root.eq-enabled; value <=> root.band0; value-changed(v) => { root.band-changed(0, v); } }
            EqFader { label: "64"; spoken: "64 Hz"; enabled: root.eq-enabled; value <=> root.band1; value-changed(v) => { root.band-changed(1, v); } }
            EqFader { label: "125"; spoken: "125 Hz"; enabled: root.eq-enabled; value <=> root.band2; value-changed(v) => { root.band-changed(2, v); } }
            EqFader { label: "250"; spoken: "250 Hz"; enabled: root.eq-enabled; value <=> root.band3; value-changed(v) => { root.band-changed(3, v); } }
            EqFader { label: "500"; spoken: "500 Hz"; enabled: root.eq-enabled; value <=> root.band4; value-changed(v) => { root.band-changed(4, v); } }
            EqFader { label: "1k"; spoken: "1 kHz"; enabled: root.eq-enabled; value <=> root.band5; value-changed(v) => { root.band-changed(5, v); } }
            EqFader { label: "2k"; spoken: "2 kHz"; enabled: root.eq-enabled; value <=> root.band6; value-changed(v) => { root.band-changed(6, v); } }
            EqFader { label: "4k"; spoken: "4 kHz"; enabled: root.eq-enabled; value <=> root.band7; value-changed(v) => { root.band-changed(7, v); } }
            EqFader { label: "8k"; spoken: "8 kHz"; enabled: root.eq-enabled; value <=> root.band8; value-changed(v) => { root.band-changed(8, v); } }
            EqFader { label: "12k"; spoken: "12 kHz"; enabled: root.eq-enabled; value <=> root.band9; value-changed(v) => { root.band-changed(9, v); } }
        }
    }
}
