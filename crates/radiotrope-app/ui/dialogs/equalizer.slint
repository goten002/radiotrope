import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, Toggle } from "../components.slint";

component EqFader inherits Rectangle {
    in property <string> label;
    in-out property <float> value: 0;
    callback value-changed(float);

    horizontal-stretch: 1;
    height: 220px;

    // Like the volume slider: the knob grows under the pointer and a
    // bubble shows the value while hovering, dragging or scrolling
    property <bool> active: track-touch.has-hover || track-touch.pressed;
    property <length> knob: root.active ? 18px : 14px;
    animate knob { duration: Theme.fast; }
    // Keeps the bubble up briefly after a scroll
    property <bool> nudged;

    nudge-timer := Timer {
        interval: Defaults.value-hint-time;
        running: false;
        triggered => {
            root.nudged = false;
            self.running = false;
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        // Track area
        Rectangle {
            height: 180px;

            // Track groove (outer shadow for depth)
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 0;
                width: 6px;
                height: parent.height;
                background: Theme.elevated;
                border-radius: 3px;
            }

            // Track groove (inner)
            Rectangle {
                x: (parent.width - self.width) / 2 + 0.5px;
                y: 0.5px;
                width: 5px;
                height: parent.height - 1px;
                background: Theme.viz-track;
                border-radius: 2.5px;
            }

            // 0dB reference line
            Rectangle {
                x: 2px;
                y: parent.height / 2 - 0.5px;
                width: parent.width - 4px;
                height: 1px;
                background: Theme.text-secondary;
                opacity: 0.3;
            }

            // Filled portion from center to thumb
            Rectangle {
                property <float> norm-value: (root.value + 12.0) / 24.0;
                property <length> center-y: parent.height / 2;
                property <length> thumb-y: parent.height * (1.0 - norm-value);

                x: (parent.width - self.width) / 2;
                y: thumb-y < center-y ? thumb-y : center-y;
                width: 5px;
                height: thumb-y < center-y ? center-y - thumb-y : thumb-y - center-y;
                background: Theme.accent;
                border-radius: 2.5px;
            }

            // Thumb — solid filled circle
            thumb := Rectangle {
                property <float> norm-value: (root.value + 12.0) / 24.0;

                x: (parent.width - self.width) / 2;
                y: parent.height * (1.0 - norm-value) - self.height / 2;
                width: root.knob;
                height: root.knob;
                border-radius: root.knob / 2;
                background: Theme.accent;

                // Inner highlight dot
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.knob * 3 / 7;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.surface;
                }
            }

            // Drag area
            track-touch := TouchArea {
                mouse-cursor: pointer;
                moved => {
                    if self.pressed {
                        root.value = clamp(12.0 - (self.mouse-y / 1px) / (parent.height / 1px) * 24.0, -12.0, 12.0);
                        root.value-changed(root.value);
                    }
                }
                double-clicked => {
                    root.value = 0;
                    root.value-changed(root.value);
                }
                clicked => {
                    root.value = clamp(12.0 - (self.mouse-y / 1px) / (parent.height / 1px) * 24.0, -12.0, 12.0);
                    root.value-changed(root.value);
                }
                scroll-event(evt) => {
                    root.value = clamp(root.value + (evt.delta-y / 1px) / 60.0, -12.0, 12.0);
                    root.value-changed(root.value);
                    root.nudged = true;
                    nudge-timer.running = false;
                    nudge-timer.running = true;
                    accept
                }
            }

            // Value bubble above the knob (below it near the top)
            bubble := Rectangle {
                property <bool> visible-now: root.active || root.nudged;
                property <float> tenths: Math.round(root.value * 10);
                opacity: visible-now ? 1 : 0;
                animate opacity { duration: Theme.fast; }
                width: 50px;
                height: 20px;
                x: (parent.width - self.width) / 2;
                y: thumb.y > self.height + 6px
                    ? thumb.y - self.height - 4px
                    : thumb.y + thumb.height + 4px;
                border-radius: 5px;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.hairline;
                drop-shadow-blur: 6px;
                drop-shadow-color: Theme.shadow-soft;

                Text {
                    text: (bubble.tenths > 0 ? "+" : "") + (bubble.tenths / 10) + " dB";
                    font-size: Theme.font-sm;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Frequency label
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            horizontal-alignment: center;
        }
    }
}

component PresetItem inherits Rectangle {
    in property <string> name;
    in property <bool> is-selected;
    callback clicked();

    height: 26px;
    border-radius: 4px;
    background: item-touch.has-hover ? Theme.menu-hover : transparent;
    animate background { duration: Theme.fast; }

    item-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        Rectangle {
            width: 12px;

            if root.is-selected: Rectangle {
                width: 6px;
                height: 6px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: item-touch.has-hover ? Theme.text-primary : Theme.menu-text;
                animate background { duration: Theme.fast; }
            }
        }

        Text {
            text: root.name;
            color: item-touch.has-hover ? Theme.text-primary : Theme.menu-text;
            font-size: Theme.font-md;
            vertical-alignment: center;
        }
    }
}

export component EqualizerDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    in-out property <bool> eq-enabled: false;
    in-out property <string> preset-name: "Flat";
    in-out property <float> preamp-gain: 0;
    in-out property <float> band0: 0;
    in-out property <float> band1: 0;
    in-out property <float> band2: 0;
    in-out property <float> band3: 0;
    in-out property <float> band4: 0;
    in-out property <float> band5: 0;
    in-out property <float> band6: 0;
    in-out property <float> band7: 0;
    in-out property <float> band8: 0;
    in-out property <float> band9: 0;

    callback enabled-toggled(bool);
    callback preset-selected(string);
    callback preamp-changed(float);
    callback band-changed(int, float);

    if show-dialog: DialogShell {
        title: "Equalizer";
        subtitle: "10-band EQ, applied live to the stream";
        card-width: Defaults.equalizer-width;
        close-requested => { root.show-dialog = false; }

        // Controls row: enable toggle + preset dropdown
        HorizontalLayout {
            height: 28px;
            spacing: 12px;
            alignment: start;

            Toggle {
                label: "Enabled";
                checked <=> root.eq-enabled;
                toggled(on) => { root.enabled-toggled(on); }
            }

            // Preset dropdown
            Rectangle {
                width: 160px;
                height: 30px;
                border-radius: 6px;
                background: preset-dd-touch.has-hover
                    ? Theme.menu-hover
                    : Theme.elevated;
                animate background { duration: Theme.fast; }

                preset-dd-touch := TouchArea {
                    clicked => { preset-popup.show(); }
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;

                    Text {
                        text: root.preset-name == "" ? "Custom" : root.preset-name;
                        color: Theme.text-primary;
                        font-size: Theme.font-base;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    // Chevron
                    Rectangle {
                        width: 14px;
                        height: parent.height;

                        Text {
                            text: "\u{2304}";
                            color: Theme.text-secondary;
                            font-size: Theme.font-lg;
                            y: (parent.height - self.preferred-height) / 2 - 2px;
                        }
                    }
                }

                preset-popup := PopupWindow {
                    x: 0;
                    y: 30px;
                    width: 160px;

                    Rectangle {
                        background: Theme.popup-bg;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.hairline;
                        drop-shadow-blur: 8px;
                        drop-shadow-color: Theme.shadow-soft;

                        VerticalLayout {
                            padding: 4px;

                            PresetItem { name: "Flat"; is-selected: root.preset-name == "Flat"; clicked => { preset-popup.close(); root.preset-selected("Flat"); } }
                            PresetItem { name: "Radio Enhance"; is-selected: root.preset-name == "Radio Enhance"; clicked => { preset-popup.close(); root.preset-selected("Radio Enhance"); } }
                            PresetItem { name: "Rock"; is-selected: root.preset-name == "Rock"; clicked => { preset-popup.close(); root.preset-selected("Rock"); } }
                            PresetItem { name: "Pop"; is-selected: root.preset-name == "Pop"; clicked => { preset-popup.close(); root.preset-selected("Pop"); } }
                            PresetItem { name: "Classical"; is-selected: root.preset-name == "Classical"; clicked => { preset-popup.close(); root.preset-selected("Classical"); } }
                            PresetItem { name: "Jazz"; is-selected: root.preset-name == "Jazz"; clicked => { preset-popup.close(); root.preset-selected("Jazz"); } }
                            PresetItem { name: "Bass Boost"; is-selected: root.preset-name == "Bass Boost"; clicked => { preset-popup.close(); root.preset-selected("Bass Boost"); } }
                            PresetItem { name: "Treble Boost"; is-selected: root.preset-name == "Treble Boost"; clicked => { preset-popup.close(); root.preset-selected("Treble Boost"); } }
                            PresetItem { name: "Dance"; is-selected: root.preset-name == "Dance"; clicked => { preset-popup.close(); root.preset-selected("Dance"); } }
                            PresetItem { name: "Soft"; is-selected: root.preset-name == "Soft"; clicked => { preset-popup.close(); root.preset-selected("Soft"); } }
                            PresetItem { name: "Live"; is-selected: root.preset-name == "Live"; clicked => { preset-popup.close(); root.preset-selected("Live"); } }
                            PresetItem { name: "Club"; is-selected: root.preset-name == "Club"; clicked => { preset-popup.close(); root.preset-selected("Club"); } }
                            PresetItem { name: "Headphones"; is-selected: root.preset-name == "Headphones"; clicked => { preset-popup.close(); root.preset-selected("Headphones"); } }
                            PresetItem { name: "Techno"; is-selected: root.preset-name == "Techno"; clicked => { preset-popup.close(); root.preset-selected("Techno"); } }
                        }
                    }
                }
            }
        }

        // dB scale + faders
        HorizontalLayout {
            spacing: 0px;

            // dB labels
            VerticalLayout {
                width: 28px;
                height: 220px;

                Text {
                    text: "+12";
                    color: Theme.text-secondary;
                    font-size: Theme.font-2xs;
                    horizontal-alignment: right;
                    vertical-alignment: top;
                }
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "0 dB";
                    color: Theme.text-secondary;
                    font-size: Theme.font-2xs;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "-12";
                    color: Theme.text-secondary;
                    font-size: Theme.font-2xs;
                    horizontal-alignment: right;
                    vertical-alignment: bottom;
                }
            }

            // Preamp fader
            EqFader {
                label: "Pre";
                value <=> root.preamp-gain;
                value-changed(v) => { root.preamp-changed(v); }
            }

            // Separator line
            VerticalLayout {
                width: 1px;
                padding-top: 8px;
                padding-bottom: 24px;
                Rectangle {
                    width: 1px;
                    background: Theme.menu-hover;
                }
            }

            // 10 band faders — each stretches equally
            EqFader { label: "32"; value <=> root.band0; value-changed(v) => { root.band-changed(0, v); } }
            EqFader { label: "64"; value <=> root.band1; value-changed(v) => { root.band-changed(1, v); } }
            EqFader { label: "125"; value <=> root.band2; value-changed(v) => { root.band-changed(2, v); } }
            EqFader { label: "250"; value <=> root.band3; value-changed(v) => { root.band-changed(3, v); } }
            EqFader { label: "500"; value <=> root.band4; value-changed(v) => { root.band-changed(4, v); } }
            EqFader { label: "1K"; value <=> root.band5; value-changed(v) => { root.band-changed(5, v); } }
            EqFader { label: "2K"; value <=> root.band6; value-changed(v) => { root.band-changed(6, v); } }
            EqFader { label: "4K"; value <=> root.band7; value-changed(v) => { root.band-changed(7, v); } }
            EqFader { label: "8K"; value <=> root.band8; value-changed(v) => { root.band-changed(8, v); } }
            EqFader { label: "16K"; value <=> root.band9; value-changed(v) => { root.band-changed(9, v); } }
        }
    }
}
