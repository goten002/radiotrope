import { Theme, Defaults } from "../defaults.slint";
import { DialogShell, Icon, Toggle, ButtonKeys, FocusRing, PopupCard } from "../components.slint";

component EqFader inherits Rectangle {
    in property <string> label;
    in-out property <float> value: 0;
    // The EQ is off: grey instead of the accent, and it doesn't move. It
    // keeps showing its value.
    in property <bool> enabled: true;
    callback value-changed(float);

    property <color> tint: root.enabled ? Theme.accent : Theme.text-tertiary;

    horizontal-stretch: 1;
    height: 220px;

    // Like the volume slider: the knob grows under the pointer and a
    // bubble shows the value while hovering, dragging or scrolling
    property <bool> active: root.enabled && (track-touch.has-hover || track-touch.pressed);
    property <length> knob: root.active ? 18px : 14px;
    animate knob { duration: Theme.fast; }
    // Keeps the bubble up briefly after a scroll or key press
    property <bool> nudged;
    // The focus came from the keyboard (Tab, or keys used after a click),
    // so the knob shows the focus ring
    property <bool> key-focus;

    forward-focus: keys;
    accessible-role: slider;
    accessible-enabled: root.enabled;
    accessible-label: root.label == "Pre" ? "Preamp" : root.label + " Hz";
    accessible-value: (Math.round(root.value * 10) > 0 ? "+" : "") + Math.round(root.value * 10) / 10 + " dB";
    accessible-value-minimum: -12;
    accessible-value-maximum: 12;
    accessible-value-step: 0.5;
    accessible-action-increment => { root.set(root.value + 0.5); }
    accessible-action-decrement => { root.set(root.value - 0.5); }
    accessible-action-set-value(v) => { root.set(v.to-float()); }

    function set(v: float) {
        if !root.enabled {
            return;
        }
        root.value = clamp(v, -12.0, 12.0);
        root.value-changed(root.value);
        root.nudged = true;
        nudge-timer.running = false;
        nudge-timer.running = true;
    }

    nudge-timer := Timer {
        interval: Defaults.value-hint-time;
        running: false;
        triggered => {
            root.nudged = false;
            self.running = false;
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        // Track area
        Rectangle {
            height: 180px;

            // Track groove (outer shadow for depth)
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 0;
                width: 6px;
                height: parent.height;
                background: Theme.elevated;
                border-radius: 3px;
            }

            // Track groove (inner)
            Rectangle {
                x: (parent.width - self.width) / 2 + 0.5px;
                y: 0.5px;
                width: 5px;
                height: parent.height - 1px;
                background: Theme.viz-track;
                border-radius: 2.5px;
            }

            // 0dB reference line
            Rectangle {
                x: 2px;
                y: parent.height / 2 - 0.5px;
                width: parent.width - 4px;
                height: 1px;
                background: Theme.text-secondary;
                opacity: 0.3;
            }

            // Filled portion from center to thumb
            Rectangle {
                property <float> norm-value: (root.value + 12.0) / 24.0;
                property <length> center-y: parent.height / 2;
                property <length> thumb-y: parent.height * (1.0 - norm-value);

                x: (parent.width - self.width) / 2;
                y: thumb-y < center-y ? thumb-y : center-y;
                width: 5px;
                height: thumb-y < center-y ? center-y - thumb-y : thumb-y - center-y;
                background: root.tint;
                animate background { duration: Theme.normal; }
                border-radius: 2.5px;
            }

            // Thumb — solid filled circle
            thumb := Rectangle {
                property <float> norm-value: (root.value + 12.0) / 24.0;

                x: (parent.width - self.width) / 2;
                y: parent.height * (1.0 - norm-value) - self.height / 2;
                width: root.knob;
                height: root.knob;
                border-radius: root.knob / 2;
                background: root.tint;
                animate background { duration: Theme.normal; }

                // Inner highlight dot
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.knob * 3 / 7;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.surface;
                }

                if keys.has-focus && root.key-focus: FocusRing {
                    radius: parent.border-radius;
                }
            }

            // Drag area
            track-touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? pointer : default;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.key-focus = false;
                        keys.focus();
                    }
                }
                moved => {
                    if self.pressed {
                        root.value = clamp(12.0 - (self.mouse-y / 1px) / (parent.height / 1px) * 24.0, -12.0, 12.0);
                        root.value-changed(root.value);
                    }
                }
                double-clicked => {
                    root.value = 0;
                    root.value-changed(root.value);
                }
                clicked => {
                    root.value = clamp(12.0 - (self.mouse-y / 1px) / (parent.height / 1px) * 24.0, -12.0, 12.0);
                    root.value-changed(root.value);
                }
                scroll-event(evt) => {
                    root.value = clamp(root.value + (evt.delta-y / 1px) / 60.0, -12.0, 12.0);
                    root.value-changed(root.value);
                    root.nudged = true;
                    nudge-timer.running = false;
                    nudge-timer.running = true;
                    accept
                }
            }

            // Value bubble above the knob (below it near the top)
            bubble := Rectangle {
                property <bool> visible-now: root.active || root.nudged;
                property <float> tenths: Math.round(root.value * 10);
                opacity: visible-now ? 1 : 0;
                animate opacity { duration: Theme.fast; }
                width: 50px;
                height: 20px;
                x: (parent.width - self.width) / 2;
                y: thumb.y > self.height + 6px
                    ? thumb.y - self.height - 4px
                    : thumb.y + thumb.height + 4px;
                border-radius: 5px;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.hairline;
                drop-shadow-blur: 6px;
                drop-shadow-color: Theme.shadow-soft;

                Text {
                    text: (bubble.tenths > 0 ? "+" : "") + (bubble.tenths / 10) + " dB";
                    font-size: Theme.font-sm;
                    font-weight: 600;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Frequency label
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }

    // Up/Down (0.5 dB, 0.1 with Shift), Page Up/Down (3 dB) and Home/End
    // once the fader has focus
    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                root.key-focus = true;
            }
        }
        key-pressed(e) => {
            root.key-focus = true;
            if e.text == Key.UpArrow || e.text == Key.RightArrow {
                root.set(root.value + (e.modifiers.shift ? 0.1 : 0.5));
                return accept;
            }
            if e.text == Key.DownArrow || e.text == Key.LeftArrow {
                root.set(root.value - (e.modifiers.shift ? 0.1 : 0.5));
                return accept;
            }
            if e.text == Key.PageUp {
                root.set(root.value + 3);
                return accept;
            }
            if e.text == Key.PageDown {
                root.set(root.value - 3);
                return accept;
            }
            if e.text == Key.Home {
                root.set(-12);
                return accept;
            }
            if e.text == Key.End {
                root.set(12);
                return accept;
            }
            return reject;
        }
    }
}

component PresetItem inherits Rectangle {
    in property <string> name;
    in property <bool> is-selected;
    callback clicked();

    // Hovered, or reached with Tab: highlighted the same way
    property <bool> lit: item-touch.has-hover || keys.has-focus;

    height: 26px;
    border-radius: Theme.radius-sm;
    background: root.lit ? Theme.menu-hover : transparent;
    animate background { duration: Theme.fast; }

    accessible-role: radio-button;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.is-selected;
    accessible-action-default => { root.clicked(); }

    item-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    keys := ButtonKeys {
        activated => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;

        Text {
            horizontal-stretch: 1;
            text: root.name;
            color: root.lit ? Theme.text-primary : Theme.menu-text;
            font-size: Theme.font-md;
            vertical-alignment: center;
            accessible-role: none;
        }

        // Tick on the right, as on the menus
        Rectangle {
            width: 12px;

            if root.is-selected: Icon {
                width: 12px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                source: @image-url("../icons/tick.svg");
                colorize: Theme.accent;
            }
        }
    }
}

component PresetGroupLabel inherits Rectangle {
    in property <string> text;
    height: 22px;

    Text {
        // In line with the preset names under it
        x: 10px;
        height: parent.height;
        text: root.text;
        color: Theme.text-secondary;
        font-size: Theme.font-xs;
        vertical-alignment: center;
    }
}

// A column of the preset menu: its heading and its presets
export struct EqPresetGroup {
    title: string,
    names: [string],
}

export component EqualizerDialog inherits Rectangle {
    in-out property <bool> show-dialog: false;
    // The presets, from the engine's list (set from Rust): the ones shown
    // on their own at the top (Flat), then a column per group
    in property <[string]> top-presets;
    in property <[EqPresetGroup]> preset-groups;
    property <length> preset-column-width: 140px;
    in-out property <bool> eq-enabled: false;
    in-out property <string> preset-name: "Flat";
    in-out property <float> preamp-gain: 0;
    in-out property <float> band0: 0;
    in-out property <float> band1: 0;
    in-out property <float> band2: 0;
    in-out property <float> band3: 0;
    in-out property <float> band4: 0;
    in-out property <float> band5: 0;
    in-out property <float> band6: 0;
    in-out property <float> band7: 0;
    in-out property <float> band8: 0;
    in-out property <float> band9: 0;

    callback enabled-toggled(bool);
    callback preset-selected(string);
    callback preamp-changed(float);
    callback band-changed(int, float);

    if show-dialog: DialogShell {
        title: "Equalizer";
        subtitle: "10-band EQ, applied live to the stream";
        card-width: Defaults.equalizer-width;
        close-requested => { root.show-dialog = false; }

        // Controls row: enable toggle + preset dropdown
        HorizontalLayout {
            height: 28px;
            spacing: 12px;
            alignment: start;

            Toggle {
                label: "Enabled";
                checked <=> root.eq-enabled;
                toggled(on) => { root.enabled-toggled(on); }
            }

            // Preset dropdown; Space, Enter or Down opens it once reached
            // with Tab. Greyed out while the EQ is off, like the faders.
            Rectangle {
                width: 160px;
                height: 30px;
                border-radius: Theme.radius-md;
                background: root.eq-enabled && preset-dd-touch.has-hover
                    ? Theme.menu-hover
                    : Theme.elevated;
                animate background { duration: Theme.fast; }

                accessible-role: combobox;
                accessible-label: "Preset";
                accessible-enabled: root.eq-enabled;
                accessible-value: root.preset-name == "" ? "Custom" : root.preset-name;
                accessible-action-default => {
                    if root.eq-enabled {
                        preset-popup.show();
                    }
                }

                preset-dd-touch := TouchArea {
                    enabled: root.eq-enabled;
                    clicked => { preset-popup.show(); }
                }

                preset-keys := FocusScope {
                    enabled: root.eq-enabled;
                    focus-on-click: false;
                    key-pressed(event) => {
                        if event.text == Key.Space || event.text == Key.Return || event.text == Key.DownArrow {
                            preset-popup.show();
                            return accept;
                        }
                        return reject;
                    }
                }

                if preset-keys.has-focus: FocusRing {
                    radius: parent.border-radius;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;

                    Text {
                        text: root.preset-name == "" ? "Custom" : root.preset-name;
                        color: root.eq-enabled ? Theme.text-primary : Theme.disabled-text;
                        font-size: Theme.font-base;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    // Chevron
                    Rectangle {
                        width: 14px;
                        height: parent.height;

                        Text {
                            text: "\u{2304}";
                            color: root.eq-enabled ? Theme.text-secondary : Theme.disabled-text;
                            font-size: Theme.font-lg;
                            y: (parent.height - self.preferred-height) / 2 - 2px;
                        }
                    }
                }

                // Flat on top, then the groups side by side, so the list
                // stays short enough for an 800x480 screen
                preset-popup := PopupWindow {
                    x: 0;
                    y: 30px;
                    // The columns, the gaps between them and the padding
                    width: root.preset-groups.length * (root.preset-column-width + 4px) + 4px;

                    PopupCard {
                        VerticalLayout {
                            padding: 4px;
                            spacing: 4px;

                            // Each item picks before closing: the menu's rows
                            // (and their name) go away with the popup
                            for name in root.top-presets: PresetItem {
                                name: name;
                                is-selected: root.preset-name == name;
                                clicked => {
                                    root.preset-selected(name);
                                    preset-popup.close();
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.hairline;
                            }

                            HorizontalLayout {
                                spacing: 4px;

                                for group in root.preset-groups: VerticalLayout {
                                    width: root.preset-column-width;
                                    PresetGroupLabel { text: group.title; }
                                    for name in group.names: PresetItem {
                                        name: name;
                                        is-selected: root.preset-name == name;
                                        clicked => {
                                            root.preset-selected(name);
                                            preset-popup.close();
                                        }
                                    }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                        }
                    }
                }
            }
        }

        // dB scale + faders
        HorizontalLayout {
            spacing: 0px;

            // dB labels
            VerticalLayout {
                width: 28px;
                height: 220px;

                Text {
                    text: "+12";
                    color: Theme.text-secondary;
                    font-size: Theme.font-2xs;
                    horizontal-alignment: right;
                    vertical-alignment: top;
                }
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "0 dB";
                    color: Theme.text-secondary;
                    font-size: Theme.font-2xs;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "-12";
                    color: Theme.text-secondary;
                    font-size: Theme.font-2xs;
                    horizontal-alignment: right;
                    vertical-alignment: bottom;
                }
            }

            // Preamp fader
            EqFader {
                label: "Pre";
                enabled: root.eq-enabled;
                value <=> root.preamp-gain;
                value-changed(v) => { root.preamp-changed(v); }
            }

            // Separator line
            VerticalLayout {
                width: 1px;
                padding-top: 8px;
                padding-bottom: 24px;
                Rectangle {
                    width: 1px;
                    background: Theme.menu-hover;
                }
            }

            // 10 band faders — each stretches equally
            EqFader { label: "40"; enabled: root.eq-enabled; value <=> root.band0; value-changed(v) => { root.band-changed(0, v); } }
            EqFader { label: "64"; enabled: root.eq-enabled; value <=> root.band1; value-changed(v) => { root.band-changed(1, v); } }
            EqFader { label: "125"; enabled: root.eq-enabled; value <=> root.band2; value-changed(v) => { root.band-changed(2, v); } }
            EqFader { label: "250"; enabled: root.eq-enabled; value <=> root.band3; value-changed(v) => { root.band-changed(3, v); } }
            EqFader { label: "500"; enabled: root.eq-enabled; value <=> root.band4; value-changed(v) => { root.band-changed(4, v); } }
            EqFader { label: "1K"; enabled: root.eq-enabled; value <=> root.band5; value-changed(v) => { root.band-changed(5, v); } }
            EqFader { label: "2K"; enabled: root.eq-enabled; value <=> root.band6; value-changed(v) => { root.band-changed(6, v); } }
            EqFader { label: "4K"; enabled: root.eq-enabled; value <=> root.band7; value-changed(v) => { root.band-changed(7, v); } }
            EqFader { label: "8K"; enabled: root.eq-enabled; value <=> root.band8; value-changed(v) => { root.band-changed(8, v); } }
            EqFader { label: "12K"; enabled: root.eq-enabled; value <=> root.band9; value-changed(v) => { root.band-changed(9, v); } }
        }
    }
}
