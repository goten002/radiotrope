export enum ShortcutAction {
    unhandled, play-stop, mute, volume-up, volume-down, record,
    next-favorite, previous-favorite, toggle-favorite, search, network-stream,
    close-window, quit, help,
    favorite-up, favorite-down, favorite-first, favorite-last, favorite-page-up, favorite-page-down,
    favorite-play, favorite-menu, favorite-clear,
    favorite-move-up, favorite-move-down, find-favorites, undo-remove,
}

// Keys pressed together, e.g. ["Ctrl", "F"]
export struct KeyCombo {
    keys: [string],
}

// One line of the Keyboard Shortcuts dialog
export struct ShortcutRow {
    description: string,
    // Each a way to press it, drawn side by side
    alternatives: [KeyCombo],
    // Drawn between the alternatives ("or"), or empty
    separator: string,
    // The spoken label: "Search stations: Control F"
    spoken: string,
}

// One card of the dialog
export struct ShortcutGroup {
    title: string,
    rows: [ShortcutRow],
}

export global DesktopShortcuts {
    in property <bool> enabled;
    in property <[ShortcutGroup]> groups;
    pure callback label(ShortcutAction) -> string;
    callback match-key(KeyEvent) -> ShortcutAction;
}
